PUBLIC_SITE_URL=https://magnolia-healthcare-demo.vercel.app
# Consultation form delivery (api/inquiry.js). Leave UNSET for the demo: submissions are
# accepted in labelled "demo mode" and nothing is sent anywhere.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
