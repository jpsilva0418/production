---
/**
 * Caregiver application — Magnolia's existing 3-page paper application (reference PDF,
 * "Initial application for caregiver candidates"), rebuilt as a multi-step flow on the Leti
 * Silva Beauty form system. EVERY field, option, note and the certification statement is
 * carried over verbatim; nothing is removed. One optional field is ADDED — a write-in for
 * "Other" under certification type — so that answer is not lost. The paper form marks
 * nothing as required, so the web form only insists on what processing genuinely needs
 * (name, phone, email, the two yes/no gate questions, and the signed certification) —
 * everything else is labelled optional and the review step points out what was left blank.
 *
 * Interaction principles ported: one state object, Back never loses answers (and a
 * session draft survives an accidental reload), progress + recap, review with Edit,
 * gated Continue with inline validation, honest sending / error / success, copy fallback.
 * Posts JSON to /api/apply; on a host without the function the request is accepted in
 * labelled DEMO mode.
 */
import { SITE } from '../consts';
---
<section class="ap-section">
  <noscript>
    <p class="ap-noscript">This application needs JavaScript. You can also <a href="/downloads/magnolia-healthcare-caregiver-application.pdf" download>download the application form</a> and email it to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
  </noscript>

  <form id="apForm" class="ap-form" novalidate>
    <ol class="ap-prog" id="apProg" aria-label="Progress"></ol>
    <p class="ap-prog-now" id="apProgNow" aria-live="polite"></p>
    <p class="ap-draft" id="apDraft" hidden>Your draft was restored from this browser session. <button type="button" id="apDraftClear">Start over</button></p>
    <dl class="ap-recap" id="apRecap" hidden></dl>

    <!-- 1 · PERSONAL INFORMATION -->
    <fieldset class="ap-step" data-step="personal">
      <legend tabindex="-1">Personal information</legend>
      <div class="ap-field">
        <label for="ap-fullName">Full legal name <span class="ap-req">required</span></label>
        <input id="ap-fullName" name="fullName" type="text" maxlength="120" autocomplete="name" required aria-describedby="ap-fullName-err" />
        <p class="ap-err" id="ap-fullName-err" role="alert" hidden>Please enter your full legal name.</p>
      </div>
      <div class="ap-two">
        <div class="ap-field">
          <label for="ap-phone">Phone <span class="ap-req">required</span></label>
          <input id="ap-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" inputmode="tel" required aria-describedby="ap-phone-err" />
          <p class="ap-err" id="ap-phone-err" role="alert" hidden>Please enter a phone number we can call.</p>
        </div>
        <div class="ap-field">
          <label for="ap-email">Email <span class="ap-req">required</span></label>
          <input id="ap-email" name="email" type="email" maxlength="160" autocomplete="email" inputmode="email" required aria-describedby="ap-email-err" />
          <p class="ap-err" id="ap-email-err" role="alert" hidden>That email address doesn&rsquo;t look complete.</p>
        </div>
      </div>
      <div class="ap-field">
        <label for="ap-address">Address</label>
        <input id="ap-address" name="address" type="text" maxlength="200" autocomplete="street-address" />
      </div>
      <div class="ap-three">
        <div class="ap-field"><label for="ap-city">City</label><input id="ap-city" name="city" type="text" maxlength="80" autocomplete="address-level2" /></div>
        <div class="ap-field"><label for="ap-state">State</label><input id="ap-state" name="state" type="text" maxlength="40" autocomplete="address-level1" placeholder="MA" /></div>
        <div class="ap-field"><label for="ap-zip">ZIP</label><input id="ap-zip" name="zip" type="text" maxlength="10" autocomplete="postal-code" /></div>
      </div>
    </fieldset>

    <!-- 2 · AVAILABILITY -->
    <fieldset class="ap-step" data-step="availability" hidden>
      <legend tabindex="-1">Availability</legend>
      <div class="ap-field" role="group" aria-labelledby="ap-days-label">
        <span class="ap-lbl" id="ap-days-label">Days available</span>
        <div class="ap-cards ap-cards-days">
          {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].map((d) => (
            <label class="ap-card"><input type="checkbox" name="days" value={d} /><span>{d}</span></label>
          ))}
        </div>
      </div>
      <div class="ap-field" role="group" aria-labelledby="ap-times-label">
        <span class="ap-lbl" id="ap-times-label">Preferred time</span>
        <div class="ap-cards ap-cards-row">
          <label class="ap-card"><input type="checkbox" name="times" value="Morning" /><span>Morning</span></label>
          <label class="ap-card"><input type="checkbox" name="times" value="Evening" /><span>Evening</span></label>
          <label class="ap-card"><input type="checkbox" name="times" value="Night" /><span>Night</span></label>
        </div>
      </div>
    </fieldset>

    <!-- 3 · PROFESSIONAL CERTIFICATION & LICENSE -->
    <fieldset class="ap-step" data-step="license" hidden>
      <legend tabindex="-1">Professional certification &amp; license</legend>
      <div class="ap-field" role="radiogroup" aria-labelledby="ap-hasCert-label" aria-required="true" aria-describedby="ap-hasCert-err">
        <span class="ap-lbl" id="ap-hasCert-label">Are you a CNA, HHA, or do you hold any other healthcare-related license or certification? <span class="ap-req">required</span></span>
        <div class="ap-cards ap-cards-row">
          <label class="ap-card"><input type="radio" name="hasCert" value="Yes" /><span>Yes</span></label>
          <label class="ap-card"><input type="radio" name="hasCert" value="No" /><span>No</span></label>
        </div>
        <p class="ap-err" id="ap-hasCert-err" role="alert" hidden>Please choose Yes or No.</p>
      </div>
      <div id="apCertYes" hidden>
        <p class="ap-hint">If yes, please provide:</p>
        <div class="ap-field" role="group" aria-labelledby="ap-certType-label">
          <span class="ap-lbl" id="ap-certType-label">Type <span class="ap-req">check all that apply</span></span>
          <div class="ap-cards ap-cards-row">
            <label class="ap-card"><input type="checkbox" name="certType" value="CNA" /><span>CNA</span></label>
            <label class="ap-card"><input type="checkbox" name="certType" value="HHA" /><span>HHA</span></label>
            <label class="ap-card"><input type="checkbox" name="certType" value="Other" /><span>Other</span></label>
          </div>
        </div>
        <div class="ap-field" id="apCertOther" hidden>
          <label for="ap-certTypeOther">Other &mdash; please specify</label>
          <input id="ap-certTypeOther" name="certTypeOther" type="text" maxlength="120" />
        </div>
        <div class="ap-two">
          <div class="ap-field"><label for="ap-certNumber">License / certification number</label><input id="ap-certNumber" name="certNumber" type="text" maxlength="80" autocomplete="off" /></div>
          <div class="ap-field"><label for="ap-certState">State</label><input id="ap-certState" name="certState" type="text" maxlength="40" placeholder="MA" /></div>
        </div>
        <div class="ap-field ap-half"><label for="ap-certExpiry">Expiration date</label><input id="ap-certExpiry" name="certExpiry" type="date" /></div>
      </div>
      <p class="ap-note" id="apCertNo" role="status" hidden><em>If no:</em> Magnolia Healthcare Inc. may provide information about available caregiver training opportunities and courses.</p>
    </fieldset>

    <!-- 4 · CAREGIVING EXPERIENCE -->
    <fieldset class="ap-step" data-step="experience" hidden>
      <legend tabindex="-1">Caregiving experience</legend>
      <div class="ap-field" role="radiogroup" aria-labelledby="ap-hasExp-label" aria-required="true" aria-describedby="ap-hasExperience-err">
        <span class="ap-lbl" id="ap-hasExp-label">Do you have previous caregiving experience? <span class="ap-req">required</span></span>
        <div class="ap-cards ap-cards-row">
          <label class="ap-card"><input type="radio" name="hasExperience" value="Yes" /><span>Yes</span></label>
          <label class="ap-card"><input type="radio" name="hasExperience" value="No" /><span>No</span></label>
        </div>
        <p class="ap-err" id="ap-hasExperience-err" role="alert" hidden>Please choose Yes or No.</p>
      </div>
      <!-- Years / where you have worked are NOT gated on paper: they stay visible and are never cleared. -->
      <div id="apExpYes">
        <div class="ap-field ap-half">
          <label for="ap-years">Years of caregiving experience</label>
          <input id="ap-years" name="years" type="number" min="0" max="70" step="0.5" inputmode="decimal" />
        </div>
        <div class="ap-field" role="group" aria-labelledby="ap-workedAt-label">
          <span class="ap-lbl" id="ap-workedAt-label">Where have you worked? Check all that apply.</span>
          <div class="ap-cards ap-cards-2">
            {['Private Care', 'Home Care Agency', 'Nursing Home', 'Assisted Living', 'Hospital', 'Hospice', 'Other'].map((w) => (
              <label class="ap-card"><input type="checkbox" name="workedAt" value={w} /><span>{w}</span></label>
            ))}
          </div>
        </div>
      </div>
    </fieldset>

    <!-- 5 · AREAS OF EXPERIENCE -->
    <fieldset class="ap-step" data-step="areas" hidden>
      <legend tabindex="-1">Areas of experience</legend>
      <div class="ap-field" role="group" aria-labelledby="ap-areas-label">
        <span class="ap-lbl" id="ap-areas-label">What types of caregiving experience do you have? Check all that apply.</span>
        <div class="ap-cards ap-cards-2">
          {['Dementia / Alzheimer’s', 'Parkinson’s Disease', 'ALS', 'Multiple Sclerosis (MS)', 'Stroke / CVA', 'Hospice / End-of-Life Care', 'Bedbound Clients', 'Mobility & Transfers', 'Hoyer Lift', 'Personal Care', 'Medication Reminders', 'Feeding Assistance'].map((a) => (
            <label class="ap-card"><input type="checkbox" name="areas" value={a} /><span>{a}</span></label>
          ))}
        </div>
      </div>
      <div class="ap-field">
        <label for="ap-areasOther">Other</label>
        <input id="ap-areasOther" name="areasOther" type="text" maxlength="200" />
      </div>
    </fieldset>

    <!-- 6 · EMPLOYMENT / CAREGIVING HISTORY -->
    <fieldset class="ap-step" data-step="history" hidden>
      <legend tabindex="-1">Employment / caregiving history</legend>
      <p class="ap-hint">Please list your two most recent or most relevant caregiving positions.</p>
      <p class="ap-sub">Experience 1</p>
      <div class="ap-two">
        <div class="ap-field"><label for="ap-emp1Employer">Employer / agency</label><input id="ap-emp1Employer" name="emp1Employer" type="text" maxlength="120" autocomplete="organization" /></div>
        <div class="ap-field"><label for="ap-emp1Position">Position</label><input id="ap-emp1Position" name="emp1Position" type="text" maxlength="120" autocomplete="organization-title" /></div>
      </div>
      <div class="ap-two">
        <div class="ap-field"><label for="ap-emp1Dates">Dates of employment</label><input id="ap-emp1Dates" name="emp1Dates" type="text" maxlength="80" placeholder="e.g. 2021 – 2024" /></div>
        <div class="ap-field"><label for="ap-emp1Supervisor">Supervisor / contact</label><input id="ap-emp1Supervisor" name="emp1Supervisor" type="text" maxlength="160" /></div>
      </div>
      <p class="ap-sub">Experience 2</p>
      <div class="ap-two">
        <div class="ap-field"><label for="ap-emp2Employer">Employer / agency</label><input id="ap-emp2Employer" name="emp2Employer" type="text" maxlength="120" /></div>
        <div class="ap-field"><label for="ap-emp2Position">Position</label><input id="ap-emp2Position" name="emp2Position" type="text" maxlength="120" /></div>
      </div>
      <div class="ap-two">
        <div class="ap-field"><label for="ap-emp2Dates">Dates of employment</label><input id="ap-emp2Dates" name="emp2Dates" type="text" maxlength="80" /></div>
        <div class="ap-field"><label for="ap-emp2Supervisor">Supervisor / contact</label><input id="ap-emp2Supervisor" name="emp2Supervisor" type="text" maxlength="160" /></div>
      </div>
    </fieldset>

    <!-- 7 · PROFESSIONAL REFERENCES -->
    <fieldset class="ap-step" data-step="references" hidden>
      <legend tabindex="-1">Professional references</legend>
      <p class="ap-hint">Please provide two professional references.</p>
      <p class="ap-sub">Reference 1</p>
      <div class="ap-two">
        <div class="ap-field"><label for="ap-ref1Name">Name / relationship</label><input id="ap-ref1Name" name="ref1Name" type="text" maxlength="160" /></div>
        <div class="ap-field"><label for="ap-ref1Contact">Phone / email</label><input id="ap-ref1Contact" name="ref1Contact" type="text" maxlength="160" /></div>
      </div>
      <p class="ap-sub">Reference 2</p>
      <div class="ap-two">
        <div class="ap-field"><label for="ap-ref2Name">Name / relationship</label><input id="ap-ref2Name" name="ref2Name" type="text" maxlength="160" /></div>
        <div class="ap-field"><label for="ap-ref2Contact">Phone / email</label><input id="ap-ref2Contact" name="ref2Contact" type="text" maxlength="160" /></div>
      </div>
    </fieldset>

    <!-- 8 · APPLICANT CERTIFICATION -->
    <fieldset class="ap-step" data-step="certification" hidden>
      <legend tabindex="-1">Applicant certification</legend>
      <p class="ap-statement">I certify that the information provided in this application is true and complete to the best of my knowledge. I understand that this application is part of the initial screening process and does not by itself create a service agreement or guarantee an assignment.</p>
      <label class="ap-check"><input type="checkbox" name="certify" value="Yes" required aria-describedby="ap-certify-err" /><span>I have read and agree to the statement above. <span class="ap-req">required</span></span></label>
      <p class="ap-err" id="ap-certify-err" role="alert" hidden style="margin:-10px 0 14px">Please confirm the statement to continue.</p>
      <div class="ap-two">
        <div class="ap-field">
          <label for="ap-signature">Applicant signature <span class="ap-req">required</span></label>
          <input id="ap-signature" name="signature" type="text" maxlength="120" autocomplete="off" placeholder="Type your full legal name" class="ap-sig" aria-describedby="ap-signature-err ap-signature-hint" />
          <p class="ap-hint-sm" id="ap-signature-hint">Typing your name acts as your signature on this initial application.</p>
          <p class="ap-err" id="ap-signature-err" role="alert" hidden>Please type your full name as your signature.</p>
        </div>
        <div class="ap-field">
          <label for="ap-signDate">Date <span class="ap-req">required</span></label>
          <input id="ap-signDate" name="signDate" type="date" required aria-describedby="ap-signDate-err" />
          <p class="ap-err" id="ap-signDate-err" role="alert" hidden>Please enter today&rsquo;s date.</p>
        </div>
      </div>
      <div aria-hidden="true" class="ap-hp"><label for="ap-company">Company</label><input id="ap-company" name="company" type="text" tabindex="-1" autocomplete="off" /></div>
    </fieldset>

    <!-- 9 · REVIEW -->
    <fieldset class="ap-step" data-step="review" hidden>
      <legend tabindex="-1">Review your application</legend>
      <div id="apReview" class="ap-review"></div>
      <p class="ap-consent">By submitting, you agree to be contacted by Magnolia Healthcare about this application &mdash; nothing else.</p>
    </fieldset>

    <div class="ap-error" id="apError" role="alert" hidden>
      <strong>We couldn&rsquo;t send that just now.</strong> Your answers are safe on this page &mdash; please try again in a moment.
      You can also tap <em>Copy my application</em> and paste it into an email to
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      <div class="ap-err-actions"><button type="button" class="btn btn--line" id="apCopy">Copy my application</button></div>
      <span class="ap-err-code" id="apErrCode"></span>
    </div>

    <div class="ap-nav">
      <button type="button" class="btn btn--line" id="apBack" hidden>Back</button>
      <button type="submit" class="btn btn--solid" id="apNext" aria-disabled="true">Continue</button>
    </div>
  </form>

  <div class="ap-thanks" id="apThanks" hidden>
    <p class="ap-test-strip" id="apTestStrip" hidden><strong>Demo mode</strong> &mdash; this application was NOT sent anywhere.</p>
    <span class="caps-xs">Received</span>
    <h2 tabindex="-1" id="apThanksHead">Thank you &mdash; your application is with Magnolia.</h2>
    <p>This is the initial application in Magnolia&rsquo;s screening process. The team reviews every application and will contact you using the details you provided. Questions? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    <div class="ap-thanks-cta">
      <a class="btn btn--solid" href="/">Back to the site</a>
      <a class="btn btn--line" href="/mission">Our mission</a>
    </div>
  </div>
</section>

<style is:global>
  .ap-section [hidden]{display:none!important}
  .ap-noscript{background:var(--paper);border:1px solid var(--hair);padding:22px;border-radius:var(--r);text-align:center}
  .ap-noscript a{text-decoration:underline}
  .ap-form{visibility:hidden}
  .ap-form.ready{visibility:visible}
  .ap-prog{list-style:none;display:flex;gap:6px;margin:0 0 22px;padding:0}
  .ap-prog li{flex:1;min-width:0}
  .ap-prog .bar{display:block;height:3px;background:var(--hair);margin-bottom:8px;border-radius:2px;transition:background .3s}
  .ap-prog li.done .bar,.ap-prog li.now .bar{background:var(--leaf)}
  .ap-prog .lbl{font-family:var(--utility);font-weight:600;font-size:.54rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
  .ap-prog li.now .lbl{color:var(--leaf)}
  .ap-prog-now{display:none;font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--leaf);margin:-12px 0 18px}
  @media(max-width:640px){.ap-prog .lbl{display:none}.ap-prog-now{display:block}}
  .ap-draft{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1rem;font-size:.82rem;color:var(--ink-soft);background:var(--blush);border-radius:var(--r-sm);padding:10px 14px;margin:0 0 18px}
  .ap-draft button{background:none;border:0;cursor:pointer;font:inherit;font-weight:600;color:var(--brass);text-decoration:underline;text-underline-offset:3px;padding:10px 12px;min-height:44px;min-width:44px}
  .ap-recap{display:flex;flex-wrap:wrap;gap:6px 20px;background:var(--linen);border:1px solid var(--hair);border-radius:var(--r-sm);padding:10px 16px;margin:0 0 22px;font-size:.82rem}
  .ap-recap div{display:flex;gap:6px}
  .ap-recap dt{color:var(--ink-soft)}
  .ap-recap dt::after{content:':'}
  .ap-recap dd{margin:0;font-weight:600;color:var(--ink)}
  .ap-step{border:0;padding:0;margin:0;min-inline-size:auto}
  .ap-step legend{font-family:var(--display);font-size:clamp(1.5rem,3.2vw,2rem);color:var(--ink);padding:0;margin-bottom:18px;text-wrap:balance;font-variation-settings:'opsz' 72,'SOFT' 50}
  .ap-step legend:focus{outline:none}
  .ap-hint{font-size:.92rem;color:var(--ink-soft);margin:-6px 0 18px}
  .ap-hint-sm{font-size:.78rem;color:var(--ink-soft);margin-top:6px}
  .ap-sub{font-family:var(--utility);font-weight:600;font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;color:var(--brass);margin:6px 0 12px;padding-top:12px;border-top:1px solid var(--hair)}
  .ap-note{background:var(--linen);border-left:2px solid var(--brass);padding:12px 16px;border-radius:0 var(--r-sm) var(--r-sm) 0;font-size:.92rem;color:var(--ink-soft);margin:6px 0 14px}
  .ap-note em{font-style:normal;font-weight:600;color:var(--ink)}
  .ap-statement{font-family:var(--display);font-size:1.08rem;line-height:1.65;color:var(--ink);background:var(--linen);border:1px solid var(--hair);border-radius:var(--r-sm);padding:18px 20px;margin:0 0 16px;font-variation-settings:'opsz' 48,'SOFT' 50}
  .ap-check{display:flex;gap:12px;align-items:flex-start;padding:12px 0 18px;cursor:pointer;font-size:.95rem;color:var(--ink)}
  .ap-check input{width:20px;height:20px;margin:2px 0 0;flex:none;accent-color:var(--leaf)}
  .ap-cards{display:grid;gap:10px;margin-bottom:10px}
  .ap-cards-row{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}
  .ap-cards-2{grid-template-columns:1fr 1fr}
  .ap-cards-days{grid-template-columns:repeat(4,1fr)}
  @media(max-width:560px){.ap-cards-2{grid-template-columns:1fr}.ap-cards-days{grid-template-columns:1fr 1fr}}
  .ap-card{position:relative;display:flex;align-items:center;min-height:50px;padding:12px 14px;background:var(--paper);border:1px solid var(--hair-strong);border-radius:var(--r-sm);cursor:pointer;transition:border-color .2s,background .2s,box-shadow .2s}
  .ap-card:hover{border-color:var(--leaf)}
  .ap-card input{position:absolute;opacity:0;pointer-events:none}
  .ap-card span{font-size:.93rem;color:var(--ink)}
  .ap-card:has(input:checked){border-color:var(--leaf);background:#fff;box-shadow:inset 0 0 0 1px var(--leaf)}
  .ap-card:has(input:checked) span{font-weight:600}
  .ap-card:has(input:checked)::after{content:"";margin-left:auto;width:8px;height:8px;border-radius:50%;background:var(--leaf);flex:none}
  .ap-card:has(input:focus-visible){outline:2px solid var(--brass);outline-offset:3px}
  .ap-field{margin-bottom:16px}
  .ap-two{display:grid;gap:0 16px}
  .ap-three{display:grid;gap:0 16px}
  .ap-half{max-width:260px}
  @media(min-width:560px){.ap-two{grid-template-columns:1fr 1fr}.ap-three{grid-template-columns:2fr 1fr 1fr}}
  .ap-field label,.ap-lbl{display:block;font-family:var(--utility);font-weight:600;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px;line-height:1.6}
  .ap-req{font-weight:500;letter-spacing:.08em;color:var(--brass);text-transform:lowercase}
  .ap-field input:not([type="radio"]):not([type="checkbox"]),.ap-field select,.ap-field textarea{width:100%;min-height:48px;padding:12px 14px;background:#fff;border:1px solid var(--hair-strong);border-radius:var(--r-sm);color:var(--ink);font:inherit;font-size:1rem;transition:border-color .2s}
  .ap-field input[aria-invalid="true"]{border-color:#B2473D}
  .ap-sig{font-family:var(--display)!important;font-style:italic;font-size:1.25rem!important;font-variation-settings:'opsz' 48,'SOFT' 70}
  .ap-err{font-size:.82rem;color:#9A3A31;margin-top:6px}
  .ap-hp{position:absolute;left:-9999px;top:auto}
  .ap-review{display:grid;gap:14px;margin-bottom:18px}
  .ap-rev-group{background:var(--linen);border:1px solid var(--hair);border-radius:var(--r-sm);padding:16px 18px}
  .ap-rev-head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:8px}
  .ap-rev-head h3{font-size:1.05rem}
  .ap-rev-edit{background:none;border:0;cursor:pointer;font-family:var(--utility);font-weight:600;font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--brass);text-decoration:underline;text-underline-offset:3px;padding:10px 12px;min-height:44px;min-width:44px}
  .ap-rev-group dl{margin:0;display:grid;gap:5px}
  .ap-rev-group dl div{display:flex;flex-wrap:wrap;gap:4px 8px;font-size:.9rem}
  .ap-rev-group dt{color:var(--ink-soft)}
  .ap-rev-group dt::after{content:':'}
  .ap-rev-group dd{margin:0;font-weight:600;color:var(--ink);overflow-wrap:anywhere}
  .ap-rev-empty{font-size:.86rem;color:var(--ink-soft);font-style:italic}
  .ap-consent{font-size:.82rem;color:var(--ink-soft)}
  .ap-nav{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:22px}
  .ap-nav .btn{min-width:140px}
  .ap-nav #apNext{margin-left:auto}
  .ap-nav .btn[aria-disabled="true"]{opacity:.62}
  @media(max-width:560px){.ap-nav .btn{flex:1 1 100%;min-width:0}.ap-nav #apNext{order:-1}}
  .ap-error{margin-top:20px;border:1px solid var(--brass);background:#fff;border-radius:var(--r-sm);padding:16px 18px;font-size:.92rem}
  .ap-error a{text-decoration:underline;overflow-wrap:anywhere}
  .ap-err-actions{margin-top:12px}
  .ap-err-code{display:block;margin-top:8px;font-family:var(--utility);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}
  .ap-thanks{text-align:center}
  .ap-thanks .caps-xs{display:block;margin-bottom:.8rem}
  .ap-thanks h2{font-size:clamp(1.5rem,3.4vw,2.1rem);margin-bottom:12px}
  .ap-thanks h2:focus{outline:none}
  .ap-thanks p{max-width:46ch;margin:0 auto}
  .ap-thanks p a{text-decoration:underline;overflow-wrap:anywhere}
  .ap-thanks-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:26px}
  .ap-test-strip{background:var(--leaf-deep);color:var(--ivory);padding:10px 16px;border-radius:var(--r-sm);font-size:.82rem;margin:0 0 22px;letter-spacing:.04em}
</style>

<script>
  type StepKey = 'personal' | 'availability' | 'license' | 'experience' | 'areas' | 'history' | 'references' | 'certification' | 'review';
  const STEPS: StepKey[] = ['personal', 'availability', 'license', 'experience', 'areas', 'history', 'references', 'certification', 'review'];
  const STEP_LABELS: Record<StepKey, string> = { personal: 'You', availability: 'Availability', license: 'License', experience: 'Experience', areas: 'Areas', history: 'History', references: 'References', certification: 'Certify', review: 'Review' };
  const MULTI = ['days', 'times', 'certType', 'workedAt', 'areas'];
  const KEYS = ['fullName', 'phone', 'email', 'address', 'city', 'state', 'zip', 'days', 'times', 'hasCert', 'certType', 'certTypeOther', 'certNumber', 'certState', 'certExpiry',
    'hasExperience', 'years', 'workedAt', 'areas', 'areasOther', 'emp1Employer', 'emp1Position', 'emp1Dates', 'emp1Supervisor', 'emp2Employer', 'emp2Position', 'emp2Dates', 'emp2Supervisor',
    'ref1Name', 'ref1Contact', 'ref2Name', 'ref2Contact', 'certify', 'signature', 'signDate'];
  const answers: Record<string, string> = Object.fromEntries(KEYS.map((k) => [k, '']));
  const emailOk = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
  const phoneOk = (v: string) => v.replace(/\D/g, '').length >= 7;
  const REVIEW_GROUPS: [StepKey, string, [string, string][]][] = [
    ['personal', 'Personal information', [['fullName', 'Full legal name'], ['phone', 'Phone'], ['email', 'Email'], ['address', 'Address'], ['city', 'City'], ['state', 'State'], ['zip', 'ZIP']]],
    ['availability', 'Availability', [['days', 'Days available'], ['times', 'Preferred time']]],
    ['license', 'Certification & license', [['hasCert', 'License / certification'], ['certType', 'Type'], ['certTypeOther', 'Other type'], ['certNumber', 'Number'], ['certState', 'State'], ['certExpiry', 'Expiration']]],
    ['experience', 'Caregiving experience', [['hasExperience', 'Previous experience'], ['years', 'Years'], ['workedAt', 'Where you have worked']]],
    ['areas', 'Areas of experience', [['areas', 'Areas'], ['areasOther', 'Other']]],
    ['history', 'Employment history', [['emp1Employer', 'Experience 1 — employer'], ['emp1Position', 'Position'], ['emp1Dates', 'Dates'], ['emp1Supervisor', 'Supervisor / contact'], ['emp2Employer', 'Experience 2 — employer'], ['emp2Position', 'Position'], ['emp2Dates', 'Dates'], ['emp2Supervisor', 'Supervisor / contact']]],
    ['references', 'Professional references', [['ref1Name', 'Reference 1'], ['ref1Contact', 'Phone / email'], ['ref2Name', 'Reference 2'], ['ref2Contact', 'Phone / email']]],
    ['certification', 'Applicant certification', [['certify', 'Certification'], ['signature', 'Signature'], ['signDate', 'Date']]],
  ];
  /** Sections the paper form asks for ("please provide / please list") that are not blocking online — the review step flags them if empty. */
  const EXPECTED: [StepKey, string, string[]][] = [['history', 'No positions listed — the application asks for your two most recent or most relevant caregiving positions.', ['emp1Employer', 'emp1Position']], ['references', 'No references listed — the application asks for two professional references.', ['ref1Name', 'ref2Name']]];
  const DRAFT_KEY = 'mh-apply-draft-v2';
  /** Required fields per step, with the inline error that explains each. */
  const REQUIRED: Partial<Record<StepKey, [string, (v: string) => boolean][]>> = {
    personal: [['fullName', (v) => !!v.trim()], ['phone', phoneOk], ['email', emailOk]],
    license: [['hasCert', (v) => !!v]],
    experience: [['hasExperience', (v) => !!v]],
    certification: [['certify', (v) => v === 'Yes'], ['signature', (v) => !!v.trim()], ['signDate', (v) => !!v]],
  };

  const form = document.getElementById('apForm') as HTMLFormElement;
  const progEl = document.getElementById('apProg') as HTMLOListElement;
  const recapEl = document.getElementById('apRecap') as HTMLElement;
  const reviewEl = document.getElementById('apReview') as HTMLElement;
  const errorEl = document.getElementById('apError') as HTMLElement;
  const backBtn = document.getElementById('apBack') as HTMLButtonElement;
  const nextBtn = document.getElementById('apNext') as HTMLButtonElement;
  const thanksEl = document.getElementById('apThanks') as HTMLElement;
  const draftEl = document.getElementById('apDraft') as HTMLElement;
  const stepEls = new Map<StepKey, HTMLFieldSetElement>();
  form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]').forEach((el) => stepEls.set(el.dataset.step as StepKey, el));
  let stepIndex = 0;
  let returnToReview = false;
  let dirty = false; // nothing is saved to the session until the applicant types something
  let status: 'idle' | 'sending' | 'sent' | 'sent-test' | 'error' = 'idle';
  const track = (event: string, p: Record<string, unknown> = {}) => { ((window as unknown as { dataLayer?: unknown[] }).dataLayer ??= []).push({ event, ...p }); };

  const gate = (key: StepKey): boolean => (REQUIRED[key] ?? []).every(([k, ok]) => ok(answers[k]));
  const syncMulti = (name: string) => { answers[name] = Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((c) => c.value).join(', '); };
  const el = (tag: string, cls: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; };

  /* conditional blocks: if yes / if no (the paper form's own logic) */
  function syncConditionals() {
    const certYes = document.getElementById('apCertYes') as HTMLElement, certNo = document.getElementById('apCertNo') as HTMLElement, certOther = document.getElementById('apCertOther') as HTMLElement;
    const otherType = answers.certType.split(', ').includes('Other');
    certYes.hidden = answers.hasCert !== 'Yes'; certNo.hidden = answers.hasCert !== 'No'; certOther.hidden = !otherType;
    // "If yes, please provide" details that no longer apply are cleared so they can never ride along
    if (answers.hasCert !== 'Yes') ['certType', 'certTypeOther', 'certNumber', 'certState', 'certExpiry'].forEach(clearField);
    if (!otherType) clearField('certTypeOther');
  }
  function clearField(key: string) {
    if (!answers[key]) return;
    answers[key] = '';
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${key}"]`).forEach((c) => { if (c instanceof HTMLInputElement && (c.type === 'radio' || c.type === 'checkbox')) c.checked = false; else c.value = ''; });
  }

  function renderProgress() {
    progEl.textContent = '';
    STEPS.forEach((key, i) => {
      const li = el('li', i < stepIndex ? 'done' : i === stepIndex ? 'now' : '');
      if (i === stepIndex) li.setAttribute('aria-current', 'step');
      li.appendChild(el('span', 'bar'));
      const lbl = el('span', 'lbl', STEP_LABELS[key]); lbl.setAttribute('aria-hidden', 'true'); li.appendChild(lbl);
      li.appendChild(el('span', 'sr-only', `Step ${i + 1} of ${STEPS.length}: ${STEP_LABELS[key]}${i === stepIndex ? ' (current)' : ''}`));
      progEl.appendChild(li);
    });
    (document.getElementById('apProgNow') as HTMLElement).textContent = `Step ${stepIndex + 1} of ${STEPS.length} · ${STEP_LABELS[STEPS[stepIndex]]}`;
  }
  function renderRecap(current: StepKey) {
    const pairs: [string, string][] = [];
    if (answers.fullName.trim()) pairs.push(['Applicant', answers.fullName.trim()]);
    if (answers.hasCert) pairs.push(['License', answers.hasCert === 'Yes' ? (answers.certType.replace('Other', answers.certTypeOther.trim() || 'Other') || 'Yes') : 'None yet']);
    if (answers.hasExperience) pairs.push(['Experience', answers.hasExperience === 'Yes' ? (answers.years ? `${answers.years} yrs` : 'Yes') : 'New to caregiving']);
    const show = stepIndex > 0 && current !== 'review' && pairs.length > 0;
    recapEl.hidden = !show; if (!show) return;
    recapEl.textContent = '';
    pairs.forEach(([k, v]) => { const row = document.createElement('div'); row.appendChild(el('dt', '', k)); row.appendChild(el('dd', '', v)); recapEl.appendChild(row); });
  }
  function renderReview() {
    reviewEl.textContent = '';
    for (const [stepKey, heading, fields] of REVIEW_GROUPS) {
      const rows = fields.filter(([k]) => answers[k].trim());
      const expected = EXPECTED.find(([s]) => s === stepKey);
      const empty = expected && !expected[2].some((k) => answers[k].trim());
      if (rows.length === 0 && !empty) continue;
      const group = el('div', 'ap-rev-group');
      const head = el('div', 'ap-rev-head'); head.appendChild(el('h3', '', heading));
      const edit = el('button', 'ap-rev-edit', 'Edit') as HTMLButtonElement; edit.type = 'button'; edit.setAttribute('aria-label', `Edit ${heading.toLowerCase()}`);
      edit.addEventListener('click', () => { returnToReview = true; stepIndex = STEPS.indexOf(stepKey); render(true); });
      head.appendChild(edit); group.appendChild(head);
      if (empty && expected) group.appendChild(el('p', 'ap-rev-empty', expected[1]));
      if (rows.length) {
        const dl = document.createElement('dl');
        rows.forEach(([k, label]) => { const row = document.createElement('div'); row.appendChild(el('dt', '', label)); row.appendChild(el('dd', '', k === 'certify' ? 'Agreed' : answers[k].trim())); dl.appendChild(row); });
        group.appendChild(dl);
      }
      reviewEl.appendChild(group);
    }
  }
  /** Shows (or clears) the inline errors of ONE step — or of one field when `only` is given. Returns the first invalid control. */
  function showErrors(show: boolean, step: StepKey, only?: string): HTMLElement | null {
    let first: HTMLElement | null = null;
    for (const [key, ok] of REQUIRED[step] ?? []) {
      if (only && key !== only) continue;
      const err = document.getElementById(`ap-${key}-err`) as HTMLElement | null; if (!err) continue;
      const bad = show && !ok(answers[key]);
      err.hidden = !bad;
      const input = document.getElementById(`ap-${key}`) as HTMLInputElement | null;
      if (input) input.setAttribute('aria-invalid', String(bad));
      const control = input ?? form.querySelector<HTMLElement>(`[name="${key}"]`);
      if (bad && !first) first = control;
    }
    return first;
  }
  function render(focus = false) {
    const current = STEPS[stepIndex];
    stepEls.forEach((elm, key) => { elm.hidden = key !== current; });
    syncConditionals(); renderProgress(); renderRecap(current);
    if (current === 'review') renderReview();
    backBtn.hidden = stepIndex === 0;
    nextBtn.textContent = current === 'review' ? (status === 'sending' ? 'Sending…' : 'Submit application') : returnToReview ? 'Back to review' : 'Continue';
    // Continue stays focusable: an incomplete step explains itself on activation instead of going silent.
    nextBtn.setAttribute('aria-disabled', String(status === 'sending' || !gate(current)));
    form.setAttribute('aria-busy', String(status === 'sending'));
    if (focus) { stepEls.get(current)?.querySelector('legend')?.focus(); (document.querySelector('.ap-section') as HTMLElement).scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); }
    saveDraft();
    track('apply_step_viewed', { step: current, step_number: stepIndex + 1, steps_total: STEPS.length });
  }

  /* session draft — survives an accidental reload, never leaves this browser tab, cleared on submit */
  function saveDraft() { if (!dirty) return; try { sessionStorage.setItem(DRAFT_KEY, JSON.stringify({ answers, stepIndex })); } catch { /* storage unavailable: fine */ } }
  function loadDraft(): boolean {
    try {
      const raw = sessionStorage.getItem(DRAFT_KEY); if (!raw) return false;
      const d = JSON.parse(raw) as { answers?: Record<string, string>; stepIndex?: number };
      if (!d.answers) return false;
      for (const k of KEYS) answers[k] = typeof d.answers[k] === 'string' ? d.answers[k] : '';
      stepIndex = Math.min(Math.max(0, d.stepIndex ?? 0), STEPS.length - 1);
      // hydrate controls from state
      for (const k of KEYS) {
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${k}"]`).forEach((c) => {
          if (c instanceof HTMLInputElement && (c.type === 'radio' || c.type === 'checkbox')) c.checked = MULTI.includes(k) ? answers[k].split(', ').includes(c.value) : answers[k] === c.value;
          else c.value = answers[k];
        });
      }
      return KEYS.some((k) => k !== 'signDate' && answers[k]);
    } catch { return false; }
  }
  function clearDraft() { try { sessionStorage.removeItem(DRAFT_KEY); } catch { /* ignore */ } }

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    if (!t.name) return;
    if (MULTI.includes(t.name)) syncMulti(t.name);
    else if (t.name in answers) answers[t.name] = (t instanceof HTMLInputElement && t.type === 'checkbox') ? (t.checked ? t.value : '') : t.value;
    else return;
    dirty = true;
    if (['hasCert', 'certType', 'hasExperience'].includes(t.name)) syncConditionals();
    showErrors(false, STEPS[stepIndex], t.name);
    nextBtn.setAttribute('aria-disabled', String(status === 'sending' || !gate(STEPS[stepIndex])));
    saveDraft();
  });
  // Inline validation when a text field loses focus (never while typing) — that field only.
  ['fullName', 'phone', 'email', 'signature', 'signDate'].forEach((id) => { (document.getElementById(`ap-${id}`) as HTMLInputElement).addEventListener('blur', () => { if (answers[id]) showErrors(true, STEPS[stepIndex], id); }); });
  backBtn.addEventListener('click', () => { if (stepIndex > 0) { stepIndex -= 1; render(true); } });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const current = STEPS[stepIndex];
    if (!gate(current)) { const first = showErrors(true, current); first?.focus(); return; }
    if (status === 'sending') return;
    track('apply_step_completed', { step: current, step_number: stepIndex + 1 });
    if (current !== 'review') { stepIndex = returnToReview ? STEPS.indexOf('review') : stepIndex + 1; returnToReview = false; render(true); return; }
    void send();
  });
  async function send() {
    status = 'sending'; errorEl.hidden = true; render();
    const company = (document.getElementById('ap-company') as HTMLInputElement).value;
    try {
      // CLIENT-DEMO builds (PUBLIC_DEMO_ONLY=1) never contact any server — the applicant's data
      // stays in this browser tab and the result is the labelled demo-mode confirmation.
      let data: { ok?: boolean; staged?: boolean; reason?: string };
      if (import.meta.env.PUBLIC_DEMO_ONLY === '1') {
        await new Promise((r) => setTimeout(r, 650));
        data = { ok: true, staged: true };
      } else {
        const res = await fetch('/api/apply', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...answers, company }) });
        const noApi = res.status === 404 || res.status === 405 || !(res.headers.get('content-type') ?? '').includes('application/json');
        data = noApi ? { ok: true, staged: true } : ((await res.json().catch(() => ({}))) as { ok?: boolean; staged?: boolean; reason?: string });
        if (!noApi && (!res.ok || !data.ok)) throw new Error(data.reason ?? `http_${res.status}`);
      }
      status = data.staged ? 'sent-test' : 'sent';
      clearDraft();
      form.hidden = true;
      (document.getElementById('apTestStrip') as HTMLElement).hidden = status !== 'sent-test';
      thanksEl.hidden = false;
      (document.getElementById('apThanksHead') as HTMLElement).focus();
      track('apply_submitted', { staged: status === 'sent-test' });
    } catch (err) {
      status = 'error';
      const reason = err instanceof Error && err.message ? err.message : 'network';
      (document.getElementById('apErrCode') as HTMLElement).textContent = `Error code: ${reason}`;
      errorEl.hidden = false; render();
      errorEl.setAttribute('tabindex', '-1'); errorEl.focus();
      track('apply_error', { message: reason });
    }
  }
  function buildSummary(): string {
    const lines: string[] = ['Caregiver application — Magnolia Healthcare', ''];
    for (const [, heading, fields] of REVIEW_GROUPS) {
      const rows = fields.filter(([k]) => answers[k].trim()); if (!rows.length) continue;
      lines.push(heading.toUpperCase()); rows.forEach(([k, label]) => lines.push(`  ${label}: ${k === 'certify' ? 'Agreed' : answers[k].trim()}`)); lines.push('');
    }
    return lines.join('\n').trim();
  }
  const copyBtn = document.getElementById('apCopy') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const text = buildSummary(); let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; }
    catch { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.focus(); ta.select(); try { ok = document.execCommand('copy'); } catch { ok = false; } ta.remove(); }
    copyBtn.textContent = ok ? 'Copied ✓' : 'Select all & copy';
    setTimeout(() => { copyBtn.textContent = 'Copy my application'; }, 2600);
  });
  (document.getElementById('apDraftClear') as HTMLButtonElement).addEventListener('click', () => {
    clearDraft(); for (const k of KEYS) clearField(k); stepIndex = 0; returnToReview = false; dirty = false; draftEl.hidden = true;
    signDate.value = todayStr; answers.signDate = todayStr; render(true);
  });

  // date defaults to today (editable), in the visitor's local calendar
  const signDate = document.getElementById('ap-signDate') as HTMLInputElement;
  const today = new Date(); const pad = (n: number) => String(n).padStart(2, '0');
  const todayStr = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
  const restored = loadDraft();
  dirty = restored;
  if (!answers.signDate) { signDate.value = todayStr; answers.signDate = todayStr; }
  draftEl.hidden = !restored;
  form.classList.add('ready');
  render();
</script>
