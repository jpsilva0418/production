---
/** The Magnolia mark — a six-petal magnolia blossom drawn as a single-colour glyph.
 *  TEMPORARY: a typed/drawn stand-in for Magnolia's real logo artwork, which could
 *  not be viewed in this environment. Replace with the official file (SVG) when
 *  supplied; every placement goes through this one component. */
interface Props { class?: string; title?: string }
const { class: cls = 'mark', title } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <g fill="currentColor">
    <!-- outer petals -->
    <path d="M32 6c5.6 6.4 7.8 13.4 6.4 20.8C36.2 30.3 34 32.2 32 33.4c-2-1.2-4.2-3.1-6.4-6.6C24.2 19.4 26.4 12.4 32 6Z" opacity=".92"/>
    <path d="M55.4 18.6c-1.2 8.4-5 14.6-11.6 18.4-3.6 2.1-6.5 2.4-8.8 2-0.1-2.4.6-5.3 2.9-8.8 4.1-6.4 10.2-10.3 17.5-11.6Z" opacity=".8"/>
    <path d="M8.6 18.6c7.3 1.3 13.4 5.2 17.5 11.6 2.3 3.5 3 6.4 2.9 8.8-2.3.4-5.2.1-8.8-2C13.6 33.2 9.8 27 8.6 18.6Z" opacity=".8"/>
    <path d="M50.8 48.2c-7.6 2.2-14.6 1.2-20.4-3.2-2.8-2.1-4.4-4.3-5.2-6.4 2.2-.9 5-1.3 8.9-.5 7.2 1.6 12.9 5 16.7 10.1Z" opacity=".68"/>
    <path d="M13.2 48.2c3.8-5.1 9.5-8.5 16.7-10.1 3.9-.8 6.7-.4 8.9.5-.8 2.1-2.4 4.3-5.2 6.4-5.8 4.4-12.8 5.4-20.4 3.2Z" opacity=".68"/>
    <!-- stem -->
    <path d="M31.2 38.5h1.6v19.3h-1.6z" opacity=".55"/>
    <!-- heart of the blossom -->
    <circle cx="32" cy="36.6" r="2.6"/>
  </g>
</svg>
