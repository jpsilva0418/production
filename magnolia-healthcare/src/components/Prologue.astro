---
/** THE PROLOGUE — Magnolia's cinematic home opening, adapted from the Leti Silva Beauty
 *  prologue system: a leaf-green veil carries the mark + name, then lifts to reveal the
 *  film (ambient "morning light", under a leaf scrim so the typography stays legible).
 *  Engineering rules kept from the foundation: the poster is painted at t=0 (LCP),
 *  every animation is pure CSS whose base state equals the FINISHED state, the film is
 *  promoted only after the veil (preload=none; mp4 + webm; never under reduced motion
 *  or Save-Data), and the page is complete without JavaScript. */
import Mark from './Mark.astro';
import { SITE } from '../consts';
---
<section class="plg" aria-label="Magnolia Healthcare — non-medical home care in Arvada and the Denver Metro">
  <div class="plg-media" aria-hidden="true">
    <video class="plg-film" id="plgFilm" muted loop playsinline preload="none" poster="/media/hero-poster.jpg" disablepictureinpicture tabindex="-1">
      <source data-src="/media/hero-film.webm" type="video/webm" />
      <source data-src="/media/hero-film.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="plg-scrim" aria-hidden="true"></div>
  <i class="grain" aria-hidden="true"></i>
  <i class="lx-dusk" aria-hidden="true"></i>

  <!-- the veil: title card that lifts -->
  <div class="plg-veil" aria-hidden="true">
    <div class="plg-veil-c"><Mark class="plg-veil-mark" /><span class="plg-veil-name">Magnolia</span><span class="plg-veil-sub">Healthcare</span></div>
  </div>

  <div class="plg-c">
    <p class="plg-eyebrow a1">Non-medical home care <b>&middot;</b> {SITE.serviceArea.label}</p>
    <h1 class="plg-h">
      <span class="lo"><span class="li">Care that feels</span></span>
      <span class="lo"><span class="li">like family,</span></span>
      <span class="lo"><span class="li ital">at home.</span></span>
    </h1>
    <p class="plg-it a3">Personal care, homemaking, companionship and dementia support &mdash; delivered with respect, compassion and honesty, in the comfort of your own home.</p>
    <div class="plg-ctas a4">
      <a class="btn btn--ivory" href={SITE.links.consultCare}>Request a consultation</a>
      <a class="btn btn--ghost" href="/services">Explore our services</a>
    </div>
    <p class="plg-loc a4">Locally owned &middot; Colorado-licensed &middot; Founded {SITE.founded}</p>
  </div>
  <div class="plg-cue" aria-hidden="true"><span>Scroll</span><i class="ln"></i></div>
</section>

<style>
  .plg{position:relative;min-height:100svh;background:var(--leaf);overflow:hidden;display:grid;place-items:center;text-align:center;color:var(--ivory)}
  .plg-media{position:absolute;inset:0;opacity:0;animation:fadeIn 1.6s ease 1.15s forwards}
  .plg-media video{width:100%;height:100%;object-fit:cover;filter:saturate(.96);transform:scale(1.06);animation:plgKb 9s ease-in-out 1.15s infinite alternate}
  @keyframes plgKb{from{transform:scale(1.06)}to{transform:scale(1.01)}}
  /* the leaf scrim: warm light shows through, type stays AA-legible */
  .plg-scrim{position:absolute;inset:0;opacity:0;animation:fadeIn 1.6s ease 1.15s forwards;
    background:linear-gradient(rgba(21,46,39,.78),rgba(30,63,54,.62) 42%,rgba(30,63,54,.66) 68%,rgba(21,46,39,.86)),
      radial-gradient(110% 80% at 50% 45%,rgba(21,46,39,0) 50%,rgba(21,46,39,.4) 100%)}
  .plg-c{position:relative;z-index:2;padding:clamp(6.5rem,14vh,8rem) 6vw clamp(7.5rem,15vh,9.5rem);width:100%;max-width:980px}
  .plg-eyebrow{font-family:var(--utility);font-weight:600;font-size:clamp(.6rem,1.6vw,.72rem);letter-spacing:.28em;text-transform:uppercase;color:#EFE9E0;margin-bottom:clamp(1.4rem,3vh,2.2rem)}
  .plg-eyebrow b{color:var(--gold-lt);font-weight:600}
  .plg-h{font-family:var(--display);font-weight:300;font-size:clamp(2.6rem,7.4vw,6.4rem);line-height:1.02;letter-spacing:-.015em;color:var(--ivory);margin:0;
    font-variation-settings:'opsz' 144,'SOFT' 60;text-shadow:0 2px 40px rgba(21,46,39,.5)}
  .plg-h .lo{display:block;overflow:hidden;padding-block:.04em}
  .plg-h .li{display:block;transform:translateY(112%)}
  .plg-h .ital{font-style:italic;font-weight:300;color:var(--petal)}
  .plg-h .lo:nth-child(1) .li{animation:riseIn 1.05s var(--ease) 2.1s both}
  .plg-h .lo:nth-child(2) .li{animation:riseIn 1.05s var(--ease) 2.24s both}
  .plg-h .lo:nth-child(3) .li{animation:riseIn 1.05s var(--ease) 2.38s both}
  .plg-it{font-family:var(--display);font-style:italic;font-size:clamp(1.08rem,1.8vw,1.42rem);line-height:1.55;color:rgba(248,244,238,.88);max-width:34em;margin:clamp(1.4rem,2.8vh,2.2rem) auto 0;
    font-variation-settings:'opsz' 48,'SOFT' 70;opacity:0;animation:fadeUp .9s ease 2.8s both}
  .plg-ctas{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:clamp(1.8rem,3.6vh,2.6rem);opacity:0;animation:fadeUp .9s ease 3s both}
  .plg-loc{font-family:var(--utility);font-weight:600;color:var(--gold-lt);font-size:.6rem;letter-spacing:.26em;text-transform:uppercase;margin-top:clamp(1.6rem,3vh,2.2rem);opacity:0;animation:fadeUp .9s ease 3.15s both}
  /* THE VEIL — base state GONE (reduced motion = finished page); animates FROM opaque leaf */
  .plg-veil{position:absolute;inset:0;z-index:4;display:grid;place-items:center;background:var(--leaf);opacity:0;visibility:hidden;pointer-events:none;animation:veil 2s var(--ease) .95s 1 both}
  @keyframes veil{from{opacity:1;visibility:visible}70%{opacity:1}to{opacity:0;visibility:hidden}}
  .plg-veil-c{display:flex;flex-direction:column;align-items:center;opacity:0;animation:veilCard 2.5s var(--ease) .1s 1 both}
  @keyframes veilCard{from{opacity:0;transform:translateY(12px) scale(.985)}22%{opacity:1;transform:none}78%{opacity:1}to{opacity:0;transform:scale(1.01)}}
  .plg-veil :global(.plg-veil-mark){width:clamp(54px,8vw,84px);height:auto;color:var(--gold-lt);margin-bottom:1.1rem}
  .plg-veil-name{font-family:var(--display);font-weight:300;font-size:clamp(2.4rem,6vw,4.4rem);line-height:1;color:var(--ivory);font-variation-settings:'opsz' 144,'SOFT' 50}
  .plg-veil-sub{font-family:var(--utility);font-weight:600;font-size:clamp(.6rem,1.3vw,.76rem);letter-spacing:.42em;text-indent:.42em;text-transform:uppercase;color:var(--gold-lt);margin-top:.8rem}
  .plg-cue{position:absolute;bottom:clamp(1.4rem,4vh,2.6rem);left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:.9rem;opacity:0;animation:fadeIn 1s ease 3.4s both}
  .plg-cue span{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.42em;text-indent:.42em;font-size:.55rem;color:var(--gold-lt)}
  .plg-cue .ln{width:1px;height:48px;background:linear-gradient(var(--gold-lt),rgba(205,180,140,0));transform-origin:top;animation:cuePulse 2.8s ease-in-out 3.8s infinite}
  @keyframes cuePulse{0%,100%{transform:scaleY(.35);opacity:.5}50%{transform:scaleY(1);opacity:1}}
  @media(max-width:640px){
    .plg{min-height:100svh}
    .plg-c{padding-top:7rem}
    .plg-h{font-size:clamp(2.35rem,11.5vw,3.2rem)}
    .plg-ctas{flex-direction:column;align-items:center}
    .plg-ctas .btn{min-width:264px}
  }
  @media (prefers-reduced-motion:reduce){
    .plg-media,.plg-scrim,.plg-it,.plg-ctas,.plg-loc,.plg-cue{opacity:1!important;animation:none!important}
    .plg-media video{transform:none!important;animation:none!important}
    .plg-h .li{transform:none!important;animation:none!important}
    .plg-veil,.plg-veil-c{animation:none!important}
    .plg-cue .ln{animation:none!important}
  }
</style>
<script>
  // The film is promoted only once the veil has lifted — the poster carries the first
  // paint — and never under reduced motion or Save-Data (the poster then stands as a
  // photograph). Off-screen it pauses; back in view it resumes.
  const v = document.getElementById('plgFilm') as HTMLVideoElement | null;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  if (v) {
    if (reduced || saveData) {
      v.querySelectorAll('source').forEach((s) => s.remove());
    } else {
      const promote = () => {
        v.querySelectorAll('source').forEach((s) => { const src = (s as HTMLSourceElement).dataset.src; if (src) (s as HTMLSourceElement).src = src; });
        v.load();
        v.play().catch(() => {});
      };
      setTimeout(promote, 900);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }); }, { threshold: 0.05 }).observe(v);
      }
    }
  }
</script>
