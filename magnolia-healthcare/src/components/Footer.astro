---
/** Grand footer — ported from the Leti Silva Beauty .foot block, restructured for a
 *  care organisation: brand + mission line, navigation, contact. Only facts from
 *  Magnolia's own materials appear; a phone number, street address and office hours
 *  are shown as "to be confirmed" placeholders until Magnolia supplies them. */
import Mark from './Mark.astro';
import { SITE, TBC } from '../consts';
const year = new Date().getUTCFullYear();
---
<footer class="foot">
  <i class="lx-dusk" aria-hidden="true"></i>
  <div class="foot-in">
    <div class="foot-grid">
      <div class="foot-brand">
        <Mark />
        <div class="foot-name">Magnolia</div>
        <div class="foot-sub">Healthcare</div>
        <p>Because every life matters. A higher standard of home care &mdash; built on compassion, excellence, and respect for every individual.</p>
      </div>
      <div>
        <p class="foot-h">Explore</p>
        <ul class="foot-nav">
          <li><a href="/">Home</a></li>
          {SITE.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={SITE.links.apply}>Caregiver application</a></li>
          <li><a href={SITE.links.login}>Log in</a></li>
        </ul>
      </div>
      <div>
        <p class="foot-h">Contact</p>
        <ul class="foot-contact">
          <li><span class="k">Email</span><a href={`mailto:${SITE.email}`} style="overflow-wrap:anywhere">{SITE.email}</a></li>
          <li><span class="k">Call</span>{SITE.phone ? <a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a> : <span class="tbc">{TBC}</span>}</li>
          <li><span class="k">Service area</span>{SITE.serviceArea.label}</li>
        </ul>
      </div>
      <div>
        <p class="foot-h">Office</p>
        <ul class="foot-contact">
          <li><span class="k">Address</span>{SITE.address ? <>{SITE.address.street}<br />{SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}</> : <span class="tbc">{TBC}</span>}</li>
          <li><span class="k">Hours</span>{SITE.hours ? SITE.hours.map((h) => <>{h.label}: {h.value}<br /></>) : <span class="tbc">{TBC}</span>}</li>
        </ul>
      </div>
    </div>
    <div class="foot-bar">
      <span>&copy; {year} {SITE.legalName}</span>
      <span>{SITE.tagline} &middot; {SITE.serviceArea.label}</span>
      <span><a href={SITE.currentSite} target="_blank" rel="noopener noreferrer">Current website</a></span>
    </div>
  </div>
</footer>
<style>
  .tbc{color:rgba(248,244,238,.55);font-style:italic}
</style>
