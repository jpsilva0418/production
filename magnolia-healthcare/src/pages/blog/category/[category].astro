---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { CATEGORIES, CATEGORY_KEYS, getPublishedPosts, type CategoryKey } from '../../../lib/blog';
import { breadcrumbJsonLd, localBusinessJsonLd } from '../../../lib/seo';
export async function getStaticPaths() { return (Object.keys(CATEGORIES) as CategoryKey[]).map((category) => ({ params: { category } })); }
const category = Astro.params.category as CategoryKey;
const cat = CATEGORIES[category];
const posts = (await getPublishedPosts()).filter((p) => p.data.category === category);
const jsonLd = [localBusinessJsonLd(), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: cat.name, path: `/blog/category/${category}` }])];
---
<BaseLayout title={`${cat.name} — Blog`} description={cat.intro} path={`/blog/category/${category}`} jsonLd={jsonLd}>
  <section class="cov cov--c">
    <div class="cov-c">
      <nav class="crumbs fade" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/blog">Blog</a></li><li><span aria-current="page">{cat.name}</span></li></ol></nav>
      <p class="cov-kick cov-kick--c fade">The blog</p>
      <h1 class="disp rv">{cat.name}</h1>
      <p class="cov-sub rv" style="--d:.08s">{cat.intro}</p>
    </div>
  </section>
  <section class="bc-list" aria-label={`${cat.name} articles`}>
    <div class="wrap">
      <nav class="pills rv" aria-label="Categories">
        <a class="pill" href="/blog">All</a>
        {CATEGORY_KEYS.map((key) => <a class:list={['pill', key === category && 'pill-on']} href={`/blog/category/${key}`} aria-current={key === category ? 'page' : undefined}>{CATEGORIES[key].name}</a>)}
      </nav>
      {posts.length === 0 && <p class="bc-empty ital">Articles in this category are on their way.</p>}
      <div class="bc-grid" data-stag=".06">{posts.map((post) => <div class="rv"><BlogCard post={post} /></div>)}</div>
    </div>
  </section>
</BaseLayout>
<style>
  .cov--c{text-align:center}
  .cov--c .cov-c{max-width:min(90vw,760px)}
  .cov--c .cov-sub{margin-inline:auto}
  .cov-kick--c{justify-content:center}
  .cov-kick--c::before{display:none}
  .crumbs ol{list-style:none;display:flex;gap:8px;justify-content:center;margin:0 0 1.2rem;padding:0;font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
  .crumbs li+li::before{content:"\203A";margin-right:8px;color:var(--brass)}
  .bc-list{padding:.4rem 0 clamp(5rem,9vw,7rem)}
  .pills{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:2.2rem}
  .pill{font-family:var(--utility);font-weight:600;font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;padding:11px 16px;border:1px solid var(--hair-strong);border-radius:999px;background:var(--paper);color:var(--ink-soft);transition:border-color .2s,color .2s;min-height:40px;display:inline-flex;align-items:center}
  .pill:hover{border-color:var(--leaf);color:var(--leaf)}
  .pill-on{border-color:var(--leaf);background:var(--leaf);color:var(--ivory)}
  .pill-on:hover{color:var(--ivory)}
  .bc-grid{display:grid;gap:clamp(1rem,2vw,1.6rem)}
  .bc-grid>div{display:flex}
  .bc-grid>div>:global(*){flex:1}
  @media(min-width:640px){.bc-grid{grid-template-columns:1fr 1fr}}
  @media(min-width:980px){.bc-grid{grid-template-columns:1fr 1fr 1fr}}
  .bc-empty{text-align:center;color:var(--ink-soft);padding:1.4rem 0}
</style>
