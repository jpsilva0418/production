---
/** SERVICES — the care Magnolia Healthcare, Inc. describes on its current site: the six
 *  "Specialized Care" cards and the four "How We Help" cards, staged as editorial rows
 *  (the Leti Silva Beauty services-page system). Each description is the site's own
 *  sentence. No pricing: the current site publishes none. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { localBusinessJsonLd, breadcrumbJsonLd } from '../../lib/seo';
const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const jsonLd = [localBusinessJsonLd(), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }])];
---
<BaseLayout
  title="Services — Specialized Care & How We Help"
  description="Hospice & palliative, Alzheimer’s & dementia care, rehabilitation support, geriatric care, Parkinson’s, ALS & multiple sclerosis — with 24/7 caregiver support, case management, nursing support and chat support. Magnolia Healthcare, Inc., anywhere in Massachusetts."
  path="/services"
  jsonLd={jsonLd}>

  <section class="cov ghostwrap">
    <span class="ghost-w" aria-hidden="true">care</span>
    <div class="cov-c">
      <p class="cov-kick fade">Our services</p>
      <h1 class="disp rv">Specialized care, <span class="ital">at home.</span></h1>
      <p class="cov-sub rv" style="--d:.08s">Our caregivers are thoughtfully selected, trained, and committed to bringing warmth, dignity, and genuine human connection into every home.</p>
      <div class="cov-cta fade" style="--d:.16s">
        <a class="btn btn--solid" href={SITE.links.consultCare}>Free consultation</a>
        <a class="tlk" href="#how">How we help</a>
      </div>
    </div>
  </section>

  <div class="chapslate fade" role="presentation"><span class="cs-t">Specialized care</span></div>

  <section class="sec lit" style="padding-top:clamp(40px,6vw,80px)">
    <i class="lx-shaft" aria-hidden="true"></i>
    <div class="wrap svc-rows">
      {specialized.map((s) => (
        <article class="svc" id={s.id}>
          <figure class="svc-fig"><div class="ph ph--framed rv-im"><Plate id={s.data.plate} alt="" class="lv" sizes="(max-width:899px) 90vw, 46vw" /><i class="grain" aria-hidden="true"></i></div></figure>
          <div class="svc-copy">
            <span class="caps-xs rv">No. {s.data.numeral}</span>
            <h2 class="rv" style="--d:.06s">{s.data.title}</h2>
            <p class="svc-sum rv" style="--d:.1s">{s.data.summary}</p>
            <div class="svc-act fade" style="--d:.2s">
              <a class="btn btn--solid" href={`${SITE.links.consultCare}&service=${s.id}`}>Ask about this care</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="chapslate chapslate--dk fade" role="presentation" id="how"><span class="cs-t">How we help</span></div>

  <section class="sec sec--dk lit">
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="wrap how-grid" data-stag=".08" style="position:relative;z-index:1">
      {support.map((s) => (
        <article class="how rv" id={s.id}>
          <span class="caps-xs">No. {s.data.numeral}</span>
          <h2>{s.data.title}</h2>
          <p>{s.data.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec--linen sec--tight">
    <div class="wrap">
      <div class="note-card rv">
        <span class="note-mono" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 64 64" fill="currentColor"><path d="M32 6c5.6 6.4 7.8 13.4 6.4 20.8C36.2 30.3 34 32.2 32 33.4c-2-1.2-4.2-3.1-6.4-6.6C24.2 19.4 26.4 12.4 32 6Z"/><path d="M55.4 18.6c-1.2 8.4-5 14.6-11.6 18.4-3.6 2.1-6.5 2.4-8.8 2-0.1-2.4.6-5.3 2.9-8.8 4.1-6.4 10.2-10.3 17.5-11.6Z" opacity=".8"/><path d="M8.6 18.6c7.3 1.3 13.4 5.2 17.5 11.6 2.3 3.5 3 6.4 2.9 8.8-2.3.4-5.2.1-8.8-2C13.6 33.2 9.8 27 8.6 18.6Z" opacity=".8"/><circle cx="32" cy="36.6" r="2.6"/></svg></span>
        <span class="caps">Care starts here</span>
        <p class="note-copy">Let&rsquo;s talk about the care your family needs.</p>
        <span class="note-rule" aria-hidden="true"></span>
        <p class="note-body">Tell us a little about your loved one. We&rsquo;ll reach out to set up a free consultation and find the caregiver who fits them best. {SITE.serviceArea.label}.</p>
        <a class="btn btn--solid" href={SITE.links.consultCare}>Free consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-rows{display:grid;row-gap:clamp(4.5rem,8vw,7.5rem)}
  .svc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(2.4rem,6vw,6rem);align-items:center;scroll-margin-top:90px}
  .svc-fig{margin:0}
  .svc-fig .ph{aspect-ratio:4/3.3}
  .svc:nth-child(even) .svc-fig{order:2}
  .svc:nth-child(even) .svc-copy{order:1}
  .svc-copy .caps-xs{display:block;margin-bottom:1.2rem}
  .svc-copy h2{font-size:clamp(2rem,3.4vw,3.2rem);line-height:1.08;margin:0 0 1.2rem}
  .svc-copy h2 a{color:inherit;transition:color .3s}
  .svc-copy h2 a:hover,.svc-copy h2 a:focus-visible{color:var(--brass)}
  .svc-sum{max-width:30em;margin:0 0 1.4rem}
  .svc-inc{list-style:none;margin:0 0 clamp(1.6rem,2.8vw,2.2rem);padding:0;display:grid;gap:.45rem;max-width:30em}
  .svc-inc li{position:relative;padding-left:1.5rem;font-size:.95rem;color:var(--ink)}
  .svc-inc li::before{content:"";position:absolute;left:0;top:.72em;width:9px;height:1px;background:var(--brass)}
  .svc-act{display:flex;align-items:center;gap:1.8rem;flex-wrap:wrap}
  @media(max-width:899px){
    .svc{grid-template-columns:1fr;row-gap:1.8rem}
    .svc:nth-child(even) .svc-fig,.svc:nth-child(even) .svc-copy{order:0}
    .svc-fig .ph{aspect-ratio:4/3}
  }
  .how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(1.4rem,2.6vw,2.4rem)}
  .how{border-top:1px solid var(--hairdk);padding-top:1.4rem}
  .how .caps-xs{display:block;color:var(--gold-lt);margin-bottom:.9rem}
  .how h2{font-size:clamp(1.4rem,2vw,1.8rem);color:var(--ivory);margin-bottom:.8rem}
  .how p{color:rgba(248,244,238,.8);font-size:.95rem}
  .note-body{max-width:34em;margin:0 auto clamp(1.8rem,3.4vw,2.6rem)}
  @media(max-width:1023px){.how-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:599px){.how-grid{grid-template-columns:1fr}}
</style>
