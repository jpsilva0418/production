---
/** SERVICES — the four services Magnolia actually offers, staged as editorial rows
 *  (the Leti Silva Beauty services-page system). No pricing: the current site has none. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { localBusinessJsonLd, breadcrumbJsonLd } from '../../lib/seo';
const services = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const jsonLd = [localBusinessJsonLd(), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }])];
---
<BaseLayout
  title="Services — Personal Care, Homemaking, Companionship & Dementia Support"
  description="Non-medical home care in Arvada and the Denver Metro: personal care, homemaking, companionship, and individualized Alzheimer’s and dementia support. Every care plan is built around the client’s routines, preferences, culture, and goals for independence."
  path="/services"
  jsonLd={jsonLd}>

  <section class="cov ghostwrap">
    <span class="ghost-w" aria-hidden="true">care</span>
    <div class="cov-c">
      <p class="cov-kick fade">Our services</p>
      <h1 class="disp rv">Four kinds of care, <span class="ital">at home.</span></h1>
      <p class="cov-sub rv" style="--d:.08s">Our team of trusted providers offers personal care and homemaking services to support clients with daily living &mdash; hygiene, cooking, mobility, errands &mdash; along with companionship and individualized dementia support.</p>
      <div class="cov-cta fade" style="--d:.16s">
        <a class="btn btn--solid" href={SITE.links.consultCare}>Request a consultation</a>
        <a class="tlk" href={`tel:${SITE.phoneE164}`}>Call {SITE.phone}</a>
      </div>
    </div>
  </section>

  <div class="chapslate fade" role="presentation"><span class="cs-t">The services</span></div>

  <section class="sec lit" style="padding-top:clamp(40px,6vw,80px)">
    <i class="lx-shaft" aria-hidden="true"></i>
    <div class="wrap svc-rows">
      {services.map((s) => (
        <article class="svc" id={s.id}>
          <figure class="svc-fig"><div class="ph ph--framed rv-im"><Plate id={s.data.plate} alt="" class="lv" sizes="(max-width:899px) 90vw, 46vw" /><i class="grain" aria-hidden="true"></i></div></figure>
          <div class="svc-copy">
            <span class="caps-xs rv">No. {s.data.numeral}</span>
            <h2 class="rv" style="--d:.06s"><a href={`/services/${s.id}`}>{s.data.title}</a></h2>
            <p class="svc-sum rv" style="--d:.1s">{s.data.summary}</p>
            <ul class="svc-inc rv" style="--d:.14s">
              {s.data.includes.map((i) => <li>{i}</li>)}
            </ul>
            <div class="svc-act fade" style="--d:.2s">
              <a class="btn btn--solid" href={`${SITE.links.consultCare}&service=${s.id}`}>Ask about {s.data.title.replace('Alzheimer’s & ', '')}</a>
              <a class="tlk" href={`/services/${s.id}`}>Read about this service</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec--linen sec--tight">
    <div class="wrap">
      <div class="note-card rv">
        <span class="note-mono" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 64 64" fill="currentColor"><path d="M32 6c5.6 6.4 7.8 13.4 6.4 20.8C36.2 30.3 34 32.2 32 33.4c-2-1.2-4.2-3.1-6.4-6.6C24.2 19.4 26.4 12.4 32 6Z"/><path d="M55.4 18.6c-1.2 8.4-5 14.6-11.6 18.4-3.6 2.1-6.5 2.4-8.8 2-0.1-2.4.6-5.3 2.9-8.8 4.1-6.4 10.2-10.3 17.5-11.6Z" opacity=".8"/><path d="M8.6 18.6c7.3 1.3 13.4 5.2 17.5 11.6 2.3 3.5 3 6.4 2.9 8.8-2.3.4-5.2.1-8.8-2C13.6 33.2 9.8 27 8.6 18.6Z" opacity=".8"/><circle cx="32" cy="36.6" r="2.6"/></svg></span>
        <span class="caps">Every plan is personal</span>
        <p class="note-copy">Every care plan is built around the client&rsquo;s routines, preferences, culture, and goals for independence &mdash; and reviewed as needs change.</p>
        <span class="note-rule" aria-hidden="true"></span>
        <a class="btn btn--solid" href={SITE.links.consultCare}>Start with a conversation</a>
      </div>
    </div>
  </section>

  <section class="sec sec--dk lit addr">
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="wrap addr-in">
      <span class="caps-xs fade">Office &amp; service area</span>
      <h2 class="disp rv">Arvada, Colorado</h2>
      <p class="addr-lines rv" style="--d:.07s">{SITE.address.street}<br /><span class="dim">{SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}</span></p>
      <p class="addr-towns rv" style="--d:.1s">Non-medical home care across {SITE.serviceArea.label}. Office hours Monday&ndash;Friday, 8:30 a.m.&ndash;5:30 p.m. {SITE.hoursNote}</p>
      <span class="addr-rule" aria-hidden="true"></span>
      <div class="addr-cta fade" style="--d:.16s">
        <a class="btn btn--ivory" href={SITE.links.consultCare}>Request a consultation</a>
        <a class="tlk tlk--lt" href={`tel:${SITE.phoneE164}`}>Call {SITE.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-rows{display:grid;row-gap:clamp(4.5rem,8vw,7.5rem)}
  .svc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(2.4rem,6vw,6rem);align-items:center;scroll-margin-top:90px}
  .svc-fig{margin:0}
  .svc-fig .ph{aspect-ratio:4/3.3}
  .svc:nth-child(even) .svc-fig{order:2}
  .svc:nth-child(even) .svc-copy{order:1}
  .svc-copy .caps-xs{display:block;margin-bottom:1.2rem}
  .svc-copy h2{font-size:clamp(2rem,3.4vw,3.2rem);line-height:1.08;margin:0 0 1.2rem}
  .svc-copy h2 a{color:inherit;transition:color .3s}
  .svc-copy h2 a:hover,.svc-copy h2 a:focus-visible{color:var(--brass)}
  .svc-sum{max-width:30em;margin:0 0 1.4rem}
  .svc-inc{list-style:none;margin:0 0 clamp(1.6rem,2.8vw,2.2rem);padding:0;display:grid;gap:.45rem;max-width:30em}
  .svc-inc li{position:relative;padding-left:1.5rem;font-size:.95rem;color:var(--ink)}
  .svc-inc li::before{content:"";position:absolute;left:0;top:.72em;width:9px;height:1px;background:var(--brass)}
  .svc-act{display:flex;align-items:center;gap:1.8rem;flex-wrap:wrap}
  @media(max-width:899px){
    .svc{grid-template-columns:1fr;row-gap:1.8rem}
    .svc:nth-child(even) .svc-fig,.svc:nth-child(even) .svc-copy{order:0}
    .svc-fig .ph{aspect-ratio:4/3}
  }
  .addr-in{text-align:center;max-width:760px;margin-inline:auto;position:relative;z-index:1}
  .addr-in .caps-xs{display:block;margin-bottom:1.4rem}
  .addr-in h2{font-size:clamp(2.4rem,4.4vw,4rem);margin-bottom:clamp(1.6rem,3vw,2.4rem)}
  .addr-lines{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.22em;font-size:.66rem;line-height:2.4;color:var(--ivory);margin:0 0 1.4rem}
  .addr-lines .dim{color:var(--gold-lt)}
  .addr-towns{font-family:var(--display);font-style:italic;font-size:1.1rem;color:rgba(248,244,238,.8);max-width:30em;margin:0 auto 2rem;font-variation-settings:'opsz' 48,'SOFT' 60}
  .addr-rule{display:block;width:56px;height:1px;background:var(--gold-lt);opacity:.6;margin:0 auto 2rem}
  .addr-cta{display:flex;justify-content:center;align-items:center;gap:2.2rem;flex-wrap:wrap}
</style>
