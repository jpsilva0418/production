  /* ---- floating contact ---- */
  .cfab{position:fixed;right:18px;bottom:18px;z-index:60;width:58px;height:58px;border-radius:50%;background:var(--leaf);color:var(--gold-lt);border:1px solid var(--gold-lt);display:grid;place-items:center;cursor:pointer;box-shadow:0 14px 30px -12px rgba(21,46,39,.6);transition:transform .3s var(--ease),background .3s}
  .cfab::after{content:"";position:absolute;inset:3px;border:1px solid rgba(185,151,91,.45);border-radius:50%}
