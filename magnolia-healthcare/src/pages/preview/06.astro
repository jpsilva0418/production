---
/** CONCEPT 06 — "Signature Magnolia". The current site's own visual DNA, rebuilt at the
 *  highest level: the centred logo header (nav split either side of the mark), the film hero
 *  ending in the curved sage band, the pale-sage mission panel over the team photograph, the
 *  gold-hairline card frames, the client carousel, the forest-green "Let's talk" banner with
 *  gold icons and lotus line art, the dark "Blog" bar, the "Join our team" band, and the
 *  floating contact control — every one recognisable, every one elevated. Content is verbatim
 *  from src/lib/magnolia-content.ts; nothing is invented. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';
import Plate from '../../components/Plate.astro';
import ConceptBar from '../../components/preview/ConceptBar.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts, fmtDate, readingTime } from '../../lib/blog';
import { NAV, LOGIN, HERO, MISSION, SECTION_LABELS, BANNER, CAREERS, FOUNDER, FOOTER, MEDIA, SITE, TESTIMONIALS } from '../../lib/magnolia-content';

const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const posts = (await getPublishedPosts()).slice(0, 2);
/** Only Magnolia's own photographs are shown as card insets; generated placeholders stay out. */
const supplied = new Set<string>(['dementia', 'companionship', 'personal-care', 'supplied-clinician']);
const navL = NAV.slice(0, 3);
const navR = NAV.slice(3);
const mailto = `mailto:${FOOTER.email}`;
const tbcRows = ['Phone', 'Facebook', 'WhatsApp', 'Chat'];
---
<BaseLayout title="Concept 06 · Signature Magnolia" description="The current Magnolia website's own DNA — curved sage band, gold ring, framed cards — rebuilt at the highest level." path="/preview/06" bodyClass="preview c06" chrome={false}>

  <!-- ① HEADER — her centred logo, the five destinations split either side of the mark -->
  <header class="c6hd">
    <div class="c6hd-in">
      <div class="c6hd-l">
        <a class="btn btn--solid c6hd-cta" href={HERO.ctaHref}>{HERO.cta}</a>
        <nav class="c6nav" aria-label="Primary (left)">{navL.map((n) => <a href={n.href} aria-current={n.href === '/' ? 'page' : undefined}>{n.label}</a>)}</nav>
      </div>
      <a class="c6logo" href="/" aria-label={`${SITE.name} — home`}>
        <span class="c6ring"><Mark class="c6mark" /></span>
        <span class="c6wm" aria-hidden="true"><span class="c6wm-n">Magnolia</span><span class="c6wm-s"><svg width="8" height="8" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21s-8-5.3-8-11.2A4.6 4.6 0 0 1 12 7a4.6 4.6 0 0 1 8 2.8C20 15.7 12 21 12 21Z"/></svg>Healthcare</span></span>
      </a>
      <div class="c6hd-r">
        <nav class="c6nav" aria-label="Primary (right)">{navR.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
        <a class="c6login" href={LOGIN.href}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>{LOGIN.label}</a>
        <button class="c6menu-btn" id="c6menuBtn" type="button" aria-expanded="false" aria-controls="c6menu"><span class="sr-only">Menu</span><span class="c6bars" aria-hidden="true"><i></i><i></i><i></i></span></button>
      </div>
    </div>
    <nav class="c6menu" id="c6menu" aria-label="Menu" hidden>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href={LOGIN.href}>{LOGIN.label}</a></li></ul>
      <a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a>
    </nav>
  </header>

  <!-- ② HERO — her film, her halftone, her white outlined button, her curved sage band -->
  <section class="hero" aria-label="Magnolia Healthcare — home care agency">
    <div class="hero-film" aria-hidden="true">
      <video id="c6film" muted loop playsinline preload="none" poster={MEDIA.heroFilm.poster} disablepictureinpicture tabindex="-1">
        <source data-src={MEDIA.heroFilm.webm} type="video/webm" /><source data-src={MEDIA.heroFilm.mp4} type="video/mp4" />
      </video>
    </div>
    <i class="hero-scrim" aria-hidden="true"></i><i class="hero-dots" aria-hidden="true"></i>
    <div class="hero-c">
      <h1 class="hero-h fade">{HERO.headline}</h1>
      <p class="hero-sub fade" style="--d:.12s">{HERO.sub}</p>
      <div class="fade" style="--d:.22s"><a class="btn btn--ghost hero-btn" href={HERO.ctaHref}>{HERO.cta}</a></div>
    </div>
    <div class="hero-curve" aria-hidden="true"></div>
    <a class="hero-arrow" href="#mission" aria-label="Scroll to Our Mission"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16M5 13l7 7 7-7"/></svg></a>
  </section>

  <!-- ③ OUR MISSION — her pale sage panel, then her team photograph, framed -->
  <section class="mis" id="mission">
    <div class="wrap">
      <h2 class="mis-h rv">{MISSION.heading}</h2>
      <i class="rule fade" aria-hidden="true"></i>
      <p class="caps mis-eye fade" style="--d:.06s">{MISSION.eyebrow}</p>
      <div class="mis-body rv" style="--d:.1s">
        <p class="mis-lede">{MISSION.sentences[0]}</p>
        <p>{MISSION.sentences[1]} {MISSION.sentences[2]}</p>
        <p>{MISSION.sentences[3]}</p>
      </div>
      <figure class="mis-fig">
        <div class="ph gframe rv-im"><Plate id={MEDIA.plates.team5} alt="The Magnolia Healthcare team in front of the Magnolia Healthcare sign; the founder stands at the centre" class="lv lv--rise" sizes="(max-width:899px) 90vw, 900px" widths={[480, 652]} /><i class="grain" aria-hidden="true"></i></div>
        <figcaption class="caps-xs fade">The Magnolia team &middot; supplied imagery</figcaption>
      </figure>
    </div>
  </section>

  <!-- ④ WHY CHOOSE US? · SPECIALIZED CARE — her six gold-framed cards -->
  <section class="why" id="services">
    <div class="wrap">
      <h2 class="h-caps rv">{SECTION_LABELS.why}</h2>
      <p class="caps sub fade">{SECTION_LABELS.specialized}</p>
      <svg class="chev fade" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 10l7 7 7-7"/></svg>
      <div class="grid grid--3" data-stag=".07">
        {specialized.map((s) => (
          <article class="gf rv">
            <div class="gf-top">
              <span class="medal" aria-hidden="true">{s.data.numeral}</span>
              {supplied.has(s.data.plate) && <span class="gf-im"><Plate id={s.data.plate} alt="" sizes="76px" widths={[160, 240]} /></span>}
            </div>
            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>
            <a class="arrow-link" href={`/services#${s.id}`} aria-label={`${s.data.title} — learn more`}>Learn more <span class="arr" aria-hidden="true">&rarr;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑤ CARE, AT HOME — a supplied clip in a gold frame on the sage ground -->
  <section class="cine6" aria-label="Care at home — film">
    <div class="wrap">
      <div class="cine6-fr rv-im">
        <video data-film muted loop playsinline preload="none" poster={MEDIA.cineFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
          <source data-src={MEDIA.cineFilm.webm} type="video/webm" /><source data-src={MEDIA.cineFilm.mp4} type="video/mp4" />
        </video>
        <i class="grain" aria-hidden="true"></i>
      </div>
      <p class="caps-xs cine6-cap fade">Care, at home &middot; {HERO.area}</p>
    </div>
  </section>

  <!-- ⑥ HOW WE HELP — her four cards, same gold-frame language -->
  <section class="why" id="how">
    <div class="wrap">
      <h2 class="h-caps rv">{SECTION_LABELS.how}</h2>
      <svg class="chev fade" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 10l7 7 7-7"/></svg>
      <div class="grid grid--4" data-stag=".07">
        {support.map((s) => (
          <article class="gf rv">
            <div class="gf-top">
              <span class="medal" aria-hidden="true">{s.data.numeral}</span>
              {supplied.has(s.data.plate) && <span class="gf-im"><Plate id={s.data.plate} alt="" sizes="76px" widths={[160, 240]} /></span>}
            </div>
            <h3>{s.data.title}</h3>
            <p>{s.data.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑦ WHAT OUR CLIENTS SAY — her carousel, rebuilt properly -->
  <section class="why voices" id="voices">
    <div class="wrap">
      <h2 class="h-caps rv">{SECTION_LABELS.voices}</h2>
      <div class="tst gf rv" id="c6tst" aria-roledescription="carousel" aria-label="Client testimonials" style="--d:.08s">
        <span class="tst-q" aria-hidden="true">&ldquo;</span>
        <div class="tst-view"><div class="tst-track" id="tstTrack" aria-live="polite">
          {TESTIMONIALS.map((t, i) => (
            <figure class="tst-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${TESTIMONIALS.length}`}>
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption>{t.name}</figcaption>
            </figure>
          ))}
        </div></div>
        <div class="tst-ctl">
          <button class="tst-btn" id="tstPrev" type="button" aria-label="Previous testimonial"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
          <div class="tst-dots" id="tstDots">{TESTIMONIALS.map((t, i) => <button type="button" aria-label={`Show testimonial ${i + 1}: ${t.name}`} aria-current={i === 0 ? 'true' : undefined}></button>)}</div>
          <button class="tst-btn" id="tstNext" type="button" aria-label="Next testimonial"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </div>
      <p class="tst-note fade">Client words as published on Magnolia&rsquo;s current website.</p>
    </div>
  </section>

  <!-- ⑧ MEET THE FOUNDER — the gold ring, now around her -->
  <section class="fnd" id="founder">
    <div class="wrap fnd-grid">
      <figure class="fnd-fig">
        <div class="arch rv-im"><Plate id={FOUNDER.plate} alt="The founder of Magnolia Healthcare" sizes="(max-width:899px) 70vw, 320px" widths={[400, 560]} /></div>
        <figcaption><span class="caps-xs">{FOUNDER.label} &middot; {FOUNDER.name}</span></figcaption>
      </figure>
      <div class="fnd-copy">
        <h2 class="h-caps rv">Meet the founder</h2>
        <i class="rule fade" aria-hidden="true"></i>
        <p class="ital fnd-note rv" style="--d:.06s">{FOUNDER.note}</p>
        <p class="fnd-line fade" style="--d:.1s">{MISSION.sentences[2]}</p>
        <a class="tlk fade" style="--d:.14s" href={SITE.links.mission}>Read our mission</a>
      </div>
      <figure class="fnd-team">
        <div class="ph gframe rv-im"><Plate id={MEDIA.plates.team4} alt="Four Magnolia caregivers in scrubs" sizes="(max-width:899px) 90vw, 380px" widths={[480, 640]} /><i class="grain" aria-hidden="true"></i></div>
        <figcaption class="caps-xs fade">Our team &middot; supplied imagery</figcaption>
      </figure>
    </div>
  </section>

  <!-- ⑨ LET'S TALK — her forest-green banner, gold icons, lotus line art -->
  <section class="ban" id="consult">
    <div class="wrap ban-grid">
      <div>
        <p class="caps ban-eye fade">{BANNER.eyebrow}</p>
        <h2 class="rv">{BANNER.heading}</h2>
        <p class="ban-body rv" style="--d:.06s">{BANNER.body}</p>
        <ul class="ban-pts fade" style="--d:.1s">
          <li><span class="ban-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.5 5.6 6 .6-4.5 4.1 1.3 6L12 16.2 6.7 19.3l1.3-6L3.5 9.2l6-.6z"/></svg></span>{BANNER.points[0]}</li>
          <li><span class="ban-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-7.1 7-12a7 7 0 1 0-14 0c0 4.9 7 12 7 12Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>{BANNER.points[1]}</li>
        </ul>
        <div class="ban-cta fade" style="--d:.14s"><a class="btn btn--ivory" href={BANNER.ctaHref}>{BANNER.cta}</a><a class="tlk tlk--lt" href={mailto}>Email {FOOTER.email}</a></div>
      </div>
      <svg class="lotus fade" viewBox="0 0 200 160" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true">
        <path d="M100 18c16 28 16 70 0 104-16-34-16-76 0-104Z"/>
        <path d="M100 122c-22-12-38-40-36-78 22 18 34 48 36 78Z"/><path d="M100 122c22-12 38-40 36-78-22 18-34 48-36 78Z"/>
        <path d="M100 122c-30-2-58-22-70-54 30 6 56 28 70 54Z"/><path d="M100 122c30-2 58-22 70-54-30 6-56 28-70 54Z"/>
        <path d="M100 122c-34 4-62-6-82-30 32-2 60 8 82 30Z" opacity=".55"/><path d="M100 122c34 4 62-6 82-30-32-2-60 8-82 30Z" opacity=".55"/>
        <path d="M44 130q56 26 112 0" opacity=".8"/><path d="M58 141q42 18 84 0" opacity=".5"/>
      </svg>
    </div>
  </section>

  <!-- ⑩ MAGNOLIA MOMENTS — her heading, her dark "Blog" bar, the two posts -->
  {posts.length > 0 && (
    <section class="why blog" id="journal">
      <div class="wrap">
        <h2 class="h-caps rv">{SECTION_LABELS.blog}</h2>
        <div class="blog-bar fade">
          <span class="blog-bar-t">Blog</span>
          <a class="blog-search" href={`${SITE.links.blog}#blogSearch`}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>Search posts</a>
          <a class="tlk tlk--lt" href={SITE.links.blog}>All posts</a>
        </div>
        <div class="grid grid--2 blog-grid" data-stag=".08">
          {posts.map((p) => (
            <article class="gf bp rv">
              <a class="bp-ph" href={`/blog/${p.id}`} tabindex="-1" aria-hidden="true"><Plate id={p.data.plate} alt="" sizes="(max-width:599px) 90vw, 440px" widths={[448, 640]} /></a>
              <p class="caps-xs bp-meta">{fmtDate(p.data.pubDate)} &middot; {p.data.migrate ? 'Excerpt' : `${readingTime(p.body)} min read`}</p>
              <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
              <a class="arrow-link" href={`/blog/${p.id}`} aria-label={`Read: ${p.data.title}`}>Read <span class="arr" aria-hidden="true">&rarr;</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ⑪ JOIN OUR TEAM — her green band, the application download -->
  <section class="join" id="careers">
    <h2 class="join-bar">{CAREERS.banner}</h2>
    <div class="wrap join-in">
      <p class="h-caps h-caps--sm rv" role="presentation">{CAREERS.heading}</p>
      <p class="join-body rv" style="--d:.06s">{CAREERS.body}</p>
      <p class="caps join-dl fade" style="--d:.1s">{CAREERS.download}</p>
      <div class="join-cta fade" style="--d:.14s">
        <a class="btn btn--gold" href={CAREERS.pdf} download>Download <span aria-hidden="true">&gt;</span></a>
        <a class="btn btn--solid" href={CAREERS.apply}>Apply online</a>
      </div>
      <p class="join-mail fade" style="--d:.18s">Email completed applications to <a href={mailto}>{FOOTER.email}</a></p>
    </div>
  </section>

  <!-- ⑫ FOOTER — white, centred, hers -->
  <footer class="ft">
    <div class="wrap">
      <span class="c6ring ft-ring"><Mark class="c6mark" /></span>
      <p class="ft-name">{FOOTER.legal}</p>
      <p class="ft-line"><a href={mailto}>{FOOTER.email}</a></p>
      <p class="caps-xs">{FOOTER.area}</p>
      <nav class="ft-nav" aria-label="Footer">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}<a href={SITE.links.apply}>Apply</a><a href={LOGIN.href}>{LOGIN.label}</a></nav>
      <p class="ft-bar">&copy; {new Date().getUTCFullYear()} {FOOTER.legal} &middot; <a href={SITE.currentSite} target="_blank" rel="noopener noreferrer">Current website</a></p>
    </div>
  </footer>

  <!-- ⑬ CONTACT — her floating buttons, as one -->
  <div class="csheet gf" id="c6sheet" hidden role="dialog" aria-label="Contact Magnolia">
    <p class="caps-xs">Contact</p>
    <a class="cs-row" href={mailto}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span>Email<small>{FOOTER.email}</small></span></a>
    {tbcRows.map((r) => <span class="cs-row cs-row--off" aria-disabled="true"><span>{r}<small>To be supplied by Magnolia</small></span></span>)}
  </div>
  <button class="cfab" id="c6contact" type="button" aria-expanded="false" aria-controls="c6sheet"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16v10H9l-5 4z"/></svg><span class="sr-only">Contact Magnolia</span></button>

  <ConceptBar current={6} />
</BaseLayout>

<style>
  /* ---- header ---- */
  .c6hd{position:sticky;top:0;z-index:70;background:#fff;border-bottom:1px solid var(--hair)}
  .c6hd-in{width:var(--wrap);margin-inline:auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;min-height:88px}
  .c6hd-l,.c6hd-r{display:flex;align-items:center;gap:clamp(1.2rem,2.4vw,2.4rem)}
  .c6hd-r{justify-content:flex-end}
  .c6hd-cta{border-radius:999px;padding:1em 1.6em .95em;min-height:40px;font-size:.6rem}
  .c6nav{display:flex;align-items:center;gap:clamp(1rem,2vw,1.9rem)}
  .c6nav a{position:relative;font-family:var(--utility);font-weight:600;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);padding:.6em 0;min-height:44px;display:inline-flex;align-items:center;transition:color .3s}
  .c6nav a::after{content:"";position:absolute;left:0;right:0;bottom:.4em;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)}
  .c6nav a:hover,.c6nav a[aria-current="page"]{color:var(--leaf)}
  .c6nav a:hover::after,.c6nav a:focus-visible::after,.c6nav a[aria-current="page"]::after{transform:scaleX(1)}
  .c6logo{display:inline-flex;align-items:center;gap:.8rem;min-height:44px;justify-self:center}
  .c6ring{position:relative;width:46px;height:46px;flex:none;border-radius:50%;border:1px solid var(--gold);display:grid;place-items:center;color:var(--leaf);background:#fff}
  .c6ring::after{content:"";position:absolute;inset:3px;border:1px solid rgba(185,151,91,.32);border-radius:50%}
  .c6ring :global(.c6mark){width:26px;height:26px}
  .c6wm{display:flex;flex-direction:column;line-height:1}
  .c6wm-n{font-family:var(--display);font-size:1.22rem;letter-spacing:.2em;text-transform:uppercase;color:var(--leaf);font-variation-settings:'opsz' 48,'SOFT' 30}
  .c6wm-s{display:flex;align-items:center;gap:.5em;margin-top:.45em;font-family:var(--utility);font-weight:600;font-size:.5rem;letter-spacing:.38em;text-transform:uppercase;color:var(--brass)}
  .c6login{display:inline-flex;align-items:center;gap:.5em;min-height:44px;font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);transition:color .3s}
  .c6login:hover{color:var(--leaf)}
  .c6menu-btn{display:none;width:44px;height:44px;background:none;border:0;cursor:pointer;place-items:center;border-radius:50%}
  .c6bars{display:flex;flex-direction:column;gap:5px}
  .c6bars i{display:block;width:22px;height:1.5px;background:var(--leaf);transition:transform .35s var(--ease),opacity .25s}
  .c6menu-btn[aria-expanded="true"] .c6bars i:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
  .c6menu-btn[aria-expanded="true"] .c6bars i:nth-child(2){opacity:0}
  .c6menu-btn[aria-expanded="true"] .c6bars i:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
  .c6menu{display:none}
  @media(max-width:1023px){
    .c6hd-in{min-height:72px}
    .c6nav,.c6hd-cta,.c6login{display:none}
    .c6menu-btn{display:grid}
    .c6logo{gap:.6rem}
    .c6wm-n{font-size:1.05rem}
    .c6menu{display:block;position:absolute;top:100%;left:0;right:0;background:#fff;border-bottom:1px solid var(--hair);box-shadow:0 30px 50px -30px rgba(21,46,39,.4);padding:.6rem 5vw 1.4rem}
    .c6menu[hidden]{display:none}
    html:not(.js) .c6menu[hidden]{display:block;position:static;box-shadow:none}
    .c6menu ul{list-style:none;margin:0 0 1rem;padding:0}
    .c6menu li+li{border-top:1px solid var(--hair)}
    .c6menu li a{display:flex;align-items:center;min-height:50px;font-family:var(--display);font-size:1.3rem;color:var(--leaf);letter-spacing:.06em;text-transform:uppercase}
