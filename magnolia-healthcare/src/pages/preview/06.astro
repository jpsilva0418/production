</style>
<style is:global>
  /* Founder's own tonal balance: white canvas, pale sage panels, one deep-green banner, gold as hairline only. */
  body.c06{--ivory:#FDFDFC;--linen:#F3F3F1;--paper:#FEFEFE;--sage-band:#EAEDE8;--sage:#B1C09D;--sage-2:#B9C7A8;--sage-deep:#7FA45E;--leaf-deep:#122E1F;
    --ink:#2A2F2B;--ink-soft:#5B625D;--brass:#7E6238;--gold:#B9975B;--hair:rgba(42,47,43,.12);--hair-strong:rgba(42,47,43,.26);
    --shadow-lg:0 50px 90px -46px rgba(18,46,31,.3);--shadow:0 24px 48px -30px rgba(18,46,31,.26);background:#FEFEFE;color:var(--ink-soft)}
  body.c06 #toTop{bottom:88px}
  @media(max-width:640px){body.c06 #toTop{bottom:134px}}
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  /* hero film — promoted right away (poster carries the first paint), paused off-screen */
  const film = document.getElementById('c6film') as HTMLVideoElement | null;
  if (film) {
    if (reduced || saveData) film.querySelectorAll('source').forEach((s) => s.remove());
    else {
      const promote = () => { film.querySelectorAll('source').forEach((s) => { const src = (s as HTMLSourceElement).dataset.src; if (src) (s as HTMLSourceElement).src = src; }); film.load(); film.play().catch(() => {}); };
      setTimeout(promote, 350);
      if ('IntersectionObserver' in window) new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) film.play().catch(() => {}); else film.pause(); }); }, { threshold: 0.05 }).observe(film);
    }
  }

  /* disclosure helper — menu and contact sheet share it (aria-expanded, Escape, outside click) */
  const disclose = (btnId: string, panelId: string, closeOnLink: boolean) => {
    const btn = document.getElementById(btnId), panel = document.getElementById(panelId);
    if (!btn || !panel) return;
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); panel.hidden = !open; if (!open && document.activeElement && panel.contains(document.activeElement)) btn.focus(); };
    btn.addEventListener('click', () => set(panel.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
    document.addEventListener('click', (e) => { const t = e.target as Node; if (!panel.hidden && !panel.contains(t) && !btn.contains(t)) set(false); });
    if (closeOnLink) panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  };
  disclose('c6menuBtn', 'c6menu', true);
  disclose('c6contact', 'c6sheet', false);

  /* testimonials carousel — buttons, dots, arrow keys, swipe; auto-advance only without reduced motion, paused on hover/focus */
  const car = document.getElementById('c6tst'), track = document.getElementById('tstTrack');
  if (car && track) {
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#tstDots button'));
    let i = 0, timer = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = `translateX(-${i * 100}%)`;
      slides.forEach((s, k) => s.setAttribute('aria-hidden', String(k !== i)));
      dots.forEach((d, k) => { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };
    const start = () => { if (reduced || timer) return; timer = window.setInterval(() => go(i + 1), 6500); };
    document.getElementById('tstPrev')?.addEventListener('click', () => go(i - 1));
    document.getElementById('tstNext')?.addEventListener('click', () => go(i + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    car.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1); } else if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1); } });
    let x0 = 0;
    track.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    track.addEventListener('pointerup', (e) => { const dx = e.clientX - x0; if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1); });
    ['mouseenter', 'focusin'].forEach((ev) => car.addEventListener(ev, stop));
    ['mouseleave', 'focusout'].forEach((ev) => car.addEventListener(ev, start));
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    go(0); start();
  }
</script>
