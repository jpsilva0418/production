---
/** CONCEPT 03 — "Warm Human Premium". The people first: the current site's warmth
 *  (sage, blush scrubs, the smiling team, the magnolia) becomes the whole mood. Warm
 *  ivory ground, generous sage bands, blush panels, gold hairlines, rounded framed
 *  photographs, italics as handwritten asides. Order: centred-logo header → warm split
 *  hero (the team in an arch, the corridor film as a polaroid) → sage statement band →
 *  Our Mission as "Our promise" (four numbered sentences) → What our clients say (early)
 *  → Specialized care (six warm cards) → How we help (four blush panels) → the founder
 *  chapter + team gallery → "Let's talk…" deep-green panel → "Care, at home" cinema band
 *  → Magnolia Moments → Join our team → warm deep-green footer. Copy is verbatim from
 *  src/lib/magnolia-content.ts; no business fact is invented. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import Mark from '../../components/Mark.astro';
import BlogCard from '../../components/BlogCard.astro';
import ConceptBar from '../../components/preview/ConceptBar.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../lib/blog';
import { NAV, LOGIN, HERO, MISSION, SECTION_LABELS, BANNER, CAREERS, FOUNDER, FOOTER, MEDIA, SITE, TESTIMONIALS } from '../../lib/magnolia-content';

const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const posts = (await getPublishedPosts()).slice(0, 2);
const numerals = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.'];
const [first, ...rest] = MISSION.sentences;
---
<BaseLayout title="Concept 03 · Warm Human Premium" description={SITE.description} path="/preview/03" bodyClass="preview c03" chrome={false}>

  <!-- ① HEADER — centred logo above one row of the five destinations (the current site's centred logo, with a visible nav) -->
  <div class="hd-slot" id="hdSlot">
    <header class="hd" id="siteHeader">
      <div class="hd-in">
        <a class="hd-logo" href="/" aria-label={`${SITE.name} — home`}>
          <Mark />
          <span class="wm" aria-hidden="true"><span class="wm-name">Magnolia</span><span class="wm-sub">Healthcare</span></span>
        </a>
        <div class="hd-row">
          <a class="hd-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <nav class="hd-nav" aria-label="Primary">
            {NAV.map((n) => <a href={n.href} aria-current={n.href === '/' ? 'page' : undefined}>{n.label}</a>)}
          </nav>
          <div class="hd-tools">
            <a class="hd-login" href={LOGIN.href}>{LOGIN.label}</a>
            <a class="btn btn--solid hd-cta" href={HERO.ctaHref}>{HERO.cta}</a>
          </div>
        </div>
        <button class="menu-btn" id="menuOpen" aria-expanded="false" aria-controls="menu" aria-label="Open menu">Menu <span class="bars" aria-hidden="true"><i></i><i></i></span></button>
      </div>
    </header>
  </div>
  <nav class="menu" id="menu" aria-label="Main menu" aria-hidden="true" inert>
    <div class="menu-top">
      <a class="hd-logo" href="/" aria-label={`${SITE.name} — home`} tabindex="-1"><Mark /><span class="wm" aria-hidden="true"><span class="wm-name">Magnolia</span><span class="wm-sub">Healthcare</span></span></a>
      <button class="menu-close" id="menuClose">Close <span class="x" aria-hidden="true">&times;</span></button>
    </div>
    <div class="menu-body">
      <ul class="menu-list">
        {NAV.map((n, i) => <li><a href={n.href}><span class="mrn">{numerals[i]}</span><span class="mlb">{n.label}</span></a></li>)}
      </ul>
      <div class="menu-sub"><a href={LOGIN.href}>{LOGIN.label}</a><a href={CAREERS.apply}>Caregiver application</a><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
      <div class="menu-cta"><a class="btn btn--solid pill" href={HERO.ctaHref}>{HERO.cta}</a></div>
    </div>
    <div class="menu-foot"><span>{FOOTER.legal}</span><span>{HERO.sub} · {HERO.area}</span></div>
  </nav>

  <!-- ② HERO — a warm split: the words left, the team right in an arch, the corridor film as a polaroid -->
  <section class="hero" aria-labelledby="h1">
    <div class="wrap hero-g">
      <div class="hero-c">
        <p class="caps hero-sub fade">{HERO.sub} <b aria-hidden="true">&middot;</b> {HERO.area}</p>
        <h1 id="h1" class="hero-h rv" style="--d:.06s">Because every <span class="ital">life</span> matters.</h1>
        <p class="hero-aside ital fade" style="--d:.14s">Seeing the person beyond their needs.</p>
        <div class="hero-cta fade" style="--d:.2s">
          <a class="btn btn--solid pill" href={HERO.ctaHref}>{HERO.cta}</a>
          <a class="btn btn--line pill" href={SITE.links.careers}>{SECTION_LABELS.team}</a>
        </div>
      </div>
      <figure class="hero-fig">
        <div class="arch arch--team rv-im"><Plate id={MEDIA.plates.team5} alt="The Magnolia Healthcare team in front of the Magnolia sign — the founder in white at the centre" class="lv lv--breathe" sizes="(max-width:899px) 92vw, 600px" widths={[480, 652]} loading="eager" fetchpriority="high" /><i class="grain" aria-hidden="true"></i></div>
        <div class="pola fade" style="--d:.3s">
          <div class="pola-fr">
            <video data-film muted loop playsinline preload="none" poster={MEDIA.heroFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
              <source data-src={MEDIA.heroFilm.webm} type="video/webm" /><source data-src={MEDIA.heroFilm.mp4} type="video/mp4" />
            </video>
          </div>
          <span class="pola-cap ital" aria-hidden="true">A walk together</span>
        </div>
        <figcaption class="sr-only">The Magnolia team, and a companion walking arm-in-arm with an older woman down a bright corridor.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ③ SAGE BAND — the mission's eyebrow and first sentence, very large -->
  <section class="band" aria-label="Our mission, in one sentence">
    <div class="wrap-text band-c">
      <p class="caps fade">{MISSION.eyebrow}</p>
      <p class="band-s rv" style="--d:.08s">{first}</p>
      <i class="band-rule fade" style="--d:.2s" aria-hidden="true"></i>
    </div>
  </section>

  <!-- ④ OUR MISSION, in full — "Our promise": four numbered sentences -->
  <section class="sec sec--tight" id="mission">
    <div class="wrap">
      <div class="sh">
        <p class="kick kick--c">Our promise</p>
        <h2 class="disp rv">{MISSION.heading}</h2>
        <p class="ital sh-aside fade" style="--d:.08s">Four sentences we hold ourselves to, in every home.</p>
      </div>
      <ol class="promise" data-stag=".08">
        {MISSION.sentences.map((s, i) => (
          <li class="fade"><span class="p-n">{numerals[i]}</span><i class="p-rule" aria-hidden="true"></i><p>{s}</p></li>
        ))}
      </ol>
      <p class="sh-link fade"><a class="arrow-link" href={SITE.links.mission}>Read our mission <span class="arr" aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <!-- ⑤ WHAT OUR CLIENTS SAY — early and prominent -->
  <section class="sec sec--tight voices" id="voices">
    <div class="wrap">
      <div class="sh">
        <p class="kick kick--c">{SECTION_LABELS.voices}</p>
        <h2 class="disp rv">Words from the families <span class="ital">we care for.</span></h2>
      </div>
      <div class="tst-grid" data-stag=".09">
        {TESTIMONIALS.map((t) => (
          <figure class="tst card rv">
            <span class="tst-q" aria-hidden="true">&ldquo;</span>
            <blockquote><p class="ital">{t.quote}</p></blockquote>
            <figcaption><span class="caps">{t.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="tst-note ital fade">Client words as published on Magnolia&rsquo;s current website.</p>
    </div>
  </section>

  <!-- ⑥ SPECIALIZED CARE — six warm cards with rounded photo tops and gold hairlines -->
  <section class="sec sec--tight svc" id="services">
    <div class="wrap">
      <div class="sh">
        <p class="kick kick--c">{SECTION_LABELS.why}</p>
        <h2 class="disp rv">{SECTION_LABELS.specialized}</h2>
        <p class="ital sh-aside fade" style="--d:.08s">Six kinds of care, each shaped around the person.</p>
      </div>
      <div class="svc-grid" data-stag=".07">
        {specialized.map((s) => (
          <article class="svc-card card rv" id={`care-${s.id}`}>
            <div class="ph svc-ph"><Plate id={s.data.plate} alt="" sizes="(max-width:639px) 92vw, (max-width:1023px) 46vw, 400px" widths={[400, 640, 900]} /></div>
            <div class="svc-body">
              <span class="caps-xs">No. {s.data.numeral}</span>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              <a class="arrow-link" href={HERO.ctaHref} aria-label={`Ask about ${s.data.title}`}>Ask about this care <span class="arr" aria-hidden="true">&rarr;</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑦ HOW WE HELP — four panels on blush -->
  <section class="sec sec--tight sec--blush" id="how">
    <div class="wrap">
      <div class="sh">
        <p class="kick kick--c">{SECTION_LABELS.how}</p>
        <h2 class="disp rv">Support for the <span class="ital">whole</span> family.</h2>
      </div>
      <ul class="help" data-stag=".08">
        {support.map((s, i) => (
          <li class="help-p card fade"><span class="caps-xs">{numerals[i]}</span><h3>{s.data.title}</h3><p>{s.data.summary}</p></li>
        ))}
      </ul>
      <div class="sh-cta fade"><a class="btn btn--solid pill" href={HERO.ctaHref}>{HERO.cta}</a><a class="tlk" href={SITE.links.services}>All of our care, in detail</a></div>
    </div>
  </section>

  <!-- ⑧ THE FOUNDER + THE TEAM — a warm chapter, no names -->
  <section class="sec sec--tight sec--linen" id="founder">
    <div class="wrap people">
      <figure class="founder rv-im">
        <div class="arch arch--portrait"><Plate id={FOUNDER.plate} alt="The founder of Magnolia Healthcare, in white" sizes="(max-width:899px) 80vw, 380px" widths={[420, 560]} /></div>
        <figcaption><span class="caps">{FOUNDER.label} <b aria-hidden="true">&middot;</b> {FOUNDER.name}</span><span class="ital founder-note">{FOUNDER.note}</span></figcaption>
      </figure>
      <div class="people-r">
        <p class="kick">The people</p>
        <h2 class="disp rv">Thoughtfully selected, trained, and <span class="ital">committed.</span></h2>
        <p class="people-line fade" style="--d:.08s">{rest[1]}</p>
        <div class="gallery" data-stag=".1">
          <div class="ph ph--soft rv-im"><Plate id={MEDIA.plates.team4} alt="Four Magnolia caregivers in scrubs" sizes="(max-width:899px) 45vw, 300px" widths={[400, 640]} /></div>
          <div class="ph ph--soft rv-im"><Plate id={MEDIA.plates.clinician} alt="A Magnolia clinician" sizes="(max-width:899px) 45vw, 300px" widths={[400, 640]} /></div>
        </div>
        <p class="caps-xs gal-cap fade">Our team <b aria-hidden="true">&middot;</b> supplied imagery</p>
      </div>
    </div>
  </section>

  <!-- ⑨ "LET'S TALK…" — the consultation banner as a deep-green panel inset on ivory -->
  <section class="sec sec--tight" id="consult">
    <div class="wrap">
      <div class="talk sec--dk lit rv">
        <i class="lx-dusk" aria-hidden="true"></i>
        <div class="talk-c">
          <p class="caps">{BANNER.eyebrow}</p>
          <h2 class="talk-h">{BANNER.heading}</h2>
          <p class="talk-b ital">{BANNER.body}</p>
          <ul class="talk-pts" aria-label="Good to know">{BANNER.points.map((p) => <li>{p}</li>)}</ul>
          <div class="talk-cta"><a class="btn btn--ivory pill" href={BANNER.ctaHref}>{BANNER.cta}</a><a class="tlk tlk--lt" href={`mailto:${SITE.email}`}>Or email {SITE.email}</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑩ CINEMA BAND — the kitchen film -->
  <div class="cine cine--sage">
    <div class="wrap">
      <div class="cine-fr rv-im">
        <video data-film muted loop playsinline preload="none" poster={MEDIA.cineFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
          <source data-src={MEDIA.cineFilm.webm} type="video/webm" /><source data-src={MEDIA.cineFilm.mp4} type="video/mp4" />
        </video>
        <i class="grain" aria-hidden="true"></i>
      </div>
      <p class="cine-cap">Care, at home</p>
    </div>
  </div>

  <!-- ⑪ MAGNOLIA MOMENTS — two warm cards -->
  <section class="sec sec--tight" id="moments">
    <div class="wrap">
      <div class="sh sh--row">
        <div><p class="kick">The blog</p><h2 class="disp rv">{SECTION_LABELS.blog}</h2></div>
        <a class="tlk fade" href={SITE.links.blog}>All posts</a>
      </div>
      <div class="jr-grid" data-stag=".1">{posts.map((p) => <div class="rv"><BlogCard post={p} headingLevel="h3" /></div>)}</div>
    </div>
  </section>

  <!-- ⑫ JOIN OUR TEAM — a friendly two-column card -->
  <section class="sec sec--tight" id="careers">
    <div class="wrap">
      <div class="join card rv">
        <div class="join-l">
          <p class="caps">{CAREERS.banner}</p>
          <h2 class="disp">{CAREERS.heading}</h2>
          <p class="join-b">{CAREERS.body}</p>
        </div>
        <div class="join-r">
          <a class="join-t" href={CAREERS.apply}><span class="caps-xs">Apply online</span><strong>Complete our application here.</strong><span class="arrow-link">Start the application <span class="arr" aria-hidden="true">&rarr;</span></span></a>
          <a class="join-t" href={CAREERS.pdf} download><span class="caps-xs">Or by email</span><strong>{CAREERS.download}</strong><span class="join-m">Email the completed form to {SITE.email}.</span><span class="arrow-link">Download (PDF) <span class="arr" aria-hidden="true">&darr;</span></span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑬ FOOTER — warm, on deep green -->
  <footer class="foot">
    <div class="foot-in">
      <div class="foot-grid">
        <div class="foot-brand"><Mark /><p class="foot-name">Magnolia</p><p class="foot-sub">Healthcare</p><p>{FOOTER.tagline} &middot; {FOOTER.area}</p></div>
        <div><p class="foot-h">Explore</p><ul class="foot-nav">{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
        <div><p class="foot-h">Join</p><ul class="foot-nav"><li><a href={CAREERS.apply}>Caregiver application</a></li><li><a href={CAREERS.pdf} download>Application form (PDF)</a></li><li><a href={LOGIN.href}>{LOGIN.label}</a></li></ul></div>
        <div><p class="foot-h">Contact</p><ul class="foot-contact"><li><span class="k">Email</span><a href={`mailto:${FOOTER.email}`}>{FOOTER.email}</a></li><li><span class="k">Service area</span>{FOOTER.area}</li></ul></div>
      </div>
      <div class="foot-bar"><span>&copy; {FOOTER.legal}</span><a href={SITE.currentSite} rel="noopener">Current website &rarr;</a></div>
    </div>
  </footer>

  <ConceptBar current={3} />
</BaseLayout>

<style is:global>
  /* ---- warm re-tune of the tokens ---- */
  body.c03{--ivory:#FDFDFC;--linen:#F3F3F1;--paper:#FFFFFF;--blush:#F8F2EE;--sage-band:#EAEDE8;--sage:#B1C09D;--sage-mid:#7FA45E;--ink:#2A2F2B;--ink-soft:#5B625D;--brass:#8D6F45;
    --hair:rgba(42,47,43,.12);--hair-strong:rgba(42,47,43,.26);--gold-line:rgba(185,151,91,.5);--hdh:138px;--shadow-soft:0 30px 60px -34px rgba(42,47,43,.22);background:var(--ivory)}
  body.c03 .disp,body.c03 h1,body.c03 h2{font-weight:300}
  body.c03 .ital{font-weight:300}
  body.c03 .pill{border-radius:999px;padding-inline:2.4em}
  body.c03 .pill::after{border-radius:999px}

  /* ---- header: centred logo over the nav row; compact single row once stuck ---- */
  body.c03 .hd-slot{position:relative;height:var(--hdh)}
  body.c03 .hd{background:var(--ivory)}
  body.c03 .hd-in{flex-direction:column;align-items:stretch;gap:.9rem;padding-block:1.1rem .9rem;min-height:0;position:relative}
  body.c03 .hd-logo{justify-content:center;margin-inline:auto}
  body.c03 .hd-logo .mark{width:40px;height:40px}
  body.c03 .hd-logo .wm{align-items:center}
  body.c03 .hd-logo .wm-name{font-size:1.5rem}
  body.c03 .hd-row{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.5rem;border-top:1px solid var(--gold-line);padding-top:.75rem}
  body.c03 .hd-mail{justify-self:start;font-family:var(--utility);font-weight:600;font-size:.72rem;letter-spacing:.06em;color:var(--brass);padding:.5em 0;min-height:44px;display:inline-flex;align-items:center}
  body.c03 .hd-mail:hover{color:var(--leaf)}
  body.c03 .hd-nav a{font-size:.82rem;padding:.7em 0;min-height:44px;display:inline-flex;align-items:center}
  body.c03 .hd-tools{justify-self:end}
  body.c03 .hd-login{font-family:var(--utility);font-weight:600;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--leaf);padding:.5em 0;min-height:44px;display:inline-flex;align-items:center;transition:color .3s}
  body.c03 .hd-login:hover{color:var(--brass)}
  body.c03 .hd-cta{border-radius:999px;padding-inline:1.7em}
  body.c03 .hd-cta::after{border-radius:999px}
  body.c03 .menu-btn{display:none;position:absolute;right:0;top:50%;transform:translateY(-50%)}
  body.c03 .hd--stuck{background:rgba(251,247,240,.92)}
  body.c03 .hd--stuck .hd-in{flex-direction:row;align-items:center;justify-content:space-between;padding-block:.5rem;gap:1.5rem}
  body.c03 .hd--stuck .hd-logo{margin:0}
  body.c03 .hd--stuck .hd-logo .mark{width:30px;height:30px}
  body.c03 .hd--stuck .hd-logo .wm{align-items:flex-start}
  body.c03 .hd--stuck .hd-logo .wm-name{font-size:1.2rem}
  body.c03 .hd--stuck .hd-row{border-top:0;padding-top:0;flex:1;grid-template-columns:1fr auto}
  body.c03 .hd--stuck .hd-mail{display:none}
  body.c03 .hd--stuck .hd-nav{justify-self:end}
  @media(max-width:1023px){
    body.c03{--hdh:84px}
    body.c03 .hd-in{padding-block:.9rem;gap:0}
    body.c03 .hd-row{display:none}
    body.c03 .menu-btn{display:inline-flex}
    body.c03 .hd--stuck .hd-logo{margin-inline:auto}
    body.c03 .hd--stuck .hd-logo .wm{align-items:center}
  }
  @media(max-width:560px){body.c03 .menu-btn{font-size:0;gap:0}body.c03 .menu-btn .bars{gap:7px}}

  /* ---- shared section furniture ---- */
  body.c03 .sh{text-align:center;max-width:46em;margin:0 auto clamp(2.4rem,4.5vw,3.8rem)}
  body.c03 .sh .kick{margin-bottom:1.3rem;white-space:nowrap}
  @media(max-width:560px){body.c03 .kick--c::before,body.c03 .kick--c::after{flex:0 1 28px}}
  body.c03 .sh .disp{font-size:clamp(2.1rem,4.2vw,3.6rem)}
  body.c03 .sh-aside{display:block;margin-top:1rem;font-size:1.18rem;color:var(--ink-soft);font-variation-settings:'opsz' 48,'SOFT' 70}
  body.c03 .sh--row{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap;text-align:left;max-width:none}
  body.c03 .sh--row .kick{margin-bottom:.6rem}
  body.c03 .sh--row .kick::after{display:none}
  body.c03 .sh-link,body.c03 .sh-cta{text-align:center;margin-top:clamp(2rem,3.6vw,3rem)}
  body.c03 .sh-cta{display:flex;justify-content:center;align-items:center;gap:1.4rem 2.2rem;flex-wrap:wrap}
  body.c03 .arch{position:relative;overflow:hidden;background:var(--linen);box-shadow:var(--shadow-soft)}
  body.c03 .arch img{width:100%;height:100%;object-fit:cover}
  body.c03 .arch::after{content:"";position:absolute;inset:10px;border:1px solid rgba(251,247,240,.55);border-radius:inherit;pointer-events:none;z-index:5}
  body.c03 .ph--soft{border-radius:var(--r-lg);box-shadow:var(--shadow-soft)}

  /* ---- hero ---- */
  body.c03 .hero{padding:clamp(2rem,5vw,4.5rem) 0 clamp(3rem,6vw,5.5rem);overflow:hidden}
  body.c03 .hero-g{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);column-gap:clamp(2.4rem,6vw,6rem);align-items:center}
  body.c03 .hero-sub{display:block;margin-bottom:clamp(1.2rem,2.2vw,1.8rem)}
  body.c03 .hero-sub b{color:var(--sage-mid)}
  body.c03 .hero-h{font-family:var(--display);font-weight:400;font-size:clamp(2.7rem,5.4vw,4.9rem);line-height:1.02;letter-spacing:-.012em;color:var(--ink);margin:0;font-variation-settings:'opsz' 144,'SOFT' 70;text-wrap:balance}
  body.c03 .hero-h .ital{color:var(--moss);font-variation-settings:'opsz' 144,'SOFT' 100}
  body.c03 .hero-aside{display:block;margin:clamp(1.2rem,2vw,1.6rem) 0 0;font-size:clamp(1.15rem,1.6vw,1.4rem);color:var(--ink-soft);font-variation-settings:'opsz' 48,'SOFT' 70}
  body.c03 .hero-cta{display:flex;gap:.9rem 1rem;flex-wrap:wrap;margin-top:clamp(1.8rem,3vw,2.6rem)}
  body.c03 .hero-fig{margin:0;position:relative;padding:0 0 clamp(2.6rem,5vw,3.6rem) clamp(1.4rem,4vw,3rem)}
  body.c03 .arch--team{aspect-ratio:13/9;border-radius:50% 50% var(--r-lg) var(--r-lg)/27% 27% var(--r-lg) var(--r-lg)}
  body.c03 .pola{position:absolute;left:0;bottom:0;width:clamp(150px,34%,220px);background:var(--paper);padding:8px 8px 10px;border-radius:var(--r);box-shadow:0 26px 50px -24px rgba(21,46,39,.45),0 0 0 1px var(--hair);transform:rotate(-3deg)}
  body.c03 .pola-fr{aspect-ratio:4/3;overflow:hidden;border-radius:var(--r-sm);background:var(--sage-band)}
  body.c03 .pola-fr video{width:100%;height:100%;object-fit:cover}
