---
/** CONCEPT 05 · IMMERSIVE STORYTELLING — the homepage as a scroll-driven narrative: a day
 *  of care in four chapters. The corridor film is pinned under the page and the chapters
 *  slide over it as light cards whose top edge is Magnolia's own curved sage band; the
 *  kitchen film is pinned a second time under the "Begin" resolution. Palette is the
 *  founder's own: white / pale grey / pale sage canvases, charcoal type, gold hairlines,
 *  the deep forest green once — on the consultation banner. Every string is verbatim
 *  from src/lib/magnolia-content.ts; every motion's base state is the finished page. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';
import Plate from '../../components/Plate.astro';
import BlogCard from '../../components/BlogCard.astro';
import ConceptBar from '../../components/preview/ConceptBar.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../lib/blog';
import { NAV, LOGIN, HERO, MISSION, SECTION_LABELS, BANNER, CAREERS, FOUNDER, FOOTER, MEDIA, SITE, TESTIMONIALS, TBC } from '../../lib/magnolia-content';

const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const posts = (await getPublishedPosts()).slice(0, 2);
const supplied = new Set<string>(Object.values(MEDIA.plates));
const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi'];
const chapters = [
  { id: 'mission', label: 'Mission' },
  { id: 'care', label: 'Care' },
  { id: 'people', label: 'People' },
  { id: 'begin', label: 'Begin' },
];
const year = new Date().getUTCFullYear();
---
<BaseLayout title="Concept 05 · Immersive Storytelling" description="A scroll-driven narrative: a pinned hero the chapters slide over, the mission unfolding line by line, care as a sequence." path="/preview/05" bodyClass="preview c05" chrome={false}>

  <!-- ===== HEADER (own) · light over the film, white bar once a chapter covers it ===== -->
  <div class="c5-prog" id="c5Prog" aria-hidden="true"></div>
  <header class="c5-hd" id="c5Head" data-tone="film">
    <div class="c5-hd-in">
      <a class="hd-logo c5-logo" href="/" aria-label={`${SITE.name} — home`}>
        <Mark />
        <span class="wm" aria-hidden="true"><span class="wm-name">Magnolia</span><span class="wm-sub">Healthcare</span></span>
      </a>
      <div class="c5-hd-tools">
        <a class="c5-pill" href={HERO.ctaHref}>{HERO.cta}</a>
        <button class="c5-menu-btn" id="menuOpen" type="button" aria-expanded="false" aria-controls="menu"><span class="c5-menu-w">Menu</span><span class="bars" aria-hidden="true"><i></i><i></i></span></button>
      </div>
    </div>
  </header>
  <nav class="menu" id="menu" aria-label="Main menu" aria-hidden="true" inert>
    <div class="menu-top">
      <a class="hd-logo" href="/" aria-label={`${SITE.name} — home`} tabindex="-1"><Mark /><span class="wm" aria-hidden="true"><span class="wm-name">Magnolia</span><span class="wm-sub">Healthcare</span></span></a>
      <button class="menu-close" id="menuClose" type="button">Close <span class="x" aria-hidden="true">&times;</span></button>
    </div>
    <div class="menu-body">
      <ul class="menu-list">
        {NAV.map((n, i) => <li><a href={n.href} aria-current={n.href === '/' ? 'page' : undefined}><span class="mrn">{roman[i]}.</span><span class="mlb">{n.label}</span></a></li>)}
      </ul>
      <div class="menu-sub">
        <a href={LOGIN.href}>{LOGIN.label}</a>
        <a href={CAREERS.apply}>Caregiver application</a>
        <a href={`mailto:${FOOTER.email}`}>{FOOTER.email}</a>
      </div>
      <div class="menu-cta"><a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a></div>
    </div>
    <div class="menu-foot"><span>{FOOTER.legal}</span><span>{HERO.sub} &middot; {FOOTER.area}</span></div>
  </nav>

  <!-- chapter rail (desktop) -->
  <nav class="c5-rail" id="c5Rail" aria-label="Chapters">
    {chapters.map((c, i) => <a href={`#${c.id}`} data-rail={c.id}><i aria-hidden="true"></i><span><b>{roman[i]}.</b> {c.label}</span></a>)}
  </nav>

  <!-- ===== HERO · the corridor film, pinned under the page ===== -->
  <section class="c5-hero" id="c5Hero" data-pin data-chapter="hero" data-tone="film" aria-label="Magnolia Healthcare — home care agency">
    <div class="c5-hero-media" aria-hidden="true">
      <video id="c5Film" muted loop playsinline preload="none" poster={MEDIA.heroFilm.poster} disablepictureinpicture tabindex="-1">
        <source data-src={MEDIA.heroFilm.webm} type="video/webm" />
        <source data-src={MEDIA.heroFilm.mp4} type="video/mp4" />
      </video>
    </div>
    <div class="c5-scrim" aria-hidden="true"></div>
    <div class="c5-hero-c">
      <p class="c5-hero-k a1"><span class="c5-hk-l">{FOOTER.legal} <b>&middot;</b> </span>{HERO.area}</p>
      <h1 class="c5-h1">
        <span class="lo"><span class="li">Because</span></span>
        <span class="lo"><span class="li">every life</span></span>
        <span class="lo"><span class="li ital">matters</span></span>
      </h1>
      <p class="c5-hero-sub a3">{HERO.sub}</p>
      <div class="c5-hero-cta a4"><a class="btn btn--ivory" href={HERO.ctaHref}>{HERO.cta}</a></div>
    </div>
    <div class="c5-cue a4" aria-hidden="true"><span>A day of care</span><i></i></div>
  </section>

  <!-- ===== CHAPTER I · MISSION · slides over the film ===== -->
  <section class="c5-ch" id="mission" data-chapter="mission" data-tone="light">
    <div class="wrap">
      <header class="c5-chh">
        <p class="c5-chn rv">Chapter i <i></i> <span>{MISSION.heading}</span></p>
        <p class="kick rv" style="--d:.06s">{MISSION.eyebrow}</p>
      </header>
      <div class="c5-mis">
        <div class="c5-mis-t">
          <h2 class="disp c5-mis-h rv">{MISSION.heading}</h2>
          {MISSION.sentences.map((s, i) => <p class={`c5-mis-s rv${i === 0 ? ' c5-mis-s--lead' : ''}`} style={`--d:${(0.1 + i * 0.12).toFixed(2)}s`}>{s}</p>)}
          <ul class="c5-vals fade" style="--d:.5s" aria-label="Our values">
            {MISSION.values.map((v, i) => <li><b>{roman[i]}.</b> {v}</li>)}
          </ul>
        </div>
        <figure class="c5-mis-f">
          <div class="ph ph--framed rv-im" style="--d:.2s"><Plate id={MEDIA.plates.hug} alt="A caregiver embracing an older woman in her kitchen" class="lv lv--rise" sizes="(max-width:899px) 90vw, 520px" widths={[480, 624]} /><i class="grain" aria-hidden="true"></i></div>
          <figcaption class="fade" style="--d:.3s">Seeing the person beyond their needs</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== CHAPTER II · CARE · the six kinds of care as a sequence, then how we help ===== -->
  <section class="c5-ch c5-ch--sage" id="care" data-chapter="care" data-tone="light">
    <div class="wrap">
      <header class="c5-chh c5-chh--row">
        <div>
          <p class="c5-chn rv">Chapter ii <i></i> <span>{SECTION_LABELS.why}</span></p>
          <h2 class="disp rv" style="--d:.06s">{SECTION_LABELS.specialized}</h2>
        </div>
        <p class="ital c5-chh-line rv" style="--d:.12s">Six kinds of specialized support, each shaped around the person and delivered at home.</p>
      </header>
    </div>
    <div class="c5-seq">
      <ul class="c5-trk" id="c5Trk" tabindex="0" aria-label="Specialized care — six panels, scroll sideways">
        {specialized.map((s, i) => (
          <li class="c5-pn" data-i={i}>
            {supplied.has(s.data.plate) ? (
              <div class="ph c5-pn-ph"><Plate id={s.data.plate} alt="" sizes="(max-width:599px) 86vw, 400px" widths={[448, 640]} /></div>
            ) : (
              <div class="c5-pn-ab" aria-hidden="true"><Mark /><span>{s.data.numeral}</span></div>
            )}
            <div class="c5-pn-b">
              <span class="caps-xs">No. {s.data.numeral}</span>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              <a class="arrow-link" href={`/services#${s.id}`}>Learn more <span class="arr" aria-hidden="true">&rarr;</span></a>
            </div>
          </li>
        ))}
      </ul>
      <div class="c5-ctl">
        <div class="c5-dots" role="group" aria-label="Go to panel">
          {specialized.map((s, i) => <button type="button" class="c5-dot" data-go={i} aria-label={`Panel ${i + 1} of ${specialized.length}: ${s.data.title}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>)}
        </div>
        <div class="c5-arrows">
          <button type="button" class="c5-arr" id="c5Prev" aria-label="Previous panel">&larr;</button>
          <button type="button" class="c5-arr" id="c5Next" aria-label="Next panel">&rarr;</button>
        </div>
      </div>
    </div>
    <div class="wrap c5-how">
      <div class="c5-how-l rv">
        <p class="c5-chn">{SECTION_LABELS.how}</p>
        <h2 class="disp c5-how-h">Around every person, a team.</h2>
        <a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a>
      </div>
      <ol class="c5-rows" data-stag=".12">
        {support.map((s) => <li class="fade"><span class="c5-row-n">{s.data.numeral}</span><div><h3>{s.data.title}</h3><p>{s.data.summary}</p></div></li>)}
      </ol>
    </div>
  </section>

  <!-- ===== CHAPTER III · PEOPLE · voices, the founder, the team ===== -->
  <section class="c5-ch" id="people" data-chapter="people" data-tone="light">
    <div class="wrap">
      <header class="c5-chh">
        <p class="c5-chn rv">Chapter iii <i></i> <span>{SECTION_LABELS.voices}</span></p>
        <h2 class="disp rv" style="--d:.06s">In their own words.</h2>
      </header>
      <div class="c5-qs" data-stag=".22">
        {TESTIMONIALS.map((t) => (
          <figure class="c5-q fade">
            <span class="c5-q-m" aria-hidden="true">&ldquo;</span>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption><span class="caps-xs">{t.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="c5-q-note fade">Client words as published on Magnolia&rsquo;s current website.</p>
    </div>
    <div class="c5-found" data-plx-host>
      <div class="wrap c5-found-in">
        <div class="c5-team rv-im">
          <Plate id={MEDIA.plates.team5} alt="The Magnolia Healthcare team of five in front of the Magnolia sign; the founder, in white, at the centre" class="plx" data-plx=".07" sizes="(max-width:899px) 90vw, 820px" widths={[480, 652]} />
          <i class="grain" aria-hidden="true"></i>
        </div>
        <figure class="c5-fdr fade" style="--d:.25s">
          <div class="ph ph--framed"><Plate id={FOUNDER.plate} alt="Portrait crop of the founder" sizes="200px" widths={[320, 560]} /></div>
          <figcaption><span class="caps-xs">{FOUNDER.label} &middot; {TBC}</span><em>{FOUNDER.note}</em></figcaption>
        </figure>
        <p class="c5-found-cap fade" style="--d:.3s">The Magnolia team &middot; {HERO.area}</p>
      </div>
    </div>
  </section>

  <!-- the kitchen film · pinned a second time, the resolution slides over it -->
  <div class="c5-band" data-pin data-chapter="people" data-tone="film" role="presentation">
    <video data-film muted loop playsinline preload="none" poster={MEDIA.cineFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
      <source data-src={MEDIA.cineFilm.webm} type="video/webm" />
      <source data-src={MEDIA.cineFilm.mp4} type="video/mp4" />
    </video>
    <i class="grain" aria-hidden="true"></i>
    <p class="c5-band-cap">Care, at home</p>
  </div>

  <!-- ===== CHAPTER IV · BEGIN · the resolution: her deep-green banner, once ===== -->
  <section class="c5-ch c5-ch--dk" id="begin" data-chapter="begin" data-tone="dark">
    <div class="wrap-text c5-beg">
      <p class="c5-chn rv">Chapter iv <i></i> <span>{BANNER.eyebrow}</span></p>
      <h2 class="c5-beg-h rv" style="--d:.06s">{BANNER.heading}</h2>
      <p class="c5-beg-b fade" style="--d:.12s">{BANNER.body}</p>
      <ul class="c5-pts fade" style="--d:.18s">{BANNER.points.map((p) => <li>{p}</li>)}</ul>
      <div class="c5-beg-cta fade" style="--d:.24s">
        <a class="btn btn--ivory" href={BANNER.ctaHref}>{BANNER.cta}</a>
        <a class="tlk tlk--lt" href={`mailto:${FOOTER.email}`}>Or email {FOOTER.email}</a>
      </div>
    </div>
  </section>
  <div class="c5-ch c5-ch--after" data-chapter="begin" data-tone="light">
    {posts.length > 0 && (
      <section class="wrap c5-mom" aria-labelledby="c5MomH">
        <header class="c5-chh c5-chh--row">
          <div><p class="caps rv">The blog</p><h2 class="disp rv" id="c5MomH" style="--d:.06s">{SECTION_LABELS.blog}</h2></div>
          <a class="tlk fade" href={SITE.links.blog}>All posts</a>
        </header>
        <div class="c5-mom-g" data-stag=".1">{posts.map((p) => <div class="rv"><BlogCard post={p} headingLevel="h3" /></div>)}</div>
      </section>
    )}
    <section class="c5-join" aria-labelledby="c5JoinH">
      <div class="wrap c5-join-in">
        <div class="c5-join-t">
          <p class="caps rv">{CAREERS.banner}</p>
          <h2 class="disp rv" id="c5JoinH" style="--d:.06s">{CAREERS.heading}</h2>
          <p class="fade" style="--d:.12s">{CAREERS.body}</p>
          <div class="c5-join-a fade" style="--d:.18s">
            <a class="btn btn--line" href={CAREERS.apply}>Apply online</a>
            <a class="tlk" href={CAREERS.pdf} download>{CAREERS.download}</a>
          </div>
        </div>
        <div class="ph ph--framed c5-join-ph rv-im"><Plate id={MEDIA.plates.team4} alt="Four Magnolia caregivers in scrubs" class="lv lv--breathe" sizes="(max-width:899px) 70vw, 380px" widths={[480, 640]} /></div>
      </div>
    </section>
  </div>

  <!-- ===== FOOTER (own) · light, compact ===== -->
  <footer class="c5-foot">
    <div class="wrap c5-foot-in">
      <div class="c5-foot-brand">
        <a class="hd-logo" href="/" aria-label={`${SITE.name} — home`}><Mark /><span class="wm" aria-hidden="true"><span class="wm-name">Magnolia</span><span class="wm-sub">Healthcare</span></span></a>
        <p class="ital">{HERO.headline}.</p>
      </div>
      <nav aria-label="Footer">
        <p class="c5-foot-h">Explore</p>
        <ul class="c5-foot-nav">
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={CAREERS.apply}>Caregiver application</a></li>
          <li><a href={LOGIN.href}>{LOGIN.label}</a></li>
        </ul>
      </nav>
      <div>
        <p class="c5-foot-h">Contact</p>
        <ul class="c5-foot-ct">
          <li><span>Email</span><a href={`mailto:${FOOTER.email}`}>{FOOTER.email}</a></li>
          <li><span>Service area</span>{FOOTER.area}</li>
          <li><span>Phone</span><em>{TBC}</em></li>
        </ul>
      </div>
    </div>
    <div class="wrap c5-foot-bar">
      <span>&copy; {year} {FOOTER.legal}</span>
      <span>{FOOTER.tagline} &middot; {FOOTER.area}</span>
      <a href={SITE.currentSite} target="_blank" rel="noopener noreferrer">Current website</a>
    </div>
  </footer>

  <ConceptBar current={5} />
</BaseLayout>

<style is:global>
  /* ---- the founder's palette · white / pale grey / pale sage, charcoal type, gold hairlines, deep green once ---- */
  body.c05{--ivory:#FDFDFC;--linen:#F3F3F1;--paper:#FFFFFF;--sage-band:#EAEDE8;--sage:#B1C09D;--moss:#7FA45E;--leaf:#122E1F;--leaf-2:#1B3D2B;--leaf-deep:#0C2016;
    --ink:#2A2F2B;--ink-soft:#5B625D;--brass:#9A7B4F;--gold-lt:#D9C39A;--hair:rgba(154,123,79,.28);--hair-strong:rgba(154,123,79,.5);
    --pad:clamp(72px,10vw,128px);--gut:max(20px,calc((100vw - var(--wrap)) / 2));background:var(--ivory);color:var(--ink-soft)}
  body.c05 main{position:relative}
  /* the full-screen menu, re-voiced pale sage so the page never goes dark */
  body.c05 .menu{background:var(--sage-band);color:var(--ink)}
  body.c05 .menu-top .hd-logo,body.c05 .menu-top .hd-logo .wm-name{color:var(--ink)}
  body.c05 .menu-top .hd-logo .wm-sub,body.c05 .menu-list .mrn,body.c05 .menu-sub a,body.c05 .menu-foot{color:var(--brass)}
  body.c05 .menu-list .mlb{color:var(--ink);font-weight:300}
  body.c05 .menu-list a{border-bottom-color:var(--hair)}
  body.c05 .menu-list li:first-child a{border-top-color:var(--hair)}
  body.c05 .menu-list a:hover .mlb,body.c05 .menu-list a:focus-visible .mlb,body.c05 .menu-sub a:hover,body.c05 .menu-sub a:focus-visible{color:var(--leaf)}
  body.c05 .menu-close,body.c05 .menu-close .x{color:var(--ink)}
  body.c05 .menu-foot{border-top-color:var(--hair)}
  body.c05 .bcard-title{font-weight:300}
</style>

<style>
  /* ===== header ===== */
  .c5-prog{position:fixed;top:0;left:0;right:0;height:3px;z-index:72;background:var(--moss);transform:scaleX(0);transform-origin:left;pointer-events:none;display:none}
  .c5-hd{position:fixed;top:0;left:0;right:0;z-index:70;color:var(--ivory);transition:background .45s var(--ease),box-shadow .45s var(--ease)}
  .c5-hd-in{width:var(--wrap);margin-inline:auto;display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:72px;padding-block:.6rem}
  .c5-hd .hd-logo,.c5-hd .hd-logo .wm-name{color:currentColor;transition:color .4s}
  .c5-hd .hd-logo .wm-sub{color:var(--gold-lt);transition:color .4s}
  .c5-hd-tools{display:flex;align-items:center;gap:clamp(.6rem,1.6vw,1.4rem)}
  .c5-pill{display:inline-flex;align-items:center;min-height:40px;padding:0 1.15em;border-radius:999px;border:1px solid rgba(253,253,252,.7);background:rgba(253,253,252,.14);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
    font-family:var(--utility);font-weight:600;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;color:var(--ivory);transition:background .35s,color .35s,border-color .35s}
  .c5-pill:hover,.c5-pill:focus-visible{background:var(--ivory);color:var(--leaf)}
  .c5-menu-btn{display:inline-flex;align-items:center;gap:.7rem;min-height:44px;min-width:44px;padding:0 .2rem;background:none;border:0;cursor:pointer;color:currentColor;
    font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase}
  .c5-menu-btn .bars{display:inline-flex;flex-direction:column;gap:6px}
  .c5-menu-btn .bars i{display:block;width:24px;height:1.5px;background:currentColor;transition:transform .4s var(--ease)}
  .c5-menu-btn:hover .bars i:first-child{transform:translateY(-2px)}
  .c5-menu-btn:hover .bars i:last-child{transform:translateY(2px)}
  /* once a light chapter covers the film: white bar, charcoal type, solid pill */
  .c5-hd[data-tone="light"]{color:var(--ink);background:rgba(253,253,252,.9);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 1px 0 var(--hair)}
  .c5-hd[data-tone="light"] .hd-logo .wm-sub{color:var(--brass)}
  .c5-hd[data-tone="light"] .c5-pill{background:var(--leaf);border-color:var(--leaf);color:var(--ivory)}
  .c5-hd[data-tone="light"] .c5-pill:hover,.c5-hd[data-tone="light"] .c5-pill:focus-visible{background:var(--leaf-2)}
  .c5-hd[data-tone="dark"]{color:var(--ivory);background:rgba(12,32,22,.6);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
  @media(max-width:599px){.c5-hd-in{min-height:64px}.c5-hd .hd-logo .wm-sub{display:none}.c5-hd .hd-logo .wm-name{font-size:1.1rem}.c5-hd .hd-logo .mark{width:28px;height:28px}
    .c5-pill{font-size:.54rem;padding:0 .9em;min-height:36px;letter-spacing:.12em}.c5-menu-w{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.c5-hk-l{display:none}}

  /* ===== chapter rail (desktop) ===== */
  .c5-rail{position:fixed;left:clamp(14px,2vw,28px);top:50%;transform:translateY(-50%);z-index:60;display:none;flex-direction:column;gap:14px;color:var(--ink)}
  .c5-rail[data-tone="film"],.c5-rail[data-tone="dark"]{color:var(--ivory)}
  .c5-rail a{display:flex;align-items:center;gap:.8rem;min-height:30px;color:inherit;font-family:var(--utility);font-weight:600;font-size:.58rem;letter-spacing:.2em;text-transform:uppercase}
  .c5-rail a i{display:block;width:8px;height:8px;border-radius:50%;border:1px solid currentColor;transition:transform .35s var(--ease),background .35s}
  .c5-rail a span{opacity:0;transform:translateX(-6px);transition:opacity .35s,transform .45s var(--ease);padding:.5em .8em .45em;border-radius:999px;background:rgba(253,253,252,.86);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  .c5-rail[data-tone="film"] a span,.c5-rail[data-tone="dark"] a span{background:rgba(42,47,43,.55)}
  .c5-rail a span b{font-family:var(--display);font-style:italic;font-weight:400;font-size:.8rem;letter-spacing:0;text-transform:none;margin-right:.2em}
  .c5-rail a:hover span,.c5-rail a:focus-visible span,.c5-rail a[aria-current="true"] span{opacity:1;transform:none}
  .c5-rail a[aria-current="true"] i{background:currentColor;transform:scale(1.35)}
