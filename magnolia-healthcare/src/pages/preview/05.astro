<script>
  // ---- the pinned films: promote the hero immediately; pause either film once a chapter covers it ----
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const hero = document.getElementById('c5Hero');
  const film = document.getElementById('c5Film') as HTMLVideoElement | null;
  if (film) {
    if (reduced || saveData) film.querySelectorAll('source').forEach((s) => s.remove());
    else setTimeout(() => { film.querySelectorAll('source').forEach((s) => { const src = (s as HTMLSourceElement).dataset.src; if (src) (s as HTMLSourceElement).src = src; }); film.load(); film.play().catch(() => {}); }, 500);
  }
  const pins = Array.from(document.querySelectorAll<HTMLElement>('[data-pin]'));
  const prog = document.getElementById('c5Prog');
  let ticking = false;
  const frame = () => {
    ticking = false;
    const y = scrollY;
    if (prog) { const max = document.documentElement.scrollHeight - innerHeight; prog.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`; }
    if (reduced) return;
    pins.forEach((pin) => {
      const next = pin.nextElementSibling as HTMLElement | null;
      const covered = !!next && next.getBoundingClientRect().top <= 0;
      if (pin.classList.contains('is-covered') === covered) return;
      pin.classList.toggle('is-covered', covered);
      const v = pin.querySelector('video');
      if (v) { if (covered) v.pause(); else v.play().catch(() => {}); }
    });
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
  addEventListener('resize', frame);
  frame();

  // ---- chapter rail + header tone: whichever chapter crosses the upper-middle of the viewport is current ----
  const head = document.getElementById('c5Head');
  const rail = document.getElementById('c5Rail');
  const setCurrent = (el: HTMLElement) => {
    const tone = el.dataset.tone ?? 'light';
    if (head) head.dataset.tone = tone;
    if (rail) { rail.dataset.tone = tone; rail.querySelectorAll<HTMLElement>('[data-rail]').forEach((a) => { if (a.dataset.rail === el.dataset.chapter) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); }); }
  };
  const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
  if ('IntersectionObserver' in window) {
    const cio = new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) setCurrent(e.target as HTMLElement); }); }, { rootMargin: '-12% 0px -82% 0px', threshold: 0 });
    marks.forEach((m) => cio.observe(m));
  } else if (hero) setCurrent(hero);

  // ---- the care sequence: prev / next / dots over a native scroll-snap track ----
  const trk = document.getElementById('c5Trk');
  if (trk) {
    const panels = Array.from(trk.children) as HTMLElement[];
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.c5-dot'));
    const prev = document.getElementById('c5Prev') as HTMLButtonElement | null;
    const next = document.getElementById('c5Next') as HTMLButtonElement | null;
    const pad = () => parseFloat(getComputedStyle(trk).paddingLeft) || 0;
    let cur = 0;
    const paint = () => {
      dots.forEach((d, i) => { if (i === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
      if (prev) prev.disabled = cur === 0;
      if (next) next.disabled = cur === panels.length - 1;
    };
    const go = (n: number) => {
      cur = Math.max(0, Math.min(panels.length - 1, n));
      trk.scrollTo({ left: panels[cur].offsetLeft - pad(), behavior: reduced ? 'auto' : 'smooth' });
      paint();
    };
    prev?.addEventListener('click', () => go(cur - 1));
    next?.addEventListener('click', () => go(cur + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(parseInt(d.dataset.go ?? '0', 10))));
    let t: ReturnType<typeof setTimeout> | undefined;
    trk.addEventListener('scroll', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        const x = trk.scrollLeft + pad();
        let best = 0, dist = Infinity;
        panels.forEach((p, i) => { const d = Math.abs(p.offsetLeft - x); if (d < dist) { dist = d; best = i; } });
        if (best !== cur) { cur = best; paint(); }
      }, 80);
    }, { passive: true });
    paint();
  }
</script>
