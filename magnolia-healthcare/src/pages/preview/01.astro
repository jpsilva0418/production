---
/** CONCEPT 01 — the founder's chosen direction (src/pages/index.astro), finished properly.
 *  Same composition and visual language: Prologue veil hero over the corridor film, deep
 *  muted leaf-green atmosphere, warm cream serif, blush italic accent, spacious editorial
 *  chapters. Completed against docs/03-preservation-map.md: "Why choose us?" above
 *  Specialized care, a founder treatment (framed 4:5 portrait beside the five-person team
 *  photograph, no name), a quiet gallery of the supplied stills, and a Join our team teaser.
 *  Order: hero → Chapter i · mission (team photo + values) → Why choose us? → Specialized
 *  care → cinema band → Chapter ii · How we help → What our clients say → Chapter iii ·
 *  the people (founder + team) → gallery → finale banner → Magnolia Moments → Join our
 *  team → footer. Every word is the site's own (src/lib/magnolia-content.ts). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/preview/c01/Hero.astro';
import Plate from '../../components/Plate.astro';
import BlogCard from '../../components/BlogCard.astro';
import ConceptBar from '../../components/preview/ConceptBar.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../lib/blog';
import { HERO, MISSION, SECTION_LABELS, BANNER, CAREERS, FOUNDER, MEDIA, SITE, TESTIMONIALS, TBC } from '../../lib/magnolia-content';

const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const posts = (await getPublishedPosts()).slice(0, 2);
const numerals = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.'];
const [m1, m2, m3, m4] = MISSION.sentences;
const values = [
  { t: MISSION.values[0], d: 'Seeing the person beyond their needs.' },
  { t: MISSION.values[1], d: 'Delivering exceptional care and maintaining the highest standards.' },
  { t: MISSION.values[2], d: 'Warmth, dignity, and genuine human connection in every home.' },
];
---
<BaseLayout headerLight headerPrologue title="Concept 01 · Cinematic Luxury Care" description="Design review concept 01 — the approved home-page direction, finished properly." path="/preview/01" bodyClass="preview c01">

  <!-- ① PROLOGUE · veil → corridor film, the founder's copy -->
  <Hero />

  <!-- ② CHAPTER I · OUR MISSION (verbatim) + the team + the values triplet -->
  <section class="sec lit" id="mission">
    <i class="lx-shaft" aria-hidden="true"></i>
    <div class="wrap chap">
      <div class="chap-l rv">
        <p class="chap-rn">Chapter i.</p>
        <h2 class="disp chap-t">Our <span class="ital">mission.</span></h2>
        <p class="chap-line">{MISSION.eyebrow}.</p>
        <a class="tlk" href={SITE.links.mission}>Read our mission</a>
      </div>
      <div class="fam-r">
        <div class="fam-copy">
          <p class="lede rv">{m1}</p>
          <div class="fam-body rv" style="--d:.1s"><p>{m2} {m3}</p><p>{m4}</p></div>
          <ul class="values" data-stag=".08">
            {values.map((v, i) => <li class="fade"><span class="v-n">{numerals[i]}</span><span class="v-t">{v.t}</span><span class="v-d">{v.d}</span></li>)}
          </ul>
        </div>
        <figure class="fam-fig">
          <div class="ph ph--framed rv-im"><Plate id={MEDIA.plates.team4} alt="Four Magnolia Healthcare caregivers in scrubs" class="lv lv--rise" sizes="(max-width:899px) 90vw, 520px" widths={[480, 640]} /><i class="grain" aria-hidden="true"></i></div>
          <figcaption class="fade" style="--d:.2s">The Magnolia team &middot; supplied photograph</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="chapslate chapslate--linen fade" role="presentation"><span class="cs-t">{SECTION_LABELS.why}</span></div>

  <!-- ③ SPECIALIZED CARE · the six cards of the current site -->
  <section class="sec sec--linen ghostwrap" id="services">
    <span class="ghost-w" aria-hidden="true">care</span>
    <div class="wrap" style="position:relative;z-index:1">
      <div class="svc-head">
        <div>
          <p class="kick">{SECTION_LABELS.specialized}</p>
          <h2 class="disp rv">Care shaped around<br />the person.</h2>
        </div>
        <p class="ital svc-head-line rv" style="--d:.1s">Six kinds of specialized support, each delivered at home with compassion, excellence, and respect.</p>
      </div>
      <div class="svc-grid" data-stag=".08">
        {specialized.map((s) => (
          <a class="svc card rv" href={`/services#${s.id}`} aria-label={`${s.data.title} — learn about this care`}>
            <div class="ph svc-ph"><Plate id={s.data.plate} alt="" sizes="(max-width:599px) 92vw, (max-width:1023px) 46vw, 400px" widths={[400, 640, 900]} /></div>
            <div class="svc-body">
              <span class="caps-xs">No. {s.data.numeral}</span>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              <span class="arrow-link">Learn more <span class="arr" aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
      <div class="svc-cta fade">
        <a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a>
        <a class="tlk" href={SITE.links.services}>All of our care, in detail</a>
      </div>
    </div>
  </section>

  <!-- ④ CINEMA BAND · the kitchen film -->
  <div class="cine">
    <div class="wrap">
      <div class="cine-fr rv-im">
        <video data-film muted loop playsinline preload="none" poster={MEDIA.cineFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
          <source data-src={MEDIA.cineFilm.webm} type="video/webm" />
          <source data-src={MEDIA.cineFilm.mp4} type="video/mp4" />
        </video>
        <i class="grain" aria-hidden="true"></i><i class="lx-warm" aria-hidden="true"></i>
      </div>
      <p class="cine-cap">Care, at home &mdash; {HERO.area}</p>
    </div>
  </div>

  <!-- ⑤ CHAPTER II · HOW WE HELP (the four cards of the current site) -->
  <section class="sec sec--dk lit" id="how">
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="wrap chap" style="position:relative;z-index:1">
      <div class="chap-l rv">
        <p class="chap-rn">Chapter ii.</p>
        <h2 class="disp chap-t">How we<br />help.</h2>
        <p class="chap-line">Reliable support and compassionate care, around the clock.</p>
        <a class="tlk tlk--lt" href={SITE.links.services}>Our services</a>
      </div>
      <div>
        <p class="why-quote rv">&ldquo;Warmth, dignity, and genuine human connection in every home.&rdquo;</p>
        <ul class="ledger" data-stag=".08">
          {support.map((s, i) => (
            <li class="fade"><span class="l-n">{numerals[i]}</span><div><span class="l-t">{s.data.title}</span><span class="l-d">{s.data.summary}</span></div></li>
          ))}
        </ul>
        <div class="why-cta fade">
          <a class="btn btn--ivory" href={HERO.ctaHref}>{HERO.cta}</a>
          <a class="tlk tlk--lt" href={`mailto:${SITE.email}`}>Or email {SITE.email}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="chapslate fade" role="presentation"><span class="cs-t">{SECTION_LABELS.voices}</span></div>

  <!-- ⑥ TESTIMONIALS · the current site's carousel as a quiet triptych -->
  <section class="sec sec--tight" id="voices">
    <div class="wrap">
      <div class="tst-grid" data-stag=".1">
        {TESTIMONIALS.map((t) => (
          <figure class="tst card rv">
            <span class="tst-q" aria-hidden="true">&ldquo;</span>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption><span class="caps-xs">{t.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="tst-note fade">Client words as published on Magnolia&rsquo;s current website.</p>
    </div>
  </section>

  <!-- ⑦ CHAPTER III · THE PEOPLE — founder portrait (no name) beside the five-person team photograph -->
  <section class="sec sec--blush lit" id="founder">
    <i class="lx-shaft" aria-hidden="true"></i>
    <div class="wrap chap" style="position:relative;z-index:1">
      <div class="chap-l rv">
        <p class="chap-rn">Chapter iii.</p>
        <h2 class="disp chap-t">The people<br />behind <span class="ital">the care.</span></h2>
        <p class="chap-line">Thoughtfully selected, trained, and committed to every home.</p>
        <a class="tlk" href={SITE.links.careers}>{SECTION_LABELS.team}</a>
      </div>
      <div class="fd" data-plx-host>
        <figure class="fd-port plx" data-plx="0.04">
          <div class="ph ph--framed rv-im"><Plate id={FOUNDER.plate} alt="The founder of Magnolia Healthcare" class="lv lv--rise" sizes="(max-width:899px) 80vw, 360px" widths={[420, 560]} /><i class="grain" aria-hidden="true"></i></div>
          <figcaption class="fade"><span class="fd-k">{FOUNDER.label}</span><span class="fd-tbc">{TBC}</span></figcaption>
        </figure>
        <div class="fd-side">
          <p class="fd-note rv">{FOUNDER.note}</p>
          <figure class="fd-team plx" data-plx="-0.03">
            <div class="ph rv-im" style="--d:.12s"><Plate id={MEDIA.plates.team5} alt="The Magnolia Healthcare team in front of the Magnolia sign — the founder in white at the centre" class="lv lv--breathe" sizes="(max-width:899px) 90vw, 560px" widths={[480, 652]} /><i class="grain" aria-hidden="true"></i></div>
            <figcaption class="fade" style="--d:.16s">The Magnolia team &middot; supplied photograph</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑧ GALLERY · a quiet moment of the supplied stills, living -->
  <section class="sec sec--tight gal" aria-label="Moments of care — supplied photographs">
    <div class="wrap">
      <p class="kick kick--c">At home with Magnolia</p>
      <div class="gal-grid" data-plx-host data-stag=".12">
        <figure class="gal-a plx rv-im" data-plx="0.03"><div class="ph"><Plate id={MEDIA.plates.hug} alt="A caregiver embracing an older woman in her kitchen" class="lv" sizes="(max-width:899px) 90vw, 620px" widths={[480, 624]} /><i class="grain" aria-hidden="true"></i></div><figcaption>Companionship</figcaption></figure>
        <figure class="gal-b plx rv-im" data-plx="-0.04"><div class="ph"><Plate id={MEDIA.plates.window} alt="A caregiver pointing out of a window beside an older woman" class="lv lv--rise" sizes="(max-width:899px) 60vw, 420px" widths={[400, 602]} /><i class="grain" aria-hidden="true"></i></div><figcaption>Personal care</figcaption></figure>
        <figure class="gal-c plx rv-im" data-plx="0.06"><div class="ph"><Plate id={MEDIA.plates.couple} alt="A caregiver with an older couple" class="lv lv--breathe" sizes="(max-width:899px) 46vw, 280px" widths={[300, 448]} /><i class="grain" aria-hidden="true"></i></div><figcaption>Geriatric care</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- ⑨ FINALE · the consultation banner -->
  <section class="finale lit" aria-labelledby="finH">
    <div class="finale-media" aria-hidden="true"><img src={MEDIA.heroFilm.poster} alt="" class="lv lv--breathe" loading="lazy" decoding="async" width="1600" height="726" /></div>
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="finale-c">
      <span class="caps-xs fade">{BANNER.eyebrow}</span>
      <h2 class="rv" id="finH">{BANNER.heading}</h2>
      <p class="finale-line fade" style="--d:.08s">{BANNER.body}</p>
      <ul class="finale-points fade" style="--d:.12s">{BANNER.points.map((p) => <li>{p}</li>)}</ul>
      <div class="finale-cta fade" style="--d:.16s">
        <a class="btn btn--ivory" href={BANNER.ctaHref}>{BANNER.cta}</a>
        <a class="tlk tlk--lt" href={`mailto:${SITE.email}`}>Email {SITE.email}</a>
      </div>
    </div>
  </section>

  <!-- ⑩ MAGNOLIA MOMENTS -->
  <section class="sec sec--tight" id="journal">
    <div class="wrap">
      <div class="jr-head">
        <div><p class="caps rv">The blog</p><h2 class="disp rv" style="--d:.06s">{SECTION_LABELS.blog}</h2></div>
      </div>
      <div class="jr-grid" data-stag=".08">
        {posts.map((p) => <div class="rv"><BlogCard post={p} headingLevel="h3" /></div>)}
        <div class="rv"><a class="jr-all" href={SITE.links.blog}><span class="caps-xs">{SECTION_LABELS.blog}</span><span class="jr-all-t">All <span class="ital">posts.</span></span><span class="arrow-link">Open the blog <span class="arr" aria-hidden="true">&rarr;</span></span></a></div>
      </div>
    </div>
  </section>

  <!-- ⑪ JOIN OUR TEAM · the careers page as a quiet note card -->
  <section class="sec sec--linen" id="careers">
    <div class="wrap">
      <div class="note-card rv">
        <div class="note-mono" aria-hidden="true"><span class="note-n">M</span></div>
        <p class="caps">{CAREERS.banner}</p>
        <h2 class="join-h">{CAREERS.heading}</h2>
        <p class="note-copy">{CAREERS.body}</p>
        <i class="note-rule"></i>
        <div class="join-cta">
          <a class="btn btn--solid" href={CAREERS.apply}>Apply online</a>
          <a class="tlk" href={CAREERS.pdf} download>{CAREERS.download}</a>
        </div>
        <p class="join-mail">Completed applications go to <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </div>
  </section>

  <ConceptBar current={1} />
</BaseLayout>

<style is:global>
  /* Concept tuning: the approved look, with a touch more travel and patience in the reveals. */
  body.c01 .rv{transform:translateY(30px);transition-duration:.9s,1.05s,.7s}
  body.c01 .rv.in{transform:none}
  body.c01 .rv-im img,body.c01 .rv-im video{transform:scale(1.12);transition-duration:1.6s}
  body.c01 .rv-im.in img,body.c01 .rv-im.in video{transform:none}
</style>

<style>
  /* CHAPTER I */
  .fam-r{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);column-gap:clamp(2.4rem,5vw,5.5rem);align-items:start}
  .fam-copy .lede{margin:0 0 clamp(1.4rem,2.6vw,2.2rem);max-width:24em;font-family:var(--display);font-variation-settings:'opsz' 48,'SOFT' 50}
  .fam-body{max-width:34em}
  .fam-body p+p{margin-top:1.1em}
  .values{list-style:none;margin:clamp(2rem,3.6vw,3rem) 0 0;padding:0;border-top:1px solid var(--hair)}
  .values li{display:grid;grid-template-columns:2.2em 1fr;column-gap:.4rem;padding:1.05rem 0;border-bottom:1px solid var(--hair)}
  .v-n{grid-row:1;font-family:var(--display);font-style:italic;color:var(--brass);font-size:1.02rem}
  .v-t{display:block;grid-column:2;font-family:var(--display);font-size:1.22rem;color:var(--ink);font-variation-settings:'opsz' 48,'SOFT' 40}
  .v-d{display:block;grid-column:2;font-size:.92rem;color:var(--ink-soft);margin-top:.3rem;max-width:42em}
  .fam-fig{margin:0}
  .fam-fig .ph{aspect-ratio:1/1}
  figcaption.fade,.fam-fig figcaption,.fd figcaption,.gal figcaption{margin-top:1.4rem;text-align:center;font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.22em;font-size:.56rem;color:var(--brass)}
  @media(max-width:899px){.fam-r{grid-template-columns:1fr;row-gap:2.4rem}.fam-fig{order:-1}.fam-fig .ph{aspect-ratio:4/3}}

  /* SPECIALIZED CARE */
  .svc-head{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap;margin-bottom:clamp(2.6rem,5vw,4.4rem)}
  .svc-head .kick{margin-bottom:1.4rem}
  .ghost-w{right:-1%;bottom:-.1em;font-size:clamp(7rem,18vw,17rem)}
  .svc-head .disp{font-size:clamp(2.2rem,4.4vw,4rem)}
  .svc-head-line{margin:0;max-width:24em;font-size:1.12rem;color:var(--ink-soft);font-variation-settings:'opsz' 48,'SOFT' 60}
  .svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.6rem)}
  .svc{display:flex;flex-direction:column;overflow:hidden;color:var(--ink);border-color:rgba(138,106,60,.3)}
  .svc:hover{border-color:var(--brass)}
  .svc-ph{aspect-ratio:4/3;border-radius:var(--r) var(--r) 0 0}
  .svc-ph :global(img){transition:transform 1.1s var(--ease)}
  .svc:hover .svc-ph :global(img){transform:scale(1.04)}
  .svc-body{padding:1.4rem 1.5rem 1.6rem;display:flex;flex-direction:column;flex:1;gap:.55rem}
  .svc-body h3{font-size:1.38rem;line-height:1.15}
  .svc-body p{font-size:.92rem;color:var(--ink-soft);flex:1}
  .svc-body .arrow-link{margin-top:.6rem;font-size:.98rem}
  .svc-cta{margin-top:clamp(2.6rem,4.5vw,3.8rem);display:flex;align-items:center;gap:2rem;flex-wrap:wrap}
  @media(max-width:1023px){.svc-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:599px){.svc-grid{grid-template-columns:1fr}}
  .cine-fr video{width:100%;height:100%;object-fit:cover}

  /* HOW WE HELP */
  .why-quote{font-family:var(--display);font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.28;letter-spacing:-.005em;color:var(--ivory);max-width:17em;margin:0 0 clamp(2rem,3.6vw,3rem);font-variation-settings:'opsz' 96,'SOFT' 60}
  .ledger{list-style:none;margin:0;padding:0;border-top:1px solid var(--hairdk)}
  .ledger li{display:flex;gap:clamp(1rem,2vw,1.6rem);padding:clamp(1rem,1.8vw,1.4rem) 0;border-bottom:1px solid var(--hairdk)}
  .l-n{flex:0 0 2em;font-family:var(--display);font-style:italic;color:var(--gold-lt);font-size:1.02rem}
  .l-t{display:block;font-family:var(--display);font-size:1.2rem;color:var(--ivory);font-variation-settings:'opsz' 48,'SOFT' 40}
  .l-d{display:block;font-size:.92rem;color:rgba(248,244,238,.74);margin-top:.3rem;max-width:44em}
  .why-cta{display:flex;align-items:center;gap:2rem;flex-wrap:wrap;margin-top:clamp(2rem,3.6vw,3rem)}
  .why-cta .tlk{max-width:100%;overflow-wrap:anywhere}

  /* TESTIMONIALS */
  .tst-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.6rem)}
  .tst{position:relative;margin:0;padding:clamp(1.8rem,3vw,2.6rem) clamp(1.5rem,2.6vw,2.2rem) clamp(1.6rem,2.6vw,2.2rem);display:flex;flex-direction:column}
  .tst-q{position:absolute;top:.4rem;left:1.1rem;font-family:var(--display);font-size:4.2rem;line-height:1;color:var(--petal-deep);opacity:.55}
  .tst blockquote{margin:0 0 1.4rem;flex:1}
  .tst blockquote p{font-family:var(--display);font-style:italic;font-size:clamp(1.08rem,1.5vw,1.26rem);line-height:1.5;color:var(--ink);font-variation-settings:'opsz' 48,'SOFT' 60}
  .tst figcaption .caps-xs{color:var(--brass)}
  .tst-note{margin-top:1.6rem;text-align:center;font-size:.82rem;color:var(--ink-soft);font-style:italic}
  @media(max-width:899px){.tst-grid{grid-template-columns:1fr}}

  /* CHAPTER III · THE PEOPLE */
  .fd{display:grid;grid-template-columns:minmax(220px,340px) 1fr;column-gap:clamp(1.6rem,3.5vw,3.2rem);align-items:start}
  .fd-port{margin:0}
  .fd-port .ph{aspect-ratio:4/5}
  .fd-port figcaption{display:flex;flex-direction:column;gap:.35rem}
  .fd-tbc{color:var(--ink-soft);font-weight:500;letter-spacing:.14em;text-transform:none;font-family:var(--display);font-style:italic;font-size:.95rem}
  .fd-side{display:flex;flex-direction:column;gap:clamp(1.4rem,2.6vw,2.2rem);padding-top:clamp(0rem,4vw,3rem)}
  .fd-note{font-family:var(--display);font-style:italic;font-size:clamp(1.08rem,1.5vw,1.3rem);line-height:1.55;color:var(--ink-soft);max-width:26em;margin:0;font-variation-settings:'opsz' 48,'SOFT' 60}
  .fd-team{margin:0}
  .fd-team .ph{aspect-ratio:3/2}
  @media(max-width:899px){.fd{grid-template-columns:1fr;row-gap:2.2rem}.fd-port{width:min(360px,100%);margin-inline:auto}.fd-side{padding-top:0}}

  /* GALLERY */
  .gal{background:var(--paper)}
  .gal .kick--c{margin-bottom:clamp(2.2rem,4vw,3.4rem)}
  .gal-grid{display:grid;grid-template-columns:5fr 4fr 3fr;gap:clamp(1rem,2vw,1.6rem);align-items:start}
  .gal-grid figure{margin:0}
  .gal-grid .ph{aspect-ratio:4/3}
  .gal-b{margin-top:clamp(2rem,5vw,4.5rem)}
  .gal-c{margin-top:clamp(4rem,10vw,9rem)}
  @media(max-width:899px){.gal-grid{grid-template-columns:1fr 1fr}.gal-a{grid-column:1/-1}.gal-b,.gal-c{margin-top:0}}

  /* FINALE */
  .finale{position:relative;min-height:80svh;display:grid;place-items:center;text-align:center;overflow:hidden;background:var(--leaf);color:var(--ivory)}
  .finale-media{position:absolute;inset:0}
  .finale-media img{width:100%;height:100%;object-fit:cover;object-position:50% 40%;filter:saturate(.85)}
  .finale-media::after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(21,46,39,.8),rgba(21,46,39,.62) 45%,rgba(21,46,39,.86)),radial-gradient(110% 85% at 50% 50%,rgba(21,46,39,0) 45%,rgba(21,46,39,.45) 100%)}
  .finale-c{position:relative;z-index:1;padding:clamp(6rem,14vh,9rem) 6vw;max-width:860px}
  .finale-c .caps-xs{color:var(--gold-lt);display:block;margin-bottom:1.6rem}
  .finale-c h2{font-size:clamp(2.2rem,5vw,4.4rem);line-height:1.08;color:var(--ivory);margin:0 0 1.4rem;font-variation-settings:'opsz' 144,'SOFT' 60}
