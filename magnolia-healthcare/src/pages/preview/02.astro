---
/** CONCEPT 02 — "Modern Editorial Healthcare". The home page as an issue of a printed
 *  magazine about Magnolia: paper-white ground, a masthead, a numbered Contents strip,
 *  the mission as an essay, specialized care as an index, testimonials as a Letters
 *  page, photography as captioned plates. Palette per the founder's note: white / pale
 *  grey canvases, pale sage panels, gold hairlines, charcoal text; deep forest green
 *  on the one consultation notice and the primary button only. Every word of business
 *  content comes verbatim from src/lib/magnolia-content.ts and the content collections. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';
import Plate from '../../components/Plate.astro';
import ConceptBar from '../../components/preview/ConceptBar.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts, fmtDate, readingTime, BLOG_NAME } from '../../lib/blog';
import { NAV, LOGIN, HERO, MISSION, SECTION_LABELS, BANNER, CAREERS, FOUNDER, FOOTER, MEDIA, SITE, TESTIMONIALS, TBC } from '../../lib/magnolia-content';

const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const posts = (await getPublishedPosts()).slice(0, 2);
const CONTENTS = [
  { n: '01', id: 'mission', label: MISSION.heading }, { n: '02', id: 'care', label: SECTION_LABELS.specialized },
  { n: '03', id: 'how', label: SECTION_LABELS.how }, { n: '04', id: 'letters', label: SECTION_LABELS.voices },
  { n: '05', id: 'founder', label: 'Founder & team' }, { n: '06', id: 'consult', label: BANNER.eyebrow },
  { n: '07', id: 'moments', label: SECTION_LABELS.blog }, { n: '08', id: 'careers', label: SECTION_LABELS.team },
];
const folio = (id: string) => CONTENTS.find((c) => c.id === id)!;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout title="Concept 02 · Modern Editorial Healthcare" description="A magazine issue about Magnolia Healthcare: masthead navigation, numbered contents, the mission as an essay, photography as plates." path="/preview/02" bodyClass="preview c02" chrome={false}>

  <!-- MASTHEAD -->
  <header class="mh">
    <div class="wrap mh-top">
      <button class="mh-menu" id="menuOpen" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
      <a class="mh-logo" href="/" aria-label={`${SITE.name} — home`}>
        <Mark class="mh-mark" />
        <span class="mh-wm" aria-hidden="true">Magnolia</span>
        <span class="mh-sub" aria-hidden="true">Healthcare</span>
      </a>
      <a class="mh-login mh-login--m" href={LOGIN.href}>{LOGIN.label}</a>
    </div>
    <div class="mh-rule">
      <div class="wrap mh-row">
        <a class="mh-login" href={LOGIN.href}>{LOGIN.label}</a>
        <nav class="mh-nav" aria-label="Primary">{NAV.map((n) => <a href={n.href} aria-current={n.href === '/' ? 'page' : undefined}>{n.label}</a>)}</nav>
        <a class="btn btn--solid mh-cta" href={HERO.ctaHref}>{HERO.cta}</a>
      </div>
    </div>
  </header>
  <nav class="mh-sheet" id="menu" aria-label="Main menu" aria-hidden="true" inert>
    <div class="mh-sheet-top"><span class="caps-xs">Contents</span><button class="mh-close" id="menuClose" type="button">Close <span aria-hidden="true">&times;</span></button></div>
    <ol class="mh-list">{NAV.map((n, i) => <li><a href={n.href}><span class="mh-ln">{pad(i)}</span>{n.label}</a></li>)}</ol>
    <div class="mh-sheet-sub"><a href={LOGIN.href}>{LOGIN.label}</a><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
    <a class="btn btn--solid mh-sheet-cta" href={HERO.ctaHref}>{HERO.cta}</a>
  </nav>

  <!-- COVER -->
  <section class="wrap hero" aria-label="Magnolia Healthcare — home care agency">
    <div class="hero-c">
      <p class="deck fade">{HERO.sub}</p>
      <h1 class="hero-h"><span class="rv">Because every</span><span class="rv" style="--d:.1s">life matters</span></h1>
      <p class="hero-area fade" style="--d:.2s">{SITE.legalName} &middot; {HERO.area}</p>
      <div class="hero-cta fade" style="--d:.26s"><a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a><a class="tlk" href="#care">{SECTION_LABELS.specialized}</a></div>
    </div>
    <figure class="still">
      <div class="still-fr rv-im">
        <video data-film muted loop playsinline preload="none" poster={MEDIA.heroFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
          <source data-src={MEDIA.heroFilm.webm} type="video/webm" /><source data-src={MEDIA.heroFilm.mp4} type="video/mp4" />
        </video>
      </div>
      <figcaption class="cap fade"><span class="cap-n">Fig. 1</span><span>Film: a companion and a client, at home</span></figcaption>
    </figure>
  </section>

  <!-- CONTENTS -->
  <nav class="wrap toc fade" aria-label="Contents">
    <span class="toc-t">Contents</span>
    <ol>{CONTENTS.map((c) => <li><a href={`#${c.id}`}><span class="toc-n">{c.n}</span>{c.label}</a></li>)}</ol>
  </nav>

  <!-- No. 01 · OUR MISSION — the essay -->
  <section class="sec sec--sage panel" id="mission">
    <div class="wrap">
      <p class="folio fade"><span class="folio-n">No. {folio('mission').n}</span><i class="rl" aria-hidden="true"></i><span>{MISSION.heading}</span></p>
      <div class="ess">
        <div class="ess-l">
          <p class="caps-xs rv">{MISSION.eyebrow}</p>
          <h2 class="disp ess-t rv" style="--d:.06s">Our <span class="ital">mission.</span></h2>
          <a class="tlk fade" style="--d:.12s" href={SITE.links.mission}>Read the mission</a>
        </div>
        <div class="ess-r">
          <p class="ess-lead fade">{MISSION.sentences[0]}</p>
          <blockquote class="ess-pull rv"><p>{MISSION.sentences[1]}</p></blockquote>
          <div class="ess-cols fade"><p>{MISSION.sentences[2]}</p><p>{MISSION.sentences[3]}</p></div>
          <ul class="ess-values fade" aria-label="Three words the mission leans on">{MISSION.values.map((v) => <li>{v}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- No. 02 · SPECIALIZED CARE — the index -->
  <section class="sec" id="care">
    <div class="wrap">
      <p class="folio fade"><span class="folio-n">No. {folio('care').n}</span><i class="rl" aria-hidden="true"></i><span>{SECTION_LABELS.why}</span></p>
      <div class="sec-h">
        <h2 class="disp rv">{SECTION_LABELS.specialized}</h2>
        <p class="ital sec-line fade" style="--d:.08s">An index of the six kinds of care Magnolia brings into the home.</p>
      </div>
      <div class="ix" id="careIndex">
        {specialized.map((s, i) => (
          <>
            <article class="ix-row fade" class:list={{ on: i === 0 }} data-k={s.id} style={`--d:${(i * 0.06).toFixed(2)}s`}>
              <span class="ix-n">{s.data.numeral}</span>
              <h3><a href={`/services#${s.id}`}>{s.data.title}</a></h3>
              <p>{s.data.summary}</p>
            </article>
            <figure class="ix-fig" class:list={{ on: i === 0 }} data-k={s.id} aria-hidden="true">
              <div class="ph ix-ph"><Plate id={s.data.plate} alt="" sizes="(max-width:899px) 92px, 440px" widths={[200, 448, 640]} /></div>
              <figcaption class="cap"><span class="cap-n">Pl. {s.data.numeral}</span><span>{s.data.title}</span></figcaption>
            </figure>
          </>
        ))}
      </div>
      <div class="sec-cta fade"><a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a><a class="tlk" href={SITE.links.services}>All of our care, in detail</a></div>
    </div>
  </section>

  <!-- No. 03 · HOW WE HELP — four columns -->
  <section class="sec sec--tight" id="how">
    <div class="wrap">
      <p class="folio fade"><span class="folio-n">No. {folio('how').n}</span><i class="rl" aria-hidden="true"></i><span>{SECTION_LABELS.how}</span></p>
      <h2 class="disp sec-t rv">How we <span class="ital">help.</span></h2>
      <div class="how" data-stag=".08">
        {support.map((s) => <div class="how-c fade"><span class="how-n">{s.data.numeral}</span><h3>{s.data.title}</h3><p>{s.data.summary}</p></div>)}
      </div>
    </div>
  </section>

  <!-- No. 04 · WHAT OUR CLIENTS SAY — the Letters page -->
  <section class="sec sec--sage" id="letters">
    <div class="wrap">
      <p class="folio fade"><span class="folio-n">No. {folio('letters').n}</span><i class="rl" aria-hidden="true"></i><span>Letters</span></p>
      <div class="let">
        <h2 class="disp sec-t rv">{SECTION_LABELS.voices}</h2>
        <div class="let-list" data-stag=".1">
          {TESTIMONIALS.map((t) => <figure class="let-q fade"><blockquote><p>&ldquo;{t.quote}&rdquo;</p></blockquote><figcaption>&mdash; {t.name}</figcaption></figure>)}
        </div>
        <p class="let-note fade">Client words as published on Magnolia&rsquo;s current website.</p>
      </div>
    </div>
  </section>

  <!-- No. 05 · FOUNDER & TEAM — the profile and the plates -->
  <section class="sec" id="founder">
    <div class="wrap">
      <p class="folio fade"><span class="folio-n">No. {folio('founder').n}</span><i class="rl" aria-hidden="true"></i><span>Founder &amp; team</span></p>
      <div class="pro">
        <figure class="pro-fig">
          <div class="ph pro-ph rv-im"><Plate id={FOUNDER.plate} alt="The founder of Magnolia Healthcare" sizes="(max-width:899px) 80vw, 440px" widths={[440, 560]} /></div>
          <figcaption class="cap fade"><span class="cap-n">Pl. I</span><span>{FOUNDER.label} &middot; {TBC}</span></figcaption>
        </figure>
        <div class="pro-c">
          <p class="caps-xs rv">{FOUNDER.label}</p>
          <p class="pro-line rv" style="--d:.06s">{FOUNDER.note}</p>
          <figure class="pro-team">
            <div class="ph rv-im"><Plate id={MEDIA.plates.team5} alt="The Magnolia Healthcare team in front of the Magnolia Healthcare sign; the founder, in white, at the centre" sizes="(max-width:899px) 92vw, 620px" widths={[480, 652]} /></div>
            <figcaption class="cap fade"><span class="cap-n">Pl. II</span><span>The Magnolia team, in front of the Magnolia sign</span></figcaption>
          </figure>
        </div>
      </div>
      <div class="plates" data-stag=".1">
        <figure class="pl fade">
          <div class="ph pl-film rv-im">
            <video data-film muted loop playsinline preload="none" poster={MEDIA.cineFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
              <source data-src={MEDIA.cineFilm.webm} type="video/webm" /><source data-src={MEDIA.cineFilm.mp4} type="video/mp4" />
            </video>
          </div>
          <figcaption class="cap"><span class="cap-n">Fig. 2</span><span>Film: at a kitchen table</span></figcaption>
        </figure>
        <figure class="pl fade"><div class="ph pl-sq rv-im"><Plate id={MEDIA.plates.team4} alt="Four Magnolia caregivers in scrubs" sizes="(max-width:899px) 44vw, 380px" widths={[400, 640]} /></div><figcaption class="cap"><span class="cap-n">Pl. III</span><span>Magnolia caregivers</span></figcaption></figure>
        <figure class="pl fade"><div class="ph pl-sq rv-im"><Plate id={MEDIA.plates.clinician} alt="A member of the Magnolia team in scrubs" sizes="(max-width:899px) 44vw, 380px" widths={[400, 800]} /></div><figcaption class="cap"><span class="cap-n">Pl. IV</span><span>Supplied photograph</span></figcaption></figure>
      </div>
    </div>
  </section>

  <!-- No. 06 · CARE STARTS HERE — the boxed notice (the one deep-green surface) -->
  <section class="sec sec--tight" id="consult">
    <div class="wrap">
      <div class="notice rv">
        <div class="notice-c">
          <p class="caps-xs notice-k">No. {folio('consult').n} &middot; {BANNER.eyebrow}</p>
          <h2>{BANNER.heading}</h2>
          <p class="notice-b">{BANNER.body}</p>
        </div>
        <div class="notice-s">
          <ul class="notice-pts">{BANNER.points.map((p) => <li>{p}</li>)}</ul>
          <a class="btn btn--ivory" href={BANNER.ctaHref}>{BANNER.cta}</a>
          <a class="tlk tlk--lt" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- No. 07 · MAGNOLIA MOMENTS — two teasers -->
  {posts.length > 0 && (
    <section class="sec sec--tight" id="moments">
      <div class="wrap">
        <p class="folio fade"><span class="folio-n">No. {folio('moments').n}</span><i class="rl" aria-hidden="true"></i><span>The blog</span></p>
        <div class="sec-h"><h2 class="disp rv">{BLOG_NAME}</h2><a class="tlk fade" href={SITE.links.blog}>All posts</a></div>
        <div class="mm" data-stag=".1">
          {posts.map((p) => (
            <article class="tz fade">
              <a class="tz-ph ph" href={`/blog/${p.id}`} tabindex="-1" aria-hidden="true"><Plate id={p.data.plate} alt="" sizes="(max-width:599px) 120px, 200px" widths={[240, 448]} /></a>
              <div class="tz-c">
                <p class="tz-meta"><span>{fmtDate(p.data.pubDate)}</span><span aria-hidden="true">&middot;</span><span>{p.data.migrate ? 'Excerpt' : `${readingTime(p.body)} min read`}</span></p>
                <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
                <p class="tz-d">{p.data.description}</p>
                <a class="arrow-link" href={`/blog/${p.id}`}>Read <span class="arr" aria-hidden="true">&rarr;</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- No. 08 · JOIN OUR TEAM — the classified -->
  <section class="sec sec--tight" id="careers">
    <div class="wrap">
      <aside class="cls rv" aria-labelledby="clsT">
        <p class="caps-xs cls-k">No. {folio('careers').n} &middot; Classified &middot; {CAREERS.banner}</p>
        <h2 id="clsT">{CAREERS.heading}</h2>
        <p class="cls-b">{CAREERS.body}</p>
        <div class="cls-a"><a class="btn btn--line" href={CAREERS.apply}>Apply online</a><a class="tlk" href={CAREERS.pdf} download>{CAREERS.download}</a><a class="tlk" href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
      </aside>
    </div>
  </section>

  <!-- COLOPHON -->
  <footer class="col">
    <div class="wrap">
      <div class="col-grid">
        <div class="col-brand"><Mark class="col-mark" /><p class="col-name">{FOOTER.legal}</p><p class="col-tag">{FOOTER.tagline} &middot; {FOOTER.area}</p></div>
        <div><p class="col-h">Contact</p><ul class="col-list"><li><a href={`mailto:${FOOTER.email}`}>{FOOTER.email}</a></li><li>{FOOTER.area}</li></ul></div>
        <div><p class="col-h">Contents</p><ul class="col-list">{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
        <div><p class="col-h">Also</p><ul class="col-list"><li><a href={CAREERS.apply}>Caregiver application</a></li><li><a href={LOGIN.href}>{LOGIN.label}</a></li><li><a href={SITE.currentSite} rel="noopener" target="_blank">Current website</a></li></ul></div>
      </div>
      <div class="col-bar"><span>{FOOTER.legal}</span><span>Set in Fraunces &amp; Figtree &middot; Concept 02</span></div>
    </div>
  </footer>

  <ConceptBar current={2} />
</BaseLayout>

<style is:global>
  /* ---- the issue's paper: founder's palette (white canvas, pale sage panels, gold hairlines, charcoal text) ---- */
  .c02{--ivory:#FDFDFC;--paper:#FFFFFF;--linen:#F3F3F1;--sage-band:#EAEDE8;--sage:#B1C09D;--leaf:#163B2B;--leaf-2:#1E4A37;--leaf-deep:#122E1F;
    --ink:#2A2F2B;--ink-soft:#5B625D;--brass:#8E7046;--hair:rgba(42,47,43,.14);--hair-strong:rgba(142,112,70,.45);--gold-lt:#CDB48C;
    background:var(--ivory);color:var(--ink-soft);line-height:1.78}
  .c02 .caps-xs{font-size:.62rem;letter-spacing:.24em}
  .c02 .disp{letter-spacing:-.022em;font-variation-settings:'opsz' 144,'SOFT' 24}
  .c02 h3{font-variation-settings:'opsz' 48,'SOFT' 24;letter-spacing:-.005em}
  .c02 .sec{padding-block:clamp(72px,9vw,128px)}
  .c02 .sec--tight{padding-block:clamp(56px,7vw,96px)}
  .c02 .sec--sage{background:var(--sage-band)}
  .c02 .panel{border-radius:50% 50% 0 0 / clamp(28px,5vw,72px);margin-top:clamp(.5rem,2vw,1.5rem)}
  .c02 section{scroll-margin-top:84px}
  .c02 .ph{border-radius:0;background:var(--linen)}

  /* ---- masthead ---- */
  .mh{position:sticky;top:-137px;z-index:60;background:var(--ivory)}
  .mh-top{position:relative;display:flex;align-items:center;justify-content:center;height:137px}
  .mh-logo{display:flex;flex-direction:column;align-items:center;color:var(--leaf);min-height:44px;justify-content:center}
  .mh-logo .mh-mark{width:40px;height:40px;color:var(--leaf)}
  .mh-wm{font-family:var(--display);font-weight:400;font-size:1.55rem;line-height:1;text-transform:uppercase;letter-spacing:.24em;text-indent:.24em;color:var(--ink);margin-top:.55rem;font-variation-settings:'opsz' 72,'SOFT' 30}
  .mh-sub{font-family:var(--utility);font-weight:600;font-size:.56rem;letter-spacing:.44em;text-indent:.44em;text-transform:uppercase;color:var(--brass);margin-top:.5rem}
  .mh-menu,.mh-login{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.24em;font-size:.62rem;color:var(--ink);background:none;border:0;cursor:pointer;min-height:44px;display:inline-flex;align-items:center;padding:0;transition:color .3s}
  .mh-menu:hover,.mh-login:hover{color:var(--brass)}
  .mh-menu,.mh-login--m{display:none;position:absolute;top:50%;transform:translateY(-50%)}
  .mh-rule{border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
  .mh-row{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:56px}
  .mh-nav{display:flex;justify-content:center;gap:clamp(1.6rem,3.4vw,3.6rem)}
  .mh-nav a{position:relative;font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.24em;font-size:.62rem;color:var(--ink);padding:.9em 0;transition:color .3s}
  .mh-nav a::after{content:"";position:absolute;left:0;right:0;bottom:.4em;height:1px;background:var(--brass);transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)}
  .mh-nav a:hover,.mh-nav a:focus-visible,.mh-nav a[aria-current="page"]{color:var(--brass)}
  .mh-nav a:hover::after,.mh-nav a:focus-visible::after,.mh-nav a[aria-current="page"]::after{transform:scaleX(1)}
  .mh-cta{justify-self:end;min-height:40px;padding:.9em 1.5em .85em;font-size:.62rem}
  @media(max-width:1023px){
    .mh{top:0;border-bottom:1px solid var(--hair)}
    .mh-top{height:64px}
    .mh-logo{flex-direction:row;gap:.6rem}
    .mh-logo .mh-mark{width:28px;height:28px}
    .mh-wm{font-size:1.02rem;margin:0;letter-spacing:.22em;text-indent:0}
    .mh-sub{display:none}
    .mh-menu{display:inline-flex;left:0}
    .mh-login--m{display:inline-flex;right:0}
    .mh-rule{display:none}
  }
  /* mobile sheet (wired by the shared runtime: #menu / #menuOpen / #menuClose) */
  .mh-sheet{position:fixed;inset:0;z-index:120;background:var(--ivory);display:flex;flex-direction:column;padding:0 5vw 5vw;overflow-y:auto;overscroll-behavior:contain;
    opacity:0;visibility:hidden;transition:opacity .4s var(--ease),visibility 0s linear .4s}
  .mh-sheet.open{opacity:1;visibility:visible;transition:opacity .4s var(--ease)}
  .mh-sheet-top{display:flex;justify-content:space-between;align-items:center;height:64px;border-bottom:1px solid var(--hair);flex:none}
  .mh-close{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.24em;font-size:.62rem;color:var(--ink);background:none;border:0;cursor:pointer;min-height:44px;display:inline-flex;align-items:center;gap:.6rem;padding:0}
  .mh-close span{font-family:var(--display);font-size:1.5rem;line-height:1;color:var(--brass)}
  .mh-list{list-style:none;margin:1rem 0 0;padding:0}
  .mh-list li{transform:translateY(16px);opacity:0;transition:transform .5s var(--ease),opacity .5s ease}
  .mh-sheet.open .mh-list li{transform:none;opacity:1}
  .mh-sheet.open .mh-list li:nth-child(2){transition-delay:.05s}.mh-sheet.open .mh-list li:nth-child(3){transition-delay:.1s}.mh-sheet.open .mh-list li:nth-child(4){transition-delay:.15s}.mh-sheet.open .mh-list li:nth-child(5){transition-delay:.2s}
  .mh-list a{display:flex;align-items:baseline;gap:1.2rem;padding:.95rem 0;border-bottom:1px solid var(--hair);font-family:var(--display);font-weight:300;font-size:clamp(1.9rem,7.5vw,2.5rem);line-height:1.1;color:var(--ink);letter-spacing:-.015em;font-variation-settings:'opsz' 96,'SOFT' 30}
  .mh-ln{font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.2em;color:var(--brass)}
  .mh-sheet-sub{display:flex;flex-wrap:wrap;column-gap:1.6rem;margin-top:1.4rem}
  .mh-sheet-sub a{display:inline-flex;align-items:center;min-height:44px;font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.2em;font-size:.62rem;color:var(--brass)}
  .mh-sheet-cta{margin-top:auto;width:100%}

  /* ---- cover ---- */
  .hero{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);column-gap:clamp(2.5rem,6vw,7rem);align-items:center;padding:clamp(2.6rem,5vw,4.6rem) 0 clamp(3rem,6vw,5.5rem)}
  .deck{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.3em;font-size:.68rem;color:var(--brass);display:flex;align-items:center;gap:1.2rem;margin-bottom:clamp(1.6rem,3vw,2.6rem)}
  .deck::before{content:"";width:40px;height:1px;background:var(--brass)}
