<script>
  // The index: hovering or focusing a row swaps the plate in the sticky column (desktop).
  const ix = document.getElementById('careIndex');
  if (ix) {
    const rows = ix.querySelectorAll<HTMLElement>('.ix-row'), figs = ix.querySelectorAll<HTMLElement>('.ix-fig');
    const set = (k: string | undefined) => { rows.forEach((r) => r.classList.toggle('on', r.dataset.k === k)); figs.forEach((f) => f.classList.toggle('on', f.dataset.k === k)); };
    rows.forEach((r) => { r.addEventListener('mouseenter', () => set(r.dataset.k)); r.addEventListener('focusin', () => set(r.dataset.k)); });
  }
</script>
