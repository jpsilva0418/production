---
/** CONCEPT 07 · FAMILY, AT HOME — EVOLVED. The best of 01 and 05, rebalanced to the
 *  client's own light palette.
 *  · Opening: Preview 01's veil → corridor film, cream serif, blush italic — kept, with her
 *    gold logo ring drawn into the veil and her deep green as the scrim (c07/Hero.astro).
 *  · Structure: Preview 05's pinned film with chapters rising over it, the top edge of each
 *    chapter being her curved sage band — which now flattens gently as the chapter rises.
 *  · Order: her site's own — mission, then the team photograph (founder in white), then
 *    "Why choose us?" / Specialized care, How we help, What our clients say, the
 *    consultation banner, then Magnolia Moments and Join our team.
 *  · Palette (sampled from her screenshots, docs/03-preservation-map.md §8): warm white and
 *    ivory canvases, pale sage #EAEDE8 panels, the sage curve #B1C09D, charcoal #2C302C type,
 *    her logo gold as hairlines, deep green #122E1F only for the opening and her banner.
 *  Every string is verbatim from src/lib/magnolia-content.ts and the content collections. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/preview/c07/Hero.astro';
import Mark from '../../components/Mark.astro';
import Plate from '../../components/Plate.astro';
import BlogCard from '../../components/BlogCard.astro';
import ConceptBar from '../../components/preview/ConceptBar.astro';
import { getCollection } from 'astro:content';
import { getPublishedPosts } from '../../lib/blog';
import { HERO, MISSION, SECTION_LABELS, BANNER, CAREERS, FOUNDER, MEDIA, SITE, TESTIMONIALS, TBC } from '../../lib/magnolia-content';

const all = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const specialized = all.filter((s) => s.data.kind === 'specialized');
const support = all.filter((s) => s.data.kind === 'support');
const posts = (await getPublishedPosts()).slice(0, 2);
const supplied = new Set<string>(Object.values(MEDIA.plates));
const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi'];
const chapters = [
  { id: 'mission', label: 'Mission' },
  { id: 'people', label: 'People' },
  { id: 'care', label: 'Care' },
  { id: 'voices', label: 'Voices' },
  { id: 'begin', label: 'Begin' },
];
const ring = 'M27 89.84A46 46 0 1 1 73 89.84';
---
<BaseLayout headerLight headerPrologue title="Concept 07 · Family, at Home — Evolved" description="Design review concept 07 — Preview 01's opening with the best of 01 and 05 after it, in Magnolia's own light palette." path="/preview/07" bodyClass="preview c07">

  <div class="c7-prog" id="c7Prog" aria-hidden="true"></div>
  <nav class="c7-rail" id="c7Rail" aria-label="Chapters">
    {chapters.map((c, i) => <a href={`#${c.id}`} data-rail={c.id}><i aria-hidden="true"></i><span><b>{roman[i]}.</b> {c.label}</span></a>)}
  </nav>

  <!-- ① THE OPENING · Preview 01's veil → corridor film (pinned) -->
  <Hero />

  <!-- ② CHAPTER I · OUR MISSION — rises over the film on her curved sage band -->
  <section class="c7-ch c7-ch--first" id="mission" data-chapter="mission" data-tone="light" data-curve>
    <div class="c7-light" aria-hidden="true"><i class="lx-shaft"></i></div>
    <div class="wrap c7-mis">
      <div class="c7-mis-t">
        <p class="chap-rn rv">Chapter i.</p>
        <h2 class="disp c7-mis-h rv" style="--d:.06s">Our <span class="ital">mission.</span></h2>
        <p class="kick rv" style="--d:.1s">{MISSION.eyebrow}</p>
        {MISSION.sentences.map((s, i) => <p class={`c7-mis-s rv${i === 0 ? ' c7-mis-s--lead' : ''}`} style={`--d:${(0.16 + i * 0.12).toFixed(2)}s`}>{s}</p>)}
        <div class="c7-mis-foot fade" style="--d:.62s">
          <ul class="c7-vals" aria-label="Our values">{MISSION.values.map((v, i) => <li><b>{roman[i]}.</b> {v}</li>)}</ul>
          <a class="tlk" href={SITE.links.mission}>Read our mission</a>
        </div>
      </div>
      <figure class="c7-mis-f">
        <div class="ph ph--framed rv-im" style="--d:.2s"><Plate id={MEDIA.plates.hug} alt="A caregiver embracing an older woman in her kitchen" class="lv lv--rise" sizes="(max-width:899px) 90vw, 520px" widths={[480, 624]} /><i class="grain" aria-hidden="true"></i></div>
        <figcaption class="fade" style="--d:.3s">Seeing the person beyond their needs</figcaption>
      </figure>
    </div>
  </section>

  <!-- ③ CHAPTER II · THE PEOPLE — her team photograph, straight after the mission as on her site; the founder in white -->
  <section class="c7-ch c7-ch--sage" id="people" data-chapter="people" data-tone="light" data-curve>
    <div class="wrap chap">
      <div class="chap-l rv">
        <p class="chap-rn">Chapter ii.</p>
        <h2 class="disp chap-t">The people<br />behind <span class="ital">the care.</span></h2>
        <p class="chap-line">Thoughtfully selected, trained, and committed to every home.</p>
        <a class="tlk" href={SITE.links.careers}>{SECTION_LABELS.team}</a>
      </div>
      <div class="c7-ppl" data-plx-host>
        <div class="c7-team rv-im">
          <div class="c7-team-in plx" data-plx="0.05"><Plate id={MEDIA.plates.team5} alt="The Magnolia Healthcare team of five in front of the Magnolia sign; the founder, in white, at the centre" sizes="(max-width:899px) 92vw, 760px" widths={[480, 652]} /></div>
          <i class="grain" aria-hidden="true"></i>
        </div>
        <p class="c7-team-cap fade">The Magnolia team &middot; supplied photograph</p>
        <figure class="c7-fdr">
          <div class="ph ph--framed rv-im" style="--d:.12s"><Plate id={FOUNDER.plate} alt="The founder of Magnolia Healthcare" class="lv lv--breathe" sizes="(max-width:599px) 128px, 188px" widths={[280, 420]} /><i class="grain" aria-hidden="true"></i></div>
          <figcaption class="fade" style="--d:.2s"><span class="caps-xs">{FOUNDER.label}</span><span class="c7-tbc">{TBC}</span><em>{FOUNDER.note}</em></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="chapslate chapslate--linen fade" role="presentation"><span class="cs-t">{SECTION_LABELS.why}</span></div>

  <!-- ④ CHAPTER III · CARE — the six specialized-care cards (a swipeable sequence on a phone, a 3 × 2 grid on desktop), then How we help -->
  <section class="c7-care" id="care" data-chapter="care" data-tone="light">
    <div class="wrap c7-care-h">
      <div>
        <p class="chap-rn rv">Chapter iii.</p>
        <p class="kick rv" style="--d:.04s">{SECTION_LABELS.specialized}</p>
        <h2 class="disp rv" style="--d:.08s">Care shaped around<br />the <span class="ital">person.</span></h2>
      </div>
      <p class="ital c7-care-line rv" style="--d:.12s">Six kinds of specialized support, each delivered at home with compassion, excellence, and respect.</p>
    </div>
    <div class="c7-seq">
      <ul class="c7-trk fade" id="c7Trk" tabindex="0" aria-label="Specialized care — six kinds of care">
        {specialized.map((s, i) => (
          <li class="c7-pn" style={`--i:${i}`}>
            {supplied.has(s.data.plate) ? (
              <div class="ph c7-pn-ph"><Plate id={s.data.plate} alt="" sizes="(max-width:899px) 82vw, 400px" widths={[448, 640]} /></div>
            ) : (
              <div class="c7-pn-ab" aria-hidden="true">
                <span class="c7-pn-ring"><svg viewBox="0 0 100 100" fill="none"><path d={ring} /></svg><Mark /></span>
                <span class="c7-pn-num">{s.data.numeral}</span>
              </div>
            )}
            <div class="c7-pn-b">
              <span class="caps-xs">No. {s.data.numeral}</span>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              <a class="arrow-link" href={`/services#${s.id}`} aria-label={`${s.data.title} — learn more`}>Learn more <span class="arr" aria-hidden="true">&rarr;</span></a>
            </div>
          </li>
        ))}
      </ul>
      <div class="c7-ctl">
        <div class="c7-dots" role="group" aria-label="Go to card">
          {specialized.map((s, i) => <button type="button" class="c7-dot" data-go={i} aria-label={`Card ${i + 1} of ${specialized.length}: ${s.data.title}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>)}
        </div>
        <div class="c7-arrows">
          <button type="button" class="c7-arr" id="c7Prev" aria-label="Previous card">&larr;</button>
          <button type="button" class="c7-arr" id="c7Next" aria-label="Next card">&rarr;</button>
        </div>
      </div>
    </div>

    <div class="wrap c7-how">
      <div class="c7-how-l rv">
        <p class="kick">{SECTION_LABELS.how}</p>
        <h2 class="disp c7-how-h">Around every person, <span class="ital">a team.</span></h2>
        <div class="c7-how-cta">
          <a class="btn btn--solid" href={HERO.ctaHref}>{HERO.cta}</a>
          <a class="tlk" href={SITE.links.services}>All of our care</a>
        </div>
      </div>
      <ol class="c7-rows" data-stag=".1">
        {support.map((s, i) => <li class="fade"><span class="c7-row-n">{roman[i]}.</span><div><h3>{s.data.title}</h3><p>{s.data.summary}</p></div></li>)}
      </ol>
    </div>
  </section>

  <!-- ⑤ CHAPTER IV · WHAT OUR CLIENTS SAY — the three quotes, one after another -->
  <section class="c7-voices" id="voices" data-chapter="voices" data-tone="light">
    <div class="wrap">
      <header class="c7-vh">
        <p class="chap-rn rv">Chapter iv.</p>
        <h2 class="disp rv" style="--d:.06s">What our clients <span class="ital">say.</span></h2>
      </header>
      <div class="c7-qs" data-stag=".2">
        {TESTIMONIALS.map((t) => (
          <figure class="c7-q fade">
            <span class="c7-q-m" aria-hidden="true">&ldquo;</span>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption><span class="caps-xs">{t.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="c7-q-note fade">Client words as published on Magnolia&rsquo;s current website.</p>
    </div>
  </section>

  <!-- ⑥ the kitchen film, pinned — the consultation chapter rises over it -->
  <div class="c7-band" data-pin data-chapter="voices" data-tone="film" role="presentation">
    <video data-film muted loop playsinline preload="none" poster={MEDIA.cineFilm.poster} disablepictureinpicture tabindex="-1" aria-hidden="true">
      <source data-src={MEDIA.cineFilm.webm} type="video/webm" />
      <source data-src={MEDIA.cineFilm.mp4} type="video/mp4" />
    </video>
    <i class="grain" aria-hidden="true"></i>
    <p class="c7-band-cap">Care, at home <b>&middot;</b> {HERO.area}</p>
  </div>

  <!-- ⑦ CHAPTER V · BEGIN — her deep-green consultation banner: the one controlled dark moment after the opening -->
  <section class="c7-ch c7-ch--dk" id="begin" data-chapter="begin" data-tone="dark" data-curve aria-labelledby="c7BegH">
    <div class="c7-light" aria-hidden="true"><i class="lx-dusk"></i></div>
    <div class="wrap-text c7-beg">
      <span class="c7-seal fade" aria-hidden="true"><svg viewBox="0 0 100 100" fill="none"><path d={ring} /></svg><Mark /></span>
      <p class="caps-xs fade" style="--d:.04s">Chapter v. &middot; {BANNER.eyebrow}</p>
      <h2 class="c7-beg-h rv" id="c7BegH" style="--d:.08s">{BANNER.heading}</h2>
      <p class="c7-beg-b fade" style="--d:.14s">{BANNER.body}</p>
      <ul class="c7-pts fade" style="--d:.2s">{BANNER.points.map((p) => <li>{p}</li>)}</ul>
      <div class="c7-beg-cta fade" style="--d:.26s">
        <a class="btn btn--ivory" href={BANNER.ctaHref}>{BANNER.cta}</a>
        <a class="tlk tlk--lt" href={`mailto:${SITE.email}`}>Or email {SITE.email}</a>
      </div>
    </div>
  </section>

  <!-- ⑧ after the resolution · Magnolia Moments and Join our team, back on her light ground -->
  <div class="c7-ch c7-after" data-chapter="begin" data-tone="light" data-curve>
    {posts.length > 0 && (
      <section class="wrap c7-mom" aria-labelledby="c7MomH">
        <header class="c7-mom-h">
          <div><p class="caps rv">The blog</p><h2 class="disp rv" id="c7MomH" style="--d:.06s">{SECTION_LABELS.blog}</h2></div>
        </header>
        <div class="c7-mom-g" data-stag=".1">
          {posts.map((p) => <div class="rv"><BlogCard post={p} headingLevel="h3" /></div>)}
          <div class="rv"><a class="c7-all" href={SITE.links.blog}><span class="caps-xs">{SECTION_LABELS.blog}</span><span class="c7-all-t">All <span class="ital">posts.</span></span><span class="arrow-link">Open the blog <span class="arr" aria-hidden="true">&rarr;</span></span></a></div>
        </div>
      </section>
    )}
    <section class="c7-join" aria-labelledby="c7JoinH">
      <div class="wrap c7-join-in">
        <div class="c7-join-t">
          <p class="caps rv">{CAREERS.banner}</p>
          <h2 class="disp rv" id="c7JoinH" style="--d:.06s">{CAREERS.heading}</h2>
          <p class="fade" style="--d:.12s">{CAREERS.body}</p>
          <div class="c7-join-a fade" style="--d:.18s">
            <a class="btn btn--solid" href={CAREERS.apply}>Apply online</a>
            <a class="tlk" href={CAREERS.pdf} download>{CAREERS.download}</a>
          </div>
          <p class="c7-join-mail fade" style="--d:.22s">Completed applications go to <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
        <div class="ph ph--framed c7-join-ph rv-im"><Plate id={MEDIA.plates.team4} alt="Four Magnolia caregivers in scrubs" class="lv lv--breathe" sizes="(max-width:899px) 80vw, 380px" widths={[480, 640]} /><i class="grain" aria-hidden="true"></i></div>
      </div>
    </section>
  </div>

  <ConceptBar current={7} />
</BaseLayout>

<style is:global>
  /* ---- her palette (docs/03-preservation-map.md §8): light canvases, pale sage, charcoal, gold hairlines ---- */
  body.c07{--ivory:#FCFBF8;--linen:#F4F3EF;--paper:#FFFFFF;--blush:#F7EEEA;--sage-band:#EAEDE8;--sage:#B1C09D;--moss:#7FA45E;
    --leaf:#122E1F;--leaf-2:#1B3D2B;--leaf-deep:#0C2016;--ink:#2C302C;--ink-soft:#5A605A;
    --brass:#7E6130;--gold:#B89A6A;--gold-ring:#B4843A;--gold-lt:#D9C39A;--petal:#E9CFC7;--petal-deep:#C98B80;
    --hair:rgba(126,97,48,.2);--hair-strong:rgba(126,97,48,.4);--hairdk:rgba(217,195,154,.22);--hairdk-strong:rgba(217,195,154,.42);
    --gut:max(20px,calc((100vw - var(--wrap)) / 2));--peek:56px;background:var(--ivory);color:var(--ink-soft)}
  @media(max-width:599px){body.c07{--wrap:calc(100vw - 40px)}}
  @media(max-width:640px){body.c07{--peek:38px}}
  body.c07 main{position:relative}
  /* 01's reveals, with a touch more travel and patience */
  body.c07 .rv{transform:translateY(30px);transition-duration:.9s,1.05s,.7s}
  body.c07 .rv.in{transform:none}
  body.c07 .rv-im img,body.c07 .rv-im video{transform:scale(1.1);transition-duration:1.5s}
  body.c07 .rv-im.in img,body.c07 .rv-im.in video{transform:none}
  /* the shared header, re-voiced to her canvas once it sticks */
  body.c07 .hd--stuck{background:rgba(252,251,248,.92);box-shadow:0 1px 0 var(--hair),0 18px 40px -30px rgba(44,48,44,.3)}
  /* the full-screen menu, re-voiced light: her pale sage, charcoal type, gold numerals */
  body.c07 .menu{background:var(--sage-band);color:var(--ink)}
  body.c07 .menu-top .hd-logo,body.c07 .menu-top .hd-logo .wm-name{color:var(--ink)}
  body.c07 .menu-top .hd-logo .wm-sub,body.c07 .menu-list .mrn,body.c07 .menu-sub a,body.c07 .menu-foot{color:var(--brass)}
  body.c07 .menu-list .mlb{color:var(--ink);font-weight:300}
  body.c07 .menu-list .mnote{color:var(--ink-soft)}
  body.c07 .menu-list a{border-bottom-color:var(--hair)}
  body.c07 .menu-list li:first-child a{border-top-color:var(--hair)}
  body.c07 .menu-list a:hover .mlb,body.c07 .menu-list a:focus-visible .mlb,body.c07 .menu-sub a:hover,body.c07 .menu-sub a:focus-visible{color:var(--leaf)}
  body.c07 .menu-close{color:var(--ink)}
  body.c07 .menu-close .x{color:var(--brass)}
  body.c07 .menu-foot{border-top-color:var(--hair)}
  body.c07 .menu .btn--ivory{background:var(--leaf);color:var(--ivory);border-color:var(--leaf)}
  body.c07 .menu .btn--ivory::after{background:var(--leaf-2)}
  /* the shared footer, re-voiced light: her pale grey ground, charcoal type, gold hairlines */
  body.c07 .foot{background:var(--linen);color:var(--ink-soft);border-top:1px solid var(--hair)}
  body.c07 .foot .lx-dusk{display:none}
  body.c07 .foot-brand .mark{color:var(--gold-ring)}
  body.c07 .foot-brand .foot-name{color:var(--ink);font-weight:300}
  body.c07 .foot-brand .foot-sub,body.c07 .foot-h,body.c07 .foot-contact .k,body.c07 .foot-bar{color:var(--brass)}
  body.c07 .foot-brand p{color:var(--ink-soft)}
  body.c07 .foot-nav a,body.c07 .foot-contact a{color:var(--ink)}
  body.c07 .foot-nav a:hover,body.c07 .foot-nav a:focus-visible,body.c07 .foot-contact a:hover{color:var(--leaf)}
  body.c07 .foot .tbc{color:var(--ink-soft)}
  body.c07 .foot-bar{border-top-color:var(--hair)}
  body.c07 .foot-bar a:hover{color:var(--ink)}
  body.c07 .bcard-title{font-weight:350}
  body.c07 .chap-rn{color:var(--brass)}
</style>

<style>
  /* ===== mobile progress bar + desktop chapter rail ===== */
  .c7-prog{position:fixed;top:0;left:0;right:0;height:2px;z-index:72;background:var(--gold-ring);transform:scaleX(0);transform-origin:left;pointer-events:none;display:none}
  .c7-rail{position:fixed;left:clamp(14px,2vw,28px);top:50%;transform:translateY(-50%);z-index:60;display:none;flex-direction:column;gap:12px;color:var(--ink);opacity:0;transition:opacity .5s ease}
  .c7-rail.on{opacity:1}
  .c7-rail:not(.on){pointer-events:none}
  .c7-rail[data-tone="film"],.c7-rail[data-tone="dark"]{color:var(--ivory)}
  .c7-rail a{display:flex;align-items:center;gap:.8rem;min-height:30px;color:inherit;font-family:var(--utility);font-weight:600;font-size:.58rem;letter-spacing:.2em;text-transform:uppercase}
  .c7-rail a i{display:block;width:7px;height:7px;border-radius:50%;border:1px solid currentColor;transition:transform .35s var(--ease),background .35s}
  .c7-rail a span{opacity:0;transform:translateX(-6px);transition:opacity .35s,transform .45s var(--ease);padding:.5em .85em .45em;border-radius:999px;background:rgba(252,251,248,.9);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  .c7-rail[data-tone="film"] a span,.c7-rail[data-tone="dark"] a span{background:rgba(18,46,31,.55)}
  .c7-rail a span b{font-family:var(--display);font-style:italic;font-weight:400;font-size:.8rem;letter-spacing:0;text-transform:none;margin-right:.2em}
  .c7-rail a:hover span,.c7-rail a:focus-visible span{opacity:1;transform:none}
  .c7-rail a[aria-current="true"] i{background:currentColor;transform:scale(1.4)}
  @media(min-width:1180px){.c7-rail{display:flex}}
  @media(max-width:1023px){.c7-prog{display:block}}

  /* ===== chapter cards · her curved sage band as the top edge; the curve eases flatter as the card rises (--cv, set by the script) ===== */
  .c7-ch{--cv:44px;--lip:12px;--c-bg:var(--ivory);position:relative;z-index:1;isolation:isolate;padding-block:var(--pad)}
  .c7-ch::before,.c7-ch::after{content:"";position:absolute;left:0;right:0;border-radius:50% 50% 0 0/var(--cv) var(--cv) 0 0;pointer-events:none}
  .c7-ch::before{top:calc(-1 * var(--lip));height:160px;background:var(--sage);z-index:-2}
  .c7-ch::after{top:0;bottom:0;background:var(--c-bg);z-index:-1;box-shadow:0 -26px 60px -34px rgba(44,48,44,.42)}
  .c7-light{position:absolute;inset:0;overflow:hidden;border-radius:50% 50% 0 0/var(--cv) var(--cv) 0 0;pointer-events:none;z-index:-1}
  .c7-ch--first{margin-top:calc(-1 * var(--peek))}
  .c7-ch--sage{--c-bg:var(--sage-band);--lip:0px}
  .c7-ch--sage::after{box-shadow:none}
  .c7-ch--dk{--c-bg:var(--leaf);color:rgba(252,251,248,.86)}
  .c7-ch--dk::after{box-shadow:0 -26px 60px -30px rgba(0,0,0,.5)}
  .c7-after{--lip:8px;padding-top:0;padding-bottom:0;margin-top:-1px}

  /* ===== I · mission · the four sentences unfold beside her most human photograph ===== */
  .c7-mis{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:clamp(2.4rem,6vw,6.5rem);align-items:center;position:relative}
  .c7-mis-h{font-size:clamp(2.6rem,5.2vw,4.8rem);font-weight:300;margin:0 0 clamp(1rem,1.8vw,1.4rem)}
  .c7-mis .kick{margin-bottom:clamp(1.6rem,2.8vw,2.4rem)}
  .c7-mis-s{font-family:var(--display);font-weight:300;font-size:clamp(1.12rem,1.5vw,1.42rem);line-height:1.5;color:var(--ink);max-width:25em;margin:0 0 1.1em;font-variation-settings:'opsz' 48,'SOFT' 50}
  .c7-mis-s--lead{font-size:clamp(1.5rem,2.4vw,2.2rem);line-height:1.3;max-width:19em;font-variation-settings:'opsz' 96,'SOFT' 60}
  .c7-mis-foot{display:flex;align-items:center;justify-content:space-between;gap:1.2rem 2rem;flex-wrap:wrap;margin-top:clamp(1.6rem,2.6vw,2.2rem);padding-top:1.2rem;border-top:1px solid var(--hair)}
