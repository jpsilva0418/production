    // her curved band: deep as a chapter enters, easing flatter as it rises into place
    const deep = small.matches ? 34 : 70, flat = small.matches ? 16 : 26;
    curves.forEach((c) => {
      const t = c.getBoundingClientRect().top;
      if (t > vh + 80 || t < -vh) return;
      const p = Math.min(1, Math.max(0, 1 - t / vh));
