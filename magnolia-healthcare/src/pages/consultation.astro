---
/** CONSULTATION — the current site's "Care starts here" page (banner + form), restaged
 *  on the Leti Silva Beauty "velvet table" split: sticky editorial panel (the banner copy
 *  and ways to reach Magnolia) beside the consultation form on a raised paper stage. */
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsultForm from '../components/ConsultForm.astro';
import { SITE, TBC } from '../consts';
---
<BaseLayout
  title="Free Consultation — Let’s Talk About the Care Your Family Needs"
  description="Tell us a little about your loved one. We’ll reach out to set up a free consultation and find the caregiver who fits them best. Magnolia Healthcare, Inc. — anywhere in Massachusetts."
  path="/consultation"
  headerLight>
  <section class="iq" id="iqSection" aria-label="Request a consultation">
    <div class="iq-l ghostwrap">
      <span class="ghost-w" aria-hidden="true">hello</span>
      <div class="iq-lc">
        <p class="iq-kick fade" id="iqKick">Free consultation</p>
        <h1 class="disp iq-t rv">Let&rsquo;s talk about the care your family needs.</h1>
        <p class="iq-line rv" id="iqLine" style="--d:.08s">Tell us a little about your loved one. We&rsquo;ll reach out to set up a free consultation and find the caregiver who fits them best.</p>
        <dl class="iq-ways rv" style="--d:.14s">
          <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          <div><dt>Call</dt><dd>{SITE.phone ? <a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a> : <span class="dim">{TBC}</span>}</dd></div>
          <div><dt>Area</dt><dd>{SITE.serviceArea.label}</dd></div>
          <div><dt>Cost</dt><dd>The consultation is free.</dd></div>
        </dl>
      </div>
    </div>
    <div class="iq-r lit">
      <i class="lx-dusk" aria-hidden="true"></i>
      <div class="iq-form-head">
        <span class="caps-xs rv">Care starts here</span>
        <h2 class="rv" style="--d:.06s">Your request</h2>
      </div>
      <div class="cf-stage fade" style="--d:.1s"><ConsultForm /></div>
      <p class="iq-assure fade" style="--d:.16s">Free consultation <i aria-hidden="true">&middot;</i> No marketing list <i aria-hidden="true">&middot;</i> {SITE.serviceArea.label}</p>
    </div>
  </section>
  <script is:inline>
    // The framing follows the ?for= parameter the form also reads, so a "Join our team"
    // CTA is introduced as such. Neutral wording renders without JS, so nothing misleads.
    (function () {
      var raw = (new URLSearchParams(location.search).get('for') || '').trim().toLowerCase();
      var frames = {
        care: { kick: 'Free consultation', line: 'Tell us a little about your loved one. We’ll reach out to set up a free consultation and find the caregiver who fits them best.' },
        self: { kick: 'Free consultation', line: 'Tell us a little about the support you’re considering. We’ll reach out to set up a free consultation.' },
      };
      var f = frames[raw]; if (!f) return;
      var k = document.getElementById('iqKick'), l = document.getElementById('iqLine');
      if (k) k.textContent = f.kick; if (l) l.textContent = f.line;
    })();
  </script>
</BaseLayout>
<style>
  .iq{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);background:var(--leaf)}
  .iq-l{position:sticky;top:0;height:100svh;background:var(--leaf);color:rgba(248,244,238,.88);display:flex;flex-direction:column;justify-content:center;overflow:hidden;
    padding:clamp(7rem,15vh,9rem) clamp(1.6rem,4.5vw,4.5rem) clamp(3rem,7vh,5rem) max(5vw,(100vw - var(--wrap))/2)}
  .iq-l .ghost-w{left:-2%;bottom:-.1em;font-size:clamp(7rem,15vw,13rem);-webkit-text-stroke-color:rgba(205,180,140,.2)}
  .iq-lc{position:relative;z-index:1}
  .iq-kick{display:flex;align-items:center;gap:1.3rem;font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.22em;font-size:.62rem;color:var(--gold-lt);margin:0 0 clamp(1.4rem,3vh,2.2rem)}
  .iq-kick::before{content:"";width:48px;height:1px;background:var(--hairdk-strong)}
  .iq-t{font-size:clamp(2.2rem,4.6vw,4rem)!important;font-size:clamp(3.2rem,6.4vw,6rem);color:var(--ivory);margin-bottom:clamp(1rem,2.4vh,1.6rem)}
  .iq-line{font-family:var(--display);font-style:italic;font-size:clamp(1.12rem,1.6vw,1.4rem);color:rgba(248,244,238,.85);max-width:22em;margin:0 0 clamp(2rem,4.5vh,3rem);font-variation-settings:'opsz' 48,'SOFT' 60}
  .iq-ways{margin:0;border-top:1px solid var(--hairdk)}
  .iq-ways div{display:grid;grid-template-columns:5.5em 1fr;gap:1rem;padding:.95em 0;border-bottom:1px solid var(--hairdk);font-size:.95rem}
  .iq-ways dt{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.2em;font-size:.58rem;color:var(--gold-lt);padding-top:.35em}
  .iq-ways dd{margin:0;color:rgba(248,244,238,.9);overflow-wrap:anywhere}
  .iq-ways dd a:hover{color:var(--gold-lt)}
  .iq-ways .dim{color:rgba(248,244,238,.6);font-size:.85rem}
  .iq-r{position:relative;background:linear-gradient(rgba(0,0,0,.18),rgba(0,0,0,.18)),var(--leaf);padding:clamp(7rem,15vh,9rem) max(5vw,(100vw - var(--wrap))/2) clamp(4rem,9vh,6rem) clamp(1.6rem,4.5vw,4.5rem)}
  .iq-form-head{position:relative;z-index:1;margin-bottom:clamp(1.8rem,3.4vw,2.6rem)}
  .iq-form-head .caps-xs{color:var(--gold-lt);display:block;margin-bottom:.8rem}
  .iq-form-head h2{font-size:clamp(1.8rem,2.6vw,2.4rem);color:var(--ivory)}
  .cf-stage{position:relative;z-index:1;max-width:660px;background:var(--paper);border:1px solid var(--hair);border-radius:var(--r-lg);padding:clamp(22px,3.4vw,44px);box-shadow:0 100px 170px -60px rgba(0,0,0,.8),0 34px 70px -34px rgba(0,0,0,.5)}
  .iq-assure{margin:clamp(1.6rem,3vw,2.2rem) 0 0;max-width:660px;position:relative;z-index:1;text-align:center;font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.22em;font-size:.56rem;line-height:2.3;color:var(--gold-lt)}
  .iq-assure i{font-style:normal;opacity:.7;padding:0 .6em}
  @media(max-width:899px){
    .iq{grid-template-columns:1fr}
    .iq-l{position:relative;top:auto;height:auto;min-height:0;padding:clamp(6.5rem,16vh,8rem) 5vw clamp(3rem,9vw,4rem)}
    .iq-r{padding:clamp(3rem,8vw,4rem) 5vw clamp(4rem,10vw,5.5rem)}
    .cf-stage,.iq-assure{margin-inline:auto}
  }
</style>
