---
/** OUR MISSION — the current site's "Our Mission" statement, restaged as an editorial
 *  story (the Leti Silva Beauty About-page system: title card, "the story" with drop cap
 *  and pull quote, cinema band, sticky values chapter). The statement is the client's
 *  own, verbatim; nothing is paraphrased into a new claim. The founder's portrait is
 *  the woman at the centre of the supplied team photo — her name and biography are
 *  supplied by Magnolia, never guessed. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import { SITE, TBC } from '../consts';
---
<BaseLayout
  title="Our Mission — Dedicated Professionals at Your Service"
  description="Our mission is to provide a higher standard of care — one built on compassion, excellence, and respect for every individual. Magnolia Healthcare, Inc., a Massachusetts home care agency."
  path="/mission">

  <!-- TITLE CARD -->
  <section class="acov">
    <div class="acov-l">
      <p class="cov-kick fade">Our mission</p>
      <h1 class="disp rv">Dedicated professionals<br /><span class="ital">at your service.</span></h1>
      <p class="cov-sub rv" style="--d:.1s">Our mission is to provide a higher standard of care &mdash; one built on compassion, excellence, and respect for every individual.</p>
      <div class="cov-cta fade" style="--d:.2s">
        <a class="btn btn--solid" href={SITE.links.consultCare}>Free consultation</a>
        <a class="tlk" href={SITE.links.services}>Our services</a>
      </div>
    </div>
    <div class="acov-r">
      <figure class="portrait rv">
        <div class="portrait-fr"><Plate id="founder" alt="The founder of Magnolia Healthcare, Inc." class="lv lv--breathe" sizes="(max-width:899px) 76vw, 380px" widths={[480, 560]} loading="eager" fetchpriority="high" /><i class="grain" aria-hidden="true"></i></div>
        <figcaption><span class="caps-xs">Founder &middot; {SITE.founder ?? TBC}</span><em>From the supplied team photograph. Name and biography to be supplied by Magnolia.</em></figcaption>
      </figure>
    </div>
  </section>

  <div class="chapslate fade" role="presentation"><span class="cs-t">The mission</span></div>

  <!-- THE STORY (verbatim mission statement) -->
  <section class="sec lit">
    <i class="lx-shaft" aria-hidden="true"></i>
    <div class="wrap">
      <div class="story">
        <span class="caps-xs story-k rv">Why Magnolia exists</span>
        <p class="drop rv" style="--d:.07s">Our mission is to provide a higher standard of care &mdash; one built on compassion, excellence, and respect for every individual.</p>
        <p class="rv">We believe caring for someone means seeing the person beyond their needs and creating an environment where they feel safe, valued, and understood.</p>
        <div class="story-pull rv"><p>&ldquo;Because every life matters.&rdquo;</p></div>
        <p class="rv">Our caregivers are thoughtfully selected, trained, and committed to bringing warmth, dignity, and genuine human connection into every home.</p>
        <p class="rv">We are committed to delivering exceptional care, maintaining the highest standards, and being a trusted partner to every client and family we serve.</p>
      </div>
    </div>
  </section>

  <!-- THE TEAM -->
  <section class="sec sec--linen sec--tight">
    <div class="wrap">
      <figure class="tm-hero rv-im"><div class="ph ph--framed"><Plate id="supplied-team-5" alt="The Magnolia Healthcare team" class="lv" sizes="(max-width:899px) 92vw, 760px" widths={[480, 652]} /><i class="grain" aria-hidden="true"></i></div><figcaption class="caps-xs">The Magnolia team &middot; supplied imagery &middot; names and roles to be confirmed by Magnolia</figcaption></figure>
    </div>
  </section>

  <div class="chapslate chapslate--dk fade" role="presentation"><span class="cs-t">What guides us</span></div>

  <!-- THE VALUES · sticky chapter (the three words of the mission statement) -->
  <section class="sec sec--dk lit">
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="wrap chap" style="position:relative;z-index:1">
      <div class="chap-l rv">
        <p class="chap-rn">What guides us</p>
        <h2 class="disp chap-t">A higher standard of care.</h2>
        <p class="chap-line">Three words from our mission that shape every visit and every relationship.</p>
        <a class="tlk tlk--lt" href={SITE.links.careers}>Join our team</a>
      </div>
      <div class="vals" data-stag=".1">
        <article class="val rv">
          <span class="val-n">i.</span>
          <h3>Compassion</h3>
          <p>Caring for someone means seeing the person beyond their needs and creating an environment where they feel safe, valued, and understood.</p>
        </article>
        <article class="val rv">
          <span class="val-n">ii.</span>
          <h3>Excellence</h3>
          <p>We are committed to delivering exceptional care and maintaining the highest standards.</p>
        </article>
        <article class="val rv">
          <span class="val-n">iii.</span>
          <h3>Respect</h3>
          <p>Our caregivers bring warmth, dignity, and genuine human connection into every home.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- THE NEXT STEP -->
  <section class="sec">
    <div class="wrap">
      <div class="note-card rv">
        <span class="caps">Care starts here</span>
        <p class="note-copy">Let&rsquo;s talk about the care your family needs.</p>
        <span class="note-rule" aria-hidden="true"></span>
        <p class="note-body">Tell us a little about your loved one. We&rsquo;ll reach out to set up a free consultation and find the caregiver who fits them best.</p>
        <div class="note-act">
          <a class="btn btn--solid" href={SITE.links.consultCare}>Free consultation</a>
          <a class="tlk" href={SITE.links.services}>Explore our care</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .acov{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);min-height:92svh}
  .acov-l{display:flex;flex-direction:column;justify-content:center;padding:clamp(7rem,16vh,10rem) clamp(1.6rem,5vw,5.5rem) clamp(3.6rem,8vh,6rem) max(5vw,(100vw - var(--wrap))/2)}
  .acov-l h1{font-size:clamp(2.8rem,6.4vw,5.8rem);margin-bottom:clamp(1.2rem,2.4vh,1.8rem)}
  .acov-r{position:relative;display:grid;place-items:center;align-content:center;padding:clamp(3rem,7vh,5.5rem) clamp(1.8rem,4vw,4rem);background:var(--linen)}
  .portrait{position:relative;width:min(380px,78%);margin:0}
  .portrait-fr{position:relative;aspect-ratio:4/5;border-radius:999px 999px var(--r) var(--r);overflow:hidden;outline:1px solid var(--brass);outline-offset:11px;box-shadow:var(--shadow-lg)}
  .portrait-fr :global(img){width:100%;height:100%;object-fit:cover}
  .portrait figcaption{margin-top:1.8rem;text-align:center}
  .portrait figcaption .caps-xs{display:block}
  .portrait figcaption em{display:block;font-family:var(--display);font-style:italic;font-size:.95rem;color:var(--ink-soft);margin-top:.3rem;font-variation-settings:'opsz' 48,'SOFT' 60}
  @media(max-width:899px){
    .acov{grid-template-columns:1fr;min-height:0}
    .acov-r{order:-1;padding:clamp(6.5rem,18vw,8rem) 5vw clamp(2rem,5vw,3rem)}
    .acov-l{padding:clamp(3rem,9vw,4.5rem) 5vw clamp(3.4rem,10vw,5rem)}
  }
  .story{max-width:640px;margin-inline:auto}
  .story-k{text-align:center;display:block;margin-bottom:clamp(2.4rem,4.5vw,3.6rem)}
  .story p{font-size:clamp(1.12rem,1.5vw,1.26rem);line-height:1.9;color:var(--ink-soft);margin:0}
  .story p+p{margin-top:1.5em}
  .story .drop::first-letter{font-family:var(--display);float:left;font-size:4.4em;line-height:.8;padding:.06em .12em 0 0;color:var(--leaf);font-variation-settings:'opsz' 144,'SOFT' 50}
  .story-pull{margin:clamp(2.8rem,5vw,4rem) 0;padding:clamp(1.8rem,3.4vw,2.6rem) 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);text-align:center}
  .story-pull p{font-family:var(--display);font-style:italic;font-size:clamp(1.4rem,2.3vw,1.9rem);line-height:1.5;color:var(--leaf);max-width:20em;margin-inline:auto;font-variation-settings:'opsz' 72,'SOFT' 60}
  .story-pull+p{margin-top:0}
  .tm-hero{margin:0;width:min(760px,100%);margin-inline:auto}
  .tm-hero .ph{aspect-ratio:652/452}
  .tm-hero figcaption{margin-top:1.2rem;text-align:center;display:block}
  .vals{display:grid;gap:clamp(1.6rem,3vw,2.6rem)}
  .val{border-top:1px solid var(--hairdk);padding-top:1.4rem;display:grid;grid-template-columns:2.4em 1fr;column-gap:.6rem}
  .val-n{font-family:var(--display);font-style:italic;color:var(--gold-lt);font-size:1.1rem;padding-top:.3rem}
  .val h3{font-size:clamp(1.5rem,2.2vw,2rem);margin-bottom:.7rem;grid-column:2}
  .val p{grid-column:2;max-width:34em;color:rgba(248,244,238,.8)}
  .note-body{max-width:34em;margin:0 auto clamp(1.8rem,3.4vw,2.6rem)}
  .note-act{display:flex;justify-content:center;align-items:center;gap:2rem;flex-wrap:wrap}
</style>
