---
/** OUR CAREGIVERS — the current site's "Our Caregivers" content, staged for a premium
 *  care organisation. Only one person is named on the current site (the founder).
 *  Caregiver tiles are UNMISTAKABLE placeholders: no names, no titles, no credentials. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import { SITE } from '../consts';
const placeholders = ['team-1', 'team-2', 'team-3'];
---
<BaseLayout
  title="Our Caregivers — Selected, Trained, Trusted"
  description="Magnolia Healthcare’s team of dedicated caregivers is carefully selected, extensively trained, and has undergone thorough state and federal background checks — committed to the highest quality home care."
  path="/team">

  <section class="cov ghostwrap">
    <span class="ghost-w" aria-hidden="true">people</span>
    <div class="cov-c">
      <p class="cov-kick fade">Our caregivers</p>
      <h1 class="disp rv">Selected with care.<br /><span class="ital">Trained for you.</span></h1>
      <p class="cov-sub rv" style="--d:.08s">Our team of dedicated caregivers is committed to providing the highest quality home care services. Each member is carefully selected and goes through extensive training to meet the unique needs of our clients.</p>
      <div class="cov-cta fade" style="--d:.16s">
        <a class="btn btn--solid" href={SITE.links.consultCare}>Request a consultation</a>
        <a class="tlk" href={SITE.links.careers}>Join our team</a>
      </div>
    </div>
  </section>

  <!-- THE FOUNDER -->
  <section class="sec sec--linen">
    <div class="wrap fd-grid">
      <figure class="fd-fig rv-im"><div class="ph ph--framed fd-ph"><Plate id="founder" alt="" class="lv lv--breathe" sizes="(max-width:899px) 86vw, 420px" widths={[480, 720, 960]} /><i class="grain" aria-hidden="true"></i></div><figcaption class="fade" style="--d:.14s">Portrait placeholder &mdash; real photograph to be supplied</figcaption></figure>
      <div class="fd-copy">
        <span class="caps rv">Founder</span>
        <h2 class="disp rv" style="--d:.06s">{SITE.founder}</h2>
        <p class="lede rv" style="--d:.1s">Founder of Magnolia Healthcare, established in {SITE.founded}.</p>
        <p class="rv" style="--d:.14s">Madina started Magnolia with a genuine desire to make a difference in the lives of individuals who require non-medical home care, drawing on a background in healthcare and special education for those with unique needs. She is also committed to organizing community events that promote engagement, nurture relationships, and emphasize the value of mutual support.</p>
        <a class="arrow-link fade" style="--d:.2s" href={SITE.links.mission}>Read the mission <span class="arr" aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <div class="chapslate fade" role="presentation"><span class="cs-t">What every caregiver brings</span></div>

  <!-- STANDARDS (existing claims only) -->
  <section class="sec sec--tight">
    <div class="wrap std-grid" data-stag=".08">
      <article class="card std rv"><span class="std-n">i.</span><h3>Carefully selected</h3><p>Each member of our team is carefully selected to ensure they are qualified to meet the unique needs of our clients.</p></article>
      <article class="card std rv"><span class="std-n">ii.</span><h3>Extensively trained</h3><p>Caregivers go through extensive training, with ongoing training and development so they have the knowledge and skills to provide the highest level of care.</p></article>
      <article class="card std rv"><span class="std-n">iii.</span><h3>Background-checked</h3><p>Our caregivers have undergone thorough state and federal background checks to ensure the safety and well-being of our clients.</p></article>
    </div>
  </section>

  <!-- THE TEAM — placeholders, unmistakably -->
  <section class="sec sec--blush sec--tight">
    <div class="wrap">
      <div class="tm-head">
        <div><p class="caps rv">The caregiving team</p><h2 class="disp rv" style="--d:.06s">The people behind the care.</h2></div>
        <p class="ital tm-note rv" style="--d:.1s">The current website does not name individual caregivers. These tiles are placeholders for the profiles Magnolia chooses to share &mdash; names, roles and photographs will be supplied by Magnolia, never invented.</p>
      </div>
      <div class="tm-grid" data-stag=".08">
        {placeholders.map((p, i) => (
          <article class="tm card rv" aria-label={`Caregiver profile placeholder ${i + 1}`}>
            <div class="ph tm-ph"><Plate id={p} alt="" sizes="(max-width:599px) 92vw, 300px" widths={[400, 640, 900]} /></div>
            <div class="tm-body">
              <span class="plaque">Placeholder</span>
              <h3>Caregiver profile</h3>
              <p>Name, role and photograph to be provided by Magnolia Healthcare.</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- JOIN -->
  <section class="sec sec--dk lit">
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="wrap join" style="position:relative;z-index:1">
      <span class="caps-xs fade">Careers</span>
      <h2 class="disp rv">Make a significant difference &mdash; join our expanding team.</h2>
      <p class="join-line rv" style="--d:.08s">Tailored schedules, meaningful work, and continuous professional development. Help clients maintain their safety and independence at home.</p>
      <div class="join-cta fade" style="--d:.14s">
        <a class="btn btn--ivory" href={SITE.links.apply}>Apply to join Magnolia</a>
        <a class="tlk tlk--lt" href={`tel:${SITE.phoneE164}`}>Call {SITE.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .fd-grid{display:grid;grid-template-columns:minmax(260px,420px) 1fr;column-gap:clamp(3rem,7vw,7rem);align-items:center}
  .fd-fig{margin:0}
  .fd-ph{aspect-ratio:4/5}
  .fd-fig figcaption{margin-top:1.4rem;text-align:center;font-family:var(--display);font-style:italic;font-size:.95rem;color:var(--ink-soft)}
  .fd-copy .caps{display:block;margin-bottom:1rem}
  .fd-copy .disp{font-size:clamp(2.4rem,4.6vw,4.2rem);margin-bottom:1.2rem}
  .fd-copy .lede{margin-bottom:1.2rem;font-family:var(--display);font-variation-settings:'opsz' 48,'SOFT' 50}
  .fd-copy p{max-width:36em}
  .fd-copy .arrow-link{margin-top:1.6rem}
  @media(max-width:899px){.fd-grid{grid-template-columns:1fr;row-gap:2.2rem}.fd-fig{width:min(380px,100%);margin-inline:auto}}
  .std-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.6rem)}
  .std{padding:clamp(1.6rem,2.8vw,2.2rem)}
  .std-n{display:block;font-family:var(--display);font-style:italic;color:var(--brass);font-size:1.15rem;margin-bottom:1rem}
  .std h3{font-size:1.4rem;margin-bottom:.7rem}
  .std p{font-size:.95rem}
  @media(max-width:719px){.std-grid{grid-template-columns:1fr}}
  .tm-head{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap;margin-bottom:clamp(2rem,3.6vw,3rem)}
  .tm-head .caps{display:block;margin-bottom:.6rem}
  .tm-head .disp{font-size:clamp(2rem,3.6vw,3.2rem)}
  .tm-note{margin:0;max-width:30em;font-size:1.02rem;color:var(--ink-soft);font-variation-settings:'opsz' 48,'SOFT' 60}
  .tm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.6rem)}
  .tm{overflow:hidden}
  .tm-ph{aspect-ratio:4/5;border-radius:var(--r) var(--r) 0 0}
  .tm-body{padding:1.3rem 1.5rem 1.6rem}
  .tm-body .plaque{margin-bottom:.9rem}
  .tm-body h3{font-size:1.3rem;margin-bottom:.4rem}
  .tm-body p{font-size:.9rem;color:var(--ink-soft)}
  @media(max-width:899px){.tm-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:599px){.tm-grid{grid-template-columns:1fr}}
  .join{text-align:center;max-width:800px;margin-inline:auto}
  .join .caps-xs{display:block;margin-bottom:1.4rem}
  .join .disp{font-size:clamp(2rem,4vw,3.6rem);margin-bottom:1.4rem}
  .join-line{font-family:var(--display);font-style:italic;font-size:1.12rem;color:rgba(248,244,238,.82);max-width:30em;margin:0 auto 2.2rem;font-variation-settings:'opsz' 48,'SOFT' 60}
  .join-cta{display:flex;justify-content:center;align-items:center;gap:2.2rem;flex-wrap:wrap}
</style>
