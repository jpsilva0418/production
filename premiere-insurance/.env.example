# Premiere Insurance — environment. Placeholders only; real values live in the host's
# encrypted environment settings and are never committed. Nothing here is NEXT_/PUBLIC_
# unless it is safe for a browser to read.

# ── Site ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://www.premiereinsuranceinc.com
# Shows a "Demo preview" strip and adds noindex. Keep true on any non-production host.
PUBLIC_DEMO_BANNER=true

# Existing third-party integrations from the live site. OFF by default so a demo on another
# domain never writes into the business's analytics or its real chat inbox.
PUBLIC_ENABLE_GTM=false
PUBLIC_ENABLE_CALLBELL=false
PUBLIC_ENABLE_ELFSIGHT=false

# ── Lead storage (required for any inquiry to be accepted) ───────────────────
# Postgres connection string (Supabase "session pooler" URL works). Without it the form
# and assistant say plainly that online inquiries are unavailable and point to phone/WhatsApp.
DATABASE_URL=
IP_HASH_SALT=change-me-to-a-long-random-string

# ── Routing: who receives which queue (comma-separated addresses) ────────────
# Unset queues fall back to LEAD_ROUTE_GENERAL. CONFIRM THESE WITH THE AGENCY.
LEAD_ROUTE_PERSONAL=
LEAD_ROUTE_COMMERCIAL=
LEAD_ROUTE_GENERAL=
# Who is told when a lead could not be delivered after every retry.
LEAD_ALERT_EMAIL=

# ── Email delivery (Resend). Both are needed, and the From domain must be verified ──
RESEND_API_KEY=
LEADS_FROM_EMAIL="Premiere Insurance Website <leads@your-verified-domain.com>"

# ── Optional: push every lead to a CRM endpoint (signed JSON POST) ───────────
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Staff lead inbox (/staff/leads) and the retry job ────────────────────────
STAFF_INBOX_TOKEN=
CRON_SECRET=

# ── Assistant brain ──────────────────────────────────────────────────────────
# Unset: the guided engine (no AI provider, no cost). Set: Claude answers, with the guided
# engine as automatic fallback. PAID — needs approval before it is switched on.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# ── Phone-answering AI intake (/api/phone/lead). OFF unless set. ─────────────
# Never set this before the telephony plan in docs/PHONE.md is approved.
PHONE_WEBHOOK_SECRET=
