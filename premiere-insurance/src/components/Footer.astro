---
import { site, assets } from '../content/site';
import { t, homePath, pagePath, localeName, locales, type Locale } from '../i18n';
interface Props { locale: Locale; alternates: Record<Locale, string>; }
const { locale, alternates } = Astro.props;
const d = t(locale);
---
<footer class="site-footer on-dark">
  <div class="wrap site-footer__inner">
    <img src={assets.logoFooter} alt={`${site.name} Agency`} width="200" height="70" loading="lazy" />
    <div class="site-footer__cols">
      <div>
        <h2>{d.footer.changeLanguage}</h2>
        <ul>
          {locales.filter((l) => l !== locale).map((l) => (
            <li><a href={alternates[l]} lang={l === 'pt' ? 'pt-BR' : l} hreflang={l} data-set-lang={l}>{localeName[l]}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>{d.footer.about}</h2>
        <ul>
          <li><a class="is-accent" href={homePath(locale)}>{d.footer.home}</a></li>
          <li><a href={pagePath(locale, 'privacy-policy')}>{d.footer.terms}</a></li>
          <li><a href={`tel:${site.phone.e164}`}>{site.phone.display}</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__fine">
      <p>{d.footer.aiNote}</p>
      <p>Copyright © {new Date().getFullYear()} {d.footer.copyright}</p>
    </div>
  </div>
</footer>
