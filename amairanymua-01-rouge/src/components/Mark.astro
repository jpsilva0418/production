---
/** The Rouge mark — a monogram "AS" inside a thin ring, in the display serif.
 *  Concept styling only: Amairany has no logo file, and the footer says so. Every placement
 *  goes through this one component, so an official mark would be a one-file swap. */
interface Props { class?: string; title?: string }
const { class: cls = 'mark', title } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1.2" opacity=".9" />
  <circle cx="32" cy="32" r="26.5" stroke="currentColor" stroke-width=".6" opacity=".45" />
  <text x="32" y="40.5" text-anchor="middle" fill="currentColor" font-family="'Fraunces Variable','Iowan Old Style',Georgia,'Times New Roman',serif" font-size="23" font-style="italic" letter-spacing="-.5">AS</text>
</svg>
