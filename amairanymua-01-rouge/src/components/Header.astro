---
/** Site header + full-screen menu. Desktop: the lockup, three sections, her Instagram and a
 *  "Book" button to the Book page. Phone: lockup + MENU; the menu carries the bridal inquiry,
 *  event booking, Instagram, TikTok, Google reviews and email, so every way to reach her is one
 *  tap away. She has published no phone number, so there is none.
 *  Variants: `light` over dark heroes, `prologue` fades in after the title card.
 *  Menu logic lives in BaseLayout's shared runtime; without JavaScript MENU jumps to the
 *  footer's navigation instead. */
import Mark from './Mark.astro';
import { SITE, NAV, LINKS, SOCIAL, L, HER, book } from '../consts';
interface Props { light?: boolean; prologue?: boolean; current?: string }
const { light = false, prologue = false, current = '' } = Astro.props;
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
const primary = NAV.filter((n) => n.href !== LINKS.book);
const numerals = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.'];
---
<header class:list={['hd', { 'hd--lt': light, 'hd--plg': prologue }]} id="siteHeader">
  <div class="hd-in">
    <a class="hd-logo" href={LINKS.home} aria-label={`${SITE.name} — home`}>
      <Mark />
      <span class="wm" aria-hidden="true"><span class="wm-name">{HER.brand.script}</span><span class="wm-sub">{HER.brand.caps}</span></span>
    </a>
    <nav class="hd-nav" aria-label="Primary">
      {primary.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="hd-tools">
      <a class="hd-phone" href={L.ig} rel="external">{SITE.handle}</a>
      <a class="btn btn--solid hd-cta" href={LINKS.book} aria-current={isCurrent(LINKS.book) ? 'page' : undefined}>Book</a>
      <button class="menu-btn js-only" id="menuOpen" aria-expanded="false" aria-controls="menu">Menu <span class="bars" aria-hidden="true"><i></i><i></i></span></button>
      <a class="menu-btn nojs-only" href="#foot-nav">Menu <span class="bars" aria-hidden="true"><i></i><i></i></span></a>
    </div>
  </div>
</header>
<nav class="menu" id="menu" aria-label="Main menu" aria-hidden="true" inert>
  <div class="menu-top">
    <a class="hd-logo" href={LINKS.home} aria-label={`${SITE.name} — home`} tabindex="-1">
      <Mark />
      <span class="wm" aria-hidden="true"><span class="wm-name">{HER.brand.script}</span><span class="wm-sub">{HER.brand.caps}</span></span>
    </a>
    <button class="menu-close" id="menuClose">Close <span class="x" aria-hidden="true">&times;</span></button>
  </div>
  <div class="menu-body">
    <ul class="menu-list">
      <li><a href={LINKS.home} aria-current={current === LINKS.home ? 'page' : undefined}><span class="mrn">{numerals[0]}</span><span class="mlb">Home</span><span class="mnote">Start here</span></a></li>
      {NAV.map((n, i) => (
        <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}><span class="mrn">{numerals[i + 1]}</span><span class="mlb">{n.label}</span><span class="mnote">{n.note}</span></a></li>
      ))}
    </ul>
    <div class="menu-sub">
      {SOCIAL.map((s) => <a href={s.href} rel="external">{s.label}{s.key !== 'google' && <> {s.value}</>}</a>)}
      <a href={L.mail}>Email</a>
    </div>
    <div class="menu-cta">
      <a class="btn btn--ivory" href={LINKS.inquiry}>Bridal inquiry</a>
      <Fragment set:html={book('event', 'Book event glam', 'btn btn--ghost')} />
    </div>
  </div>
  <div class="menu-foot">
    <span>{SITE.name}</span>
    <span>Hair + Makeup · {SITE.area}</span>
  </div>
</nav>
