---
import { resolveSeo, type SeoInput } from '../lib/seo';
import { SITE, A } from '../consts';
interface Props extends SeoInput { inquiry?: boolean }
const { inquiry = false, ...rest } = Astro.props;
const seo = resolveSeo(rest);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content="noindex,nofollow,noarchive">
<link rel="canonical" href={seo.canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={`${SITE.name} · design preview`} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={`A website concept for ${SITE.handle} by JP Silva Digital. Design preview, not the official website.`} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href={`${A}/img/favicon.svg`} type="image/svg+xml" />
<meta name="theme-color" content="#0D0D0D" />
<link rel="stylesheet" href={`${A}/css/marker.css`}>
{inquiry && <link rel="stylesheet" href={`${A}/css/inquiry-core.css`}>}
<slot />
