---
/* The only place a tracking script may be added. Renders nothing at all when
   no IDs are configured, so the default build ships zero tracking bytes and
   sets no cookies. See src/lib/analytics.ts for the variables. */
import { GA_ID, ADS_ID, PIXEL_ID, hasAnalytics } from '../lib/analytics';
const gtagId = GA_ID || ADS_ID;
---
{/* The ids travel as data-* attributes and are read back with
    document.currentScript.dataset, deliberately NOT with `define:vars`.

    define:vars interpolates the value into the body of a <script>, and the
    sanitiser that is supposed to neutralise a `</script>` sequence in that
    position is incomplete in every Astro release up to 7.2.7
    (GHSA-j687-52p2-xcff). Nothing attacker-controlled reaches here — these
    are JP's own environment variables and the build is fully static — so it
    was not exploitable. But an attribute value is escaped by the ordinary,
    patched path, the runtime behaviour is identical, and this stops the
    question arising again the moment a real measurement id is set. */}
{hasAnalytics && (
  <>
    {gtagId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
        <script is:inline data-ga={GA_ID} data-ads={ADS_ID}>
          (function () {
            var ids = document.currentScript.dataset;
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            if (ids.ga) gtag('config', ids.ga);
            if (ids.ads) gtag('config', ids.ads);
          })();
        </script>
      </>
    )}

    {PIXEL_ID && (
      <script is:inline data-pixel={PIXEL_ID}>
        var jpPixelId = document.currentScript.dataset.pixel;
        !function (f, b, e, v, n, t, s) {
          if (f.fbq) return; n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
          t = b.createElement(e); t.async = !0; t.src = v;
          s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
        }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', jpPixelId);
        fbq('track', 'PageView');
      </script>
    )}
  </>
)}

<script>
  /* Delegated click tracking for [data-track] elements. Loads either way:
     with no tags configured every call is a no-op, which keeps the markup
     identical between a tracked and an untracked build. */
  import { bindDelegatedTracking } from '../lib/analytics';
  bindDelegatedTracking();
</script>
