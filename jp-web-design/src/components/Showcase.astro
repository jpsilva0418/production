---
/* ==========================================================================
   SHOWCASE — the hero's proof surface, in three layouts.
   Replaces the fictional before/after slider with real project recordings.
   The copy, CTAs, ticker and tilt/magnet script around it are unchanged;
   this component only fills the figure slot.

   variant="laptop"  one MacBook, projects rotate inside its screen
   variant="phones"  three phones fanned in 3D, the front one plays
   variant="hybrid"  MacBook for the websites + one phone for the software

   Every clip was cut from a phone recording (512×1000 after cropping the
   status bar), so inside a laptop screen it sits in a phone-shaped view
   over a soft blurred backdrop of its own poster. When desktop recordings
   exist, drop them in and remove the `.mac__view` sizing — nothing else
   changes.

   Progressive enhancement, same rule as the rest of the page: without JS
   the first clip's poster shows in a finished frame; nothing is hidden.
   ========================================================================== */
export interface Props { variant: 'laptop' | 'phones' | 'hybrid' }
const { variant } = Astro.props;

/* Honest labels, same system as the plates: IN SERVICE means live client
   work; IN DEVELOPMENT means not yet public. Change here, never in markup. */
const sites = [
  { name: 'Leti Silva Beauty',   kind: 'Bridal makeup studio', type: 'Website',
    url: 'letisilvabeauty.com',  clip: 'leti',        bg: '#2a211c', light: false, tag: 'In service' },
  { name: 'V Cleaning Services', kind: 'Family cleaning company', type: 'Website',
    url: 'vcleaningservices.com', clip: 'vcleaning',  bg: '#d9e9f6', light: true,  tag: 'In service' },
  { name: 'Behold Money',        kind: 'Personal finance app', type: 'Software',
    url: 'beholdmoney.com',       clip: 'beholdmoney', bg: '#1a1530', light: false, tag: 'In development' },
];
/* The hybrid's phone shows the software itself, not its landing page. */
const app = { name: 'Behold', kind: 'Finance app · Software', clip: 'behold' };

const tick = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 8.5 15 16 5.5"/></svg>`;
---
<figure class={`sc sc--${variant}`} data-anim style="--d:480ms" id="shotWrap" data-showcase>

  {variant !== 'phones' && (
  <div class="hyb">
    <div class="mac" id="shotFrame">
      <div class="mac__lid">
        <div class="mac__screen">
          <div class="mac__bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <p class="mac__url" data-sc-url>{sites[0].url}</p>
          </div>
          <div class="mac__stage" data-sc-stage style={`background:${sites[0].bg}`}>
            {sites.map((s, i) => (
              <img class:list={['mac__bd', { on: i === 0 }]} src={`/media/${s.clip}.jpg`} alt="" aria-hidden="true" loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
            <div class="mac__view">
              {sites.map((s, i) => (
                <video class:list={['sc__clip', { on: i === 0 }]} data-i={i} data-name={s.name} data-kind={s.kind}
                       data-type={s.type} data-url={s.url} data-tag={s.tag} data-bg={s.bg} data-light={s.light ? '1' : ''}
                       poster={`/media/${s.clip}.jpg`} muted playsinline preload={i === 0 ? 'auto' : 'none'}
                       aria-label={`Screen recording of ${s.name}`}>
                  <source src={`/media/${s.clip}.mp4`} type="video/mp4" />
                  <source src={`/media/${s.clip}.webm`} type="video/webm" />
                </video>
              ))}
            </div>
            <span class="mac__note" aria-hidden="true">Mobile view · real site</span>
          </div>
        </div>
      </div>
      <div class="mac__base" aria-hidden="true"></div>
    </div>
    {variant === 'hybrid' && (
      <div class="solo" aria-label={`${app.name}, the app itself`}>
        <div class="ph ph--solo">
          <div class="ph__scr">
            <video class="sc__loop" poster={`/media/${app.clip}.jpg`} muted playsinline loop preload="metadata"
                   aria-label={`Screen recording of the ${app.name} app`}>
              <source src={`/media/${app.clip}.mp4`} type="video/mp4" />
              <source src={`/media/${app.clip}.webm`} type="video/webm" />
            </video>
          </div>
        </div>
        <p class="solo__cap"><strong>{app.name}</strong><span>{app.kind}</span></p>
      </div>
    )}
  </div>
  )}

  {variant === 'phones' && (
    <div class="fan" id="shotFrame">
      <span class="fan__glow" data-sc-stage aria-hidden="true"></span>
      {sites.map((s, i) => (
        <div class="ph" data-role={i === 0 ? 'front' : i === 1 ? 'left' : 'right'} data-slot={i}>
          <div class="ph__scr">
            <video class:list={['sc__clip', { on: true }]} data-i={i} data-name={s.name} data-kind={s.kind}
                   data-type={s.type} data-url={s.url} data-tag={s.tag} data-bg={s.bg} data-light={s.light ? '1' : ''}
                   poster={`/media/${s.clip}.jpg`} muted playsinline preload={i === 0 ? 'auto' : 'metadata'}
                   aria-label={`Screen recording of ${s.name}`}>
              <source src={`/media/${s.clip}.mp4`} type="video/mp4" />
              <source src={`/media/${s.clip}.webm`} type="video/webm" />
            </video>
          </div>
        </div>
      ))}
    </div>
  )}


  <figcaption class="sc__cap" aria-live="polite">
    <strong data-sc-name>{sites[0].name}</strong>
    <span data-sc-kind>{sites[0].kind} · {sites[0].type}</span>
    <span class="sc__tag" data-sc-tag>{sites[0].tag}</span>
  </figcaption>

  <div class="sc__tabs" role="tablist" aria-label="Projects">
    {sites.map((s, i) => (
      <button class="sc__tab" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>
        <span class="sc__bar" aria-hidden="true"></span>{s.name}
      </button>
    ))}
  </div>
</figure>

<style>
  .sc { position: relative; max-width: 56rem; margin: clamp(2.5rem, 5vw, 3.5rem) auto 0; perspective: 1400px; }
  .js-anim .sc[data-anim] { transform: translateY(46px) rotateX(9deg); }
  .js-anim .sc[data-anim].in { transform: none; transition-duration: .9s; }
  .sc__clip, .sc__loop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sc__clip { opacity: 0; transition: opacity .7s var(--ease); }
  .sc__clip.on { opacity: 1; }

  /* ------------------------------------------------------------ laptop */
  .mac { position: relative; margin-inline: auto; max-width: 44rem; transform-style: preserve-3d; will-change: transform; transition: transform .3s var(--ease); }
  .mac__lid {
    background: #11141b; border-radius: 1.1rem 1.1rem .3rem .3rem; padding: 2.6% 2.6% 3.2%;
    box-shadow: 0 40px 80px -30px rgba(16, 24, 43, .35);
  }
  .mac__screen { position: relative; aspect-ratio: 16 / 10; border-radius: .3rem; overflow: hidden; background: #000; }
  .mac__base { height: 1rem; margin-inline: -6%; background: linear-gradient(#d4d9e3, #a7aebc); border-radius: 0 0 1rem 1rem; position: relative; }
  .mac__base::before { content: ""; position: absolute; left: 50%; top: 0; width: 15%; height: .4rem; transform: translateX(-50%); background: #9aa1ae; border-radius: 0 0 .5rem .5rem; }
  .mac__bar {
    position: absolute; inset: 0 0 auto 0; height: 9%; z-index: 3;
    display: flex; align-items: center; gap: .4rem; padding-inline: 3%;
    background: #fafbfe; border-bottom: 1px solid var(--rule);
  }
  .mac__bar > span { width: .5rem; height: .5rem; border-radius: 50%; flex: none; }
  .mac__bar > span:nth-child(1) { background: #f6b1ab; }
  .mac__bar > span:nth-child(2) { background: #f3d9a0; }
  .mac__bar > span:nth-child(3) { background: #b6e3c6; }
  .mac__url {
    margin: 0 auto; font-family: var(--mono); font-size: .68rem; color: var(--graphite);
    background: #fff; border: 1px solid var(--rule); border-radius: 999px; padding: .2rem 1rem; min-width: 40%; text-align: center;
  }
  .mac__stage { position: absolute; inset: 9% 0 0 0; overflow: hidden; transition: background-color .6s var(--ease); }
  .mac__bd {
    position: absolute; inset: -8%; width: 116%; height: 116%; object-fit: cover; opacity: 0;
    filter: blur(28px) saturate(1.2); transition: opacity .7s var(--ease);
  }
  .mac__bd.on { opacity: .55; }
  /* the sharp, phone-shaped view: full height of the screen, never dimmed */
  .mac__view {
    position: absolute; top: 5%; bottom: 0; left: 50%; transform: translateX(-50%);
    aspect-ratio: 512 / 1000; border-radius: .9rem .9rem 0 0; overflow: hidden; background: #000;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .12), 0 24px 48px -12px rgba(0, 0, 0, .5);
  }
  .mac__note {
    position: absolute; right: 3%; bottom: 6%; font-family: var(--mono); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase;
    padding: .35rem .5rem; border-radius: .35rem; background: rgba(255, 255, 255, .16); color: rgba(255, 255, 255, .9); backdrop-filter: blur(6px);
  }
  .mac__stage.light .mac__note { background: rgba(16, 24, 43, .08); color: var(--ink); }

  /* ------------------------------------------------------------ phones */
  .fan { position: relative; height: clamp(22rem, 52vw, 32rem); transform-style: preserve-3d; }
  .fan__glow {
    position: absolute; left: 50%; top: 50%; width: 70%; height: 70%; transform: translate(-50%, -50%);
    border-radius: 50%; background: var(--glow, #cdd9ff); filter: blur(60px); opacity: .55; transition: background-color .8s var(--ease);
  }
  .ph {
    position: absolute; left: 50%; top: 50%; width: clamp(10rem, 24vw, 15rem); aspect-ratio: 512 / 1000;
    background: #11141b; border-radius: 2.2rem; padding: .45rem;
    box-shadow: 0 40px 80px -30px rgba(16, 24, 43, .45);
    transition: transform .9s var(--ease), filter .9s var(--ease), opacity .9s var(--ease); will-change: transform;
  }
  .ph__scr { position: relative; width: 100%; height: 100%; border-radius: 1.8rem; overflow: hidden; background: #000; }
  .ph[data-role="front"] { transform: translate(-50%, -50%) rotateY(0) scale(1); z-index: 3; }
  .ph[data-role="left"]  { transform: translate(-50%, -50%) translateX(-86%) translateZ(-120px) rotateY(24deg) scale(.86); z-index: 2; filter: brightness(.9); }
  .ph[data-role="right"] { transform: translate(-50%, -50%) translateX(86%)  translateZ(-120px) rotateY(-24deg) scale(.86); z-index: 2; filter: brightness(.9); }
  .ph[data-role="left"] .sc__clip, .ph[data-role="right"] .sc__clip { opacity: .95; }
  .fan--float .ph[data-role="front"] { animation: hover 6s ease-in-out infinite; }
  @keyframes hover { 50% { transform: translate(-50%, calc(-50% - 10px)); } }

  /* ------------------------------------------------------------ hybrid */
  .hyb { position: relative; max-width: 44rem; margin-inline: auto; }
  .sc--hybrid .hyb { padding-right: 8%; padding-bottom: 2.4rem; }
  .solo { position: absolute; right: -1%; bottom: 0; width: 22%; z-index: 4; }
  .ph--solo { position: relative; left: auto; top: auto; width: 100%; transform: none; }
  .solo__cap { margin: .6rem 0 0; display: flex; flex-direction: column; align-items: center; line-height: 1.3; }
  .solo__cap strong { font-size: .9rem; }
  .solo__cap span { font-family: var(--mono); font-size: .62rem; letter-spacing: .06em; text-transform: uppercase; color: var(--graphite); }

  /* ------------------------------------------------------------ caption + tabs */
  .sc__cap { margin-top: 1.25rem; display: flex; align-items: baseline; justify-content: center; gap: .6rem; flex-wrap: wrap; line-height: 1.3; }
  .sc__cap strong { font-size: 1.05rem; font-weight: 740; letter-spacing: -.01em; }
  .sc__cap > span:not(.sc__tag) { color: var(--graphite); font-size: var(--fs-small); }
  .sc__tag {
    font-family: var(--mono); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase;
    padding: .3rem .45rem; border-radius: .3rem; background: var(--green-soft); color: var(--green-t); border: 1px solid var(--green-bd);
  }
  .sc__tag.dev { background: var(--amber-soft); color: var(--amber-t); border-color: var(--amber-bd); }
  .sc__tabs { margin-top: .8rem; display: flex; justify-content: center; gap: .5rem; flex-wrap: wrap; }
  .sc__tab {
    position: relative; overflow: hidden; font: 600 .82rem/1 var(--sans); color: var(--graphite); cursor: pointer;
    background: var(--card); border: 1px solid var(--rule); border-radius: 999px; padding: .6rem .9rem; transition: color .18s var(--ease), border-color .18s var(--ease);
  }
  .sc__tab[aria-selected="true"] { color: var(--ink); border-color: var(--ink); }
  .sc__bar { position: absolute; left: 0; bottom: 0; height: 2px; width: 0; background: var(--redline); }

  /* ------------------------------------------------------------ phones + small screens */
  @media (max-width: 40rem) {
    /* laptop → full-size phone: the footage is portrait, so this is its native shape */
    .sc--laptop .mac, .sc--hybrid .mac { max-width: 17rem; }
    .sc--laptop .mac__lid, .sc--hybrid .mac__lid { border-radius: 2.6rem; padding: .5rem; }
    .sc--laptop .mac__screen, .sc--hybrid .mac__screen { aspect-ratio: 512 / 1000; border-radius: 2.1rem; }
    .mac__base, .mac__bar, .mac__bd, .mac__note { display: none; }
    .mac__stage { inset: 0; background: #000 !important; }
    .mac__view { inset: 0; top: 0; left: 0; transform: none; width: 100%; border-radius: 0; box-shadow: none; }
    /* hybrid on a phone: the two devices sit side by side, website left, app right */
    .sc--hybrid .hyb { display: flex; align-items: flex-end; gap: 4%; padding: 0; }
    .sc--hybrid .mac { flex: 1 1 60%; margin: 0; max-width: none; }
    .solo { position: static; flex: 0 0 34%; }
    .fan { height: 24rem; }
    .ph { width: 10.5rem; }
    .ph[data-role="left"]  { transform: translate(-50%, -50%) translateX(-62%) translateZ(-120px) rotateY(24deg) scale(.8); }
    .ph[data-role="right"] { transform: translate(-50%, -50%) translateX(62%)  translateZ(-120px) rotateY(-24deg) scale(.8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc__clip, .ph, .mac__stage, .mac__bd { transition: none; }
    .fan--float .ph[data-role="front"] { animation: none; }
  }
</style>

<script>
  /* One rotation controller for all three layouts. Rules:
     - the active clip plays once, then the next one crossfades in;
     - tabs jump; arrow keys move between tabs;
     - only the first clip loads with the page, the next preloads metadata;
     - nothing plays off-screen or under prefers-reduced-motion (posters show). */
  const root = document.querySelector('[data-showcase]');
  if (root) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clips = Array.from(root.querySelectorAll<HTMLVideoElement>('.sc__clip')).sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.sc__tab'));
    const stage = root.querySelector<HTMLElement>('[data-sc-stage]');
    const bds = Array.from(root.querySelectorAll<HTMLImageElement>('.mac__bd'));
    const url = root.querySelector('[data-sc-url]'), name = root.querySelector('[data-sc-name]');
    const kind = root.querySelector('[data-sc-kind]'), tag = root.querySelector('[data-sc-tag]');
    const phones = Array.from(root.querySelectorAll<HTMLElement>('.ph[data-slot]'));
    const fan = root.querySelector('.fan');
    const loop = root.querySelector<HTMLVideoElement>('.sc__loop');
    const roles = ['front', 'left', 'right'];
    let cur = 0, visible = true;

    const tryPlay = (v: HTMLVideoElement) => { const p = v.play(); if (p && p.catch) p.catch(() => {}); };

    const paint = (i: number) => {
      const d = clips[i].dataset;
      if (stage) { stage.style.backgroundColor = d.bg || ''; stage.style.setProperty('--glow', d.bg || ''); stage.classList.toggle('light', !!d.light); }
      if (url) url.textContent = d.url || '';
      if (name) name.textContent = d.name || '';
      if (kind) kind.textContent = (d.kind || '') + ' · ' + (d.type || '');
      if (tag) { tag.textContent = d.tag || ''; tag.classList.toggle('dev', /development/i.test(d.tag || '')); }
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', k === i ? 'true' : 'false');
        const bar = t.querySelector<HTMLElement>('.sc__bar'); if (bar) bar.style.width = k < i ? '100%' : '0';
      });
      bds.forEach((b, k) => b.classList.toggle('on', k === i));
      /* laptop/hybrid: crossfade. phones: every clip stays visible, the fan rotates. */
      if (phones.length) phones.forEach((p, k) => p.dataset.role = roles[(k - i + 3) % 3]);
      else clips.forEach((v, k) => v.classList.toggle('on', k === i));
    };

    const play = (i: number) => {
      clips.forEach((v, k) => { if (k !== i) v.pause(); });
      cur = i; paint(i);
      const v = clips[i]; if (v.preload === 'none') v.preload = 'auto';
      try { v.currentTime = 0; } catch (e) {}
      if (!reduced && visible) tryPlay(v);
      const n = clips[(i + 1) % clips.length]; if (n.preload === 'none') n.preload = 'metadata';
    };

    clips.forEach((v, k) => {
      v.addEventListener('ended', () => { if (k === cur) play((cur + 1) % clips.length); });
      v.addEventListener('timeupdate', () => {
        if (k !== cur || !v.duration) return;
        const bar = tabs[k]?.querySelector<HTMLElement>('.sc__bar'); if (bar) bar.style.width = (v.currentTime / v.duration * 100) + '%';
      });
    });
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => play(k));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const n = (k + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[n].focus(); play(n);
      });
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
        if (reduced) return;
        if (visible) { tryPlay(clips[cur]); if (loop) tryPlay(loop); }
        else { clips[cur].pause(); if (loop) loop.pause(); }
      }, { threshold: .25 }).observe(root);
    }

    if (fan && !reduced) fan.classList.add('fan--float');
    play(0);
  }
</script>
