---
/* ==========================================================================
   INQUIRY FORM — the canonical intake, rendered.

   Fields, labels, options and validation all come from lib/intake.ts, which
   the Website Project Planner's final step also uses. Change a field there
   and both surfaces follow; never add one here alone.

   Deliberately NOT a React island. The planner already costs ~70KB of React
   and only loads on /free-demo; a second island for nine inputs and a fetch
   would put that cost on every page carrying this form.

   States: idle → sending → sent | error | unconfigured. The success state is
   reached only on a real 2xx from the endpoint (see lib/inquiry.ts). With no
   endpoint configured the form does not pretend — it hands off to email with
   every answer pre-filled.
   ========================================================================== */
import { INTAKE_FIELDS } from '../lib/intake';
import { REPLY_SLA } from '../data/site';

export interface Props {
  /** Preselects "What do you need?" — used by the service pages. */
  need?: string;
  id?: string;
}
const { need = '', id = 'inquiry' } = Astro.props;
---

<form class="iq" id={id} novalidate data-inquiry data-need={need}>
  <div class="iq__grid">
    {INTAKE_FIELDS.map((f) => (
      <p class:list={['iq__field', { 'iq__field--full': f.full }]}>
        <label for={`${id}-${f.key}`}>
          {f.label}
          {f.required
            ? <><span aria-hidden="true"> *</span><span class="vh"> (required)</span></>
            : <span class="iq__opt">optional</span>}
        </label>

        {f.kind === 'select' ? (
          <select id={`${id}-${f.key}`} name={f.key} required={f.required}>
            <option value="">{f.empty}</option>
            {f.options!.map((o) => <option value={o} selected={f.key === 'need' && o === need}>{o}</option>)}
          </select>
        ) : f.kind === 'textarea' ? (
          <textarea id={`${id}-${f.key}`} name={f.key} rows="5" required={f.required} placeholder={f.placeholder}></textarea>
        ) : (
          <input
            id={`${id}-${f.key}`} name={f.key} type={f.kind} required={f.required}
            autocomplete={f.autocomplete} inputmode={f.inputmode} placeholder={f.placeholder}
          />
        )}

        <span class="iq__err" id={`${id}-${f.key}-e`} hidden></span>
      </p>
    ))}
  </div>

  {/* Honeypot. Hidden from people and assistive tech; only bots fill it. */}
  <p class="iq__trap" aria-hidden="true">
    <label for={`${id}-fax`}>Fax number</label>
    <input id={`${id}-fax`} name="trap" type="text" tabindex="-1" autocomplete="off" />
  </p>

  <div class="iq__foot">
    <button class="btn btn--primary" type="submit" data-submit>
      <span data-label>Send my inquiry</span>
      <span class="iq__spin" data-spin hidden aria-hidden="true"></span>
    </button>
    <p class="small iq__sla">No obligation. I reply within {REPLY_SLA}.</p>
  </div>

  {/* Single live region for every outcome. Never pre-filled with success. */}
  <div class="iq__out" data-out role="status" aria-live="polite" hidden></div>
</form>

<style>
  .iq { max-width: 44rem; }
  .iq__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4) var(--s5); }
  @media (max-width: 40rem) { .iq__grid { grid-template-columns: 1fr; } }
  .iq__field { display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
  .iq__field--full { grid-column: 1 / -1; }
  .iq__field label { font-weight: 700; font-size: var(--fs-small); }
  .iq__field label span[aria-hidden] { color: var(--redline); }
  .iq__opt { font-weight: 500; color: var(--graphite); font-size: .85em; margin-left: .35rem; }

  .iq input, .iq select, .iq textarea {
    width: 100%; padding: .8rem .9rem;
    background: var(--card); border: 1px solid var(--rule-hi); border-radius: 12px;
    font-size: 1rem; /* 16px — stops iOS zooming the page on focus */
    transition: border-color .18s var(--ease), box-shadow .18s var(--ease);
  }
  .iq textarea { resize: vertical; min-height: 7.5rem; }
  .iq input:hover, .iq select:hover, .iq textarea:hover { border-color: var(--graphite); }
  .iq input:focus, .iq select:focus, .iq textarea:focus {
    border-color: var(--redline); box-shadow: 0 0 0 3px var(--blue-soft); outline: none;
  }
  .iq [aria-invalid="true"] { border-color: var(--red-t); }
  .iq [aria-invalid="true"]:focus { box-shadow: 0 0 0 3px var(--red-soft); }
  .iq__err { color: var(--red-t); font-size: var(--fs-small); font-weight: 600; }

  /* Off-screen rather than display:none — some bots skip hidden inputs. */
  .iq__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .iq__foot { display: flex; align-items: center; gap: var(--s5); flex-wrap: wrap; margin-top: var(--s6); }
  .iq__sla { margin: 0; }
  .iq [data-submit][disabled] { opacity: .75; cursor: progress; }
  .iq__spin {
    width: 1rem; height: 1rem; border-radius: 50%; flex: none;
    border: 2px solid rgba(255, 255, 255, .45); border-top-color: #fff;
    animation: iqspin .7s linear infinite;
  }
  @keyframes iqspin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .iq__spin { animation-duration: 2s; } }

  .iq__out { margin-top: var(--s5); padding: var(--s5); border-radius: 14px; border: 1px solid var(--rule); background: var(--card); }
  .iq__out h3 { font-size: var(--fs-h3); font-weight: 800; letter-spacing: -.015em; margin-bottom: var(--s2); }
  .iq__out p { color: var(--graphite); font-size: var(--fs-small); }
  .iq__out p + .btn, .iq__out p + p { margin-top: var(--s4); }
  .iq__out--ok { border-left: 3px solid var(--green-t); }
  .iq__out--ok h3 { color: var(--green-t); }
  .iq__out--warn { border-left: 3px solid var(--amber-t); }
  .iq__out--warn h3 { color: var(--amber-t); }
</style>

<script>
  import { sendInquiry, mailtoFor, isConfigured, type Inquiry } from '../lib/inquiry';
  import { validateIntake, needFromHint, INTAKE_FIELDS, EMPTY_INTAKE, type IntakeValues } from '../lib/intake';
  import { track, EVENTS } from '../lib/analytics';
  import { EMAIL, REPLY_SLA, DEMO_TURNAROUND } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
  if (form) {
    const out = form.querySelector<HTMLElement>('[data-out]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const spin = form.querySelector<HTMLElement>('[data-spin]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;

    const field = (n: string) =>
      form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;

    /* A service page can arrive as /contact#google-ads or ?need=Google+Ads.
       Hash is supported because query strings do not survive every host or
       preview environment. */
    const needSel = field('need') as HTMLSelectElement | null;
    if (needSel && !needSel.value) {
      const hint = new URLSearchParams(location.search).get('need') ?? location.hash;
      const resolved = needFromHint(hint);
      if (resolved) needSel.value = resolved;
    }

    const setError = (n: string, msg: string | null) => {
      const el = field(n);
      const box = document.getElementById(`${form.id}-${n}-e`);
      if (!el || !box) return;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (msg) { el.setAttribute('aria-describedby', box.id); box.textContent = msg; box.hidden = false; }
      else { el.removeAttribute('aria-describedby'); box.hidden = true; }
    };

    const values = (): IntakeValues =>
      INTAKE_FIELDS.reduce((acc, f) => {
        acc[f.key] = (field(f.key)?.value ?? '').trim();
        return acc;
      }, { ...EMPTY_INTAKE });

    const show = (cls: string, html: string) => {
      out.className = `iq__out ${cls}`;
      out.innerHTML = html;
      out.hidden = false;
    };

    const busy = (on: boolean) => {
      btn.disabled = on;
      spin.hidden = !on;
      label.textContent = on ? 'Sending…' : 'Send my inquiry';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = values();
      const errs = validateIntake(v);
      INTAKE_FIELDS.forEach((f) => setError(f.key, errs[f.key] ?? null));

      const keys = Object.keys(errs);
      if (keys.length) {
        field(keys[0])?.focus();
        show('iq__out--warn', `<h3>Check a couple of fields</h3><p>The highlighted fields need an answer before this can send.</p>`);
        return;
      }

      const data: Inquiry = {
        source: 'contact',
        name: v.name, email: v.email,
        phone: v.phone || undefined,
        company: v.company || undefined,
        website: v.website || undefined,
        need: v.need || undefined,
        budget: v.budget || undefined,
        timeline: v.timeline || undefined,
        message: v.message,
        trap: (field('trap') as HTMLInputElement)?.value || undefined,
      };

      busy(true);
      const res = await sendInquiry(data);
      busy(false);

      /* A bot that filled the honeypot sees the same screen as a person, and
         nothing is transmitted. */
      if (res.ok || (!res.ok && res.reason === 'spam')) {
        if (res.ok) {
          track(EVENTS.inquiry, { need: data.need });
          if (data.need) track(EVENTS.serviceInquiry, { label: data.need });
        }
        form.querySelector<HTMLElement>('.iq__grid')!.hidden = true;
        form.querySelector<HTMLElement>('.iq__foot')!.hidden = true;
        show('iq__out--ok',
          `<h3>Got it — thank you.</h3>
           <p>Your inquiry reached me. I reply within ${REPLY_SLA}, and if you asked for the free
              homepage demo the concept usually follows within ${DEMO_TURNAROUND}.</p>`);
        return;
      }

      /* Everything below is a failure, and says so. No success is shown. */
      const href = mailtoFor(data, EMAIL);
      if (res.reason === 'unconfigured') {
        show('iq__out--warn',
          `<h3>Send this by email instead</h3>
           <p>The form’s delivery address is not connected yet, so I am not going to pretend this
              was sent. Everything you typed is already in the email below — press send and it
              reaches me exactly the same way.</p>
           <a class="btn btn--primary" href="${href}">Open the email, pre-filled</a>
           <p>Or write to <strong>${EMAIL}</strong> directly.</p>`);
      } else {
        show('iq__out--warn',
          `<h3>That did not send</h3>
           <p>Something went wrong on the way${res.reason === 'network' ? ' — it looks like a connection problem' : ''}.
              Your answers are still in the form, so you can try again. If it keeps failing, the
              email below carries the same details.</p>
           <a class="btn btn--ghost" href="${href}">Send it by email instead</a>`);
      }
    });

    /* Clear an error as soon as the field is corrected. */
    INTAKE_FIELDS.forEach((f) => {
      field(f.key)?.addEventListener('input', () => {
        if (field(f.key)?.getAttribute('aria-invalid') === 'true') setError(f.key, null);
      });
    });

    if (!isConfigured) {
      console.info('[inquiry] PUBLIC_INQUIRY_ENDPOINT is not set — the form will hand off to email.');
    }
  }
</script>
