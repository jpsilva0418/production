---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Omit on pages that should not be indexed (thank-you, etc.) */
  noindex?: boolean;
  /** Extra JSON-LD emitted after the sitewide Organization block. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* Sitewide entity. Deliberately minimal: no foundingDate, no
   numberOfEmployees, no award, no aggregateRating — none of it is true yet,
   and markup that outruns reality is how structured-data penalties happen.
   TODO(launch): add `telephone`, `address` and real `sameAs` profiles, then
   upgrade @type to ProfessionalService. */
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#org`,
  name: 'JP Web Design',
  url: Astro.site?.href,
  description:
    'Founder-led web design studio building conversion-focused websites for businesses across the United States.',
  founder: { '@type': 'Person', name: 'JP Silva' },
  areaServed: { '@type': 'Country', name: 'United States' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="JP Web Design" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f6f8fc" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <!-- Native same-origin prefetch. A few hundred bytes, no library. -->
  <script type="speculationrules">
    {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
