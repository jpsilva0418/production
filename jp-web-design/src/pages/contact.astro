---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { SITE_NAME, EMAIL, PHONE, REPLY_SLA, DEMO_TURNAROUND } from '../data/site';

/* The one inquiry page. Every CTA on the site that is not the free demo
   points here, and the form on this page is the only form besides the
   planner — both of which share one transport (lib/inquiry.ts). */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact — ${SITE_NAME}`,
  url: new URL('/contact', Astro.site).href,
};
---
<Base
  title={`Start a project | ${SITE_NAME}`}
  description="Tell JP Silva about your website or advertising project. Free consultation, free homepage demo, and no obligation either way."
  schema={schema}
>
  <section class="section">
    <div class="container">
      <p><span class="mark"><b>§01</b> Contact</span></p>
      <div class="head">
        <h1 class="display">Tell me about your business</h1>
        <p class="lead">
          Whether it is a website, advertising, or you are not sure which you need yet &mdash;
          this is the form. I read every one myself and reply within {REPLY_SLA}.
        </p>
      </div>

      <div class="ct">
        <div class="ct__form">
          <h2 class="h3 ct__fh">Start a project</h2>
          <InquiryForm />
        </div>

        <aside class="ct__side" aria-label="Other ways to reach me">
          <div class="note ct__demo">
            <span class="lbl">Fastest route for a website</span>
            <h2 class="h3">See the demo first</h2>
            <p class="small">
              Eight questions, about four minutes, and I design a homepage concept for your
              business. Free, yours to keep, and no obligation once you have seen it. It usually
              comes back within {DEMO_TURNAROUND}.
            </p>
            <a class="btn btn--primary btn--wide ct__demobtn" href="/free-demo" data-track="demo_start" data-track-label="contact">Start the free demo</a>
          </div>

          <div class="ct__block">
            <h2 class="h3">Prefer email?</h2>
            <p class="small">It reaches me directly, and I answer it myself.</p>
            <a class="tlink" href={`mailto:${EMAIL}`} data-track="email_click" data-track-label="contact">{EMAIL}</a>
          </div>

          <div class="ct__block">
            <h2 class="h3">Prefer to talk?</h2>
            {PHONE ? (
              <>
                <p class="small">Call or text, and a human answers.</p>
                <a class="tlink" href={`tel:${PHONE.replace(/[^+\d]/g, '')}`} data-track="call_click" data-track-label="contact">{PHONE}</a>
              </>
            ) : (
              <>
                <p class="small">
                  A number a human answers is going up before launch. Until then, send the form or
                  email me and we will find a time to speak.
                </p>
                <p class="ct__todo">Phone — to be added before launch</p>
              </>
            )}
          </div>

          <div class="ct__block ct__block--last">
            <h2 class="h3">What happens next</h2>
            <p class="small">
              I reply within {REPLY_SLA}. The first conversation is about understanding what you do
              and who you are trying to reach &mdash; no slides, no proposal ambush, and no
              obligation at the end of it. If a cheaper option is genuinely right for you, I will
              say so.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .ct { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(var(--s6), 5vw, var(--s8)); align-items: start; }
  @media (max-width: 62rem) { .ct { grid-template-columns: 1fr; } }

  .ct__fh { margin-bottom: var(--s5); padding-bottom: var(--s4); border-bottom: 1px solid var(--rule); }

  .ct__side { display: flex; flex-direction: column; gap: var(--s6); }
  .ct__demo h2 { margin-bottom: var(--s2); }
  .ct__demobtn { margin-top: var(--s5); }

  .ct__block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s2);
               padding-top: var(--s5); border-top: 1px solid var(--rule); }
  .ct__block--last { gap: var(--s3); }
  .ct__todo { font-family: var(--mono); font-size: .8125rem; color: var(--redline); }
</style>
