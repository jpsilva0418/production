      radial-gradient(1px 1px at 12% 22%, #5a5f74 50%, transparent 51%),
      radial-gradient(1px 1px at 78% 14%, #5a5f74 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 62% 34%, #464b60 50%, transparent 51%),
      radial-gradient(1px 1px at 30% 12%, #464b60 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 44%, #3c4156 50%, transparent 51%);
  }
  :global(.js-anim) .night:not(.wipe)::after { opacity: 0; }
  .night__in { position: relative; z-index: 2; transition: opacity .6s var(--ease) .45s; }
  :global(.js-anim) .night:not(.wipe) .night__in { opacity: 0; }
  .night__clock {
    font-family: var(--mono); font-weight: 700; font-size: clamp(3.2rem, 10vw, 6.5rem);
    letter-spacing: -.02em; font-variant-numeric: tabular-nums;
  }
  .night__clock b { color: var(--ember); font-weight: 700; }
  .night__h { font-size: clamp(1.6rem, 4.4vw, 2.8rem); font-weight: 800; letter-spacing: -.025em; margin-top: .6rem; text-wrap: balance; }
  .night__sub { color: var(--night-mute); max-width: 38rem; margin: 1.1rem auto 0; text-wrap: pretty; }

  .srch { max-width: 30rem; margin: 2.2rem auto 0; text-align: left; }
  .srch__bar {
    display: flex; align-items: center; gap: .6rem; background: var(--night-2);
    border: 1px solid var(--night-rule); border-radius: 999px; padding: .8rem 1.2rem;
    font-size: .95rem; color: var(--night-ink);
  }
  .srch__bar svg { width: 1.05rem; height: 1.05rem; color: #8a8fa3; flex: none; }
  .srch__q { font-family: var(--mono); font-size: .88rem; }
  .srch__caret {
    display: none; width: 2px; height: 1.05em; background: var(--ember);
    vertical-align: text-bottom; animation: caret 1s steps(1) infinite;
  }
  :global(.js-anim) .srch__caret.on { display: inline-block; }
  @keyframes caret { 50% { opacity: 0; } }
  .srch__res { display: grid; gap: .6rem; margin-top: 1rem; }
  .srch__r {
    display: flex; justify-content: space-between; align-items: center; gap: .8rem;
    background: #12141d; border: 1px solid #232633; border-radius: 14px;
    padding: .85rem 1.1rem;
    transition: opacity .5s var(--ease), transform .5s var(--ease), border-color .3s, box-shadow .3s;
  }
  :global(.js-anim) .srch__r:not(.show) { opacity: 0; transform: translateY(12px); }
  .srch__r--win { border-color: var(--ember); box-shadow: 0 0 0 3px rgba(240, 98, 58, .25); }
  :global(.js-anim) .srch__r--win:not(.picked) { border-color: #232633; box-shadow: none; }
  .srch__n { font-weight: 700; font-size: .92rem; }
  .srch__d { display: block; font-weight: 500; font-size: .78rem; color: #8a8fa3; margin-top: .15rem; }
  .srch__go { font-size: .72rem; font-weight: 700; letter-spacing: .08em; color: var(--ember); white-space: nowrap; transition: opacity .3s; }
  :global(.js-anim) .srch__r--win:not(.picked) .srch__go { opacity: 0; }
  .night__tag {
    display: inline-block; margin-top: 1.8rem; font-family: var(--mono); font-size: .8rem;
    letter-spacing: .14em; color: var(--ember); border: 1px solid #2a2a30;
    border-radius: 999px; padding: .5rem 1rem;
    transition: opacity .5s var(--ease), transform .5s var(--ease);
  }
  :global(.js-anim) .night__tag:not(.show) { opacity: 0; transform: translateY(8px); }
  .night__link {
    display: inline-flex; margin-top: 1.6rem; font-weight: 700; color: var(--night-ink);
    border-bottom: 2px solid var(--ember); padding-bottom: 2px; text-decoration: none;
  }
  .night__link:hover { color: var(--ember); }

  /* ── packages note / why / faq ───────────────────────────────────────── */
  .pk__note { margin-top: var(--s6); font-size: var(--fs-small); color: var(--graphite); }

  .why__g { display: grid; gap: 1rem; margin-top: clamp(2rem, 4vw, 3rem); text-align: left; }
  @media (min-width: 52rem) { .why__g { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 40rem) and (max-width: 52rem) { .why__g { grid-template-columns: repeat(2, 1fr); } }
  .why__i {
    display: flex; gap: .8rem; align-items: flex-start;
    background: var(--card); border: 1px solid var(--rule); border-radius: 16px;
    padding: 1.1rem 1.25rem; box-shadow: var(--shadow);
  }
  .why__c { color: var(--green-t); flex: none; margin-top: .15rem; }
  :global(.why__c svg) { width: 1.2rem; height: 1.2rem; }
  .why__t { font-size: 1rem; font-weight: 800; letter-spacing: -.01em; margin-bottom: .25rem; }

  .faq__w { max-width: 54rem; }
  .faq { margin-top: clamp(1.5rem, 3vw, 2rem); text-align: left; border-top: 1px solid var(--rule); }
  .faq__i { border-bottom: 1px solid var(--rule); }
  .faq__i summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s4);
    cursor: pointer; padding: var(--s4) 0; font-weight: 700; list-style: none;
    min-height: 2.75rem;
  }
  .faq__i summary::-webkit-details-marker { display: none; }
  .faq__i summary::after {
    content: '+'; font-family: var(--mono); color: var(--redline);
    font-size: 1.125rem; flex: none; transition: transform .25s var(--ease);
  }
  .faq__i[open] summary::after { content: '–'; }
  .faq__i > p { padding-bottom: var(--s5); max-width: var(--measure); }

  /* ── close ───────────────────────────────────────────────────────────── */
  .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .stat {
    background: var(--card); border: 1px solid var(--rule); border-radius: var(--r);
    box-shadow: var(--shadow); padding: 1.3rem 1.8rem; min-width: 10.5rem;
  }
  .stat__n { font-size: 2rem; font-weight: 800; letter-spacing: -.03em; color: var(--redline); font-variant-numeric: tabular-nums; }
  .stat__l { font-size: .85rem; font-weight: 700; color: var(--graphite); letter-spacing: .06em; text-transform: uppercase; margin-top: .2rem; }

  .close__card {
    position: relative; overflow: hidden; border-radius: 28px; text-align: center; color: #fff;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 4vw, 4rem);
    background: linear-gradient(115deg, #2f5cf0, #4a74ff 45%, #7c9bff);
    background-size: 200% 200%;
    animation: gradShift 9s ease-in-out infinite alternate;
    box-shadow: 0 40px 80px -30px rgba(47, 92, 240, .55);
  }
  .orb { position: absolute; border-radius: 50%; background: radial-gradient(circle, rgba(255, 255, 255, .35), rgba(255, 255, 255, 0) 70%); pointer-events: none; }
  .orb--1 { width: 16rem; height: 16rem; left: -4rem; top: -5rem; animation: bobA 9s ease-in-out infinite; }
  .orb--2 { width: 11rem; height: 11rem; right: -2rem; bottom: -3rem; animation: bobB 11s ease-in-out infinite; }
  .orb--3 { width: 6rem; height: 6rem; right: 18%; top: -2rem; animation: bobA 7s ease-in-out -3s infinite; }
  .close__card > * { position: relative; z-index: 1; }
  .close__h { font-size: var(--fs-mega); font-weight: 800; letter-spacing: -.03em; line-height: 1.06; text-wrap: balance; }
  .close__sub { margin: 1rem auto 0; max-width: 36rem; color: #dfe7ff; text-wrap: pretty; }
  .close__b { justify-content: center; margin-top: 2rem; }
  .close__cta { background: #fff; color: var(--ink); font-weight: 800; box-shadow: 0 16px 32px -12px rgba(0, 0, 0, .35); }
  .close__cta:hover { transform: translateY(-2px) scale(1.02); }
  .close__alt { border-color: rgba(255, 255, 255, .55); color: #fff; background: transparent; }
  .close__alt:hover { background: rgba(255, 255, 255, .12); transform: translateY(-2px); }
  .close__fine { margin-top: 1.1rem; font-size: .88rem; color: #c9d6ff; }
  .close :global(:where(a, button):focus-visible) { outline-color: #fff; }
</style>

<script>
  /* Reveal controller + cinematics. Everything here is enhancement: the
     page is complete before any of it runs. */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;
  const root = document.documentElement;
  const gated = root.classList.contains('js-anim');

  (window as any).__revealReady = true;

  /* ---------- word splitter (only when the gate is armed) ---------- */
  if (gated) {
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((h) => {
      const words = (h.textContent || '').trim().split(/\s+/);
      h.textContent = '';
      words.forEach((w, i) => {
        const outer = document.createElement('span'); outer.className = 'w';
        outer.style.setProperty('--wd', String(i * 45));
        const inner = document.createElement('span'); inner.textContent = w;
        outer.appendChild(inner); h.appendChild(outer);
        if (i < words.length - 1) h.appendChild(document.createTextNode(' '));
      });
    });
  }

  /* ---------- reveals ---------- */
  const els = [...document.querySelectorAll<HTMLElement>('[data-anim],[data-split],[data-steps]')];
  const vh = () => window.innerHeight || root.clientHeight;
  const revealNow = () => els.forEach((el) => {
    if (el.getBoundingClientRect().top < vh()) el.classList.add('in');
  });

  if (!gated) {
    els.forEach((el) => el.classList.add('in'));
  } else {
    const opening = root.classList.contains('js-open');
    setTimeout(revealNow, opening ? 1450 : 0);
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting && e.boundingClientRect.top > 0) return;
          e.target.classList.add('in');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
    } else {
      els.forEach((el) => el.classList.add('in'));
    }
    setTimeout(revealNow, 2600);   /* watchdog sweep */
  }

  /* ---------- scroll: progress bar + parallax + reveal sweep ---------- */
  const prog = document.getElementById('prog');
  const plx = [...document.querySelectorAll<HTMLElement>('[data-plx]')].map((el) => ({ el, f: Number(el.dataset.plx) }));
  /* IO only reports intersection CHANGES — an instant jump (momentum fling,
     End key, find-in-page) can leapfrog an element from below the viewport
     to above it with no false→true transition, so no callback ever fires.
     This sweep runs in the same rAF as the progress bar and reveals
     anything at or above the current viewport, then retires itself. */
  let pending = gated ? els.filter((el) => !el.classList.contains('in')) : [];
  let ticking = false;
  const frame = () => {
    ticking = false;
    const y = scrollY, h = root.scrollHeight - innerHeight;
    if (prog) prog.style.transform = 'scaleX(' + (h > 0 ? y / h : 0) + ')';
    if (!reduced) plx.forEach((p) => { p.el.style.translate = '0 ' + (y * p.f).toFixed(1) + 'px'; });
    if (pending.length) {
      const limit = vh();
      pending = pending.filter((el) => {
        if (el.classList.contains('in')) return false;
        if (el.getBoundingClientRect().top < limit) { el.classList.add('in'); return false; }
        return true;
      });
    }
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
  frame();

  /* ---------- card tilt (fine pointers) ---------- */
  if (fine && !reduced) {
    document.querySelectorAll<HTMLElement>('.tilt').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - .5, dy = (e.clientY - r.top) / r.height - .5;
        card.style.transform = 'perspective(800px) rotateY(' + (dx * 5) + 'deg) rotateX(' + (-dy * 4) + 'deg) translateY(-4px)';
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
  }

  /* ---------- night: wipe, clock roll, typed search, the pick ---------- */
  const night = document.getElementById('night');
  if (night && gated) {
    const clock = document.getElementById('clock')!;
    const qEl = document.getElementById('srchQ')!;
    const caret = document.getElementById('srchCaret')!;
    const q = 'emergency roof repair near me';
    const runNight = () => {
      night.classList.add('wipe');
      const start = 360, end = 587, dur = 1400; let t0: number | null = null;
      const roll = (ts: number) => {
        if (t0 === null) t0 = ts;
        const p = Math.min((ts - t0) / dur, 1), e = 1 - Math.pow(1 - p, 2);
        const m = Math.round(start + (end - start) * e);
        clock.textContent = Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0');
        if (p < 1) requestAnimationFrame(roll);
      };
      clock.textContent = '6:00';
      requestAnimationFrame(roll);

      qEl.textContent = ''; caret.classList.add('on');
      const showR = (id: string, d: number) => setTimeout(() => document.getElementById(id)!.classList.add('show'), d);
      let i = 0;
      const type = () => {
        qEl.textContent = q.slice(0, ++i);
        if (i < q.length) setTimeout(type, 34 + Math.random() * 40);
        else {
          showR('rw', 420); showR('r2', 640); showR('r3', 860);
          setTimeout(() => {
            document.getElementById('rw')!.classList.add('picked');
            document.getElementById('nightTag')!.classList.add('show');
            caret.classList.remove('on');
          }, 1700);
        }
      };
      setTimeout(type, 900);
    };
    new IntersectionObserver((es, o) => es.forEach((e) => {
      if (e.isIntersecting) { runNight(); o.disconnect(); }
    }), { threshold: 0.3 }).observe(night);
  }

  /* ---------- count-up stats ---------- */
  if (gated) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      if (target === 0) return;
      new IntersectionObserver((es, o) => es.forEach((en) => {
        if (!en.isIntersecting) return; o.disconnect();
        const dur = 900; let t0: number | null = null;
        el.textContent = '0';
        const step = (ts: number) => {
          if (t0 === null) t0 = ts;
          const p = Math.min((ts - t0) / dur, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }), { threshold: 0.6 }).observe(el);
    });
  }

  /* ---------- "Build mine like this" → seed the planner's industry ------ */
  const KEY = 'jpwd.planner.v1';
  document.querySelectorAll<HTMLAnchorElement>('[data-plate-industry]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        const cur = JSON.parse(sessionStorage.getItem(KEY) || '{}');
        sessionStorage.setItem(KEY, JSON.stringify({ ...cur, businessType: a.dataset.plateIndustry }));
      } catch (e) { /* storage unavailable — the link still lands on the planner */ }
    });
  });
</script>
