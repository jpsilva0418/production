<script>
  /* ~600 bytes. Content is visible by default; this only opts elements into
     the entrance once JS is confirmed alive, so a failed script or a
     crawler sees a finished page rather than an empty one. */
  const els = document.querySelectorAll<HTMLElement>('[data-anim]');

  /* Tell the watchdog the reveal controller is alive. */
  (window as any).__revealReady = true;

  /* Anything already in view — the entire hero — is revealed on this frame
     rather than waiting for an observer callback. Above-the-fold content
     should never depend on a scroll event that has not happened. */
  const vh = window.innerHeight || document.documentElement.clientHeight;
  els.forEach((el) => {
    if (el.getBoundingClientRect().top < vh) el.classList.add('in');
  });

  if (document.documentElement.classList.contains('js-anim') && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        /* Reveal on entry — or if a fast flick-scroll carried the element
           above the viewport before the callback ran. Without the second
           case, scrolling quickly can leave content permanently hidden. */
        if (!e.isIntersecting && e.boundingClientRect.top > 0) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    els.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
  } else {
    /* No observer support: reveal everything immediately rather than leaving
       anything hidden. */
    els.forEach((el) => el.classList.add('in'));
  }
</script>
