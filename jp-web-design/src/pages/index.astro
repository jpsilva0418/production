---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Packages from '../components/Packages.astro';
import Planner from '../components/planner/Planner.jsx';

/* The plates. Every one is a SPEC BUILD — uncommissioned, built to show the
   pattern, and labelled so on the page. `industry` maps to the planner's
   businessType ids, which is what lets "Build mine like this →" arrive at
   the planner with the visitor's industry already answered. */
const plates = [
  {
    n: '01', industry: 'construction', trade: 'Roofing / Storm repair',
    cap: 'Opens with the one thing a homeowner with a leak needs: proof someone will actually come. Estimate path above the fold, insurance help named, photos load last.',
  },
  {
    n: '02', industry: 'beauty', trade: 'Med spa / Aesthetics',
    cap: 'Booking is the navigation, not a button hidden in it. Treatments read like outcomes, not a price list, and the whole page keeps a before-and-after level of calm.',
  },
  {
    n: '03', industry: 'restaurant', trade: 'Restaurant / Neighborhood',
    cap: 'Menu and hours in the first screen, because that is the entire reason anyone visits. Atmosphere comes from type and colour, not a slow carousel of dark photos.',
  },
];

/* Services are a list, not a card grid. A grid of eight equal cards asks the
   eye to compare things that aren't comparable; a list with a revealed
   detail lets someone scan the eight names first and stop only where it
   matters to them. */
const services = [
  { n: '01', t: 'Website design',        d: 'A new site built around how your customers actually decide — not around the order a template happened to stack its sections in.' },
  { n: '02', t: 'Website redesign',      d: 'You already have a site. It either looks dated, or it looks fine and does nothing. Those are different problems with different fixes.' },
  { n: '03', t: 'SEO foundations',       d: 'Structure, speed, correct markup, one clear topic per page. The groundwork rankings are built on — not a monthly retainer with a dashboard.' },
  { n: '04', t: 'Local SEO',             d: 'Google Business Profile, consistent business details everywhere, and service-area pages capped at the places you genuinely work.' },
  { n: '05', t: 'Landing pages',         d: 'One page, one audience, one action. Built for campaigns where every click has a price attached to it.' },
  { n: '06', t: 'E-commerce',            d: 'Product and category structure that customers and search engines can both navigate without getting lost.' },
  { n: '07', t: 'Website care',          d: 'Hosting, updates, backups, uptime monitoring, and a set block of edit time each month. Optional, and saying no changes nothing.' },
  { n: '08', t: 'Conversion work',       d: 'Traffic is fine and the phone still isn’t ringing. Nine times out of ten that is a structure problem wearing a design problem’s clothes.' },
];

const industries = [
  { t: 'Construction & contracting', live: '/industries/construction-web-design',
    d: 'Prequalification, project profiles, and the careers page that fills a superintendent seat.' },
  { t: 'Roofing, HVAC & plumbing',
    d: 'Emergency paths, financing, insurance-claim help, and galleries that survive a phone on LTE.' },
  { t: 'Beauty, salons & med spas',
    d: 'Booking as a navigation element, treatment pages that rank, consent-governed before-and-afters.' },
  { t: 'Legal & professional',
    d: 'Practice-area depth, credential display, and intake that respects how regulated advertising works.' },
  { t: 'Real estate',
    d: 'Listing structure, neighbourhood guides, and valuation requests that reach the right person.' },
  { t: 'Restaurants & hospitality',
    d: 'Menu and hours first. Everything else is secondary, and most sites get that exactly backwards.' },
];

const ticker = [
  'Construction', 'Roofing', 'HVAC', 'Plumbing', 'Electrical', 'Landscaping',
  'Cleaning', 'Restaurants', 'Salons', 'Med spas', 'Fitness studios', 'Law firms',
  'Real estate', 'Medical offices', 'Professional services', 'E-commerce',
];

const process = [
  { n: '01', t: 'Discovery',  d: 'One working session on your customers, your competition, and how work actually reaches you today.', you: '60–90 min' },
  { n: '02', t: 'Strategy',   d: 'Page structure, conversion path and search targets, written down and agreed before any design exists.', you: 'Review' },
  { n: '03', t: 'Content',    d: 'I write it. You correct it. Nobody hands you a spreadsheet and asks you to write your own website.', you: '~1 hour' },
  { n: '04', t: 'Design',     d: 'Every page type, desktop and mobile, at full fidelity — before a line of production code is written.', you: 'One round' },
  { n: '05', t: 'Build',      d: 'Fast, accessible, semantic. The performance budget is enforced by the build, not checked once at the end.', you: 'Nothing' },
  { n: '06', t: 'Review',     d: 'You see it on a real URL and mark it up. Revisions run to the number named in your package.', you: '1–2 hours' },
  { n: '07', t: 'Testing',    d: 'Keyboard, screen reader, real devices, forms end to end. Every link and every state.', you: 'Nothing' },
  { n: '08', t: 'Launch',     d: 'Redirects mapped, analytics verified, Search Console connected, every account in your name.', you: 'Approve' },
  { n: '09', t: 'Support',    d: 'A defined post-launch window, then an optional care plan. Not a silence.', you: 'Optional' },
];

const faqs = [
  { q: 'Is the free demo actually free?',
    a: 'Yes, and nothing is attached to it. You answer the planner questions, I design a homepage concept for your business, and you look at it. If you do not want to go further, that is the end of it — no invoice, no follow-up sequence. I offer it because the studio is new, and real work on your own business is more convincing than any portfolio I could point you at.' },
  { q: 'What happens on the free consultation?',
    a: 'About twenty minutes. I look at your current site beforehand so the time goes on your business rather than on me asking basic questions. Straight answers on scope, timeline and what a project involves. No slides, no proposal ambush, and if a cheaper option is genuinely right for you I will say so.' },
  { q: 'How much does a website cost?',
    a: 'It depends on page count, features, how much content already exists, and the timeline — which is why I quote after a short conversation rather than publishing a number that would be wrong for most people. The planner tells you which package fits before we ever speak.' },
  { q: 'How long does a project take?',
    a: 'A Starter site is usually two to three weeks. A Business Growth site is usually five to seven. Custom projects are scoped individually. The biggest variable is never design — it is how quickly photos and content decisions land.' },
  { q: 'Do you work with businesses outside your area?',
    a: 'Yes, across the United States. Discovery happens on a call, review happens on a real URL, and nothing about the process requires being in the same room.' },
  { q: 'Do you provide SEO?',
    a: 'I build the foundation: structure, speed, correct markup, one clear topic per page, and the local setup. I do not sell monthly SEO retainers and I will not promise rankings. Anyone guaranteeing a position is either guessing or selling you advertising with a different label on it.' },
  { q: 'Can you redesign my existing website?',
    a: 'Yes, and it is a large share of the work. If we move platforms the page addresses change, which needs a redirect map on day one or you lose whatever search visibility you have built.' },
  { q: 'Will I own my website?',
    a: 'Completely, from day one. Domain, hosting account, code, content and analytics are all registered in your name. No licence, no lease, no platform fee. If you ever want to move on, nothing is held back.' },
  { q: 'Can you write the website content?',
    a: 'Yes, and that is the default. You talk for an hour and correct a draft. The most common reason a website project stalls for months is a client being asked to write it themselves.' },
  { q: 'Can you maintain the website after launch?',
    a: 'Every project includes a post-launch support window. After that there is an optional care plan — hosting, updates, backups, monitoring, and a set block of edit time each month. Optional, and declining it changes nothing else.' },
  { q: 'Do you build e-commerce websites?',
    a: 'Yes, under the Custom Website package. Payments, tax and shipping rules need deciding in week one — they shape the build more than the visual design does.' },
  { q: 'What do you need from me to start?',
    a: 'An hour of your time, whatever photos and logo files you have, and access to your domain. If you have none of those, that is a normal starting point and it is planned for rather than treated as a problem.' },
  { q: 'How many revisions are included?',
    a: 'One round with Starter, two with Business Growth, and a project-specific structure on Custom. They are named in the proposal so there is never an argument about which round we are on.' },
  { q: 'What if I have no logo or professional photos?',
    a: 'Common, and workable. I direct what photography is needed and work with what exists in the meantime. If a logo is missing we use a clean typographic wordmark rather than stalling the project on a branding exercise you did not ask for.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="JP Web Design | Website Design for U.S. Businesses"
  description="Founder-led web design for businesses across the United States. Free homepage demo, free consultation, fixed scope and a fixed launch date."
  schema={faqSchema}
>

  <script is:inline>
    /* Runs synchronously before paint. Only after this class exists does any
       [data-anim] element hide itself — so JS failing means a visible page,
       not a blank one. */
    (function () {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('js-anim');

        /* Watchdog. Hiding and revealing are done by two different scripts;
           if the second one never runs — bundle blocked, CSP, a JS error, an
           extension — the first has already hidden everything. This
           guarantees that cannot outlive a second. */
        setTimeout(function () {
          if (!window.__revealReady) root.classList.remove('js-anim');
        }, 1000);
      } catch (e) {}
    })();
  </script>

  <Hero />

  <!-- ══ THE STAKE ═══════════════════════════════════════════════════════════
       One statement, given the whole viewport. The restraint is the point:
       after a dense interactive hero, the page needs to exhale before it
       starts selling anything. ═══════════════════════════════════════════ -->
  <section class="stake" aria-labelledby="stake-h">
    <div class="container stake__in">
      <p class="mark stake__mark" data-anim><b>§01</b> Why it matters</p>

      <h2 class="stake__h" id="stake-h" data-anim>
        <span class="rise"><span>Good businesses</span></span>
        <span class="rise"><span>lose work to worse</span></span>
        <span class="rise"><span>ones with <em>better</em></span></span>
        <span class="rise"><span><em>websites</em><span class="stake__stop">.</span></span></span>
      </h2>

      <!-- Deliberately offset to the far corner and set small. The statement
           owns the screen; this is a footnote to it, not a second column. -->
      <p class="stake__note" data-anim style="--d:240ms">
        It is rarely a fair fight. The competitor who wins the call is not always better
        at the work — they are just easier to believe in the ninety seconds someone
        spends deciding. The free demo exists so you can see, on your own pages, which
        side of that gap you would be on.
        <a class="tlink stake__link" href="#planner">See yours</a>
      </p>
    </div>
  </section>

  <!-- ══ THE PLATES ═════════════════════════════════════════════════════════
       Three spec builds, labelled with total honesty. The label system is
       the credibility mechanism: SPEC BUILD (uncommissioned, built to show
       the pattern) upgrades in place to COMMISSIONED, then IN SERVICE with
       a live date. Labels only ever move up, and nothing here pretends to
       be client work. The conversion mechanic: each plate's link seeds the
       planner with that industry, so choosing a plate IS starting the demo. -->
  <section class="section plt" id="work" aria-labelledby="plt-h">
    <div class="container">
      <p class="mark" data-anim><b>§02</b> Spec builds — 03 plates</p>
      <div class="head" data-anim>
        <h2 class="h2" id="plt-h">If your business were on this page</h2>
        <p class="lead">
          Three homepages, built to show the standard rather than describe it. None is
          client work — the label under each says exactly that — but every one is how I
          would open the argument for a business like yours. Pick the closest, and the
          planner will already know your industry.
        </p>
      </div>

      <div class="plt__g">

        <!-- Plate 01 — roofing -->
        <article class="plt__c" data-anim>
          <div class="plt__frame" aria-hidden="true">
            <div class="pm pm--roof">
              <div class="pm__bar">
                <span class="pm__logo">SUMMIT ROOFING</span>
                <span class="pm__chip">Get an estimate</span>
              </div>
              <span class="pm__kick">Storm damage? · Insurance claims handled</span>
              <span class="pm__head">On your roof this week, not this season.</span>
              <span class="pm__sub">Free inspections across the county. Licensed &amp; insured.</span>
              <span class="pm__cta">Request an inspection →</span>
              <div class="pm__row"><span></span><span></span><span></span></div>
            </div>
          </div>
          <p class="plt__spec">PLATE {plates[0].n} · {plates[0].trade} · <b>SPEC BUILD</b></p>
          <p class="plt__cap">{plates[0].cap}</p>
          <a class="tlink plt__go" href="#planner" data-plate-industry={plates[0].industry}>
            Build mine like this →
          </a>
        </article>

        <!-- Plate 02 — med spa -->
        <article class="plt__c" data-anim style="--d:90ms">
          <div class="plt__frame" aria-hidden="true">
            <div class="pm pm--spa">
              <div class="pm__bar">
                <span class="pm__logo">Véla Aesthetics</span>
                <span class="pm__chip">Book now</span>
              </div>
              <span class="pm__kick">Skin · Injectables · Laser</span>
              <span class="pm__head">Leave looking like you slept for a week.</span>
              <span class="pm__sub">Consultations are free, and nobody upsells you in a robe.</span>
              <span class="pm__cta">See treatments →</span>
              <div class="pm__row"><span></span><span></span><span></span></div>
            </div>
          </div>
          <p class="plt__spec">PLATE {plates[1].n} · {plates[1].trade} · <b>SPEC BUILD</b></p>
          <p class="plt__cap">{plates[1].cap}</p>
          <a class="tlink plt__go" href="#planner" data-plate-industry={plates[1].industry}>
            Build mine like this →
          </a>
        </article>

        <!-- Plate 03 — restaurant -->
        <article class="plt__c" data-anim style="--d:180ms">
          <div class="plt__frame" aria-hidden="true">
            <div class="pm pm--rest">
              <div class="pm__bar">
                <span class="pm__logo">Harbor &amp; Vine</span>
                <span class="pm__chip">Reserve</span>
              </div>
              <span class="pm__kick">Open tonight until 11</span>
              <span class="pm__head">Dinner is the easy decision.</span>
              <span class="pm__sub">Tonight's menu, the wine list, and a table in two taps.</span>
              <span class="pm__cta">View the menu →</span>
              <div class="pm__row"><span></span><span></span><span></span></div>
            </div>
          </div>
          <p class="plt__spec">PLATE {plates[2].n} · {plates[2].trade} · <b>SPEC BUILD</b></p>
          <p class="plt__cap">{plates[2].cap}</p>
          <a class="tlink plt__go" href="#planner" data-plate-industry={plates[2].industry}>
            Build mine like this →
          </a>
        </article>
      </div>

      <div class="note plt__note" data-anim>
        <span class="lbl">What the labels mean</span>
        <p class="small">
          <strong>SPEC BUILD</strong> is uncommissioned work — no client, no endorsement,
          built to show the standard. When a plate is paid client work it will read
          <strong>COMMISSIONED</strong>, and once it is live, <strong>IN SERVICE</strong> with
          the launch date. Labels only ever upgrade, and nothing on this page will claim a
          client it does not have. Your free demo, if you want it shown here, becomes the
          next plate.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ THE OFFER ══════════════════════════════════════════════════════════ -->
  <section class="section section--panel offer" id="offer" aria-labelledby="offer-h">
    <div class="container">
      <p class="mark" data-anim><b>§03</b> Two ways to start</p>
      <div class="head" data-anim>
        <h2 class="h2" id="offer-h">See yours before you pay for anything</h2>
        <p class="lead">
          You should not have to take a stranger's word for it. Both of these cost nothing,
          and neither obligates you to anything afterwards.
        </p>
      </div>

      <div class="offer__g">
        <article class="offer__c offer__c--lead" data-anim>
          <p class="offer__k">Free demo</p>
          <h3 class="offer__t">A real design of your homepage, built for your business</h3>
          <ul class="offer__l">
            <li>A designed homepage concept using your services, your work and your words — not a template with your logo dropped into it</li>
            <li>The page structure I would build, and the reasoning behind every part of it</li>
            <li>Yours to look at, with no cost and no commitment</li>
          </ul>
          <p class="offer__how">
            Answer the eight planner questions first. Four minutes, and it is what lets me
            design something specific to you instead of something generic.
          </p>
          <a class="btn btn--primary btn--wide" href="#planner">Start the free demo</a>
          <p class="offer__fine">
            <!-- TODO(launch): set a turnaround JP can hold every single time. -->
            Usually back within 3–5 business days. One project at a time, so if I am at
            capacity I will say so rather than leave you waiting.
          </p>
        </article>

        <article class="offer__c" data-anim style="--d:100ms">
          <p class="offer__k">Free consultation</p>
          <h3 class="offer__t">Twenty minutes on what is actually wrong</h3>
          <ul class="offer__l">
            <li>I look at your current site before we speak, so the time goes on your business rather than on discovery</li>
            <li>Straight answers on scope, timeline and what a project would involve</li>
            <li>If a cheaper option is genuinely right for you, I will tell you that instead</li>
          </ul>
          <p class="offer__how">
            No slides, no proposal ambush, no follow-up sequence. If it is not a fit, we will
            both know inside twenty minutes.
          </p>
          <a class="btn btn--ghost btn--wide" href="/contact">Book a free consultation</a>
          <p class="offer__fine">Prefer to type? Email reaches me directly.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ SERVICES ═══════════════════════════════════════════════════════════
       A list, not a grid. Detail opens on hover and focus, all of it in the
       DOM at load — nothing here is hidden from a crawler or a reader. ═══ -->
  <section class="section svc" id="services" aria-labelledby="svc-h">
    <div class="container">
      <p class="mark" data-anim><b>§04</b> Services</p>
      <div class="svc__top" data-anim>
        <h2 class="h2" id="svc-h">Eight things I do</h2>
        <p class="lead">
          Most projects need three or four of them. The planner works out which.
        </p>
      </div>

      <ul class="svc__l">
        {services.map((s, i) => (
          <li class="svc__i" data-anim style={`--d:${i * 45}ms`}>
            <span class="svc__n">{s.n}</span>
            <h3 class="svc__t">{s.t}</h3>
            <p class="svc__d">{s.d}</p>
            <span class="svc__x" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ PACKAGES ═══════════════════════════════════════════════════════════ -->
  <section class="section section--panel" id="packages" aria-labelledby="pkg-h">
    <div class="container">
      <p class="mark" data-anim><b>§05</b> Packages</p>
      <div class="head" data-anim>
        <h2 class="h2" id="pkg-h">Three ways to work together</h2>
        <p class="lead">
          Most businesses land in the middle. If you are unsure, the planner below will tell
          you which one fits and why — and whichever it is, the first step is the same free
          demo, so choosing wrong costs nothing.
        </p>
      </div>
      <div data-anim style="--d:80ms"><Packages /></div>
    </div>
  </section>

  <!-- ══ PLANNER ════════════════════════════════════════════════════════════ -->
  <section class="section" id="planner" aria-labelledby="pln-h">
    <div class="container">
      <p class="mark" data-anim><b>§06</b> Website Project Planner</p>
      <div class="head" data-anim>
        <h2 class="h2" id="pln-h">Eight questions, then your free demo</h2>
        <p class="lead">
          You get a page structure, a feature set, search priorities and a rough timeline on
          screen straight away — no email needed to see any of it. Leave your details at the
          end and I turn it into a designed homepage concept, free.
        </p>
      </div>

      <Planner client:visible />

      <div class="pln__meta">
        <div>
          <h3 class="h3">How the recommendation is made</h3>
          <p class="small">
            Your answers map to a site type, a page count and a feature set. Business type
            drives the page names, service breadth drives the structure, and your primary
            goal decides what the site is optimised around. Nothing is scored secretly, and
            no answer is used to price you.
          </p>
        </div>
        <div>
          <h3 class="h3">What appears on screen</h3>
          <p class="small">
            The recommended package and why, a suggested page list in your own vocabulary,
            the features that follow from it, search priorities, one thing worth leaving
            out, and an estimated timeline range.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ INDUSTRIES ═════════════════════════════════════════════════════════ -->
  <section class="section section--panel ind" id="industries" aria-labelledby="ind-h">
    <div class="container">
      <p class="mark" data-anim><b>§07</b> Industries</p>
      <div class="head" data-anim>
        <h2 class="h2" id="ind-h">Built around how your customers decide</h2>
        <p class="lead">
          A roofing customer and a med spa client behave nothing alike. The structure should
          not be the same, and neither should the page they land on.
        </p>
      </div>
    </div>

    <!-- Full-bleed ticker: motion that also does a job, naming the breadth
         without a wall of list items. Paused on hover and under reduced motion. -->
    <div class="tick" aria-hidden="true">
      <div class="tick__t">
        {[0, 1].map(() => (
          <ul class="tick__l">
            {ticker.map((x) => <li>{x}<span>·</span></li>)}
          </ul>
        ))}
      </div>
    </div>

    <div class="container">
      <ul class="ind__g">
        {industries.map((i, n) => (
          <li class="ind__c" data-anim style={`--d:${n * 55}ms`}>
            <h3 class="ind__t">{i.t}</h3>
            <p class="ind__d">{i.d}</p>
            {i.live
              ? <a class="tlink ind__a" href={i.live}>See the detail</a>
              : <span class="ind__soon">Detailed page in progress</span>}
          </li>
        ))}
      </ul>
      <p class="small ind__also" data-anim>
        Also working with electricians, landscapers, cleaning and moving companies,
        automotive businesses, barbershops, fitness studios, photography and creative
        studios, accountants, consultants, medical offices, startups, and established
        companies that need a redesign.
      </p>
    </div>
  </section>

  <!-- ══ AFTER HOURS ════════════════════════════════════════════════════════
       The one dark section on the page. Bright is the identity; this is the
       single held breath inside it — the moment the visitor pictures the
       customer they never knew they lost. If a second dark section ever
       appears on this page, one of them is wrong. ═══════════════════════ -->
  <section class="section dark grain ah" aria-labelledby="ah-h">
    <div class="container">
      <p class="mark" data-anim><b>§08</b> After hours</p>

      <h2 class="ah__h" id="ah-h" data-anim>
        <span class="rise"><span>9:47 PM<span class="ah__stop">.</span></span></span>
        <span class="rise"><span>Someone just searched</span></span>
        <span class="rise"><span>for what you do.</span></span>
      </h2>

      <div class="ah__b">
        <p class="ah__mono" data-anim style="--d:160ms" aria-hidden="true">
          RESULT&nbsp;&nbsp;→&nbsp;&nbsp;THE COMPANY THAT LOOKED READY
        </p>
        <p class="lead ah__lead" data-anim style="--d:220ms">
          A homeowner with a leak, a bride pricing hair trials, a couple choosing where to
          eat — at that hour nobody calls. They compare websites, pick one, and by morning
          the decision is made. You never find out it happened, which is exactly why it
          keeps happening.
        </p>
        <p class="ah__link" data-anim style="--d:280ms">
          <a class="tlink" href="#planner">See what answering looks like — free demo →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ══ PROCESS ════════════════════════════════════════════════════════════ -->
  <section class="section prc" id="process" aria-labelledby="prc-h">
    <div class="container">
      <p class="mark" data-anim><b>§09</b> Process</p>

      <div class="prc__hero">
        <p class="prc__fig" data-anim aria-hidden="true">
          <span class="prc__num">4</span><span class="prc__unit">hrs</span>
        </p>
        <div class="prc__claim">
          <h2 class="prc__h" id="prc-h" data-anim style="--d:60ms">
            Four hours. That is your entire time commitment.
          </h2>
          <p class="lead" data-anim style="--d:120ms">
            The reason these projects drag on for months is never design. It is that the
            client quietly gets handed the work — the copy, the photo sourcing, the
            chasing. Nine steps below, and the column on the right is what each one
            actually costs you.
          </p>
        </div>
      </div>

      <ol class="prc__l">
        {process.map((p, i) => (
          <li class="prc__i" data-anim style={`--d:${i * 40}ms`}>
            <span class="prc__n">{p.n}</span>
            <div class="prc__b">
              <h3 class="prc__t">{p.t}</h3>
              <p class="prc__d">{p.d}</p>
            </div>
            <span class="prc__y"><span>Your time</span>{p.you}</span>
          </li>
        ))}
      </ol>

      <div class="note prc__note" data-anim>
        <span class="lbl">What I guarantee, and what I don't</span>
        <p class="small">
          Scope, price and launch date — in writing, before work starts. Not rankings, not
          lead volume, not revenue. Nobody can promise those honestly, and the ones who do
          are selling something other than what they will deliver.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ WHY ════════════════════════════════════════════════════════════════ -->
  <section class="section section--panel why" aria-labelledby="why-h">
    <div class="container">
      <p class="mark" data-anim><b>§10</b> Why JP Web Design</p>
      <div class="head" data-anim>
        <h2 class="h2" id="why-h">You are hiring a person, not an account manager</h2>
        <p class="lead">
          The person you talk to is the person who builds it. That is not a slogan — it is a
          capacity constraint, and it is the reason the work stays consistent.
        </p>
      </div>

      <ol class="why__l">
        {[
          ['You own everything.', 'Domain, hosting, code, content, analytics — in your name from day one. No licence, no lease, no hostage situation at renewal.'],
          ['The date is fixed before we start.', 'So is the scope and the price. Revision rounds are named, so there is never an argument about which round we are on.'],
          ['One project at a time.', 'Yours is not queued behind five others. It also means availability is genuinely limited, and I will say so rather than overpromise.'],
          ['You do not write your own website.', 'You talk for an hour and correct a draft. Nobody hands a business owner a spreadsheet and calls it collaboration.'],
          ['Speed is enforced, not promised.', 'The performance budget fails the build. It is not a line in a proposal that nobody checks after launch.'],
          ['I will talk you out of it.', 'If a cheaper option is genuinely right for you, I will say so. Sometimes the honest answer is a template and a weekend.'],
        ].map(([t, d], i) => (
          <li class="why__r" data-anim style={`--d:${i * 60}ms`}>
            <span class="why__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="why__t">{t}</h3>
            <p class="why__d">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══ FAQ ════════════════════════════════════════════════════════════════ -->
  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="container faq__w">
      <p class="mark" data-anim><b>§11</b> Questions</p>
      <div class="head" data-anim><h2 class="h2" id="faq-h">Answers before you ask</h2></div>
      <div class="faq" data-anim style="--d:60ms">
        {faqs.map((f) => (
          <details class="faq__i">
            <summary><span>{f.q}</span></summary>
            <p class="small">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CLOSE ══════════════════════════════════════════════════════════════
       The one vermilion field on the site — the accent at full size, once,
       carrying ink text (the only text colour that passes on this fill). -->
  <section class="close" aria-labelledby="close-h">
    <div class="container close__in">
      <h2 class="close__h" id="close-h" data-anim>
        <span class="rise"><span>Let's build the one</span></span>
        <span class="rise"><span>you wish you had.</span></span>
      </h2>
      <p class="close__l" data-anim style="--d:120ms">
        A free demo of your homepage, or twenty free minutes on what is holding the
        current one back. No obligation at the end of either.
      </p>
      <div class="btn-row close__b" data-anim style="--d:200ms">
        <a class="btn close__cta" href="#planner">Get a Free Demo</a>
        <a class="btn close__alt" href="/contact">Book a Free Consultation</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── The stake: a full-height pause ──────────────────────────────────── */
  .stake { padding-block: clamp(4rem, 9vw, 7rem); }
  .stake__in {
    min-height: min(78svh, 46rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  .stake__mark { margin-bottom: 0; }

  .stake__h {
    align-self: center;
    /* Larger than anything else on the page, including the hero. This is the
       one line the whole argument rests on, and scale is how a page says so. */
    font-size: clamp(2.5rem, 7.6vw, 6.5rem);
    line-height: .96; letter-spacing: -.042em; font-weight: 720;
    text-wrap: initial;   /* explicit line breaks; balancing would fight them */
  }
  .stake__h em { font-style: normal; color: var(--redline); }
  /* Display scale — the fill orange passes large-text contrast here. */
  .stake__stop { color: var(--verm); }

  .stake__note {
    justify-self: end; max-width: 42ch;
    font-size: var(--fs-small); color: var(--graphite);
    padding-top: var(--s4); border-top: 1px solid var(--rule);
  }
  .stake__link { margin-left: .375rem; white-space: nowrap; }
  @media (max-width: 46rem) {
    .stake__in { min-height: 0; }
    .stake__note { justify-self: start; }
  }

  /* ── Plates ──────────────────────────────────────────────────────────── */
  .plt__g {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }
  @media (max-width: 62rem) { .plt__g { grid-template-columns: 1fr; max-width: 34rem; } }

  .plt__c { display: flex; flex-direction: column; gap: var(--s3); }

  .plt__frame {
    border: 1px solid var(--rule-hi); border-radius: 4px;
    overflow: hidden; aspect-ratio: 4 / 3;
    box-shadow: 0 20px 40px -24px rgba(22, 21, 15, .3);
  }
  /* Hover moves the camera, never the type: a slight push-in on the plate,
     as if leaning toward the glass. */
  .pm { transition: transform .45s var(--ease); }
  @media (hover: hover) { .plt__c:hover .pm { transform: scale(1.025); } }

  /* The spec label sits ON a hairline, museum-style. */
  .plt__spec {
    font-family: var(--mono); font-size: var(--fs-label);
    letter-spacing: .1em; color: var(--graphite);
    padding-top: var(--s3); border-top: 1px solid var(--rule);
  }
  .plt__spec b { color: var(--redline); font-weight: 500; }
  .plt__cap { font-size: var(--fs-small); color: var(--graphite); }
  .plt__go { align-self: start; margin-top: auto; }
  .plt__note { margin-top: var(--s7); max-width: 56rem; }

  /* Mini plate internals — each wears its own small identity so the grid
     reads as three different businesses, not three recolourings. */
  .pm {
    width: 100%; height: 100%;
    padding: 7% 8%;
    display: flex; flex-direction: column; justify-content: space-between;
    font-size: clamp(.55rem, 1.05vw, .72rem);
    line-height: 1.4;
  }
  @media (max-width: 62rem) { .pm { font-size: .72rem; } }
  .pm__bar { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .pm__logo { font-weight: 700; letter-spacing: .02em; white-space: nowrap; }
  .pm__chip { font-weight: 650; padding: .28em .7em; border-radius: 2px; white-space: nowrap; }
  .pm__kick { font-family: var(--mono); font-size: .82em; letter-spacing: .09em; text-transform: uppercase; }
  .pm__head { font-size: 1.9em; line-height: 1.06; letter-spacing: -.025em; font-weight: 720; max-width: 14ch; }
  .pm__sub { font-size: .95em; opacity: .78; max-width: 30ch; }
  .pm__cta { font-weight: 650; font-size: .95em; }
  .pm__row { display: flex; gap: .45rem; height: 16%; }
  .pm__row > span { flex: 1; border-radius: 2px; }

  .pm--roof { background: #fff; color: #171a1e; }
  .pm--roof .pm__logo { color: #10365c; }
  .pm--roof .pm__chip { background: #e8621d; color: #171a1e; }
  .pm--roof .pm__kick { color: #b34a10; }
  .pm--roof .pm__cta { color: #10365c; }
  .pm--roof .pm__row > span { background: #e8eaef; }

  .pm--spa { background: #faf3ef; color: #43322c; }
  .pm--spa .pm__logo { font-family: Georgia, 'Times New Roman', serif; font-weight: 600; letter-spacing: .04em; }
  .pm--spa .pm__head { font-family: Georgia, 'Times New Roman', serif; font-weight: 500; letter-spacing: -.01em; }
  .pm--spa .pm__chip { background: #43322c; color: #faf3ef; border-radius: 999px; }
  .pm--spa .pm__kick { color: #a05f45; }
  .pm--spa .pm__cta { color: #a05f45; }
  .pm--spa .pm__row > span { background: #eddcd3; }

  .pm--rest { background: #201913; color: #f2e9dc; }
  .pm--rest .pm__logo { font-family: Georgia, 'Times New Roman', serif; letter-spacing: .05em; }
  .pm--rest .pm__chip { background: #d9a441; color: #201913; }
  .pm--rest .pm__kick { color: #d9a441; }
  .pm--rest .pm__cta { color: #d9a441; }
  .pm--rest .pm__sub { opacity: .7; }
  .pm--rest .pm__row > span { background: #32281e; }

  /* ── Offer ───────────────────────────────────────────────────────────── */
  .offer__g {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(0, 1fr);
    gap: var(--s5); align-items: stretch;
  }
  @media (max-width: 52rem) { .offer__g { grid-template-columns: 1fr; } }
  .offer__c {
    display: flex; flex-direction: column; gap: var(--s3);
    background: var(--card); border: 1px solid var(--rule);
    border-radius: 3px; padding: clamp(1.25rem, 2.6vw, 1.75rem); height: 100%;
    transition: border-color .25s var(--ease), transform .25s var(--ease);
  }
  .offer__c:hover { border-color: var(--rule-hi); transform: translateY(-2px); }
  /* The demo carries the weight: darker edge, larger heading, roomier. */
  .offer__c--lead {
    border-color: var(--ink); border-width: 2px;
    padding: clamp(1.5rem, 3.2vw, 2.25rem);
  }
  .offer__c--lead .offer__t { font-size: clamp(1.25rem, 2.2vw, 1.625rem); letter-spacing: -.022em; }
  .offer__c--lead .offer__l { font-size: var(--fs-body); }
  .offer__k {
    font-family: var(--mono); font-size: var(--fs-label); letter-spacing: .12em;
    text-transform: uppercase; color: var(--redline);
  }
  .offer__t { font-size: 1.1875rem; font-weight: 680; letter-spacing: -.012em; line-height: 1.3; }
  .offer__l { display: grid; gap: var(--s3); margin-top: var(--s2); font-size: var(--fs-small); }
  .offer__l li { display: grid; grid-template-columns: 1rem 1fr; gap: var(--s3); align-items: start; }
  .offer__l li::before { content: '✓'; color: var(--redline); font-size: .875rem; line-height: 1.5; }
  .offer__how {
    font-size: var(--fs-small); color: var(--graphite);
    padding: var(--s3) var(--s4); background: var(--panel);
    border-left: 2px solid var(--rule-hi); border-radius: 0 3px 3px 0;
  }
  .offer__c .btn { margin-top: auto; }
  .offer__fine { font-size: .8125rem; color: var(--graphite); }

  /* ── Services ────────────────────────────────────────────────────────── */
  .svc__top {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--s5); flex-wrap: wrap; margin-bottom: var(--s7);
  }
  .svc__top .lead { max-width: 34ch; }

  .svc__l { border-top: 1px solid var(--rule); }
  .svc__i {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 15rem) minmax(0, 1fr) 2rem;
    align-items: start; gap: var(--s5);
    padding: clamp(1.15rem, 2.4vw, 1.6rem) 0;
    border-bottom: 1px solid var(--rule);
    transition: background-color .3s var(--ease), padding-left .3s var(--ease);
  }
  .svc__n {
    font-family: var(--mono); font-size: var(--fs-label); letter-spacing: .1em;
    color: var(--rule-hi); padding-top: .45rem;
    transition: color .3s var(--ease);
  }
  .svc__t { font-size: clamp(1.125rem, 2.1vw, 1.5rem); font-weight: 660; letter-spacing: -.02em; }
  .svc__d { font-size: var(--fs-small); color: var(--graphite); max-width: 56ch; }
  .svc__x {
    justify-self: end; width: 1.5rem; height: 1.5rem; margin-top: .25rem;
    border-radius: 50%; border: 1px solid var(--rule);
    display: grid; place-items: center;
    transition: background-color .3s var(--ease), border-color .3s var(--ease);
  }
  .svc__x::before {
    content: ''; width: .375rem; height: .375rem;
    border-top: 1.5px solid var(--rule-hi); border-right: 1.5px solid var(--rule-hi);
    transform: rotate(45deg) translate(-1px, 1px);
    transition: border-color .3s var(--ease);
  }
  /* Hover shifts the whole row a few pixels and lights the marker. Small,
     but it makes an eight-item list feel like an instrument. */
  @media (hover: hover) {
    .svc__i:hover { background: var(--panel); padding-left: var(--s4); }
    .svc__i:hover .svc__n { color: var(--redline); }
    .svc__i:hover .svc__x { background: var(--verm); border-color: var(--verm); }
    .svc__i:hover .svc__x::before { border-color: var(--ink); }
  }
  @media (max-width: 62rem) {
    .svc__i { grid-template-columns: 2.5rem 1fr; gap: var(--s3) var(--s4); }
    .svc__d { grid-column: 2; }
    .svc__x { display: none; }
  }

  /* ── Industries ──────────────────────────────────────────────────────── */
  .tick {
    margin-block: var(--s6) var(--s7);
    border-block: 1px solid var(--rule);
    padding-block: var(--s4);
    overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .tick__t { display: flex; width: max-content; animation: tick 46s linear infinite; }
  .tick__l { display: flex; }
  .tick__l li {
    display: flex; align-items: center; gap: var(--s5);
    padding-right: var(--s5);
    font-size: clamp(1.25rem, 2.6vw, 2rem); font-weight: 660;
    letter-spacing: -.02em; color: var(--ink); white-space: nowrap;
  }
  .tick__l li span { color: var(--redline); font-weight: 400; }
  .tick:hover .tick__t { animation-play-state: paused; }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tick__t { animation: none; } }

  .ind__g { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s5); }
  @media (max-width: 62rem) { .ind__g { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 40rem) { .ind__g { grid-template-columns: 1fr; } }
  .ind__c {
    display: flex; flex-direction: column; gap: var(--s3);
    padding-top: var(--s4); border-top: 2px solid var(--ink);
  }
  .ind__t { font-size: 1.0625rem; font-weight: 680; letter-spacing: -.012em; }
  .ind__d { font-size: var(--fs-small); color: var(--graphite); }
  .ind__a, .ind__soon { margin-top: auto; align-self: start; }
  .ind__soon {
    font-family: var(--mono); font-size: .75rem; letter-spacing: .08em;
    text-transform: uppercase; color: var(--graphite);
  }
  .ind__also { margin-top: var(--s7); max-width: 68ch; }

  /* ── After hours ─────────────────────────────────────────────────────── */
  .ah { padding-block: clamp(5rem, 11vw, 9rem); }
  .ah__h {
    font-size: clamp(2.5rem, 6.6vw, 5.5rem);
    line-height: .98; letter-spacing: -.038em; font-weight: 720;
  }
  .ah__stop { color: var(--ember); }
  .ah__b {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    display: grid; gap: var(--s5);
    justify-items: start;
    max-width: 46rem; margin-left: auto;
  }
  .ah__mono {
    font-family: var(--mono); font-size: var(--fs-label);
    letter-spacing: .12em; color: var(--ember);
    padding-bottom: var(--s3); border-bottom: 1px solid var(--void-rule);
    width: 100%;
  }
  .ah__lead { max-width: 56ch; }
  @media (max-width: 46rem) { .ah__b { margin-left: 0; } }

  /* ── Process ─────────────────────────────────────────────────────────── */
  /* The number is the argument. Set at a scale nothing else on the page
     reaches, and hung off the baseline of the claim beside it. */
  .prc__hero {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem); align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .prc__fig {
    display: flex; align-items: baseline; gap: .1em;
    line-height: .78; letter-spacing: -.06em; font-weight: 720;
    color: var(--ink);
  }
  .prc__num { font-size: clamp(6rem, 17vw, 15rem); }
  .prc__unit {
    font-family: var(--mono); font-size: clamp(1rem, 2.2vw, 1.75rem);
    font-weight: 400; letter-spacing: -.01em; color: var(--redline);
  }
  .prc__claim { padding-bottom: clamp(.5rem, 1.5vw, 1.25rem); }
  .prc__h {
    font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.12;
    letter-spacing: -.026em; font-weight: 680; margin-bottom: var(--s4);
    max-width: 24ch;
  }
  @media (max-width: 60rem) {
    .prc__hero { grid-template-columns: 1fr; align-items: start; gap: var(--s5); }
    .prc__claim { padding-bottom: 0; }
  }

  .prc__l { border-top: 1px solid var(--rule); counter-reset: step; }
  .prc__i {
    display: grid; grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: var(--s5); align-items: baseline;
    padding: var(--s5) 0; border-bottom: 1px solid var(--rule);
  }
  .prc__n {
    font-family: var(--mono); font-size: 1.125rem; color: var(--redline);
    letter-spacing: .04em;
  }
  .prc__t { font-size: 1.0625rem; font-weight: 680; margin-bottom: var(--s2); }
  .prc__d { font-size: var(--fs-small); color: var(--graphite); max-width: 62ch; }
  .prc__y {
    font-family: var(--mono); font-size: .8125rem; color: var(--graphite);
    text-align: right; white-space: nowrap;
  }
  .prc__y span {
    display: block; font-size: var(--fs-label); letter-spacing: .1em;
    text-transform: uppercase; color: var(--rule-hi);
  }
  @media (max-width: 52rem) {
    .prc__i { grid-template-columns: 2.75rem 1fr; }
    .prc__y { grid-column: 2; text-align: left; margin-top: var(--s2); }
    .prc__y span { display: inline; margin-right: .375rem; }
  }
  .prc__note { margin-top: var(--s6); max-width: 54rem; }

  /* ── Why ─────────────────────────────────────────────────────────────── */
  /* Statement left at scale, evidence right and small. The eye reads six
     positions in a column, then drops into detail only where it snags. */
  .why__l { border-top: 1px solid var(--rule-hi); }
  .why__r {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding: clamp(1.35rem, 3vw, 2.15rem) 0;
    border-bottom: 1px solid var(--rule-hi);
  }
  .why__n {
    font-family: var(--mono); font-size: var(--fs-label);
    letter-spacing: .1em; color: var(--redline);
  }
  .why__t {
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    line-height: 1.14; letter-spacing: -.026em; font-weight: 680;
  }
  .why__d { font-size: var(--fs-small); color: var(--graphite); max-width: 46ch; }
  @media (max-width: 60rem) {
    .why__r { grid-template-columns: 2.5rem 1fr; gap: var(--s2) var(--s4); }
    .why__d { grid-column: 2; margin-top: var(--s2); }
  }

  /* ── FAQ ─────────────────────────────────────────────────────────────── */
  .faq__w { max-width: 54rem; }
  .faq { border-top: 1px solid var(--rule); }
  .faq__i { border-bottom: 1px solid var(--rule); }
  .faq__i summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s4);
    cursor: pointer; padding: var(--s4) 0; font-weight: 640; list-style: none;
    min-height: 2.75rem;
  }
  .faq__i summary::-webkit-details-marker { display: none; }
  .faq__i summary::after {
    content: '+'; font-family: var(--mono); color: var(--redline);
    font-size: 1.125rem; flex: none; transition: transform .25s var(--ease);
  }
  .faq__i[open] summary::after { content: '–'; }
  .faq__i > p { padding-bottom: var(--s5); max-width: var(--measure); }

  /* ── Close: the vermilion field ──────────────────────────────────────── */
  /* Ink is the only text colour that passes on this fill (4.64:1) — white
     fails at 3.9:1, which is why nothing here is white. */
  .close { background: var(--verm); color: var(--ink); padding-block: clamp(5rem, 12vw, 10rem); }
  .close__in { max-width: 50rem; }
  .close__h {
    font-size: var(--fs-mega); line-height: 1.0; letter-spacing: -.035em; font-weight: 720;
  }
  .close__l { margin-top: var(--s5); font-size: var(--fs-lead); line-height: 1.55; max-width: 52ch; }
  .close__b { margin-top: var(--s6); }
  .close__cta { background: var(--ink); color: var(--paper); }
  .close__cta:hover { background: #000; }
  .close__alt { border-color: var(--ink); color: var(--ink); }
  .close__alt:hover { background: rgba(22, 21, 15, .08); }
  .close :where(a, button):focus-visible { outline-color: var(--ink); }

  /* ── Planner supporting copy ─────────────────────────────────────────── */
  .pln__meta {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--s6);
    margin-top: var(--s7); padding-top: var(--s5); border-top: 1px solid var(--rule);
  }
  .pln__meta .h3 { margin-bottom: var(--s2); }
  @media (max-width: 48rem) { .pln__meta { grid-template-columns: 1fr; gap: var(--s5); } }
</style>

<script>
  /* ~700 bytes. Content is visible by default; this only opts elements into
     the entrance once JS is confirmed alive, so a failed script or a
     crawler sees a finished page rather than an empty one. */
  const els = document.querySelectorAll<HTMLElement>('[data-anim]');

  /* Tell the watchdog the reveal controller is alive. */
  (window as any).__revealReady = true;

  /* Anything already in view — the entire hero — is revealed on this frame
     rather than waiting for an observer callback. Above-the-fold content
     should never depend on a scroll event that has not happened. */
  const vh = window.innerHeight || document.documentElement.clientHeight;
  els.forEach((el) => {
    if (el.getBoundingClientRect().top < vh) el.classList.add('in');
  });

  if (document.documentElement.classList.contains('js-anim') && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        /* Reveal on entry — or if a fast flick-scroll carried the element
           above the viewport before the callback ran. Without the second
           case, scrolling quickly can leave content permanently hidden. */
        if (!e.isIntersecting && e.boundingClientRect.top > 0) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    els.forEach((el) => { if (!el.classList.contains('in')) io.observe(el); });
  } else {
    /* No observer support: reveal everything immediately rather than leaving
       anything hidden. */
    els.forEach((el) => el.classList.add('in'));
  }

  /* "Build mine like this →" — clicking a plate seeds the planner with that
     plate's industry before the anchor jump, so the first question arrives
     already answered. The write happens in the click handler, synchronously
     ahead of the scroll; the planner island hydrates on visibility and reads
     sessionStorage on mount. Choosing a plate IS starting the demo. */
  const KEY = 'jpwd.planner.v1';
  document.querySelectorAll<HTMLAnchorElement>('[data-plate-industry]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        const cur = JSON.parse(sessionStorage.getItem(KEY) || '{}');
        sessionStorage.setItem(KEY, JSON.stringify({ ...cur, businessType: a.dataset.plateIndustry }));
      } catch (e) { /* storage unavailable — the link still lands on the planner */ }
    });
  });
</script>
