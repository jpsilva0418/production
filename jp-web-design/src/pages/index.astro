---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Packages from '../components/Packages.astro';
import Founder from '../components/Founder.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, STATUS_LABEL } from '../data/projects';
import { SERVICES } from '../data/services';
import { INDUSTRIES } from '../data/industries';

/* Latest two posts. The homepage previews the blog; /blog is the real index. */
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

/* Selected work is real now, so the spec-build plates have served their
   purpose and retired. The label system they established carries over
   unchanged: IN SERVICE for live client work, IN DEVELOPMENT for what is
   built but not public. Labels only ever upgrade. Data lives in
   src/data/projects.ts so /work and the homepage cannot drift apart. */


const why = [
  ['You own everything', 'Domain, hosting, code, content, analytics — in your name from day one.'],
  ['The date is fixed before we start', 'So is the scope and the price. Revision rounds are named in writing.'],
  ['One project at a time', 'Yours is not queued behind five others — and I say so when I’m at capacity.'],
  ['You don’t write your own website', 'You talk for an hour and correct a draft. That’s your whole job.'],
  ['Speed is enforced, not promised', 'The performance budget fails the build, not a line in a proposal.'],
  ['I’ll talk you out of it', 'If a cheaper option is genuinely right for you, I’ll say so.'],
];

const faqs = [
  { q: 'Is the free demo actually free?',
    a: 'Yes, and nothing is attached to it. You answer the planner questions, I design a homepage concept for your business, and you look at it. If you do not want to go further, that is the end of it — no invoice, no follow-up sequence. I offer it because the studio is new, and real work on your own business is more convincing than any portfolio I could point you at.' },
  { q: 'What happens on the free consultation?',
    a: 'About twenty minutes. I look at your current site beforehand so the time goes on your business rather than on me asking basic questions. Straight answers on scope, timeline and what a project involves. No slides, no proposal ambush, and if a cheaper option is genuinely right for you I will say so.' },
  { q: 'How much does a website cost?',
    a: 'It depends on page count, features, how much content already exists, and the timeline — which is why I quote after a short conversation rather than publishing a number that would be wrong for most people. The planner tells you which package fits before we ever speak.' },
  { q: 'How long does a project take?',
    a: 'A Starter site is usually two to three weeks. A Business Growth site is usually five to seven. Custom projects are scoped individually. The biggest variable is never design — it is how quickly photos and content decisions land.' },
  { q: 'Do you work with businesses outside your area?',
    a: 'Yes, across the United States. Discovery happens on a call, review happens on a real URL, and nothing about the process requires being in the same room.' },
  { q: 'Do you provide SEO?',
    a: 'I build the foundation: structure, speed, correct markup, one clear topic per page, and the local setup. I do not sell monthly SEO retainers and I will not promise rankings. Anyone guaranteeing a position is either guessing or selling you advertising with a different label on it.' },
  { q: 'Can you redesign my existing website?',
    a: 'Yes, and it is a large share of the work. If we move platforms the page addresses change, which needs a redirect map on day one or you lose whatever search visibility you have built.' },
  { q: 'Will I own my website?',
    a: 'Completely, from day one. Domain, hosting account, code, content and analytics are all registered in your name. No licence, no lease, no platform fee. If you ever want to move on, nothing is held back.' },
  { q: 'Can you write the website content?',
    a: 'Yes, and that is the default. You talk for an hour and correct a draft. The most common reason a website project stalls for months is a client being asked to write it themselves.' },
  { q: 'Can you maintain the website after launch?',
    a: 'Every project includes a post-launch support window. After that there is an optional care plan — hosting, updates, backups, monitoring, and a set block of edit time each month. Optional, and declining it changes nothing else.' },
  { q: 'Do you build e-commerce websites?',
    a: 'Yes, under the Custom Website package. Payments, tax and shipping rules need deciding in week one — they shape the build more than the visual design does.' },
  { q: 'What do you need from me to start?',
    a: 'An hour of your time, whatever photos and logo files you have, and access to your domain. If you have none of those, that is a normal starting point and it is planned for rather than treated as a problem.' },
  { q: 'How many revisions are included?',
    a: 'One round with Starter, two with Business Growth, and a project-specific structure on Custom. They are named in the proposal so there is never an argument about which round we are on.' },
  { q: 'What if I have no logo or professional photos?',
    a: 'Common, and workable. I direct what photography is needed and work with what exists in the meantime. If a logo is missing we use a clean typographic wordmark rather than stalling the project on a branding exercise you did not ask for.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const check = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5 8.5 15 16 5.5"/></svg>`;
---
<Base
  title="JP Silva Digital | Websites, Software & Ads for U.S. Businesses"
  description="Websites, Google Ads and Meta Ads for U.S. businesses — built and run by JP Silva. Free homepage demo, free consultation, no obligation either way."
  schema={faqSchema}
>

  <script is:inline>
    /* Runs synchronously before paint.
       1. Adds .js-anim — only then does any [data-anim] hide itself, so JS
          failing means a visible page, not a blank one. A 1s watchdog
          strips the class unless the reveal controller announces itself.
       2. Arms the opening sequence — once per session, never for reduced
          motion, and the overlay self-destructs on its own timer so no
          failure downstream can leave it covering the page. */
    (function () {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('js-anim');
        setTimeout(function () {
          if (!window.__revealReady) root.classList.remove('js-anim');
        }, 1000);

        var seen = false;
        try { seen = sessionStorage.getItem('jpwd.opened') === '1'; } catch (e) {}
        if (!seen) {
          try { sessionStorage.setItem('jpwd.opened', '1'); } catch (e) {}
          root.classList.add('js-open');
          setTimeout(function () {
            var o = document.getElementById('open');
            if (o) o.remove();
            root.classList.remove('js-open');
          }, 2400);
        }
      } catch (e) {}
    })();
  </script>

  <!-- ══ OPENING — hidden unless the gate arms it ═══════════════════════ -->
  <div class="open" id="open" aria-hidden="true">
    <span class="open__half open__half--t"></span>
    <span class="open__half open__half--b"></span>
    <div class="open__c">
      <p class="open__wm">
        <span class="open__badge">JP</span>
        <span class="open__name"><span class="L" style="--i:0">S</span><span class="L" style="--i:1">i</span><span class="L" style="--i:2">l</span><span class="L" style="--i:3">v</span><span class="L" style="--i:4">a</span><span class="L" style="--i:5">&nbsp;</span><b><span class="L" style="--i:6">D</span><span class="L" style="--i:7">i</span><span class="L" style="--i:8">g</span><span class="L" style="--i:9">i</span><span class="L" style="--i:10">t</span><span class="L" style="--i:11">a</span><span class="L" style="--i:12">l</span></b></span>
      </p>
      <span class="open__line"></span>
    </div>
  </div>

  <div class="prog" id="prog" aria-hidden="true"></div>

  <Hero />

  <!-- ══ THE PROBLEM ════════════════════════════════════════════════════ -->
  <section class="sec" aria-labelledby="prb-h">
    <div class="container">
      <p data-anim="pop"><span class="mark mark--red" style="margin-bottom:0">The problem</span></p>
      <h2 class="sec__h" id="prb-h" data-split data-anim>Good businesses lose work to worse ones with better websites</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        The competitor who wins the call is not always better at the work — they are just
        easier to believe in the ninety seconds someone spends deciding.
      </p>
      <div class="cards3">
        <article class="card tilt" data-anim="card" style="border-color:var(--red-bd)">
          <span class="chip chip--red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8"/></svg></span>
          <h3 class="card__t">The template look</h3>
          <p class="card__x">Your site came from the same builder as three competitors&rsquo;. Customers can&rsquo;t say why it feels interchangeable — but they feel it, and they keep scrolling.</p>
        </article>
        <article class="card tilt" data-anim="card" style="--d:110ms;border-color:var(--red-bd)">
          <span class="chip chip--red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
          <h3 class="card__t">The agency runaround</h3>
          <p class="card__x">Discovery calls, proposals, account managers, months of process — and the person you talked to is never the person doing the work.</p>
        </article>
        <article class="card tilt" data-anim="card" style="--d:220ms;border-color:var(--red-bd)">
          <span class="chip chip--red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg></span>
          <h3 class="card__t">The DIY weekend trap</h3>
          <p class="card__x">You could build it yourself — that&rsquo;s what the ads say. Six weekends later it&rsquo;s half-finished, and it still doesn&rsquo;t look like the ads.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ HOW IT WORKS ═══════════════════════════════════════════════════ -->
  <section class="sec" id="how" aria-labelledby="how-h">
    <div class="container">
      <p data-anim="pop"><span class="mark mark--green" style="margin-bottom:0">How it works</span></p>
      <h2 class="sec__h" id="how-h" data-split data-anim>From eight questions to a homepage you can look at</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        No training sessions, no onboarding calls, no proposal ambush. You answer the
        planner, I design, you decide. That&rsquo;s the whole process.
      </p>
      <div class="cards3 steps" data-anim="none" data-steps>
        <article class="card tilt" data-anim="left" style="border-color:var(--green-bd)">
          <span class="stepn">1</span>
          <h3 class="card__t">Answer eight questions</h3>
          <p class="card__x">Your trade, your goals, what you have today. The planner turns it into a page structure and a package fit — on screen, no email required.</p>
          <span class="meta">≈ 4 minutes</span>
        </article>
        <article class="card tilt" data-anim style="--d:150ms;border-color:var(--green-bd)">
          <span class="stepn">2</span>
          <h3 class="card__t">I design your homepage — free</h3>
          <p class="card__x">A real design concept using your services, your work and your words. Not a template with your logo dropped in.</p>
          <span class="meta">3–5 business days</span>
        </article>
        <article class="card tilt" data-anim="right" style="--d:300ms;border-color:var(--green-bd)">
          <span class="stepn">3</span>
          <h3 class="card__t">You decide</h3>
          <p class="card__x">Love it, we build the rest. Don&rsquo;t, and that&rsquo;s the end — no invoice, no follow-up sequence, no hard feelings.</p>
          <span class="meta">$0 either way</span>
        </article>
      </div>
      <p class="sec__note" data-anim>
        Detail on all nine project steps lives on the <a class="tlink" href="/process">process page</a> —
        your total time commitment is about four hours.
      </p>
    </div>
  </section>

  <!-- ══ SELECTED WORK ═══════════════════════════════════════════════ -->
  <section class="sec" id="work" aria-labelledby="plt-h">
    <div class="container">
      <p data-anim="pop"><span class="mark mark--amber" style="margin-bottom:0">Selected work</span></p>
      <h2 class="sec__h" id="plt-h" data-split data-anim>Real projects, honestly labelled</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        A bridal studio, a family cleaning company, and a finance app I designed and built
        myself. The label under each one is the literal truth about where it stands &mdash;
        and there is nothing on this page I did not build.
      </p>

      <div class="wrk">
        {PROJECTS.map((p, i) => (
          <a class="wrk__c" href={`/work/${p.slug}`} data-anim="card" style={`--d:${i * 90}ms`}
             data-track="project_view" data-track-label={p.slug}>
            <span class="wrk__m" style={`background:${p.tint}`}>
              <img src={p.image} alt={p.imageAlt} width="512" height="1000" loading="lazy" decoding="async" />
            </span>
            <span class="wrk__b">
              <span class={`wrk__tag ${p.status === 'development' ? 'wrk__tag--dev' : ''}`}>{STATUS_LABEL[p.status]}</span>
              <span class="wrk__cat">{p.category}</span>
              <h3 class="wrk__n">{p.name}</h3>
              <span class="wrk__x">{p.summary}</span>
              <span class="tlink wrk__go">View project <span aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        ))}
      </div>

      <div class="note plt__note" data-anim>
        <span class="lbl">What the labels mean</span>
        <p class="small">
          <strong>IN SERVICE</strong> means the site is live and working for a real business.
          <strong>IN DEVELOPMENT</strong> means it is built but not yet public. Labels only ever
          upgrade, nothing here claims a client it does not have, and no project carries a
          performance figure unless the client measured it and agreed to publish it.
          <a class="tlink plt__all" href="/work">See all work &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ══ THE OFFER ══════════════════════════════════════════════════════ -->
  <section class="sec sec--panel" id="offer" aria-labelledby="offer-h">
    <div class="container">
      <p data-anim="pop"><span class="mark" style="margin-bottom:0">Two ways to start</span></p>
      <h2 class="sec__h" id="offer-h" data-split data-anim>See yours before you pay for anything</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        You should not have to take a stranger&rsquo;s word for it. Both of these cost nothing,
        and neither obligates you to anything afterwards.
      </p>

      <div class="offer__g">
        <article class="card offer__c offer__c--lead" data-anim>
          <p class="offer__k">Free demo</p>
          <h3 class="offer__t">A real design of your homepage, built for your business</h3>
          <ul class="offer__l">
            <li set:html={check + 'A designed homepage concept using your services, your work and your words'} />
            <li set:html={check + 'The page structure I would build, and the reasoning behind it'} />
            <li set:html={check + 'Yours to look at, with no cost and no commitment'} />
          </ul>
          <a class="btn btn--primary btn--wide" href="/free-demo">Start the free demo</a>
          <p class="offer__fine">
            <!-- TODO(launch): set a turnaround JP can hold every single time. -->
            Usually back within 3–5 business days. One project at a time — if I&rsquo;m at
            capacity I&rsquo;ll say so rather than leave you waiting.
          </p>
        </article>

        <article class="card offer__c" data-anim style="--d:100ms">
          <p class="offer__k">Free consultation</p>
          <h3 class="offer__t">Twenty minutes on what is actually wrong</h3>
          <ul class="offer__l">
            <li set:html={check + 'I look at your current site before we speak'} />
            <li set:html={check + 'Straight answers on scope, timeline and what a project involves'} />
            <li set:html={check + 'If a cheaper option is right for you, I’ll tell you that instead'} />
          </ul>
          <a class="btn btn--ghost btn--wide" href="/contact">Book a free consultation</a>
          <p class="offer__fine">Prefer to type? Email reaches me directly.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ SERVICES ═══════════════════════════════════════════════════ -->
  <section class="sec" id="services" aria-labelledby="svc-h">
    <div class="container">
      <p data-anim="pop"><span class="mark" style="margin-bottom:0">Services</span></p>
      <h2 class="sec__h" id="svc-h" data-split data-anim>Three things, done properly</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        Advertising brings people to you. The website decides whether they call. I do both,
        so neither one gets blamed on the other vendor.
      </p>

      <div class="svc__g">
        {SERVICES.map((s, i) => (
          <a class="card svc__c" href={`/services/${s.slug}`} data-anim style={`--d:${i * 80}ms`}>
            <h3 class="svc__t">{s.name}</h3>
            <p class="card__x">{s.blurb}</p>
            <ul class="svc__l">
              {s.includes.slice(0, 3).map((x) => <li>{x}</li>)}
            </ul>
            <span class="tlink svc__go">What this involves <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>

      <p class="svc__note" data-anim>
        Ads get them there &middot; the website turns them into calls &middot; tracking tells you which worked.
        <a class="tlink" href="/services">All services &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ══ MEET JP ════════════════════════════════════════════════════════ -->
  <Founder />

  <!-- ══ PLANNER PREVIEW ══════════════════════════════════════════════
       The planner itself lives at /free-demo. This is the door to it, not a
       second copy — there is exactly one Website Project Planner. ══════════ -->
  <section class="sec sec--panel" id="planner" aria-labelledby="pln-h">
    <div class="container">
      <p data-anim="pop"><span class="mark mark--green" style="margin-bottom:0">Website project planner</span></p>
      <h2 class="sec__h" id="pln-h" data-split data-anim>Eight questions, then your free demo</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        A page structure, feature set, search priorities and rough timeline &mdash; on screen
        straight away, no email needed. Leave your details at the end and I turn it into a
        designed homepage concept, free.
      </p>

      <div class="pln__preview" data-anim style="--d:120ms">
        <ol class="pln__steps">
          <li><span>01</span><b>Answer eight questions</b><i>≈ 4 minutes</i></li>
          <li><span>02</span><b>Your plan appears on screen</b><i>Instant, no email</i></li>
          <li><span>03</span><b>I design your homepage</b><i>3–5 business days</i></li>
          <li><span>04</span><b>You decide</b><i>$0 either way</i></li>
        </ol>
        <div class="pln__go">
          <a class="btn btn--primary" href="/free-demo" data-track="demo_start" data-track-label="home-planner">
            Start the free demo <span class="btn__arr" aria-hidden="true">→</span>
          </a>
          <p class="small">Nothing is owed, and nothing is held back &mdash; the plan shows before any details are asked for.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ INDUSTRIES PREVIEW ══════════════════════════════════════════
       Who the work is for. The full page is /industries; this is the door
       to it. Work (what JP built) and Industries (who it suits) stay
       separate things throughout the site. ═══════════════════════════════ -->
  <section class="sec" id="industries" aria-labelledby="ind-h">
    <div class="container">
      <p data-anim="pop"><span class="mark" style="margin-bottom:0">Industries</span></p>
      <h2 class="sec__h" id="ind-h" data-split data-anim>Built around how your customers decide</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        A roofing customer and a bridal client behave nothing alike. The structure should not
        be the same, and neither should the page they land on.
      </p>

      <ul class="indp" data-anim style="--d:120ms">
        {INDUSTRIES.map((i) => (
          <li class="indp__i">
            <a href="/industries">
              <b>{i.name}</b>
              <span>{i.examples.slice(0, 4).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="indp__go" data-anim>
        <a class="btn btn--ghost" href="/industries">See who I work with</a>
      </p>
    </div>
  </section>

  <!-- ══ 9:47 PM ════════════════════════════════════════════════════════
       The one dark section. Without JS this renders complete — clock at
       9:47, all three results visible, winner ringed. The script only adds
       the cinema: circle wipe, clock roll, typed query, cascade, pick. ═══ -->
  <section class="night" id="night" aria-labelledby="ah-h">
    <div class="container night__in">
      <p class="night__clock" aria-hidden="true"><span id="clock">9:47</span><b> PM</b></p>
      <h2 class="night__h" id="ah-h">Someone just searched for what you do.</h2>
      <p class="night__sub">
        At that hour nobody calls. They compare websites, pick one, and by morning the
        decision is made. Watch it happen:
      </p>

      <div class="srch" aria-hidden="true">
        <div class="srch__bar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="srch__q" id="srchQ">emergency roof repair near me</span><span class="srch__caret" id="srchCaret"></span>
        </div>
        <div class="srch__res">
          <div class="srch__r srch__r--win" id="rw">
            <span><span class="srch__n">Modern site · clear pricing · big tap-to-call</span>
            <span class="srch__d">Answers every question in one screen — looks ready tonight</span></span>
            <span class="srch__go">← THEY TAP THIS</span>
          </div>
          <div class="srch__r" id="r2">
            <span><span class="srch__n">Your Business LLC — Welcome to our website!</span>
            <span class="srch__d">Last updated 2019 · menu of links · no number visible</span></span>
          </div>
          <div class="srch__r" id="r3">
            <span><span class="srch__n">Directory listing · 14 companies, zero photos</span>
            <span class="srch__d">A coin flip wearing a phone book&rsquo;s clothes</span></span>
          </div>
        </div>
      </div>

      <p><span class="night__tag" id="nightTag">BY MORNING, THE DECISION IS MADE</span></p>
      <p><a class="night__link" href="/free-demo">Be the site that answers — free demo →</a></p>
    </div>
  </section>

  <!-- ══ PACKAGES ═══════════════════════════════════════════════════════ -->
  <section class="sec" id="packages" aria-labelledby="pkg-h">
    <div class="container">
      <p data-anim="pop"><span class="mark" style="margin-bottom:0">Packages</span></p>
      <h2 class="sec__h" id="pkg-h" data-split data-anim>Three ways to work together</h2>
      <p class="sec__sub" data-anim style="--d:160ms">
        Scoped by your situation, not a feature checklist — and whichever fits, the first
        step is the same free demo, so choosing wrong costs nothing.
      </p>
      <div data-anim style="--d:120ms"><Packages /></div>
      <p class="pk__note" data-anim>
        No prices on the page on purpose: every project is quoted after a short
        conversation, so the number fits your scope — not an average of everyone else&rsquo;s.
      </p>
    </div>
  </section>

  <!-- ══ WHY ════════════════════════════════════════════════════════════ -->
  <section class="sec sec--panel" aria-labelledby="why-h">
    <div class="container">
