---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Packages from '../components/Packages.astro';
import Planner from '../components/planner/Planner.jsx';

/* Services are a list, not a card grid. A grid of eight equal cards asks the
   eye to compare things that aren't comparable; a list with a revealed
   detail lets someone scan the eight names first and stop only where it
   matters to them. */
const services = [
  { n: '01', t: 'Website design',        d: 'A new site built around how your customers actually decide — not around the order a template happened to stack its sections in.' },
  { n: '02', t: 'Website redesign',      d: 'You already have a site. It either looks dated, or it looks fine and does nothing. Those are different problems with different fixes.' },
  { n: '03', t: 'SEO foundations',       d: 'Structure, speed, correct markup, one clear topic per page. The groundwork rankings are built on — not a monthly retainer with a dashboard.' },
  { n: '04', t: 'Local SEO',             d: 'Google Business Profile, consistent business details everywhere, and service-area pages capped at the places you genuinely work.' },
  { n: '05', t: 'Landing pages',         d: 'One page, one audience, one action. Built for campaigns where every click has a price attached to it.' },
  { n: '06', t: 'E-commerce',            d: 'Product and category structure that customers and search engines can both navigate without getting lost.' },
  { n: '07', t: 'Website care',          d: 'Hosting, updates, backups, uptime monitoring, and a set block of edit time each month. Optional, and saying no changes nothing.' },
  { n: '08', t: 'Conversion work',       d: 'Traffic is fine and the phone still isn’t ringing. Nine times out of ten that is a structure problem wearing a design problem’s clothes.' },
];

const industries = [
  { t: 'Construction & contracting', live: '/industries/construction-web-design',
    d: 'Prequalification, project profiles, and the careers page that fills a superintendent seat.' },
  { t: 'Roofing, HVAC & plumbing',
    d: 'Emergency paths, financing, insurance-claim help, and galleries that survive a phone on LTE.' },
  { t: 'Beauty, salons & med spas',
    d: 'Booking as a navigation element, treatment pages that rank, consent-governed before-and-afters.' },
  { t: 'Legal & professional',
    d: 'Practice-area depth, credential display, and intake that respects how regulated advertising works.' },
  { t: 'Real estate',
    d: 'Listing structure, neighbourhood guides, and valuation requests that reach the right person.' },
  { t: 'Restaurants & hospitality',
    d: 'Menu and hours first. Everything else is secondary, and most sites get that exactly backwards.' },
];

const ticker = [
  'Construction', 'Roofing', 'HVAC', 'Plumbing', 'Electrical', 'Landscaping',
  'Cleaning', 'Restaurants', 'Salons', 'Med spas', 'Fitness studios', 'Law firms',
  'Real estate', 'Medical offices', 'Professional services', 'E-commerce',
];

const process = [
  { n: '01', t: 'Discovery',  d: 'One working session on your customers, your competition, and how work actually reaches you today.', you: '60–90 min' },
  { n: '02', t: 'Strategy',   d: 'Page structure, conversion path and search targets, written down and agreed before any design exists.', you: 'Review' },
  { n: '03', t: 'Content',    d: 'I write it. You correct it. Nobody hands you a spreadsheet and asks you to write your own website.', you: '~1 hour' },
  { n: '04', t: 'Design',     d: 'Every page type, desktop and mobile, at full fidelity — before a line of production code is written.', you: 'One round' },
  { n: '05', t: 'Build',      d: 'Fast, accessible, semantic. The performance budget is enforced by the build, not checked once at the end.', you: 'Nothing' },
  { n: '06', t: 'Review',     d: 'You see it on a real URL and mark it up. Revisions run to the number named in your package.', you: '1–2 hours' },
  { n: '07', t: 'Testing',    d: 'Keyboard, screen reader, real devices, forms end to end. Every link and every state.', you: 'Nothing' },
  { n: '08', t: 'Launch',     d: 'Redirects mapped, analytics verified, Search Console connected, every account in your name.', you: 'Approve' },
  { n: '09', t: 'Support',    d: 'A defined post-launch window, then an optional care plan. Not a silence.', you: 'Optional' },
];

const faqs = [
  { q: 'Is the free demo actually free?',
    a: 'Yes, and nothing is attached to it. You answer the planner questions, I design a homepage concept for your business, and you look at it. If you do not want to go further, that is the end of it — no invoice, no follow-up sequence. I offer it because the studio is new, and real work on your own business is more convincing than any portfolio I could point you at.' },
  { q: 'What happens on the free consultation?',
    a: 'About twenty minutes. I look at your current site beforehand so the time goes on your business rather than on me asking basic questions. Straight answers on scope, timeline and what a project involves. No slides, no proposal ambush, and if a cheaper option is genuinely right for you I will say so.' },
  { q: 'How much does a website cost?',
    a: 'It depends on page count, features, how much content already exists, and the timeline — which is why I quote after a short conversation rather than publishing a number that would be wrong for most people. The planner tells you which package fits before we ever speak.' },
  { q: 'How long does a project take?',
    a: 'A Starter site is usually two to three weeks. A Business Growth site is usually five to seven. Custom projects are scoped individually. The biggest variable is never design — it is how quickly photos and content decisions land.' },
  { q: 'Do you work with businesses outside your area?',
    a: 'Yes, across the United States. Discovery happens on a call, review happens on a real URL, and nothing about the process requires being in the same room.' },
  { q: 'Do you provide SEO?',
    a: 'I build the foundation: structure, speed, correct markup, one clear topic per page, and the local setup. I do not sell monthly SEO retainers and I will not promise rankings. Anyone guaranteeing a position is either guessing or selling you advertising with a different label on it.' },
  { q: 'Can you redesign my existing website?',
    a: 'Yes, and it is a large share of the work. If we move platforms the page addresses change, which needs a redirect map on day one or you lose whatever search visibility you have built.' },
  { q: 'Will I own my website?',
    a: 'Completely, from day one. Domain, hosting account, code, content and analytics are all registered in your name. No licence, no lease, no platform fee. If you ever want to move on, nothing is held back.' },
  { q: 'Can you write the website content?',
    a: 'Yes, and that is the default. You talk for an hour and correct a draft. The most common reason a website project stalls for months is a client being asked to write it themselves.' },
  { q: 'Can you maintain the website after launch?',
    a: 'Every project includes a post-launch support window. After that there is an optional care plan — hosting, updates, backups, monitoring, and a set block of edit time each month. Optional, and declining it changes nothing else.' },
  { q: 'Do you build e-commerce websites?',
    a: 'Yes, under the Custom Website package. Payments, tax and shipping rules need deciding in week one — they shape the build more than the visual design does.' },
  { q: 'What do you need from me to start?',
    a: 'An hour of your time, whatever photos and logo files you have, and access to your domain. If you have none of those, that is a normal starting point and it is planned for rather than treated as a problem.' },
  { q: 'How many revisions are included?',
    a: 'One round with Starter, two with Business Growth, and a project-specific structure on Custom. They are named in the proposal so there is never an argument about which round we are on.' },
  { q: 'What if I have no logo or professional photos?',
    a: 'Common, and workable. I direct what photography is needed and work with what exists in the meantime. If a logo is missing we use a clean typographic wordmark rather than stalling the project on a branding exercise you did not ask for.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="JP Web Design | Website Design for U.S. Businesses"
  description="Founder-led web design for businesses across the United States. Free demo, free consultation, fixed scope and a fixed launch date."
  schema={faqSchema}
>

  <script is:inline>
    /* Runs synchronously before paint. Only after this class exists does any
       [data-anim] element hide itself — so JS failing means a visible page,
       not a blank one. */
    (function () {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('js-anim');

        /* Watchdog. Hiding and revealing are done by two different scripts;
           if the second one never runs — bundle blocked, CSP, a JS error, an
           extension — the first has already hidden everything and the dark
           hero renders as a black rectangle. This guarantees that cannot
           outlive a second. */
        setTimeout(function () {
          if (!window.__revealReady) root.classList.remove('js-anim');
        }, 1000);
      } catch (e) {}
    })();
  </script>

  <Hero />

  <!-- ══ THE STAKE ═══════════════════════════════════════════════════════════
       One statement, given the whole viewport. The restraint is the point:
       after a dense interactive hero, the page needs to exhale before it
       starts selling anything. ═══════════════════════════════════════════ -->
  <section class="stake" aria-labelledby="stake-h">
    <div class="container">
      <p class="mark" data-anim><b>§01</b> Why it matters</p>
      <h2 class="stake__h" id="stake-h" data-anim>
        Good businesses lose work<br />
        to worse ones with<br />
        <em>better websites.</em>
      </h2>
      <div class="stake__grid">
        <p class="stake__p" data-anim style="--d:80ms">
          It is rarely a fair fight. The competitor who wins the call is not always better at
          the work — they are just easier to believe in the ninety seconds someone spends
          deciding.
        </p>
        <p class="stake__p" data-anim style="--d:160ms">
          That is a solvable problem, and it is the only one I work on. Not awards, not
          trends. The gap between how good you are and how good you look to a stranger.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ THE OFFER ══════════════════════════════════════════════════════════ -->
  <section class="section offer" id="offer" aria-labelledby="offer-h">
    <div class="container">
      <p class="mark" data-anim><b>§02</b> Two ways to start</p>
      <div class="head" data-anim>
        <h2 class="h2" id="offer-h">See the work before you pay for any of it</h2>
        <p class="lead">
          You should not have to take a stranger's word for it. Both of these cost nothing,
          and neither obligates you to anything afterwards.
        </p>
      </div>

      <div class="offer__g">
        <article class="offer__c offer__c--lead" data-anim>
          <p class="offer__k">Free demo</p>
          <h3 class="offer__t">A real design of your homepage, built for your business</h3>
          <ul class="offer__l">
            <li>A designed homepage concept using your services, your work and your words — not a template with your logo dropped into it</li>
            <li>The page structure I would build, and the reasoning behind every part of it</li>
            <li>Yours to look at, with no cost and no commitment</li>
          </ul>
          <p class="offer__how">
            Answer the eight planner questions first. Four minutes, and it is what lets me
            design something specific to you instead of something generic.
          </p>
          <a class="btn btn--primary btn--wide" href="#planner">Start the free demo</a>
          <p class="offer__fine">
            <!-- TODO(launch): set a turnaround JP can hold every single time. -->
            Usually back within 3–5 business days. One project at a time, so if I am at
            capacity I will say so rather than leave you waiting.
          </p>
        </article>

        <article class="offer__c" data-anim style="--d:100ms">
          <p class="offer__k">Free consultation</p>
          <h3 class="offer__t">Twenty minutes on what is actually wrong</h3>
          <ul class="offer__l">
            <li>I look at your current site before we speak, so the time goes on your business rather than on discovery</li>
            <li>Straight answers on scope, timeline and what a project would involve</li>
            <li>If a cheaper option is genuinely right for you, I will tell you that instead</li>
          </ul>
          <p class="offer__how">
            No slides, no proposal ambush, no follow-up sequence. If it is not a fit, we will
            both know inside twenty minutes.
          </p>
          <a class="btn btn--ghost btn--wide" href="/contact">Book a free consultation</a>
          <p class="offer__fine">Prefer to type? Email reaches me directly.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ SERVICES ═══════════════════════════════════════════════════════════
       A list, not a grid. Detail opens on hover and focus, all of it in the
       DOM at load — nothing here is hidden from a crawler or a reader. ═══ -->
  <section class="section svc" id="services" aria-labelledby="svc-h">
    <div class="container">
      <p class="mark" data-anim><b>§03</b> Services</p>
      <div class="svc__top" data-anim>
        <h2 class="h2" id="svc-h">Eight things I do</h2>
        <p class="lead">
          Most projects need three or four of them. The planner works out which.
        </p>
      </div>

      <ul class="svc__l">
        {services.map((s, i) => (
          <li class="svc__i" data-anim style={`--d:${i * 45}ms`}>
            <span class="svc__n">{s.n}</span>
            <h3 class="svc__t">{s.t}</h3>
            <p class="svc__d">{s.d}</p>
            <span class="svc__x" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ PACKAGES ═══════════════════════════════════════════════════════════ -->
  <section class="section section--panel" id="packages" aria-labelledby="pkg-h">
    <div class="container">
      <p class="mark" data-anim><b>§04</b> Packages</p>
      <div class="head" data-anim>
        <h2 class="h2" id="pkg-h">Three ways to work together</h2>
        <p class="lead">
          Most businesses land in the middle. If you are unsure, the planner below will tell
          you which one fits and why.
        </p>
      </div>
      <div data-anim style="--d:80ms"><Packages /></div>
    </div>
  </section>

  <!-- ══ PLANNER ════════════════════════════════════════════════════════════ -->
  <section class="section" id="planner" aria-labelledby="pln-h">
    <div class="container">
      <p class="mark" data-anim><b>§05</b> Website Project Planner</p>
      <div class="head" data-anim>
        <h2 class="h2" id="pln-h">Eight questions, then your free demo</h2>
        <p class="lead">
          You get a page structure, a feature set, search priorities and a rough timeline on
          screen straight away — no email needed to see any of it. Leave your details at the
          end and I turn it into a designed homepage concept, free.
        </p>
      </div>

      <Planner client:visible />

      <div class="pln__meta">
        <div>
          <h3 class="h3">How the recommendation is made</h3>
          <p class="small">
            Your answers map to a site type, a page count and a feature set. Business type
            drives the page names, service breadth drives the structure, and your primary
            goal decides what the site is optimised around. Nothing is scored secretly, and
            no answer is used to price you.
          </p>
        </div>
        <div>
          <h3 class="h3">What appears on screen</h3>
          <p class="small">
            The recommended package and why, a suggested page list in your own vocabulary,
            the features that follow from it, search priorities, one thing worth leaving
            out, and an estimated timeline range.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ INDUSTRIES ═════════════════════════════════════════════════════════ -->
  <section class="section section--panel ind" id="industries" aria-labelledby="ind-h">
    <div class="container">
      <p class="mark" data-anim><b>§06</b> Industries</p>
      <div class="head" data-anim>
        <h2 class="h2" id="ind-h">Built around how your customers decide</h2>
        <p class="lead">
          A roofing customer and a med spa client behave nothing alike. The structure should
          not be the same, and neither should the page they land on.
        </p>
      </div>
    </div>

    <!-- Full-bleed ticker: motion that also does a job, naming the breadth
         without a wall of list items. Paused on hover and under reduced motion. -->
    <div class="tick" aria-hidden="true">
      <div class="tick__t">
        {[0, 1].map(() => (
          <ul class="tick__l">
            {ticker.map((x) => <li>{x}<span>·</span></li>)}
          </ul>
        ))}
      </div>
    </div>

    <div class="container">
      <ul class="ind__g">
        {industries.map((i, n) => (
          <li class="ind__c" data-anim style={`--d:${n * 55}ms`}>
            <h3 class="ind__t">{i.t}</h3>
            <p class="ind__d">{i.d}</p>
            {i.live
              ? <a class="tlink ind__a" href={i.live}>See the detail</a>
              : <span class="ind__soon">Detailed page in progress</span>}
          </li>
        ))}
      </ul>
      <p class="small ind__also" data-anim>
        Also working with electricians, landscapers, cleaning and moving companies,
        automotive businesses, barbershops, fitness studios, photography and creative
        studios, accountants, consultants, medical offices, startups, and established
        companies that need a redesign.
      </p>
    </div>
  </section>

  <!-- ══ PROCESS ════════════════════════════════════════════════════════════ -->
  <section class="section prc" id="process" aria-labelledby="prc-h">
    <div class="container">
      <p class="mark" data-anim><b>§07</b> Process</p>
      <div class="prc__top">
        <h2 class="h2" id="prc-h" data-anim>Nine steps. About four hours of your time.</h2>
        <p class="lead" data-anim style="--d:80ms">
          The most common reason a website project drags on for months is that the client
          quietly gets handed the work. Here is exactly who does what.
        </p>
      </div>

      <ol class="prc__l">
        {process.map((p, i) => (
          <li class="prc__i" data-anim style={`--d:${i * 40}ms`}>
            <span class="prc__n">{p.n}</span>
            <div class="prc__b">
              <h3 class="prc__t">{p.t}</h3>
              <p class="prc__d">{p.d}</p>
            </div>
            <span class="prc__y"><span>Your time</span>{p.you}</span>
          </li>
        ))}
      </ol>

      <div class="note prc__note" data-anim>
        <span class="lbl">What I guarantee, and what I don't</span>
        <p class="small">
          Scope, price and launch date — in writing, before work starts. Not rankings, not
          lead volume, not revenue. Nobody can promise those honestly, and the ones who do
          are selling something other than what they will deliver.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ WORK ═══════════════════════════════════════════════════════════════ -->
  <section class="section section--panel" id="work" aria-labelledby="wrk-h">
    <div class="container">
      <p class="mark" data-anim><b>§08</b> Work</p>
      <div class="head" data-anim>
        <h2 class="h2" id="wrk-h">Concept work, honestly labelled</h2>
        <p class="lead">
          JP Web Design is new. Rather than pad this section, here is what is actually true —
          and the reasoning behind each piece, which is the part worth reading.
        </p>
      </div>

      <div class="note wrk__note" data-anim>
        <span class="lbl">Read this first</span>
        <p class="small">
          Everything below is a concept, not a client engagement. No project here was
          commissioned, and no business shown has endorsed or is affiliated with JP Web
          Design. Client work will replace these — with permission and attribution — as it
          launches.
        </p>
      </div>

      <ul class="grid g3 wrk">
        <li class="card wrk__c" data-anim>
          <span class="wrk__tag">Concept</span>
          <h3 class="card__t">Commercial general contractor</h3>
          <p class="card__x">
            A sixty-year-old firm whose buyers are project managers building a bid list, not
            homeowners requesting quotes. No "free quote" form anywhere — the structure is
            capabilities, delivery methods, project profiles and a careers path.
          </p>
        </li>
        <li class="card wrk__c" data-anim style="--d:80ms">
          <span class="wrk__tag">Placeholder</span>
          <h3 class="card__t">Second concept — in progress</h3>
          <p class="card__x">
            A home-services operator whose booking path breaks on mobile. The rebuild is
            about the route from search to booked job, not the visual design.
          </p>
        </li>
        <li class="card wrk__c" data-anim style="--d:160ms">
          <span class="wrk__tag">Placeholder</span>
          <h3 class="card__t">Third concept — in progress</h3>
          <p class="card__x">
            A multi-location practice where a single-location structure has stopped working.
            Hours, staff, booking and local search all fork at once.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══ WHY ════════════════════════════════════════════════════════════════ -->
  <section class="section dark grain why" aria-labelledby="why-h">
    <div class="container">
      <p class="mark" data-anim><b>§09</b> Why JP Web Design</p>
      <div class="head" data-anim>
        <h2 class="h2" id="why-h">You are hiring a person, not an account manager</h2>
        <p class="lead">
          The person you talk to is the person who builds it. That is not a slogan — it is a
          capacity constraint, and it is the reason the work stays consistent.
        </p>
      </div>

      <ul class="why__g">
        {[
          ['You own everything', 'Domain, hosting, code, content, analytics — in your name from day one. No licence, no lease, no hostage situation at renewal.'],
          ['Fixed scope and date', 'Written down before work starts. Revision rounds are named, so there is never an argument about which round we are on.'],
          ['One project at a time', 'Yours is not queued behind five others. It also means availability is genuinely limited, and I will say so rather than overpromise.'],
          ['Content is my job', 'You talk for an hour and correct a draft. Nobody hands you a spreadsheet and asks you to write your own website.'],
          ['Built to a budget', 'Speed and accessibility targets are enforced by the build itself, not checked once at the end and quietly forgotten.'],
          ['Straight answers', 'If a cheaper option is genuinely right for you, I will tell you. Sometimes the honest answer is a template and a weekend.'],
        ].map(([t, d], i) => (
          <li class="why__i" data-anim style={`--d:${i * 50}ms`}>
            <h3 class="why__t">{t}</h3>
            <p class="why__d">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══ FAQ ════════════════════════════════════════════════════════════════ -->
  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="container faq__w">
      <p class="mark" data-anim><b>§10</b> Questions</p>
      <div class="head" data-anim><h2 class="h2" id="faq-h">Answers before you ask</h2></div>
      <div class="faq" data-anim style="--d:60ms">
        {faqs.map((f) => (
          <details class="faq__i">
            <summary><span>{f.q}</span></summary>
            <p class="small">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CLOSE ══════════════════════════════════════════════════════════════ -->
  <section class="close dark grain" aria-labelledby="close-h">
    <div class="container close__in">
      <h2 class="close__h" id="close-h" data-anim>
        <span class="rise"><span>Let's see what</span></span>
        <span class="rise"><span>yours could be<span class="hero__stop">.</span></span></span>
      </h2>
      <p class="lead close__l" data-anim style="--d:120ms">
        A free demo of your homepage, or twenty free minutes on what is holding the current
        one back. No obligation at the end of either.
      </p>
      <div class="btn-row close__b" data-anim style="--d:200ms">
        <a class="btn btn--primary" href="#planner">Get a Free Demo</a>
        <a class="btn btn--ghost" href="/contact">Book a Free Consultation</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── The stake ───────────────────────────────────────────────────────── */
  .stake { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .stake__h {
    font-size: var(--fs-mega); line-height: 1.02; letter-spacing: -.035em;
    font-weight: 690; margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .stake__h em { font-style: normal; color: var(--redline); }
  .stake__grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    /* Offset into the right two-thirds — the asymmetry keeps a statement
       section from reading as a centred inspirational quote. */
    margin-left: auto; max-width: 58rem;
  }
  .stake__p { font-size: 1.0625rem; color: var(--graphite); max-width: 40ch; }
  @media (max-width: 46rem) { .stake__grid { grid-template-columns: 1fr; } }

  /* ── Offer ───────────────────────────────────────────────────────────── */
  .offer__g { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5); align-items: stretch; }
  @media (max-width: 52rem) { .offer__g { grid-template-columns: 1fr; } }
