  .open__line {
    display: block; margin: 1rem auto 0; height: 2px; width: 0;
    background: linear-gradient(90deg, var(--redline), #7c9bff); border-radius: 2px;
  }
  :global(html.js-open) .open__badge { animation: badgeIn .5s var(--pop) .1s forwards; }
  :global(html.js-open) .open__name .L { animation: letterIn .4s var(--pop) forwards; animation-delay: calc(.22s + var(--i) * .045s); }
  :global(html.js-open) .open__line { animation: lineGrow .5s var(--ease) .75s forwards; }
  :global(html.js-open) .open__half--t { animation: shutT .85s cubic-bezier(.7, 0, .2, 1) 1.35s forwards; }
  :global(html.js-open) .open__half--b { animation: shutB .85s cubic-bezier(.7, 0, .2, 1) 1.35s forwards; }
  :global(html.js-open) .open__c { animation: wmOut .3s var(--ease) 1.35s forwards; }
  @keyframes badgeIn { to { opacity: 1; transform: scale(1) rotate(0deg); } }
  @keyframes letterIn { to { opacity: 1; transform: none; } }
  @keyframes wmOut { to { opacity: 0; transform: scale(.94); } }
  @keyframes lineGrow { to { width: 200px; } }
  @keyframes shutT { to { transform: translateY(-101%); } }
  @keyframes shutB { to { transform: translateY(101%); } }
  /* the hero scene settles as the shutters part */
