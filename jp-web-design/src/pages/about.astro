---
import Base from '../layouts/Base.astro';
import { SITE_NAME, FOUNDER, EMAIL, PHONE, PHONE_URI, LEGAL_ENTITY, FOUNDER_PHOTO, SERVICE_AREA, REPLY_SLA } from '../data/site';
import { SERVICES } from '../data/services';
import { PROJECTS } from '../data/projects';

/* About Me, not About Our Agency. Written in first person because one person
   does the work, and kept falsifiable: no years in business, no client count,
   no certifications, no awards. Everything stated here is either verifiable
   from the work itself or a commitment about how I operate.

   Facts JP has not confirmed — years in business, certifications, a home
   town — are simply absent rather than guessed at or marked up for later. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: FOUNDER,
  jobTitle: 'Founder, developer and digital marketer',
  worksFor: { '@type': 'Organization', name: SITE_NAME, '@id': `${Astro.site}#org` },
  email: EMAIL,
  telephone: PHONE_URI.replace('tel:', ''),
  url: new URL('/about', Astro.site).href,
  knowsAbout: ['Web design', 'Web development', 'Google Ads', 'Meta Ads', 'Conversion optimisation'],
};

const principles = [
  {
    t: 'You see it before you pay for it',
    d: 'The free homepage demo is not a lead magnet with a catch attached. I design the concept for your business, you look at it, and if you do not want to go further that is genuinely the end of it.',
  },
  {
    t: 'You own everything',
    d: 'Domain, hosting, code, content, analytics, ad accounts, pixels and audiences — all registered in your name from day one. If you ever move on, nothing is held back and nothing has to be rebuilt.',
  },
  {
    t: 'The scope and the date are fixed before we start',
    d: 'So is the price. Revision rounds are named in writing, so there is never an argument about which round we are on.',
  },
  {
    t: 'One project at a time',
    d: 'Yours is not queued behind five others. The cost of that is honesty about capacity: if I cannot start when you need to start, I will say so rather than take the deposit.',
  },
  {
    t: 'No promises I cannot keep',
    d: 'I will not guarantee a ranking, a lead volume, or a return on ad spend. Anyone who does is guessing. I guarantee the scope, the price, the date and that I answer my own email.',
  },
  {
    t: 'I will talk you out of it',
    d: 'If a cheaper option is genuinely right for you, or if the honest answer is that you are not ready to advertise yet, that is what I will tell you.',
  },
];
---
<Base
  title={`About ${FOUNDER} | ${SITE_NAME}`}
  description={`${FOUNDER} builds websites and runs Google and Meta advertising for small businesses. One person, start to finish — here is how I work and why.`}
  schema={person}
>
  <!-- ══ INTRO ═══════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container ab__top">
      <div class="ab__intro">
        <p><span class="mark"><b>§01</b> About me</span></p>
        <h1 class="display ab__h">I&rsquo;m JP. I build the website and run the ads.</h1>
        <p class="lead">
          {SITE_NAME} is me &mdash; one person who designs, writes, builds and launches, then
          runs the Google and Meta campaigns that bring people to it. The person you speak to
          on the first call is the person doing the work.
        </p>
        <div class="btn-row ab__cta">
          <a class="btn btn--primary" href="/free-demo" data-track="demo_start" data-track-label="about">Get your free demo</a>
          <a class="btn btn--ghost" href="/contact">Start a project</a>
        </div>
      </div>

      <figure class="ab__media">
        <picture>
          <source srcset={FOUNDER_PHOTO.wide.webp} type="image/webp" />
          <img
            class="ab__img"
            src={FOUNDER_PHOTO.wide.jpg}
            alt={FOUNDER_PHOTO.alt}
            width={FOUNDER_PHOTO.wide.size} height={FOUNDER_PHOTO.wide.size}
            loading="eager" decoding="async" fetchpriority="high"
          />
        </picture>
      </figure>
    </div>
  </section>

  <!-- ══ WHO / WHAT ══════════════════════════════════════════════════════ -->
  <section class="section section--panel" aria-labelledby="who-h">
    <div class="container ab__cols">
      <div>
        <p><span class="mark"><b>§02</b> Who I am</span></p>
        <h2 class="h2" id="who-h">A developer who had to learn marketing</h2>
        <p class="body ab__p">
          I started where most people start: building websites. What became obvious quickly is
          that a good website is not the finish line. A business can have a site that looks
          genuinely excellent and still hear nothing, because nobody arrives at it &mdash; and
          it can buy plenty of traffic and still hear nothing, because the page it lands on
          cannot answer the question that was asked.
        </p>
        <p class="body ab__p">
          So I learned the other half. Google Ads, because it reaches people at the exact moment
          they are looking. Meta, because most businesses also need to reach people who have not
          thought of them yet. Doing both means I can tell you which half is actually your
          problem &mdash; and that answer is often not the one you came in expecting.
        </p>
        <p class="body ab__p">
          I build for businesses across the United States: home services and contractors, beauty
          and wellness studios, professional practices, and established companies whose sites have
          quietly stopped working. I have also built and shipped my own software, which is where
          I learned most of what I know about making something complicated feel simple.
        </p>
      </div>

      <div>
        <p><span class="mark mark--green"><b>§03</b> What I do</span></p>
        <h2 class="h2">Three services, one argument</h2>
        <p class="body ab__p">
          Ads get people there. The website turns them into calls. Tracking tells you which part
          worked. Most businesses buy those from three different vendors and then cannot work out
          which one to blame.
        </p>
        <ul class="ab__svc">
          {SERVICES.map((s) => (
            <li>
              <a href={`/services/${s.slug}`}>
                <b>{s.name}</b>
                <span>{s.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══ HOW I WORK ══════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <p><span class="mark"><b>§04</b> How I work</span></p>
      <div class="head">
        <h2 class="h2" id="how-h">Six commitments, in plain language</h2>
        <p class="lead">
          These are the things I will not negotiate on, because every one of them exists in
          response to how this industry usually treats small businesses.
        </p>
      </div>

      <div class="grid g2">
        {principles.map((p, i) => (
          <article class="card ab__pr" data-anim="card" style={`--d:${i * 60}ms`}>
            <span class="ab__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__t">{p.t}</h3>
            <p class="card__x">{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHY ═════════════════════════════════════════════════════════════ -->
  <section class="section section--panel" aria-labelledby="why-h">
    <div class="container ab__why">
      <p><span class="mark mark--amber"><b>§05</b> Why I built this</span></p>
      <h2 class="h2" id="why-h">Good businesses lose work to worse ones</h2>
      <p class="body ab__p">
        The thing that made me want to do this full time is watching it happen. A business that is
        genuinely better at the work loses the call to a competitor who is merely easier to believe
        in the ninety seconds someone spends deciding. Nothing about that is fair, and nothing about
        it is mysterious either. It is a solvable problem, and it is usually solvable quickly.
      </p>
      <p class="body ab__p">
        The industry&rsquo;s usual answer is a process designed to protect the agency: discovery
        calls, proposals, account managers, and a person doing the work you never meet. The other
        option is a website builder and six lost weekends. I built {SITE_NAME} to be the thing in
        between &mdash; one person who does the work, tells you the truth, and shows you the
        result before asking you to commit to it.
      </p>
      <p class="body ab__p">
        That is also why the free demo exists. The studio is new. Real work on your own business
        is more convincing than any portfolio I could point you at.
      </p>
    </div>
  </section>

  <!-- ══ WORK + FACTS ════════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="pf-h">
    <div class="container">
      <p><span class="mark"><b>§06</b> Recent work</span></p>
      <h2 class="h2 ab__sh" id="pf-h">What I have built</h2>
      <div class="grid g3">
        {PROJECTS.map((p) => (
          <a class="card ab__proj" href={`/work/${p.slug}`} data-track="project_view" data-track-label={p.slug}>
            <img src={p.image} alt="" width="512" height="1000" loading="lazy" decoding="async" style={`background:${p.tint}`} />
            <h3 class="card__t">{p.name}</h3>
            <p class="card__x">{p.category}</p>
          </a>
        ))}
      </div>

      <dl class="ab__facts">
        <div><dt>Business</dt><dd>{LEGAL_ENTITY ?? SITE_NAME}</dd></div>
        <div><dt>Founder</dt><dd>{FOUNDER}</dd></div>
        <div><dt>Working with</dt><dd>{SERVICE_AREA}</dd></div>
        <div><dt>Capacity</dt><dd>One project at a time</dd></div>
        <div><dt>Email</dt><dd><a class="tlink" href={`mailto:${EMAIL}`} data-track="email_click" data-track-label="about">{EMAIL}</a></dd></div>
        <div>
          <dt>Phone</dt>
          <dd><a class="tlink" href={PHONE_URI} data-track="call_click" data-track-label="about">{PHONE}</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ══ CLOSE ═══════════════════════════════════════════════════════════ -->
  <section class="section section--panel" aria-labelledby="ab-cta">
    <div class="container">
      <div class="note ab__close">
        <span class="lbl">Start here</span>
        <h2 class="h3" id="ab-cta">Want to see what I&rsquo;d do with yours?</h2>
        <p class="small">
          The demo and the consultation are both free, and neither obligates you to anything.
          I reply to every message within {REPLY_SLA} &mdash; and if I do not, email me again and say so.
        </p>
        <div class="btn-row ab__btns">
          <a class="btn btn--primary" href="/free-demo" data-track="demo_start" data-track-label="about-close">Get your free demo</a>
          <a class="btn btn--ghost" href="/contact">Start a project</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .ab__top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(var(--s6), 5vw, var(--s8)); align-items: center; }
  @media (max-width: 56rem) { .ab__top { grid-template-columns: 1fr; } }
  .ab__intro { display: flex; flex-direction: column; align-items: flex-start; }
  .ab__h { margin-bottom: var(--s5); }
  .ab__cta { margin-top: var(--s6); }

  .ab__media { margin: 0; display: flex; justify-content: center; }
  .ab__img {
    width: 100%; max-width: 21rem; aspect-ratio: 1 / 1; object-fit: cover; object-position: center 42%;
    border-radius: 50%;
    border: 5px solid var(--card); outline: 1px solid var(--rule);
    background: var(--panel); box-shadow: var(--shadow-up);
  }
  @media (max-width: 56rem) { .ab__img { max-width: 15rem; } }

  .ab__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--s6), 5vw, var(--s8)); align-items: start; }
  @media (max-width: 56rem) { .ab__cols { grid-template-columns: 1fr; } }
  .ab__p { margin-top: var(--s4); font-size: var(--fs-small); color: var(--graphite); }
  .ab__p:first-of-type { font-size: var(--fs-body); color: var(--ink); }

  .ab__svc { display: grid; gap: 0; margin-top: var(--s5); border-top: 1px solid var(--rule); }
  .ab__svc li { border-bottom: 1px solid var(--rule); }
  .ab__svc a { display: flex; flex-direction: column; gap: .2rem; padding-block: var(--s4); text-decoration: none; transition: transform .2s var(--ease); }
  .ab__svc a:hover { transform: translateX(4px); }
  .ab__svc b { font-weight: 800; letter-spacing: -.015em; }
  .ab__svc a:hover b { color: var(--redline); }
  .ab__svc span { font-size: var(--fs-small); color: var(--graphite); }

  .ab__pr { position: relative; }
  .ab__n { font-family: var(--mono); font-size: .8rem; letter-spacing: .1em; color: var(--redline); }

  .ab__why { max-width: 48rem; }
  .ab__why .ab__p:first-of-type { margin-top: var(--s5); }

  .ab__sh { margin-bottom: var(--s6); }
  .ab__proj { text-decoration: none; padding: 0; overflow: hidden; }
  .ab__proj img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top center; }
  .ab__proj .card__t { margin-top: var(--s4); }
  .ab__proj .card__t, .ab__proj .card__x { padding-inline: var(--s5); }
  .ab__proj .card__x { padding-bottom: var(--s5); }

  .ab__facts { margin-top: var(--s8); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s7); border-top: 1px solid var(--rule); }
  @media (max-width: 40rem) { .ab__facts { grid-template-columns: 1fr; } }
  .ab__facts > div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s4); padding-block: var(--s4); border-bottom: 1px solid var(--rule); align-items: baseline; }
  @media (max-width: 30rem) { .ab__facts > div { grid-template-columns: 1fr; gap: .2rem; } }
  .ab__facts dt { font-family: var(--mono); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--graphite); }
  .ab__facts dd { font-size: var(--fs-small); }

  .ab__close { max-width: 52rem; }
  .ab__close h2 { margin-bottom: var(--s2); }
  .ab__btns { margin-top: var(--s5); }
</style>
