---
import Base from '../../layouts/Base.astro';

/* This page exists because it passes the find-and-replace test: swap
   "construction" for any other industry and almost none of it still reads as
   true. That is the bar every future industry page has to clear before it
   ships. Four launch pages, then one to two a month — not eighteen at once. */

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Construction and contractor website design',
    serviceType: 'Website design',
    provider: { '@type': 'Organization', name: 'JP Web Design' },
    areaServed: { '@type': 'Country', name: 'United States' },
    audience: { '@type': 'Audience', audienceType: 'Construction companies and general contractors' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: new URL('/#industries', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: 'Construction web design' },
    ],
  },
];

const wrong = [
  ['Photos that punish the visitor', 'Jobsite photography straight off a phone, uncompressed, ten to a page. On mobile data at a site trailer it is unusable, and the gallery is the one thing the buyer actually came to see.'],
  ['A project list with no facts', 'Twelve photographs and no delivery method, no owner type, no square footage, no value range, no year. A project manager building a bid list cannot use any of it.'],
  ['Careers buried in the footer', 'Trades hiring is a live crisis and the careers page often outperforms every marketing page on a contractor site. It is usually a mailto link.'],
  ['Licence and bonding invisible', 'The three facts a prequalifier is hunting for — licence numbers, bonding capacity, insurance — are either missing or in a PDF nobody can open on a phone.'],
];

const pages = [
  ['Markets served', 'One page per sector you genuinely build in — healthcare, education, industrial, multifamily, institutional. Sector language is how owners and architects search.'],
  ['Delivery methods', 'Design-build, CM at risk, lump sum. Naming these correctly signals more competence than any amount of design polish.'],
  ['Project profiles', 'Owner type, delivery method, value range, duration, self-performed scope. Filterable by market. This is the page that gets forwarded.'],
  ['Prequalification', 'Licences, bonding capacity, EMR, insurance certificates, safety programme. Downloadable, and gated is acceptable here — that is how this market works.'],
  ['Careers', 'A real hub with a role template, not a mailto. Superintendents and foremen research employers the same way owners research contractors.'],
  ['Preconstruction', 'Budgeting, phasing, constructability. It is where the relationship usually starts and it rarely gets its own page.'],
];
---
<Base
  title="Construction & Contractor Website Design | JP Web Design"
  description="Websites for construction companies and general contractors — built around prequalification, bid lists, project profiles and trades recruiting."
  schema={schema}
>
  <nav class="crumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/#industries">Industries</a></li>
        <li aria-current="page">Construction web design</li>
      </ol>
    </div>
  </nav>

  <section class="section ind">
    <div class="container">
      <p class="mark"><b>§01</b> Construction &amp; contracting</p>
      <div class="head">
        <h1 class="display">Your website is already doing prequalification. It just isn't doing it on purpose.</h1>
        <p class="lead">
          The decisions that shape a contractor's next three years happen out of earshot —
          a project manager adding a name to a bid list, an owner's rep vetting three subs an
          architect mentioned, a superintendent deciding whether this is a step up. None of
          them fill in a contact form.
        </p>
      </div>

      <div class="btn-row">
        <a class="btn btn--primary" href="/#planner">Plan your contractor site</a>
        <a class="btn btn--ghost" href="mailto:jp@jpwebdesign.com">Ask about a bid-list review</a>
      </div>
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="h-decide">
    <div class="container">
      <p class="mark"><b>§02</b> How the decision happens</p>
      <div class="head">
        <h2 class="h2" id="h-decide">Three readers, none of whom will ever contact you</h2>
      </div>
      <ul class="rows">
        <li class="row"><span class="row__n">01</span><div class="row__b">
          <p class="h3">The project manager building a bid list</p>
          <p class="small">Wants scope, sector experience and delivery method inside thirty seconds. If the project list is a photo gallery, you are not on the list.</p>
        </div></li>
        <li class="row"><span class="row__n">02</span><div class="row__b">
          <p class="h3">The owner's rep checking three names</p>
          <p class="small">Looking for bonding capacity, safety posture and evidence you have built this building type before. A missing EMR figure reads as an answer.</p>
        </div></li>
        <li class="row"><span class="row__n">03</span><div class="row__b">
          <p class="h3">The superintendent deciding where to work</p>
          <p class="small">Fourteen years in the field, comparing you against the firm across town. Careers pages on contractor sites routinely out-traffic every marketing page.</p>
        </div></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-wrong">
    <div class="container">
      <p class="mark"><b>§03</b> The pattern</p>
      <div class="head">
        <h2 class="h2" id="h-wrong">What most contractor sites get wrong</h2>
      </div>
      <ul class="grid g2">
        {wrong.map(([t, d]) => (
          <li class="card"><h3 class="card__t">{t}</h3><p class="card__x">{d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--panel" aria-labelledby="h-pages">
    <div class="container">
      <p class="mark"><b>§04</b> Structure</p>
      <div class="head">
        <h2 class="h2" id="h-pages">The pages a commercial contractor actually needs</h2>
        <p class="lead">
          Note what is missing: there is no "get a free quote" form anywhere in this
          structure. That belongs on a residential site and it actively undercuts a
          commercial firm.
        </p>
      </div>
      <ul class="rows">
        {pages.map(([t, d], i) => (
          <li class="row">
            <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="row__b"><p class="h3">{t}</p><p class="small">{d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-tech">
    <div class="container">
      <p class="mark"><b>§05</b> Practical detail</p>
      <div class="head"><h2 class="h2" id="h-tech">Things that decide whether it works</h2></div>

      <div class="grid g3">
        <div class="tblock">
          <h3 class="h3">Photography is the critical path</h3>
          <p class="small">
            Not design. Project photos are the strongest asset a contractor owns and the
            slowest thing to collect. Every image goes through a proper pipeline — modern
            formats, correct dimensions, lazy loading below the fold — or the site is slow
            in exactly the place it must not be.
          </p>
        </div>
        <div class="tblock">
          <h3 class="h3">Credentials, displayed not filed</h3>
          <p class="small">
            State licence numbers, bonding capacity, insurance certificates, EMR, and any
            AGC or ABC affiliation. Visible on a page, not zipped in a PDF. This is the
            single highest-value content change on most contractor sites.
          </p>
        </div>
        <div class="tblock">
          <h3 class="h3">Measure bid invitations, not leads</h3>
          <p class="small">
            Form submissions are the wrong metric here. The signals that matter are
            invitations to bid, capability-statement downloads, careers applications, and
            the recruiter or owner's rep who forwards a project profile.
          </p>
        </div>
      </div>

      <div class="note ind__note">
        <span class="lbl">What this is not</span>
        <p class="small">
          If you are a residential remodeler or a home-services contractor selling to
          homeowners, almost none of the above applies to you — you need speed to contact,
          financing, reviews and service-area coverage instead. Different structure, and
          worth saying so rather than selling you this one.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="h-cta">
    <div class="container ctai">
      <h2 class="h2" id="h-cta">Get the structure before you commit to anything</h2>
      <p class="lead ctai__l">
        Eight questions, about four minutes, and a page structure on screen at the end.
        Nothing is held back behind an email address.
      </p>
      <div class="btn-row ctai__b">
        <a class="btn btn--onink" href="/#planner">Plan your contractor site</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumb { border-bottom: 1px solid var(--rule); }
  .crumb ol { display: flex; flex-wrap: wrap; gap: var(--s3); padding-block: var(--s3);
              font-family: var(--mono); font-size: .75rem; letter-spacing: .06em; color: var(--graphite); }
  .crumb li + li::before { content: '/'; margin-right: var(--s3); color: var(--rule-hi); }
  .crumb a { text-decoration: none; }
  .crumb a:hover { color: var(--redline); }
  .crumb [aria-current] { color: var(--ink); }

  .ind .display { max-width: 20ch; }
  .ind .btn-row { margin-top: var(--s6); }
  .tblock { padding-top: var(--s4); border-top: 1px solid var(--rule); }
  .tblock .h3 { margin-bottom: var(--s2); }
  .ind__note { margin-top: var(--s7); max-width: 56rem; }

  .ctai { text-align: center; }
  .ctai__l { margin: var(--s4) auto 0; }
  .ctai__b { justify-content: center; margin-top: var(--s6); }
</style>
