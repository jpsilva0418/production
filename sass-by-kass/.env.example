# Sass by Kass — DEMO environment (placeholders only; never commit a real .env)
# Public origin the demo is served from (canonical + OG URLs).
PUBLIC_SITE_URL=https://sass-by-kass-demo.vercel.app
# Lock the build to one blue direction (a | b | c) and drop the /preview routes + review bar.
# Leave UNSET for the review build.
DEMO_PALETTE=
# Enquiry form delivery (api/inquiry.js). Leave UNSET for the demo: submissions are
# accepted in labelled "demo mode" and nothing is sent anywhere.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
