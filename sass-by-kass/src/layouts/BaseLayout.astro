---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/figtree';
import '../styles/tokens.css';
import '../styles/palettes.css';
import '../styles/system.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import PaletteBar from '../components/PaletteBar.astro';
import { businessJsonLd } from '../lib/seo';
import type { SeoInput } from '../lib/seo';
import { DEFAULT_PALETTE, LOCKED_PALETTE, type PaletteId } from '../lib/palette';
interface Props extends SeoInput {
  jsonLd?: unknown;
  headerLight?: boolean;
  headerPrologue?: boolean;
  /** A /preview/<id> page sets the direction and remembers it for every other page. */
  palette?: PaletteId;
  /** Images the first frame needs (hero logo, poster): fetched before anything else. */
  preload?: string[];
  bodyClass?: string;
}
const { jsonLd, headerLight = false, headerPrologue = false, palette, bodyClass, preload = [], ...seo } = Astro.props;
const ld = jsonLd ?? businessJsonLd();
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
/* Client-demo build: locked palette, no review script. Review build: the page's own
 * palette prop (a /preview route) or the remembered choice, applied before first paint. */
const locked = LOCKED_PALETTE;
const initial = locked ?? palette ?? DEFAULT_PALETTE;
const paletteScript = locked ? '' : palette
  ? `try{localStorage.setItem('sbk-pal','${palette}')}catch(e){}`
  : `try{var p=localStorage.getItem('sbk-pal');if(p==='a'||p==='b'||p==='c'){document.body.className=document.body.className.replace(/\\bpal-[abc]\\b/,'pal-'+p)}}catch(e){}`;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...seo} />
    {preload.length ? preload.map((href) => <link rel="preload" as="image" href={href} fetchpriority="high" />) : <link rel="preload" as="image" href="/brand/sbk-logo-light-sm.webp" type="image/webp" fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class:list={[`pal-${initial}`, bodyClass]}>
    {paletteScript && <script is:inline set:html={paletteScript} />}
    <a href="#main" class="skip-link">Skip to content</a>
    <Header light={headerLight} prologue={headerPrologue} current={current} />
    <main id="main"><slot /></main>
    <Footer />
    <ScrollToTop />
    <PaletteBar />
    <!-- Informational demo badge: this is a design demo, never the live site. -->
    <div class="demo-flag" aria-hidden="true">Design demo &middot; not the live website</div>
    <script>
      // ============ Shared runtime (menu, header, reveals, parallax, lazy films) ============
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- full-screen menu (inert + aria-hidden when closed, focus managed, trapped) ---- */
      const menu = document.getElementById('menu');
      const openBtn = document.getElementById('menuOpen');
      const closeBtn = document.getElementById('menuClose');
      if (menu && openBtn && closeBtn) {
        // iOS ignores overflow:hidden on <body>, so the page is pinned in place while the menu
        // is open and returned to the same spot when it closes — never scrolled underneath.
        let lockY = 0;
        const lock = (on: boolean) => {
          const b = document.body.style;
          if (on) { lockY = scrollY; b.position = 'fixed'; b.top = `-${lockY}px`; b.left = '0'; b.right = '0'; b.width = '100%'; }
          else { b.position = ''; b.top = ''; b.left = ''; b.right = ''; b.width = ''; document.documentElement.style.scrollBehavior = 'auto'; scrollTo(0, lockY); document.documentElement.style.scrollBehavior = ''; }
        };
        const setMenu = (open: boolean, restoreFocus = true) => {
          if (open === menu.classList.contains('open')) return;
          lock(open);
          menu.classList.toggle('open', open);
          document.body.classList.toggle('menu-open', open);
          menu.setAttribute('aria-hidden', String(!open));
          (menu as HTMLElement & { inert: boolean }).inert = !open;
          openBtn.setAttribute('aria-expanded', String(open));
          if (open) closeBtn.focus(); else if (restoreFocus) openBtn.focus({ preventScroll: true });
        };
        openBtn.addEventListener('click', () => setMenu(true));
        closeBtn.addEventListener('click', () => setMenu(false));
        // a menu link closes the menu; one that leaves this page opens its target at the top
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
          const samePage = a.pathname === location.pathname && a.origin === location.origin;
          if (!samePage && a.origin === location.origin) lockY = 0;
          setMenu(false, false);
        }));
        // back/forward cache: never come back to a page with its menu still open
        addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted && menu.classList.contains('open')) setMenu(false, false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('open')) setMenu(false); });
        menu.addEventListener('keydown', (e) => {
          if (e.key !== 'Tab' || !menu.classList.contains('open')) return;
          const f = menu.querySelectorAll<HTMLElement>('a[href]:not([tabindex="-1"]), button');
          const first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });
      }

      /* ---- header: compact translucent bar after the hero; hides on fast scroll down, returns on scroll up ---- */
      const hd = document.getElementById('siteHeader');
      if (hd) {
        const settle = () => hd.classList.remove('hd--plg');
        if (hd.classList.contains('hd--plg')) { hd.addEventListener('animationend', settle, { once: true }); setTimeout(settle, 1200); }
        let lastY = scrollY, ticking = false;
        const frame = () => {
          ticking = false;
          const y = scrollY;
          const stuck = y > 120;
          hd.classList.toggle('hd--stuck', stuck);
          hd.classList.toggle('hd--hide', stuck && y > lastY && y - lastY > 6 && y > 400);
          lastY = y;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
        frame();
      }

      /* ---- stagger helper ---- */
      document.querySelectorAll('[data-stag]').forEach((s) => {
        const step = parseFloat(s.getAttribute('data-stag') ?? '') || 0.08;
        Array.prototype.forEach.call(s.children, (c: HTMLElement, i: number) => { c.style.setProperty('--d', (i * step).toFixed(2) + 's'); });
      });

      /* ---- reveals ---- */
      const toReveal = document.querySelectorAll('.rv,.rv-im,.fade,.sheen');
      if (reduced || !('IntersectionObserver' in window)) {
        toReveal.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
        toReveal.forEach((el) => io.observe(el));
        addEventListener('load', () => { setTimeout(() => {
          toReveal.forEach((el) => { const r = el.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) el.classList.add('in'); });
        }, 400); });
      }

      /* ---- ghost words ---- */
      const ghosts = document.querySelectorAll('.ghost-w');
      if (ghosts.length && 'IntersectionObserver' in window && !reduced) {
        const gio = new IntersectionObserver((es) => { es.forEach((e) => e.target.classList.toggle('in', e.isIntersecting)); }, { threshold: 0.2 });
        ghosts.forEach((g) => gio.observe(g));
      }

      /* ---- gentle parallax pairs (desktop only) ---- */
      const plxHosts = document.querySelectorAll('[data-plx-host]');
      const wide = matchMedia('(min-width:900px)');
      let plxTicking = false;
      const plxFrame = () => {
        plxTicking = false;
        if (reduced || !wide.matches) return;
        const vh = innerHeight;
        plxHosts.forEach((host) => {
          const r = host.getBoundingClientRect();
          if (r.bottom < -120 || r.top > vh + 120) return;
          const off = r.top + r.height / 2 - vh / 2;
          host.querySelectorAll<HTMLElement>('.plx').forEach((el) => {
            const f = parseFloat(el.getAttribute('data-plx') ?? '') || 0.06;
            el.style.transform = `translate3d(0,${(off * f).toFixed(1)}px,0)`;
          });
        });
      };
      if (plxHosts.length && !reduced) {
        addEventListener('scroll', () => { if (!plxTicking) { plxTicking = true; requestAnimationFrame(plxFrame); } }, { passive: true });
        plxFrame();
      }

      /* ---- lazy films: poster until near viewport, pause off-screen, never under reduced motion / Save-Data ---- */
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
      document.querySelectorAll<HTMLVideoElement>('video[data-film]').forEach((video) => {
        if (reduced || saveData) { video.querySelectorAll('source').forEach((s) => s.remove()); video.removeAttribute('autoplay'); return; }
        if (!('IntersectionObserver' in window)) return;
        let loaded = false;
        new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              if (!loaded) {
                video.querySelectorAll('source').forEach((s) => { const src = (s as HTMLSourceElement).dataset.src; if (src) (s as HTMLSourceElement).src = src; });
                video.load(); loaded = true;
              }
              video.play().catch(() => {});
            } else video.pause();
          }
        }, { rootMargin: '240px 0px' }).observe(video);
      });
    </script>
  </body>
</html>
