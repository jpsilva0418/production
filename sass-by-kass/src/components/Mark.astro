---
/** The Sass by Kass mark — a monogram "SK" inside a thin ring, in the display serif.
 *  TEMPORARY stand-in: the client supplied no logo file. Every placement goes through
 *  this one component, so the official mark (SVG) is a one-file swap. */
interface Props { class?: string; title?: string }
const { class: cls = 'mark', title } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1.2" opacity=".9" />
  <circle cx="32" cy="32" r="26.5" stroke="currentColor" stroke-width=".6" opacity=".45" />
  <text x="32" y="40.5" text-anchor="middle" fill="currentColor" font-family="'Fraunces Variable','Iowan Old Style',Georgia,'Times New Roman',serif" font-size="24" font-style="italic" letter-spacing="-1">SK</text>
</svg>
