---
/**
 * Enquiry — the multi-step inquiry system re-purposed for a stylist: conditional steps
 * per request type (bridal / extensions / other), one state object, Back never loses
 * answers, progress + recap, review step with Edit, inline validation, honest loading /
 * error / success states, and a copy-to-clipboard fallback so an answer is never lost.
 * Posts JSON to /api/inquiry (Vercel function): delivers via Resend when configured,
 * otherwise accepts in labelled DEMO mode. Client-demo builds never contact a server.
 */
import { SITE, SMS } from '../consts';
---
<section class="cf-section">
  <div class="cf-wrap">
    <noscript>
      <p class="cf-noscript">This form needs JavaScript. You can also text Kass at <a href={SMS}>{SITE.phone}</a>.</p>
    </noscript>

    <form id="cfForm" class="cf-form" novalidate>
      <ol class="cf-prog" id="cfProg" aria-label="Progress"></ol>
      <dl class="cf-recap" id="cfRecap" hidden></dl>

      <!-- Step: request type -->
      <fieldset class="cf-step" data-step="type">
        <legend tabindex="-1">What are we talking about?</legend>
        <div class="cf-cards">
          <label class="cf-card"><input type="radio" name="requestType" value="Bridal / wedding" /><span>Bridal / wedding</span></label>
          <label class="cf-card"><input type="radio" name="requestType" value="Hand-tied extensions" /><span>Hand-tied extensions</span></label>
          <label class="cf-card"><input type="radio" name="requestType" value="Color or something else" /><span>Color or something else</span></label>
        </div>
        <p class="cf-hint" style="margin-top:14px">Just want an appointment? <a class="cf-link" href={SITE.booking} target="_blank" rel="noopener noreferrer">Book online</a> — it takes a minute.</p>
      </fieldset>

      <!-- Step: bridal -->
      <fieldset class="cf-step" data-step="bridal" hidden>
        <legend tabindex="-1">Tell Kass about the day</legend>
        <div class="cf-two">
          <div class="cf-field">
            <label for="cf-weddingDate">Wedding date <span class="cf-opt">optional</span></label>
            <input id="cf-weddingDate" name="weddingDate" type="date" />
          </div>
          <div class="cf-field">
            <label for="cf-weddingPlace">Where you’re getting ready <span class="cf-opt">optional</span></label>
            <input id="cf-weddingPlace" name="weddingPlace" type="text" maxlength="120" placeholder="Town or venue" />
          </div>
        </div>
        <div class="cf-field" role="radiogroup" aria-labelledby="cf-party-label">
          <span class="cf-lbl" id="cf-party-label">How many of you need hair?</span>
          <div class="cf-cards cf-cards-row">
            <label class="cf-card"><input type="radio" name="partySize" value="Just me" /><span>Just me</span></label>
            <label class="cf-card"><input type="radio" name="partySize" value="2–4 people" /><span>2&ndash;4</span></label>
            <label class="cf-card"><input type="radio" name="partySize" value="5 or more" /><span>5 or more</span></label>
            <label class="cf-card"><input type="radio" name="partySize" value="Not sure yet" /><span>Not sure yet</span></label>
          </div>
        </div>
        <div class="cf-field" role="group" aria-labelledby="cf-styles-label">
          <span class="cf-lbl" id="cf-styles-label">Styles you’re drawn to <span class="cf-opt">optional</span></span>
          <div class="cf-cards cf-cards-row">
            <label class="cf-card"><input type="checkbox" name="bridalStyles" value="Updo" /><span>Updo</span></label>
            <label class="cf-card"><input type="checkbox" name="bridalStyles" value="Soft waves" /><span>Soft waves</span></label>
            <label class="cf-card"><input type="checkbox" name="bridalStyles" value="Half-up" /><span>Half-up</span></label>
            <label class="cf-card"><input type="checkbox" name="bridalStyles" value="Open to ideas" /><span>Open to ideas</span></label>
          </div>
        </div>
      </fieldset>

      <!-- Step: extensions -->
      <fieldset class="cf-step" data-step="extensions" hidden>
        <legend tabindex="-1">What are you hoping for?</legend>
        <div class="cf-cards cf-cards-row" role="group" aria-label="Goal">
          <label class="cf-card"><input type="checkbox" name="extGoal" value="Length" /><span>Length</span></label>
          <label class="cf-card"><input type="checkbox" name="extGoal" value="Fullness" /><span>Fullness</span></label>
          <label class="cf-card"><input type="checkbox" name="extGoal" value="Both" /><span>Both</span></label>
          <label class="cf-card"><input type="checkbox" name="extGoal" value="Not sure yet" /><span>Not sure yet</span></label>
        </div>
        <div class="cf-field">
          <label for="cf-extHair">A little about your hair <span class="cf-opt">optional</span></label>
          <textarea id="cf-extHair" name="extHair" rows="3" maxlength="1000" placeholder="Length, color, anything you’ve had done recently…"></textarea>
        </div>
        <div class="cf-field" role="radiogroup" aria-labelledby="cf-timing-label">
          <span class="cf-lbl" id="cf-timing-label">When would you like them in?</span>
          <div class="cf-cards cf-cards-row">
            <label class="cf-card"><input type="radio" name="timing" value="As soon as possible" /><span>As soon as possible</span></label>
            <label class="cf-card"><input type="radio" name="timing" value="In the next month or two" /><span>Next month or two</span></label>
            <label class="cf-card"><input type="radio" name="timing" value="Just exploring" /><span>Just exploring</span></label>
          </div>
        </div>
      </fieldset>

      <!-- Step: other -->
      <fieldset class="cf-step" data-step="other" hidden>
        <legend tabindex="-1">Tell Kass what you’re after</legend>
        <div class="cf-field">
          <label for="cf-otherText" class="sr-only">Tell Kass what you're after</label>
          <textarea id="cf-otherText" name="otherText" rows="5" maxlength="2000" placeholder="Share as much or as little as you like."></textarea>
        </div>
      </fieldset>

      <!-- Step: contact -->
      <fieldset class="cf-step" data-step="contact" hidden>
        <legend tabindex="-1">How can Kass reach you?</legend>
        <div class="cf-two">
          <div class="cf-field">
            <label for="cf-name">First name <span class="cf-req">required</span></label>
            <input id="cf-name" name="firstName" type="text" maxlength="80" autocomplete="given-name" required aria-describedby="cf-name-err" />
            <p class="cf-err" id="cf-name-err" hidden>Please enter your first name.</p>
          </div>
          <div class="cf-field">
            <label for="cf-lastName">Last name</label>
            <input id="cf-lastName" name="lastName" type="text" maxlength="80" autocomplete="family-name" />
          </div>
        </div>
        <div class="cf-two">
          <div class="cf-field">
            <label for="cf-phone">Phone <span class="cf-req">required</span></label>
            <input id="cf-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" inputmode="tel" required aria-describedby="cf-phone-err" />
            <p class="cf-err" id="cf-phone-err" hidden>That phone number doesn&rsquo;t look complete.</p>
          </div>
          <div class="cf-field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" maxlength="160" autocomplete="email" inputmode="email" aria-describedby="cf-email-err" />
            <p class="cf-err" id="cf-email-err" hidden>That email address doesn&rsquo;t look complete.</p>
          </div>
        </div>
        <div class="cf-field" role="radiogroup" aria-labelledby="cf-pref-label">
          <span class="cf-lbl" id="cf-pref-label">Best way to reach you</span>
          <div class="cf-cards cf-cards-row">
            <label class="cf-card"><input type="radio" name="preferredContact" value="Text message" /><span>Text message</span></label>
            <label class="cf-card"><input type="radio" name="preferredContact" value="Phone call" /><span>Phone call</span></label>
            <label class="cf-card"><input type="radio" name="preferredContact" value="Email" /><span>Email</span></label>
          </div>
        </div>
        <div aria-hidden="true" class="cf-hp"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" /></div>
      </fieldset>

      <!-- Step: notes -->
      <fieldset class="cf-step" data-step="notes" hidden>
        <legend tabindex="-1">Anything else?</legend>
        <p class="cf-hint">Everything here is optional.</p>
        <div class="cf-field">
          <label for="cf-notes">Notes</label>
          <textarea id="cf-notes" name="notes" rows="4" maxlength="2000" placeholder="Inspiration you’ve saved, hair history, timing, questions for Kass…"></textarea>
        </div>
        <div class="cf-field">
          <label for="cf-heard">How did you find Kass?</label>
          <select id="cf-heard" name="heardAbout">
            <option value="">Choose one (optional)</option>
            <option>Instagram</option>
            <option>TikTok</option>
            <option>A friend’s hair</option>
            <option>Google</option>
            <option>Other</option>
          </select>
        </div>
      </fieldset>

      <!-- Step: review -->
      <fieldset class="cf-step" data-step="review" hidden>
        <legend tabindex="-1">Review your enquiry</legend>
        <div id="cfReview" class="cf-review"></div>
        <p class="cf-consent">By sending this you agree to be contacted about it &mdash; nothing else, no marketing list.</p>
      </fieldset>

      <div class="cf-error" id="cfError" role="alert" hidden>
        <strong>That didn&rsquo;t send just now.</strong> Your answers are safe on this page &mdash; please try again in a moment.
        You can also tap <em>Copy my enquiry</em> and paste it into a text to <a href={SMS}>{SITE.phone}</a>.
        <div class="cf-err-actions"><button type="button" class="btn btn--line" id="cfCopy">Copy my enquiry</button></div>
        <span class="cf-err-code" id="cfErrCode"></span>
      </div>

      <div class="cf-nav">
        <button type="button" class="btn btn--line" id="cfBack" hidden>Back</button>
        <button type="submit" class="btn btn--solid" id="cfNext" disabled>Continue</button>
      </div>
    </form>

    <div class="cf-thanks" id="cfThanks" hidden>
      <p class="cf-test-strip" id="cfTestStrip" hidden><strong>Demo mode</strong> &mdash; this enquiry was NOT sent anywhere.</p>
      <span class="caps-xs">Received</span>
      <h2 tabindex="-1" id="cfThanksHead">Thank you &mdash; your enquiry is with Kass.</h2>
      <p>She&rsquo;ll come back to you to talk it through. In the meantime, anything else can be booked online, or text <a href={SMS}>{SITE.phone}</a>.</p>
      <div class="cf-thanks-cta">
        <a class="btn btn--solid" href={SITE.booking} target="_blank" rel="noopener noreferrer">Book online</a>
        <a class="btn btn--line" href="/">Back to the site</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .cf-section{padding:0}
  .cf-section [hidden]{display:none!important}
  .cf-noscript{background:var(--paper);border:1px solid var(--hair);padding:22px;border-radius:var(--r);text-align:center}
  .cf-noscript a{text-decoration:underline}
  .cf-form{visibility:hidden}
  .cf-form.ready{visibility:visible}
  .cf-prog{list-style:none;display:flex;gap:8px;margin:0 0 26px;padding:0}
  .cf-prog li{flex:1;min-width:0}
  .cf-prog .bar{display:block;height:3px;background:var(--hair);margin-bottom:8px;border-radius:2px;transition:background .3s}
  .cf-prog li.done .bar,.cf-prog li.now .bar{background:var(--leaf)}
  .cf-prog .lbl{font-family:var(--utility);font-weight:600;font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
  .cf-prog li.now .lbl{color:var(--leaf)}
  @media(max-width:560px){.cf-prog .lbl{display:none}.cf-prog li.now .lbl{display:block}}
  .cf-recap{display:flex;flex-wrap:wrap;gap:6px 20px;background:var(--linen);border:1px solid var(--hair);border-radius:var(--r-sm);padding:10px 16px;margin:0 0 22px;font-size:.82rem}
  .cf-recap div{display:flex;gap:6px}
  .cf-recap dt{color:var(--ink-soft)}
  .cf-recap dt::after{content:':'}
  .cf-recap dd{margin:0;font-weight:600;color:var(--ink)}
  .cf-step{border:0;padding:0;margin:0;min-inline-size:auto}
  .cf-step legend{font-family:var(--display);font-size:clamp(1.5rem,3.2vw,2rem);color:var(--ink);padding:0;margin-bottom:18px;text-wrap:balance;font-variation-settings:'opsz' 72,'SOFT' 50}
  .cf-step legend:focus{outline:none}
  .cf-hint{font-size:.9rem;color:var(--ink-soft);margin:-8px 0 18px}
  .cf-link{color:var(--brass);text-decoration:underline;text-underline-offset:3px}
  .cf-cards{display:grid;gap:10px;margin-bottom:10px}
  .cf-cards-row{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}
  .cf-card{position:relative;display:flex;align-items:center;min-height:52px;padding:13px 16px;background:var(--paper);border:1px solid var(--hair-strong);border-radius:var(--r-sm);cursor:pointer;transition:border-color .2s,background .2s,box-shadow .2s}
  .cf-card:hover{border-color:var(--leaf)}
  .cf-card input{position:absolute;opacity:0;pointer-events:none}
  .cf-card span{font-size:.95rem;color:var(--ink)}
  .cf-card:has(input:checked){border-color:var(--leaf);background:#fff;box-shadow:inset 0 0 0 1px var(--leaf)}
  .cf-card:has(input:checked) span{font-weight:600}
  .cf-card:has(input:checked)::after{content:"";margin-left:auto;width:8px;height:8px;border-radius:50%;background:var(--leaf);flex:none}
  .cf-card:has(input:focus-visible){outline:2px solid var(--brass);outline-offset:3px}
  .cf-field{margin-bottom:18px}
  .cf-two{display:grid;gap:0 16px}
  @media(min-width:560px){.cf-two{grid-template-columns:1fr 1fr}}
  .cf-field label,.cf-lbl{display:block;font-family:var(--utility);font-weight:600;font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
  .cf-req{font-weight:500;letter-spacing:.08em;color:var(--brass);text-transform:lowercase}
  .cf-opt{font-weight:500;letter-spacing:.08em;color:var(--ink-soft);text-transform:lowercase}
  .cf-field input:not([type="radio"]):not([type="checkbox"]),.cf-field select,.cf-field textarea{width:100%;min-height:48px;padding:12px 14px;background:#fff;border:1px solid var(--hair-strong);border-radius:var(--r-sm);color:var(--ink);font:inherit;font-size:1rem;transition:border-color .2s}
  .cf-field textarea{resize:vertical;min-height:0}
  .cf-field input[aria-invalid="true"]{border-color:#B2473D}
  .cf-err{font-size:.82rem;color:#9A3A31;margin-top:6px}
  .cf-hp{position:absolute;left:-9999px;top:auto}
  .cf-review{display:grid;gap:14px;margin-bottom:18px}
  .cf-rev-group{background:var(--linen);border:1px solid var(--hair);border-radius:var(--r-sm);padding:16px 18px}
  .cf-rev-head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:8px}
  .cf-rev-head h3{font-size:1.05rem}
  .cf-rev-edit{background:none;border:0;cursor:pointer;font-family:var(--utility);font-weight:600;font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--brass);text-decoration:underline;text-underline-offset:3px;padding:6px;min-height:36px}
  .cf-rev-group dl{margin:0;display:grid;gap:5px}
  .cf-rev-group dl div{display:flex;flex-wrap:wrap;gap:4px 8px;font-size:.9rem}
  .cf-rev-group dt{color:var(--ink-soft)}
  .cf-rev-group dt::after{content:':'}
  .cf-rev-group dd{margin:0;font-weight:600;color:var(--ink);overflow-wrap:anywhere}
  .cf-consent{font-size:.82rem;color:var(--ink-soft)}
  .cf-nav{display:flex;justify-content:space-between;gap:12px;margin-top:22px}
  .cf-nav .btn{min-width:140px}
  .cf-nav #cfNext{margin-left:auto}
  .cf-error{margin-top:20px;border:1px solid var(--brass);background:#fff;border-radius:var(--r-sm);padding:16px 18px;font-size:.92rem}
  .cf-error a{text-decoration:underline}
  .cf-err-actions{margin-top:12px}
  .cf-err-code{display:block;margin-top:8px;font-family:var(--utility);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}
  .cf-thanks{text-align:center}
  .cf-thanks .caps-xs{display:block;margin-bottom:.8rem}
  .cf-thanks h2{font-size:clamp(1.5rem,3.4vw,2.1rem);margin-bottom:12px}
  .cf-thanks h2:focus{outline:none}
  .cf-thanks p{max-width:44ch;margin:0 auto}
  .cf-thanks p a{text-decoration:underline}
  .cf-thanks-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:26px}
  .cf-test-strip{background:var(--leaf-deep);color:var(--ivory);padding:10px 16px;border-radius:var(--r-sm);font-size:.82rem;margin:0 0 22px;letter-spacing:.04em}
</style>

<script>
  type StepKey = 'type' | 'bridal' | 'extensions' | 'other' | 'contact' | 'notes' | 'review';
  const answers: Record<string, string> = {
    requestType: '', weddingDate: '', weddingPlace: '', partySize: '', bridalStyles: '', extGoal: '', extHair: '', timing: '', otherText: '',
    firstName: '', lastName: '', phone: '', email: '', preferredContact: '', notes: '', heardAbout: '',
  };
  const STEP_LABELS: Record<StepKey, string> = { type: 'About', bridal: 'The day', extensions: 'Your hair', other: 'Details', contact: 'Contact', notes: 'Notes', review: 'Review' };
  const REVIEW_GROUPS: [StepKey, string, [string, string][]][] = [
    ['type', 'About', [['requestType', 'Enquiry']]],
    ['bridal', 'The day', [['weddingDate', 'Wedding date'], ['weddingPlace', 'Getting ready at'], ['partySize', 'How many'], ['bridalStyles', 'Styles']]],
    ['extensions', 'Your hair', [['extGoal', 'Hoping for'], ['extHair', 'Your hair'], ['timing', 'Timing']]],
    ['other', 'Details', [['otherText', 'Looking for']]],
    ['contact', 'Contact', [['firstName', 'First name'], ['lastName', 'Last name'], ['phone', 'Phone'], ['email', 'Email'], ['preferredContact', 'Reach you by']]],
    ['notes', 'Notes', [['notes', 'Notes'], ['heardAbout', 'Found Kass via']]],
  ];
  const TYPE_PATHS: Record<string, StepKey[]> = {
    'Bridal / wedding': ['type', 'bridal', 'contact', 'notes', 'review'],
    'Hand-tied extensions': ['type', 'extensions', 'contact', 'notes', 'review'],
    'Color or something else': ['type', 'other', 'contact', 'review'],
  };
  const LOCKED: Record<string, string> = { bridal: 'Bridal / wedding', extensions: 'Hand-tied extensions' };
  const MULTI = ['bridalStyles', 'extGoal'];

  const form = document.getElementById('cfForm') as HTMLFormElement;
  const progEl = document.getElementById('cfProg') as HTMLOListElement;
  const recapEl = document.getElementById('cfRecap') as HTMLElement;
  const reviewEl = document.getElementById('cfReview') as HTMLElement;
  const errorEl = document.getElementById('cfError') as HTMLElement;
  const backBtn = document.getElementById('cfBack') as HTMLButtonElement;
  const nextBtn = document.getElementById('cfNext') as HTMLButtonElement;
  const thanksEl = document.getElementById('cfThanks') as HTMLElement;
  const stepEls = new Map<StepKey, HTMLFieldSetElement>();
  form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]').forEach((el) => stepEls.set(el.dataset.step as StepKey, el));

  const params = new URLSearchParams(location.search);
  const lockedType = LOCKED[(params.get('for') ?? '').trim().toLowerCase()] ?? '';
  let stepIndex = 0;
  let status: 'idle' | 'sending' | 'sent' | 'sent-test' | 'error' = 'idle';
  const track = (event: string, p: Record<string, unknown> = {}) => { ((window as unknown as { dataLayer?: unknown[] }).dataLayer ??= []).push({ event, ...p }); };

  const path = (): StepKey[] => { const full = TYPE_PATHS[answers.requestType] ?? TYPE_PATHS['Bridal / wedding']; return lockedType ? full.slice(1) : full; };
  const emailOk = (v: string) => !v.trim() || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
  const phoneOk = (v: string) => v.replace(/\D/g, '').length >= 7;
  const gate = (key: StepKey): boolean => {
    switch (key) {
      case 'type': return !!answers.requestType;
      case 'bridal': return !!answers.partySize;
      case 'extensions': return !!answers.extGoal;
      case 'other': return !!answers.otherText.trim();
      case 'contact': return !!answers.firstName.trim() && phoneOk(answers.phone) && emailOk(answers.email);
      default: return true;
    }
  };
  const syncMulti = (name: string) => { answers[name] = Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((c) => c.value).join(', '); };

  const el = (tag: string, cls: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; };
  function renderProgress(steps: StepKey[]) {
    progEl.textContent = '';
    steps.forEach((key, i) => {
      const li = el('li', i < stepIndex ? 'done' : i === stepIndex ? 'now' : '');
      if (i === stepIndex) li.setAttribute('aria-current', 'step');
      li.appendChild(el('span', 'bar'));
      const lbl = el('span', 'lbl', STEP_LABELS[key]); lbl.setAttribute('aria-hidden', 'true'); li.appendChild(lbl);
      li.appendChild(el('span', 'sr-only', `Step ${i + 1} of ${steps.length}: ${STEP_LABELS[key]}${i === stepIndex ? ' (current)' : ''}`));
      progEl.appendChild(li);
    });
  }
  function renderRecap(current: StepKey) {
    const pairs: [string, string][] = [];
    if (answers.requestType) pairs.push(['Enquiry', answers.requestType]);
    if (answers.partySize) pairs.push(['How many', answers.partySize]);
    if (answers.weddingDate) pairs.push(['Date', answers.weddingDate]);
    if (answers.extGoal) pairs.push(['Hoping for', answers.extGoal]);
    if (answers.timing) pairs.push(['Timing', answers.timing]);
    const show = stepIndex > 0 && current !== 'review' && pairs.length > 0;
    recapEl.hidden = !show;
    if (!show) return;
    recapEl.textContent = '';
    pairs.forEach(([k, v]) => { const row = document.createElement('div'); row.appendChild(el('dt', '', k)); row.appendChild(el('dd', '', v)); recapEl.appendChild(row); });
  }
  function renderReview(steps: StepKey[]) {
    reviewEl.textContent = '';
    for (const [stepKey, heading, fields] of REVIEW_GROUPS) {
      const lockedGroup = !!lockedType && stepKey === 'type';
      if (!steps.includes(stepKey) && !lockedGroup) continue;
      const rows = fields.filter(([k]) => answers[k].trim());
      if (rows.length === 0 && stepKey !== 'type') continue;
      const group = el('div', 'cf-rev-group');
      const head = el('div', 'cf-rev-head');
      head.appendChild(el('h3', '', heading));
      if (!lockedGroup) {
        const edit = el('button', 'cf-rev-edit', 'Edit') as HTMLButtonElement; edit.type = 'button'; edit.setAttribute('aria-label', `Edit ${heading.toLowerCase()}`);
        edit.addEventListener('click', () => { stepIndex = path().indexOf(stepKey); render(true); });
        head.appendChild(edit);
      }
      group.appendChild(head);
      const dl = document.createElement('dl');
      rows.forEach(([k, label]) => { const row = document.createElement('div'); row.appendChild(el('dt', '', label)); row.appendChild(el('dd', '', answers[k].trim())); dl.appendChild(row); });
      group.appendChild(dl); reviewEl.appendChild(group);
    }
  }
  const TYPE_SCOPED = ['weddingDate', 'weddingPlace', 'partySize', 'bridalStyles', 'extGoal', 'extHair', 'timing', 'otherText'];
  function resetTypeScoped() {
    TYPE_SCOPED.forEach((key) => { answers[key] = ''; form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${key}"]`).forEach((c) => { if (c instanceof HTMLInputElement && (c.type === 'radio' || c.type === 'checkbox')) c.checked = false; else c.value = ''; }); });
  }
  function showContactErrors(show: boolean) {
    const map: [string, (v: string) => boolean][] = [['name', (v) => !!v.trim()], ['phone', phoneOk], ['email', emailOk]];
    const key: Record<string, string> = { name: 'firstName', phone: 'phone', email: 'email' };
    for (const [id, ok] of map) {
      const input = document.getElementById(`cf-${id}`) as HTMLInputElement; const err = document.getElementById(`cf-${id}-err`) as HTMLElement;
      const bad = show && !ok(answers[key[id]]);
      err.hidden = !bad; input.setAttribute('aria-invalid', String(bad));
    }
  }
  function render(focus = false) {
    const steps = path();
    if (stepIndex >= steps.length) stepIndex = steps.length - 1;
    const current = steps[stepIndex];
    stepEls.forEach((elm, key) => { elm.hidden = key !== current; });
    renderProgress(steps); renderRecap(current);
    if (current === 'review') renderReview(steps);
    backBtn.hidden = stepIndex === 0;
    nextBtn.textContent = current === 'review' ? (status === 'sending' ? 'Sending…' : 'Send enquiry') : 'Continue';
    nextBtn.disabled = status === 'sending' || !gate(current);
    if (focus) stepEls.get(current)?.querySelector('legend')?.focus();
    track('step_viewed', { step: current, step_number: stepIndex + 1, steps_total: steps.length });
  }
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    if (MULTI.includes(t.name)) { syncMulti(t.name); }
    else if (!t.name || !(t.name in answers)) return;
    else answers[t.name] = t.value;
    if (t.name === 'requestType') { resetTypeScoped(); render(); return; }
    if (['firstName', 'phone', 'email'].includes(t.name)) showContactErrors(false);
    nextBtn.disabled = status === 'sending' || !gate(path()[stepIndex]);
  });
  ['name', 'phone', 'email'].forEach((id) => { (document.getElementById(`cf-${id}`) as HTMLInputElement).addEventListener('blur', () => { if (answers[id === 'name' ? 'firstName' : id]) showContactErrors(true); }); });
  backBtn.addEventListener('click', () => { if (stepIndex > 0) { stepIndex -= 1; render(true); } });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const steps = path(); const current = steps[stepIndex];
    if (current === 'contact' && !gate(current)) { showContactErrors(true); return; }
    if (status === 'sending' || !gate(current)) return;
    track('step_completed', { step: current, step_number: stepIndex + 1 });
    if (current !== 'review') { stepIndex += 1; render(true); return; }
    void send();
  });
  async function send() {
    status = 'sending'; errorEl.hidden = true; render();
    const company = (document.getElementById('cf-company') as HTMLInputElement).value;
    try {
      // DEMO MODE: on a host without the /api function (any static preview host) the
      // enquiry is accepted locally and labelled "demo mode — NOT sent anywhere".
      // CLIENT-DEMO builds (PUBLIC_DEMO_ONLY=1) never contact any server at all.
      let data: { ok?: boolean; staged?: boolean; reason?: string };
      if (import.meta.env.PUBLIC_DEMO_ONLY === '1') {
        await new Promise((r) => setTimeout(r, 650));
        data = { ok: true, staged: true };
      } else {
        const res = await fetch('/api/inquiry', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...answers, company }) });
        const noApi = res.status === 404 || res.status === 405 || !(res.headers.get('content-type') ?? '').includes('application/json');
        data = noApi ? { ok: true, staged: true } : ((await res.json().catch(() => ({}))) as { ok?: boolean; staged?: boolean; reason?: string });
        if (!noApi && (!res.ok || !data.ok)) throw new Error(data.reason ?? `http_${res.status}`);
      }
      status = data.staged ? 'sent-test' : 'sent';
      form.hidden = true;
      (document.getElementById('cfTestStrip') as HTMLElement).hidden = status !== 'sent-test';
      thanksEl.hidden = false;
      (document.getElementById('cfThanksHead') as HTMLElement).focus();
      track('form_submitted', { request_type: answers.requestType, staged: status === 'sent-test' });
    } catch (err) {
      status = 'error';
      const reason = err instanceof Error && err.message ? err.message : 'network';
      (document.getElementById('cfErrCode') as HTMLElement).textContent = `Error code: ${reason}`;
      errorEl.hidden = false; render();
      track('form_error', { request_type: answers.requestType, message: reason });
    }
  }
  function buildSummary(): string {
    const lines: string[] = ['Enquiry — Sass by Kass', ''];
    for (const [, heading, fields] of REVIEW_GROUPS) {
      const rows = fields.filter(([k]) => answers[k].trim()); if (rows.length === 0) continue;
      lines.push(heading.toUpperCase()); rows.forEach(([k, label]) => lines.push(`  ${label}: ${answers[k].trim()}`)); lines.push('');
    }
    return lines.join('\n').trim();
  }
  const copyBtn = document.getElementById('cfCopy') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const text = buildSummary(); let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; }
    catch { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.focus(); ta.select(); try { ok = document.execCommand('copy'); } catch { ok = false; } ta.remove(); }
    copyBtn.textContent = ok ? 'Copied ✓' : 'Select all & copy';
    setTimeout(() => { copyBtn.textContent = 'Copy my enquiry'; }, 2600);
  });

  if (lockedType) { answers.requestType = lockedType; const r = form.querySelector<HTMLInputElement>(`input[name="requestType"][value="${lockedType}"]`); if (r) r.checked = true; }
  form.classList.add('ready');
  render();
</script>
