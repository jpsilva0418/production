---
/** Restrained footer: logo + one line, the destinations, both booking paths and every way to
 *  reach Kass. Only supplied facts — no address or hours (none supplied). */
import Logo from './Logo.astro';
import { SITE, TEL, SMS, ext } from '../consts';
import { FOOTER } from '../lib/content';
const year = new Date().getUTCFullYear();
---
<footer class="foot">
  <i class="lx-dusk" aria-hidden="true"></i>
  <div class="foot-in">
    <div class="foot-grid">
      <div class="foot-brand">
        <Logo tone="dark" class="foot-logo" label={`${SITE.name} — ${SITE.tagline}`} />
        <p>{FOOTER.line}</p>
      </div>
      <div>
        <p class="foot-h">Explore</p>
        <ul class="foot-nav">
          <li><a href="/">Home</a></li>
          {SITE.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="foot-h">Book</p>
        <ul class="foot-contact">
          <li><span class="k">Weddings</span><a href={SITE.bridal} {...ext(SITE.bridal)}>Bridal inquiry</a></li>
          <li><span class="k">In-salon</span><a href={SITE.booking} {...ext(SITE.booking)}>Book on GlossGenius</a></li>
          <li><span class="k">Where</span>{SITE.area.label}</li>
        </ul>
      </div>
      <div>
        <p class="foot-h">Reach Kass</p>
        <ul class="foot-contact">
          <li><span class="k">Instagram</span><a href={SITE.instagram.url} {...ext(SITE.instagram.url)}>{SITE.instagram.handle}</a></li>
          <li><span class="k">Text or call</span><a href={SMS}>{SITE.phone}</a></li>
          <li><span class="k">Email</span><a href={`mailto:${SITE.email}`} style="overflow-wrap:anywhere">{SITE.email}</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bar">
      <span>&copy; {year} {SITE.name}</span>
      <span>{SITE.tagline} &middot; {SITE.area.label}</span>
      <span><a href={TEL}>{SITE.phone}</a></span>
    </div>
  </div>
</footer>
<style>
  .foot-brand :global(.foot-logo){display:block;width:min(240px,70%);height:auto;margin-bottom:1.4rem}
</style>
