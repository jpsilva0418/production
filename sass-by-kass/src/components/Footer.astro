---
/** Grand footer: brand + one line, navigation, every way to reach Kass, and the two
 *  booking paths. Only supplied facts appear — no address or hours, because none were
 *  supplied; GlossGenius carries availability. */
import Mark from './Mark.astro';
import { SITE, TEL, SMS } from '../consts';
import { FOOTER } from '../lib/content';
const year = new Date().getUTCFullYear();
---
<footer class="foot">
  <i class="lx-dusk" aria-hidden="true"></i>
  <div class="foot-in">
    <div class="foot-grid">
      <div class="foot-brand">
        <Mark />
        <div class="foot-name">Sass <i>by</i> Kass</div>
        <div class="foot-sub">{SITE.tagline}</div>
        <p>{FOOTER.line}</p>
      </div>
      <div>
        <p class="foot-h">Explore</p>
        <ul class="foot-nav">
          <li><a href="/">Home</a></li>
          {SITE.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={SITE.links.bridal}>Bridal enquiry</a></li>
        </ul>
      </div>
      <div>
        <p class="foot-h">Reach Kass</p>
        <ul class="foot-contact">
          <li><span class="k">Call</span><a href={TEL}>{SITE.phone}</a></li>
          <li><span class="k">Text</span><a href={SMS}>{SITE.phone}</a></li>
          <li><span class="k">Instagram</span><a href={SITE.instagram.url} target="_blank" rel="noopener noreferrer">{SITE.instagram.handle}</a></li>
        </ul>
      </div>
      <div>
        <p class="foot-h">Book</p>
        <ul class="foot-contact">
          <li><span class="k">Online booking</span><a href={SITE.booking} target="_blank" rel="noopener noreferrer">sassbykass.glossgenius.com</a></li>
          <li><span class="k">Brides &amp; extensions</span><a href={SITE.links.enquiry}>Start an enquiry</a></li>
          <li><span class="k">Where</span>{SITE.area.label}</li>
        </ul>
      </div>
    </div>
    <div class="foot-bar">
      <span>&copy; {year} {SITE.name}</span>
      <span>{SITE.tagline} &middot; {SITE.area.label}</span>
      <span><a href={SITE.instagram.url} target="_blank" rel="noopener noreferrer">Instagram</a></span>
    </div>
  </div>
</footer>
<style>
  .foot-name i{font-style:italic;font-weight:300;font-size:.72em;margin:0 .06em;opacity:.85}
</style>
