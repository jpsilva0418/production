---
/** Site header + full-screen menu. Desktop: wordmark, three sections, her phone and a
 *  "Book" button to her live GlossGenius page. Phone: wordmark + MENU; the menu carries
 *  Book, Call, Text and Instagram so every way to reach her is one tap away.
 *  Variants: `light` over filmed/dark heroes, `prologue` fades in after the title card.
 *  Menu logic lives in BaseLayout's shared runtime. */
import Mark from './Mark.astro';
import { SITE, TEL, SMS } from '../consts';
interface Props { light?: boolean; prologue?: boolean; current?: string }
const { light = false, prologue = false, current = '' } = Astro.props;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
const primary = SITE.nav.filter((n) => n.href !== SITE.links.book);
const numerals = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.'];
---
<header class:list={['hd', { 'hd--lt': light, 'hd--plg': prologue }]} id="siteHeader">
  <div class="hd-in">
    <a class="hd-logo" href="/" aria-label={`${SITE.name} — home`}>
      <Mark />
      <span class="wm" aria-hidden="true"><span class="wm-name">Sass <i>by</i> Kass</span><span class="wm-sub">{SITE.tagline}</span></span>
    </a>
    <nav class="hd-nav" aria-label="Primary">
      {primary.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="hd-tools">
      <a class="hd-phone" href={TEL}>{SITE.phone}</a>
      <a class="btn btn--solid hd-cta" href={SITE.booking} target="_blank" rel="noopener noreferrer">Book</a>
      <button class="menu-btn" id="menuOpen" aria-expanded="false" aria-controls="menu">Menu <span class="bars" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
</header>
<nav class="menu" id="menu" aria-label="Main menu" aria-hidden="true" inert>
  <div class="menu-top">
    <a class="hd-logo" href="/" aria-label={`${SITE.name} — home`} tabindex="-1">
      <Mark />
      <span class="wm" aria-hidden="true"><span class="wm-name">Sass <i>by</i> Kass</span><span class="wm-sub">{SITE.tagline}</span></span>
    </a>
    <button class="menu-close" id="menuClose">Close <span class="x" aria-hidden="true">&times;</span></button>
  </div>
  <div class="menu-body">
    <ul class="menu-list">
      <li><a href="/" aria-current={current === '/' ? 'page' : undefined}><span class="mrn">{numerals[0]}</span><span class="mlb">Home</span><span class="mnote">Start here</span></a></li>
      {SITE.nav.map((n, i) => (
        <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}><span class="mrn">{numerals[i + 1]}</span><span class="mlb">{n.label}</span><span class="mnote">{n.note}</span></a></li>
      ))}
    </ul>
    <div class="menu-sub">
      <a href={TEL}>Call {SITE.phone}</a>
      <a href={SMS}>Text Kass</a>
      <a href={SITE.instagram.url} target="_blank" rel="noopener noreferrer">Instagram {SITE.instagram.handle}</a>
    </div>
    <div class="menu-cta">
      <a class="btn btn--ivory" href={SITE.booking} target="_blank" rel="noopener noreferrer">Book an appointment</a>
      <a class="btn btn--ghost" href={SITE.links.bridal}>Bridal enquiry</a>
    </div>
  </div>
  <div class="menu-foot">
    <span>{SITE.name}</span>
    <span>{SITE.tagline} · {SITE.area.label}</span>
  </div>
</nav>
<style is:global>
  .hd-logo .wm-name i{font-style:italic;font-weight:300;font-size:.78em;letter-spacing:.02em;margin:0 .08em;opacity:.85}
</style>
