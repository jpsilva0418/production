---
/** DESIGN-REVIEW SELECTOR — review build only. Switches between the three blue
 *  directions (links + keys 1–3, H hides it). Never rendered in a client-demo build
 *  (DEMO_PALETTE set) and stripped again by scripts/snapshot-demo.mjs as a safety check. */
import { PALETTES, LOCKED_PALETTE } from '../lib/palette';
---
{!LOCKED_PALETTE && <nav class="cb" id="paletteBar" aria-label="Design review: blue direction">
  <span class="cb-ix">Blue direction</span>
  <ol class="cb-list">
    {PALETTES.map((p) => <li><a href={`/preview/${p.id}`} data-pal={p.id} title={`${p.name} — ${p.line}`}>{p.id.toUpperCase()}</a></li>)}
  </ol>
  <span class="cb-name" id="paletteName"></span>
  <button class="cb-hide" id="paletteHide" type="button" title="Hide (H)" aria-label="Hide direction bar">&times;</button>
</nav>}
<style is:global>
  .cb{position:fixed;left:50%;bottom:12px;transform:translateX(-50%);z-index:90;display:flex;align-items:center;gap:10px;padding:6px 8px 6px 12px;background:rgba(14,19,38,.92);color:#EEF1F7;border-radius:999px;backdrop-filter:blur(8px);font-family:var(--utility);font-size:.68rem;letter-spacing:.06em;box-shadow:0 12px 32px -14px rgba(0,0,0,.6);max-width:calc(100vw - 24px)}
  .cb.cb--hidden{display:none}
  .cb-ix{font-weight:700;text-transform:uppercase;letter-spacing:.2em;font-size:.56rem;color:#C9D3E2;padding-right:8px;border-right:1px solid rgba(255,255,255,.18);white-space:nowrap}
  .cb-list{list-style:none;display:flex;gap:4px;margin:0;padding:0}
  .cb-list a{display:grid;place-items:center;min-width:34px;height:34px;border-radius:999px;font-weight:700;color:#EEF1F7;transition:background .2s}
  .cb-list a:hover{background:rgba(255,255,255,.12)}
  .cb-list a[aria-current="page"]{background:#C9D3E2;color:#0E1326}
  .cb-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px;color:rgba(238,241,247,.8)}
  .cb-hide{background:none;border:0;color:rgba(238,241,247,.7);font-size:1.1rem;width:34px;height:34px;border-radius:999px;cursor:pointer}
  .cb-hide:hover{background:rgba(255,255,255,.12)}
  @media(max-width:640px){.cb{bottom:8px;gap:6px;padding:5px 6px 5px 10px}.cb-name{display:none}.cb-list a{min-width:32px;height:32px}}
  @media(max-width:420px){.cb{gap:4px;padding:4px 4px 4px 9px}.cb-ix{font-size:.5rem;letter-spacing:.12em;padding-right:6px}.cb-list{gap:2px}.cb-list a{min-width:30px;height:30px;font-size:.64rem}.cb-hide{width:30px;height:30px}}
  body:has(#paletteBar) .demo-flag{bottom:58px}
  @media(max-width:640px){body:has(#paletteBar) .demo-flag{bottom:54px}}
</style>
<script>
  import { PALETTES } from '../lib/palette';
  const bar = document.getElementById('paletteBar');
  if (bar) {
    const cur = (document.body.className.match(/\bpal-([abc])\b/) ?? [])[1] ?? 'a';
    bar.querySelectorAll<HTMLAnchorElement>('[data-pal]').forEach((a) => { if (a.dataset.pal === cur) a.setAttribute('aria-current', 'page'); });
    const p = PALETTES.find((x) => x.id === cur);
    const name = document.getElementById('paletteName'); if (name && p) name.textContent = `${p.id.toUpperCase()} · ${p.name}`;
    document.getElementById('paletteHide')?.addEventListener('click', () => bar.classList.add('cb--hidden'));
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === '1' || e.key === '2' || e.key === '3') location.href = `/preview/${'abc'[Number(e.key) - 1]}`;
      else if (e.key.toLowerCase() === 'h') bar.classList.toggle('cb--hidden');
    });
  }
</script>
