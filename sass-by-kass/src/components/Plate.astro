---
/** A photo slot. Renders the named placeholder plate from src/assets/plates through
 *  astro:assets (responsive widths, lazy by default). When real photography arrives,
 *  drop the file in with the same name — nothing else changes. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  style?: string;
}
const { id, alt, class: cls, widths = [480, 800, 1200], sizes = '(max-width: 899px) 90vw, 50vw', loading = 'lazy', fetchpriority, style } = Astro.props;
const plates = import.meta.glob<{ default: ImageMetadata }>('../assets/plates/*.jpg', { eager: true });
const entry = plates[`../assets/plates/${id}.jpg`];
if (!entry) throw new Error(`Plate "${id}" not found in src/assets/plates`);
---
<Image src={entry.default} alt={alt} class={cls} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} style={style} />
