---
/** HERO — her official SBK logo is the centrepiece (client correction, Nov 2026). Exactly:
 *    SBK logo · Bridal Inquiry (on-site form) · Book In-Salon (GlossGenius) · Meet Kass ↓
 *  No photograph, no video, no headline or paragraph: the logo already says "Bridal and Hair
 *  Artistry". The ground is art-directed from her palette so the logo reads as a printed card:
 *   · deep-navy field with a soft powder-blue light behind the logo and a darker vignette;
 *   · a fine champagne double frame inset from the edges (stationery, not decoration);
 *   · a faint linen weave + grain for paper-like texture;
 *   · one restrained motion: the light breathes slowly (off under reduced motion).
 *  Everything is CSS: nothing to download, so logo and buttons are there at first paint. */
import Logo from './Logo.astro';
import { SITE, HERO, ext } from '../lib/content';
---
<script is:inline>
  /* Signature entrance gate. Runs before the hero is parsed, so the first paint is already the intro's
     opening state (no flash of the final hero followed by a jump). Plays once per browsing session,
     never under reduced motion, never without JS. Failsafe: if the entrance script below has not taken
     over within 2.5 s (script error, very slow parse), the class is removed and the static approved
     hero shows: nothing can stay hidden. */
  (function(){try{var d=document.documentElement;if(!window.matchMedia||matchMedia('(prefers-reduced-motion: reduce)').matches||!document.body.animate)return;
    if(sessionStorage.getItem('sbk-intro-v3'))return;sessionStorage.setItem('sbk-intro-v3','1');d.classList.add('sbk-intro');
    setTimeout(function(){if(!d.classList.contains('sbk-intro-run'))d.classList.remove('sbk-intro');},2500);}catch(e){}})();
</script>
<section class="plg" id="hero" data-pin data-chapter="hero" data-tone="film" aria-label={`${SITE.name} — ${SITE.tagline}`}>
  <div class="plg-ground" aria-hidden="true"><i class="plg-light"></i><i class="plg-weave"></i><i class="grain"></i></div>
  <div class="plg-frame" aria-hidden="true"></div>
  <div class="plg-c">
    <div class="plg-mark">
      <svg class="plg-arc" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><circle class="a1" cx="100" cy="100" r="99" pathLength="100" stroke-dasharray="100 100" stroke-dashoffset="100"/><circle class="a2" cx="100" cy="100" r="94" pathLength="100" stroke-dasharray="100 100" stroke-dashoffset="100"/></svg>
      <h1 class="plg-logo"><Logo tone="dark" size="lg" eager label={`${SITE.name} — ${SITE.tagline}`} /></h1>
    </div>
    <span class="plg-rule" aria-hidden="true"></span>
    <div class="plg-ctas">
      <a class="btn btn--ivory" href={HERO.ctaHref}>{HERO.cta}</a>
      <a class="btn btn--ghost" href={HERO.salonHref} {...ext(HERO.salonHref)}>{HERO.salon}</a>
    </div>
  </div>
  <a class="plg-cue" href="#about"><span>{HERO.cue}</span><i class="ln" aria-hidden="true"></i></a>
</section>
<script is:inline>
  /* SBK signature entrance: one continuous logo (shared-element / FLIP).
     The logo is never duplicated or swapped. Its final place is the hero's own responsive layout,
     measured here; the wrapper starts at the screen centre (inverted transform) and plays back to
     "none", so the end position is the layout itself, not hard-coded coordinates.
       0.00–1.15 s  A  arc draws and widens; the logo is revealed inside it (circular clip) at centre
       1.15–1.35 s     hold: the full official logo inside its ring
       1.35–2.25 s  C  the same logo travels and settles into its hero position; the ring opens and fades
       1.55–2.75 s  D  header, frame, texture, rule, buttons and cue assemble around it
     Total ≈ 2.75 s. Buttons are opacity-only and remain clickable throughout. */
  (function(){var d=document.documentElement;if(!d.classList.contains('sbk-intro'))return;d.classList.add('sbk-intro-run');
    var q=function(x){return document.querySelector(x)};
    var hero=q('#hero'),mark=q('.plg-mark'),logo=q('.plg-logo'),ring=q('.plg-arc'),a1=q('.plg-arc .a1'),a2=q('.plg-arc .a2');
    var done=function(){d.classList.remove('sbk-intro','sbk-intro-run');anims.forEach(function(a){a.cancel()});};
    var anims=[];
    try{
      var r=logo.getBoundingClientRect(),W=r.width,H=r.height,vh=(window.visualViewport?visualViewport.height:innerHeight);
      var dx=innerWidth/2-(r.left+W/2),dy=vh/2-(r.top+H/2),s0=Math.min(1.1,(innerWidth*0.86)/W);
      var R=Math.hypot(W,H)/2+2,RING=0.55*W*1.0, big=Math.max(W,H)*1.2;
      var ease='cubic-bezier(.45,.05,.25,1)',glide='cubic-bezier(.65,0,.2,1)';
      var A=function(el,kf,o){if(!el)return;var a=el.animate(kf,Object.assign({fill:'both'},o));anims.push(a);return a;};
      // PHASE A + C: the wrapper (ring + logo together) sits at centre, then glides home
      var from='translate('+dx+'px,'+dy+'px) scale('+s0+')';
      A(mark,[{transform:from},{transform:from,offset:1.35/2.25},{transform:'none'}],{duration:2250,easing:glide});
      // logo revealed inside the widening ring (clip-path on the h1 wrapper, never the image)
      A(logo,[{clipPath:'circle('+(0.07*W)+'px at 50% 50%)',opacity:.55},{clipPath:'circle('+R+'px at 50% 50%)',opacity:1,offset:1.15/2.25},{clipPath:'circle('+R+'px at 50% 50%)',offset:1.35/2.25},{clipPath:'circle('+big+'px at 50% 50%)'}],{duration:2250,easing:ease});
      // the ring's edge rides the reveal edge, then opens and dissolves
      var k=(0.07*W)/RING, grow=Math.min(1.28,(innerWidth*0.98)/(2*R*s0)); // the opening ring never exceeds the screen width
      A(ring,[{opacity:1,transform:'rotate(-120deg) scale('+k+')'},{opacity:1,transform:'rotate(-90deg) scale('+(R/RING)+')',offset:1.15/2.25},{opacity:1,transform:'rotate(-88deg) scale('+(R/RING)+')',offset:1.35/2.25},{opacity:0,transform:'rotate(-80deg) scale('+(R/RING*grow)+')'}],{duration:2250,easing:ease});
      A(a1,[{strokeDashoffset:100},{strokeDashoffset:9,offset:.5},{strokeDashoffset:9}],{duration:2250,easing:ease});
      A(a2,[{strokeDashoffset:100},{strokeDashoffset:30,offset:.55},{strokeDashoffset:30}],{duration:2250,delay:80,easing:ease});
      // PHASE D: the approved hero assembles around the settled logo
      // implicit end keyframe: each element fades to its own approved computed value
      var fade=function(el,delay,dur,y){A(el,[y?{opacity:0,transform:'translateY('+y+'px)',offset:0}:{opacity:0,offset:0}],{duration:dur,delay:delay,easing:'cubic-bezier(.22,.8,.24,1)'});};
      fade(q('#siteHeader'),1550,700);fade(q('.plg-frame'),1550,800);fade(q('.plg-weave'),1500,900);
      A(q('.plg-rule'),[{opacity:0,transform:'scaleX(0)',offset:0}],{duration:550,delay:1900,easing:'cubic-bezier(.22,.8,.24,1)'});
      fade(q('.plg-ctas'),1980,650,16);fade(q('.plg-cue'),2250,500);
      // hand the page back to its static styles in one frame, once everything has finished
      Promise.all(anims.map(function(a){return a.finished})).then(done,done);
      // the user scrolling or tapping mid-entrance finishes it immediately (never in the way)
      var skip=function(){anims.forEach(function(a){try{a.finish()}catch(e){}})};
      addEventListener('wheel',skip,{once:true,passive:true});addEventListener('touchmove',skip,{once:true,passive:true});addEventListener('keydown',skip,{once:true});
      addEventListener('pagehide',done,{once:true});
    }catch(e){done();}
  })();
</script>

<style>
  .plg{--peek:56px;--inset:clamp(14px,2.4vw,30px);position:sticky;top:var(--pin-top,0px);z-index:0;min-height:100vh;min-height:100svh;overflow:hidden;display:grid;place-items:center;color:var(--ivory);
    background:radial-gradient(120% 90% at 50% 42%,var(--leaf) 0%,var(--leaf) 38%,var(--leaf-deep) 100%)}
  .plg.is-covered{visibility:hidden}
  .plg-ground{position:absolute;inset:0;pointer-events:none}
  /* powder-blue light behind the logo, a touch of champagne low in the field */
  .plg-light{position:absolute;inset:-20%;background:
      radial-gradient(38% 30% at 50% 40%,color-mix(in srgb,var(--sage) 24%,transparent) 0%,transparent 70%),
      radial-gradient(60% 40% at 50% 100%,color-mix(in srgb,var(--gold-lt) 9%,transparent) 0%,transparent 70%)}
  /* a fine linen weave: two hairline grids at 45°, barely there */
  .plg-weave{position:absolute;inset:0;opacity:.07;background:
      repeating-linear-gradient(45deg,var(--gold-lt) 0 1px,transparent 1px 7px),
      repeating-linear-gradient(-45deg,var(--sage) 0 1px,transparent 1px 7px);
      mask-image:radial-gradient(80% 70% at 50% 45%,#000 30%,transparent 85%);-webkit-mask-image:radial-gradient(80% 70% at 50% 45%,#000 30%,transparent 85%)}
  .plg-ground .grain{opacity:.06}
  /* stationery frame: two champagne hairlines inset from the edges */
  .plg-frame{position:absolute;inset:calc(var(--inset) + 70px) var(--inset) calc(var(--inset) + var(--peek)) var(--inset);border:1px solid color-mix(in srgb,var(--gold-lt) 38%,transparent);border-radius:calc(var(--r-lg) + 6px);pointer-events:none}
  .plg-frame::after{content:"";position:absolute;inset:7px;border:1px solid color-mix(in srgb,var(--gold-lt) 16%,transparent);border-radius:var(--r-lg)}
  .plg-c{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(7rem,15vh,9rem) 24px calc(var(--peek) + clamp(6rem,14vh,8rem));width:100%}
  .plg-logo{margin:0;line-height:0}
  .plg-logo :global(img){width:min(640px,78vw);height:auto;filter:drop-shadow(0 18px 40px rgba(0,0,0,.22))}
  .plg-rule{display:block;width:clamp(56px,7vw,84px);height:1px;background:var(--gold-lt);opacity:.65;margin:clamp(1.8rem,4.4vh,2.8rem) 0}
  .plg-ctas{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
  .plg-ctas .btn{min-width:210px}
  .plg-cue{position:absolute;bottom:calc(var(--peek) + clamp(1.2rem,3vh,2rem));left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:.6rem;min-height:44px;padding:6px 14px;color:var(--gold-lt)}
  .plg-cue span{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.36em;text-indent:.36em;font-size:.62rem}
  .plg-cue .ln{width:1px;height:26px;background:linear-gradient(currentColor,transparent);transform-origin:top}
  .plg-cue:hover,.plg-cue:focus-visible{color:var(--ivory)}
  /* SBK signature entrance — see the script at the end of this file for the timeline.
     Root-cause rules carried from the Nov 2026 white-box glitch (iPhone WebKit painted an opaque box
     where an animated, fill-held `filter` sat on the logo <img>):
       · the logo <img> itself is never animated and never gets a new filter; only wrappers move;
       · wrappers use only transform, opacity and clip-path;
       · no animated end state is kept: when the entrance ends, every animation is cancelled in the
         same frame the pre-state class is removed, so the page is left on its plain static styles. */
  .plg-mark{position:relative;display:grid;place-items:center}
  .plg-arc{position:absolute;left:50%;top:50%;width:110%;aspect-ratio:1;translate:-50% -50%;overflow:visible;pointer-events:none;opacity:0;fill:none;stroke-width:1}
  .plg-arc circle{vector-effect:non-scaling-stroke;transform-box:fill-box;transform-origin:center}
  .plg-arc .a1{stroke:var(--sage);stroke-opacity:.85;stroke-linecap:round}
  .plg-arc .a2{stroke:var(--gold-lt);stroke-opacity:.35;transform:scale(-1,1)}
  /* opening state, painted before the entrance script runs (removed by the script or the failsafe).
     Only the logo needs a CSS pre-state; everything else is faded by the script towards its own
     computed (approved) value, so no target opacity is ever hard-coded. */
  :global(html.sbk-intro) .plg-logo{clip-path:circle(0px at 50% 50%)}
  @media (prefers-reduced-motion:no-preference){
    .plg-light{animation:plgBreathe 9s ease-in-out infinite alternate}
    .plg-cue .ln{animation:cuePulse 2.8s ease-in-out 3s infinite}
  }
  @keyframes plgBreathe{from{opacity:.75;transform:scale(1)}to{opacity:1;transform:scale(1.06)}}
  @keyframes plgRule{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes cuePulse{0%,100%{transform:scaleY(.35);opacity:.5}50%{transform:scaleY(1);opacity:1}}
  @media(max-width:640px){
    .plg{--peek:38px}
    .plg-frame{inset:calc(var(--inset) + 62px) var(--inset) calc(var(--inset) + var(--peek)) var(--inset)}
    .plg-c{padding:6.4rem 32px calc(var(--peek) + 6.4rem)}
    .plg-logo :global(img){width:min(420px,80vw)}
    .plg-ctas{flex-direction:column;align-items:stretch;width:100%;max-width:300px}
    .plg-ctas .btn{min-width:0}
  }
  @media(max-height:640px){.plg-c{padding-top:5.6rem;padding-bottom:calc(var(--peek) + 5rem)}.plg-rule{margin:1.2rem 0}}
  @media (prefers-reduced-motion:reduce){.plg{position:relative;top:auto!important;visibility:visible!important}}
</style>
<script>
  // Pin: on a phone shorter than the hero content, the hero scrolls until its foot reaches the
  // screen's foot, then holds (About Kass rises over it).
  const hero = document.getElementById('hero');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pin = () => { hero.style.setProperty('--pin-top', `${Math.min(0, innerHeight - hero.offsetHeight)}px`); };
    pin(); addEventListener('resize', pin);
  }
</script>
