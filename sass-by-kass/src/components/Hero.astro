---
/** HERO — her official SBK logo is the centrepiece (client correction, Nov 2026). Exactly:
 *    SBK logo · Bridal Inquiry (on-site form) · Book In-Salon (GlossGenius) · Meet Kass ↓
 *  No photograph, no video, no headline or paragraph: the logo already says "Bridal and Hair
 *  Artistry". The ground is art-directed from her palette so the logo reads as a printed card:
 *   · deep-navy field with a soft powder-blue light behind the logo and a darker vignette;
 *   · a fine champagne double frame inset from the edges (stationery, not decoration);
 *   · a faint linen weave + grain for paper-like texture;
 *   · one restrained motion: the light breathes slowly (off under reduced motion).
 *  Everything is CSS: nothing to download, so logo and buttons are there at first paint. */
import Logo from './Logo.astro';
import { SITE, HERO, ext } from '../lib/content';
---
<section class="plg" id="hero" data-pin data-chapter="hero" data-tone="film" aria-label={`${SITE.name} — ${SITE.tagline}`}>
  <div class="plg-ground" aria-hidden="true"><i class="plg-light"></i><i class="plg-weave"></i><i class="grain"></i></div>
  <div class="plg-frame" aria-hidden="true"></div>
  <div class="plg-c">
    <h1 class="plg-logo"><Logo tone="dark" size="lg" eager label={`${SITE.name} — ${SITE.tagline}`} /></h1>
    <span class="plg-rule" aria-hidden="true"></span>
    <div class="plg-ctas">
      <a class="btn btn--ivory" href={HERO.ctaHref}>{HERO.cta}</a>
      <a class="btn btn--ghost" href={HERO.salonHref} {...ext(HERO.salonHref)}>{HERO.salon}</a>
    </div>
  </div>
  <a class="plg-cue" href="#about"><span>{HERO.cue}</span><i class="ln" aria-hidden="true"></i></a>
</section>

<style>
  .plg{--peek:56px;--inset:clamp(14px,2.4vw,30px);position:sticky;top:var(--pin-top,0px);z-index:0;min-height:100vh;min-height:100svh;overflow:hidden;display:grid;place-items:center;color:var(--ivory);
    background:radial-gradient(120% 90% at 50% 42%,var(--leaf) 0%,var(--leaf) 38%,var(--leaf-deep) 100%)}
  .plg.is-covered{visibility:hidden}
  .plg-ground{position:absolute;inset:0;pointer-events:none}
  /* powder-blue light behind the logo, a touch of champagne low in the field */
  .plg-light{position:absolute;inset:-20%;background:
      radial-gradient(38% 30% at 50% 40%,color-mix(in srgb,var(--sage) 24%,transparent) 0%,transparent 70%),
      radial-gradient(60% 40% at 50% 100%,color-mix(in srgb,var(--gold-lt) 9%,transparent) 0%,transparent 70%)}
  /* a fine linen weave: two hairline grids at 45°, barely there */
  .plg-weave{position:absolute;inset:0;opacity:.07;background:
      repeating-linear-gradient(45deg,var(--gold-lt) 0 1px,transparent 1px 7px),
      repeating-linear-gradient(-45deg,var(--sage) 0 1px,transparent 1px 7px);
      mask-image:radial-gradient(80% 70% at 50% 45%,#000 30%,transparent 85%);-webkit-mask-image:radial-gradient(80% 70% at 50% 45%,#000 30%,transparent 85%)}
  .plg-ground .grain{opacity:.06}
  /* stationery frame: two champagne hairlines inset from the edges */
  .plg-frame{position:absolute;inset:calc(var(--inset) + 70px) var(--inset) calc(var(--inset) + var(--peek)) var(--inset);border:1px solid color-mix(in srgb,var(--gold-lt) 38%,transparent);border-radius:calc(var(--r-lg) + 6px);pointer-events:none}
  .plg-frame::after{content:"";position:absolute;inset:7px;border:1px solid color-mix(in srgb,var(--gold-lt) 16%,transparent);border-radius:var(--r-lg)}
  .plg-c{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(7rem,15vh,9rem) 24px calc(var(--peek) + clamp(6rem,14vh,8rem));width:100%}
  .plg-logo{margin:0;line-height:0}
  .plg-logo :global(img){width:min(640px,78vw);height:auto;filter:drop-shadow(0 18px 40px rgba(0,0,0,.22))}
  .plg-rule{display:block;width:clamp(56px,7vw,84px);height:1px;background:var(--gold-lt);opacity:.65;margin:clamp(1.8rem,4.4vh,2.8rem) 0}
  .plg-ctas{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
  .plg-ctas .btn{min-width:210px}
  .plg-cue{position:absolute;bottom:calc(var(--peek) + clamp(1.2rem,3vh,2rem));left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:.6rem;min-height:44px;padding:6px 14px;color:var(--gold-lt)}
  .plg-cue span{font-family:var(--utility);font-weight:600;text-transform:uppercase;letter-spacing:.36em;text-indent:.36em;font-size:.62rem}
  .plg-cue .ln{width:1px;height:26px;background:linear-gradient(currentColor,transparent);transform-origin:top}
  .plg-cue:hover,.plg-cue:focus-visible{color:var(--ivory)}
  @media (prefers-reduced-motion:no-preference){
    .plg-light{animation:plgBreathe 9s ease-in-out infinite alternate}
    .plg-logo{animation:fadeIn .9s ease both}
    .plg-rule{animation:plgRule .9s var(--ease) .25s both}
    .plg-ctas{animation:fadeUp .8s var(--ease) .3s both}
    .plg-cue .ln{animation:cuePulse 2.8s ease-in-out 1.2s infinite}
  }
  @keyframes plgBreathe{from{opacity:.75;transform:scale(1)}to{opacity:1;transform:scale(1.06)}}
  @keyframes plgRule{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes cuePulse{0%,100%{transform:scaleY(.35);opacity:.5}50%{transform:scaleY(1);opacity:1}}
  @media(max-width:640px){
    .plg{--peek:38px}
    .plg-frame{inset:calc(var(--inset) + 62px) var(--inset) calc(var(--inset) + var(--peek)) var(--inset)}
    .plg-c{padding:6.4rem 32px calc(var(--peek) + 6.4rem)}
    .plg-logo :global(img){width:min(420px,80vw)}
    .plg-ctas{flex-direction:column;align-items:stretch;width:100%;max-width:300px}
    .plg-ctas .btn{min-width:0}
  }
  @media(max-height:640px){.plg-c{padding-top:5.6rem;padding-bottom:calc(var(--peek) + 5rem)}.plg-rule{margin:1.2rem 0}}
  @media (prefers-reduced-motion:reduce){.plg{position:relative;top:auto!important;visibility:visible!important}}
</style>
<script>
  // Pin: on a phone shorter than the hero content, the hero scrolls until its foot reaches the
  // screen's foot, then holds (About Kass rises over it).
  const hero = document.getElementById('hero');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pin = () => { hero.style.setProperty('--pin-top', `${Math.min(0, innerHeight - hero.offsetHeight)}px`); };
    pin(); addEventListener('resize', pin);
  }
</script>
