---
/** REVIEWS — only verified client words (src/lib/content.ts → REVIEWS), each with its source.
 *  None have been supplied yet, so the page shows an honest empty state and points to where
 *  her clients already talk about her (Instagram). Nothing here is invented. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import { SITE, ext, REVIEWS, REVIEWS_EMPTY } from '../lib/content';
import { businessJsonLd, breadcrumbJsonLd } from '../lib/seo';
const jsonLd = [businessJsonLd(), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews' }])];
const bridal = REVIEWS.filter((r) => r.kind !== 'salon');
const salon = REVIEWS.filter((r) => r.kind === 'salon');
const groups = [{ id: 'bridal', label: 'From her brides', items: bridal }, { id: 'salon', label: 'From the salon', items: salon }].filter((g) => g.items.length);
---
<BaseLayout
  title="Reviews — Brides and Clients of Sass by Kass"
  description={`Kind words from Kass’s brides and salon clients, published word for word with permission. ${SITE.name}, ${SITE.tagline}, ${SITE.area.label}.`}
  path="/reviews"
  jsonLd={jsonLd}>

  <section class="cov ghostwrap">
    <span class="ghost-w" aria-hidden="true">kind words</span>
    <div class="cov-c">
      <p class="cov-kick fade">Reviews</p>
      <h1 class="disp rv">{REVIEWS_EMPTY.heading.split(',')[0]}, <span class="ital">{REVIEWS_EMPTY.heading.split(',')[1]}</span></h1>
      <p class="cov-sub rv" style="--d:.08s">{REVIEWS_EMPTY.body}</p>
    </div>
  </section>

  {groups.length > 0 ? groups.map((g) => (
    <section class="sec sec--tight" aria-labelledby={`rv-${g.id}`}>
      <div class="wrap">
        <p class="caps rv" id={`rv-${g.id}`}>{g.label}</p>
        <div class="rv-grid" data-stag=".1">
          {g.items.map((t) => (
            <figure class="rv-q fade">
              <span class="rv-m" aria-hidden="true">&ldquo;</span>
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption><span class="caps-xs">{t.name}</span><span class="rv-src">{t.source}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )) : (
    <section class="sec sec--tight">
      <div class="wrap rv-empty">
        <figure class="ph ph--framed rv-im rv-empty-ph"><Plate id="bride-mother" alt="A bride and her mother getting ready, soft updos" sizes="(max-width:899px) 90vw, 520px" widths={[480, 800]} /><i class="grain" aria-hidden="true"></i></figure>
        <div class="rv-empty-t">
          <p class="caps rv">In the meantime</p>
          <p class="rv-empty-h rv" style="--d:.06s">See her brides on Instagram.</p>
          <p class="fade" style="--d:.12s">Kass shares her wedding mornings, before-and-afters and client moments on {SITE.instagram.handle}.</p>
          <div class="rv-empty-a fade" style="--d:.18s">
            <a class="btn btn--solid" href={SITE.instagram.url} {...ext(SITE.instagram.url)}>Open {SITE.instagram.handle}</a>
            <a class="tlk" href={SITE.links.portfolio}>View the portfolio</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="sec sec--linen sec--tight">
    <div class="wrap">
      <div class="note-card rv">
        <span class="caps">Ready when you are</span>
        <p class="note-copy">Getting married? Start a bridal inquiry. Booking for yourself? Choose a salon time.</p>
        <span class="note-rule" aria-hidden="true"></span>
        <div class="note-act">
          <a class="btn btn--solid" href={SITE.bridal} {...ext(SITE.bridal)}>Bridal inquiry</a>
          <a class="btn btn--line" href={SITE.booking} {...ext(SITE.booking)}>Book in-salon</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cov .ghost-w{font-size:clamp(4rem,11vw,10rem)}
  .rv-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.4rem,3vw,2.8rem);margin-top:1.6rem}
  .rv-q{position:relative;margin:0;padding-top:2rem;border-top:1px solid var(--hair-strong);display:flex;flex-direction:column;gap:1rem}
  .rv-m{position:absolute;top:.4rem;left:-.1rem;font-family:var(--display);font-size:4rem;line-height:1;color:var(--sage)}
  .rv-q blockquote{margin:1.2rem 0 0;flex:1}
  .rv-q blockquote p{font-family:var(--display);font-style:italic;font-weight:300;font-size:clamp(1.1rem,1.5vw,1.3rem);line-height:1.55;color:var(--ink)}
  .rv-q figcaption{display:grid;gap:.2rem}
  .rv-src{font-size:.8rem;color:var(--ink-soft)}
  @media(max-width:899px){.rv-grid{grid-template-columns:1fr}}
  .rv-empty{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,6vw,5rem);align-items:center}
  .rv-empty-ph{aspect-ratio:4/4.6;margin:0}
  .rv-empty-ph :global(img){object-position:50% 25%}
  .rv-empty-t .caps{display:block;margin-bottom:.8rem}
  .rv-empty-h{font-family:var(--display);font-weight:300;font-size:clamp(1.9rem,3.6vw,3rem);line-height:1.1;color:var(--ink);margin-bottom:1rem}
  .rv-empty-t>p.fade{max-width:32em}
  .rv-empty-a{display:flex;align-items:center;gap:1rem 2rem;flex-wrap:wrap;margin-top:1.6rem}
  @media(max-width:899px){.rv-empty{grid-template-columns:1fr}.rv-empty-ph{width:min(420px,100%)}}
  .note-act{display:flex;justify-content:center;align-items:center;gap:1rem 1.4rem;flex-wrap:wrap}
</style>
