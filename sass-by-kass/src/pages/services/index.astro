---
/** SERVICES — the four things Kass does, as editorial rows: a photograph with one of her
 *  clips set into its corner, the description, what's included, and the right next step
 *  (straight to GlossGenius, or the enquiry for brides and first-time extensions).
 *  No pricing: none was supplied; GlossGenius carries prices and availability. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import Film from '../../components/Film.astro';
import { getCollection } from 'astro:content';
import { SITE, SMS, HOW, MEDIA } from '../../lib/content';
import { businessJsonLd, breadcrumbJsonLd, serviceJsonLd } from '../../lib/seo';
const services = (await getCollection('services')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
const jsonLd = [
  businessJsonLd(),
  breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }]),
  ...services.map((s) => serviceJsonLd({ name: s.data.title, description: s.data.summary, path: `/services#${s.id}`, serviceType: s.data.serviceType })),
];
const roman = ['i', 'ii', 'iii'];
---
<BaseLayout
  title="Services — Hand-Tied Extensions, Dimensional Color, Bridal & Styling"
  description={`Hand-tied extensions, dimensional color, bridal hair and occasion styling by Kassandra. Book online or start an enquiry. ${SITE.name}, ${SITE.area.label}.`}
  path="/services"
  jsonLd={jsonLd}>

  <section class="cov ghostwrap">
    <span class="ghost-w" aria-hidden="true">hair</span>
    <div class="cov-c">
      <p class="cov-kick fade">Services</p>
      <h1 class="disp rv">Four things, <span class="ital">done properly.</span></h1>
      <p class="cov-sub rv" style="--d:.08s">Hand-tied extensions, dimensional color, bridal hair and styling for the occasions in between — with a plan that fits the hair you already have. Prices and availability live on the booking page.</p>
      <div class="cov-cta fade" style="--d:.16s">
        <a class="btn btn--solid" href={SITE.booking} target="_blank" rel="noopener noreferrer">Book an appointment</a>
        <a class="tlk" href="#how">How booking works</a>
      </div>
    </div>
  </section>

  <div class="chapslate fade" role="presentation"><span class="cs-t">Signature services</span></div>

  <section class="sec lit" style="padding-top:clamp(40px,6vw,80px)">
    <i class="lx-shaft" aria-hidden="true"></i>
    <div class="wrap svc-rows">
      {services.map((s) => (
        <article class="svc" id={s.id}>
          <figure class="svc-fig">
            <div class="ph ph--framed rv-im svc-ph"><Plate id={s.data.plate} alt="" class="lv" sizes="(max-width:899px) 90vw, 46vw" /><i class="grain" aria-hidden="true"></i></div>
            {s.data.film && <div class="svc-film fade" style="--d:.2s"><Film film={MEDIA[s.data.film]} label="Reel" /></div>}
          </figure>
          <div class="svc-copy">
            <span class="caps-xs rv">No. {s.data.numeral}</span>
            <h2 class="rv" style="--d:.06s">{s.data.title}</h2>
            <p class="svc-sum rv" style="--d:.1s">{s.data.summary}</p>
            {s.data.points.length > 0 && <ul class="svc-inc rv" style="--d:.14s">{s.data.points.map((p) => <li>{p}</li>)}</ul>}
            <div class="svc-act fade" style="--d:.2s">
              {s.data.cta === 'enquiry'
                ? <a class="btn btn--solid" href={`${SITE.links.book}?for=${s.data.enquiryKey}`}>Start an enquiry</a>
                : <a class="btn btn--solid" href={SITE.booking} target="_blank" rel="noopener noreferrer">Book online</a>}
              <a class="tlk" href={SMS}>Text with a question</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="chapslate chapslate--dk fade" role="presentation" id="how"><span class="cs-t">How booking works</span></div>

  <section class="sec sec--dk lit">
    <i class="lx-dusk" aria-hidden="true"></i>
    <div class="wrap how-grid" data-stag=".08" style="position:relative;z-index:1">
      {HOW.map((h, i) => (
        <article class="how rv">
          <span class="caps-xs">{roman[i]}.</span>
          <h2>{h.title}</h2>
          <p>{h.body}</p>
          <a class="arrow-link" href={h.href} {...('external' in h && h.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{h.cta} <span class="arr" aria-hidden="true">&rarr;</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="sec sec--linen sec--tight">
    <div class="wrap">
      <div class="note-card rv">
        <span class="caps">Not sure what to book?</span>
        <p class="note-copy">Text Kass a photo of your hair and what you’re hoping for — she’ll point you to the right appointment.</p>
        <span class="note-rule" aria-hidden="true"></span>
        <div class="note-act">
          <a class="btn btn--solid" href={SMS}>Text {SITE.phone}</a>
          <a class="tlk" href={SITE.booking} target="_blank" rel="noopener noreferrer">Open online booking</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-rows{display:grid;row-gap:clamp(4.5rem,8vw,7.5rem)}
  .svc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(2.4rem,6vw,6rem);align-items:center;scroll-margin-top:90px}
  .svc-fig{margin:0;position:relative;padding-right:18%;padding-bottom:10%}
  .svc-ph{aspect-ratio:4/4.6}
  .svc-ph :global(img){object-position:50% 22%}
  .svc-film{position:absolute;right:0;bottom:0;width:38%;border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow-lg);outline:6px solid var(--ivory)}
  .svc:nth-child(even) .svc-fig{order:2;padding-right:0;padding-left:18%}
  .svc:nth-child(even) .svc-film{right:auto;left:0}
  .svc:nth-child(even) .svc-copy{order:1}
  .svc-copy .caps-xs{display:block;margin-bottom:1.2rem}
  .svc-copy h2{font-size:clamp(2rem,3.4vw,3.2rem);line-height:1.08;margin:0 0 1.2rem}
  .svc-sum{max-width:30em;margin:0 0 1.4rem}
  .svc-inc{list-style:none;margin:0 0 clamp(1.6rem,2.8vw,2.2rem);padding:0;display:grid;gap:.45rem;max-width:30em}
  .svc-inc li{position:relative;padding-left:1.5rem;font-size:.95rem;color:var(--ink)}
  .svc-inc li::before{content:"";position:absolute;left:0;top:.72em;width:9px;height:1px;background:var(--brass)}
  .svc-act{display:flex;align-items:center;gap:1.8rem;flex-wrap:wrap}
  @media(max-width:899px){
    .svc{grid-template-columns:1fr;row-gap:1.8rem}
    .svc:nth-child(even) .svc-fig,.svc:nth-child(even) .svc-copy{order:0}
    .svc:nth-child(even) .svc-fig{padding-left:0;padding-right:18%}
    .svc:nth-child(even) .svc-film{left:auto;right:0}
    .svc-fig{width:min(520px,100%)}
    .svc-ph{aspect-ratio:4/4.4}
  }
  .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.4rem,2.6vw,2.4rem)}
  .how{border-top:1px solid var(--hairdk);padding-top:1.4rem}
  .how .caps-xs{display:block;color:var(--gold-lt);margin-bottom:.9rem}
  .how h2{font-size:clamp(1.4rem,2vw,1.8rem);color:var(--ivory);margin-bottom:.8rem}
  .how p{color:color-mix(in srgb,var(--ivory) 80%,transparent);font-size:.95rem;margin-bottom:.8rem}
  .note-act{display:flex;justify-content:center;align-items:center;gap:2rem;flex-wrap:wrap}
  @media(max-width:899px){.how-grid{grid-template-columns:1fr}}
</style>
