---
/** BRIDAL INQUIRY — the on-site, bridal-only inquiry page (handoff v2). Leads with her SBK logo,
 *  a short "Bridal Inquiry" identifier and her own "Ready to book?" / "More questions?" words,
 *  with the form directly beneath. No contact directory and no competing salon action here: the
 *  footer keeps the normal contact links. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import BridalInquiryForm from '../components/BridalInquiryForm.astro';
import { SITE, READY } from '../lib/content';
import { businessJsonLd, breadcrumbJsonLd } from '../lib/seo';
const jsonLd = [businessJsonLd(), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Bridal Inquiry', path: '/bridal-inquiry' }])];
---
<BaseLayout
  title="Bridal Inquiry — Wedding Hair with Kass"
  description={`Ready to book your wedding hair? Send Kass a bridal inquiry — she replies by email to confirm availability, your package, contract and deposit. ${SITE.name}, ${SITE.tagline}, ${SITE.area.label}.`}
  path="/bridal-inquiry"
  jsonLd={jsonLd}
  headerLight>
  <section class="bi" aria-labelledby="biH">
    <div class="bi-in">
      <header class="bi-intro">
        <Logo tone="dark" size="sm" class="bi-logo" eager />
        <p class="bi-label">{READY.label}</p>
        <h1 class="bi-h" id="biH">{READY.heading}</h1>
        <p class="bi-body">{READY.body}</p>
        <div class="bi-q">
          <h2>{READY.qHeading}</h2>
          <p>{READY.qBody}</p>
        </div>
      </header>
      <div class="bi-card">
        <p class="bi-card-k">Your bridal inquiry</p>
        <BridalInquiryForm />
      </div>
      <p class="bi-note">{READY.note}</p>
    </div>
  </section>
</BaseLayout>
<style>
  .bi{background:linear-gradient(var(--leaf) 0,var(--leaf) 340px,var(--leaf-deep) 100%);padding:clamp(6.2rem,12vh,8rem) 0 clamp(3.4rem,8vh,5rem);color:var(--ivory)}
  .bi-in{width:min(720px,calc(100vw - 32px));margin-inline:auto;display:grid;gap:clamp(1.4rem,3vh,2rem)}
  .bi-intro{display:grid;justify-items:center;text-align:center;gap:.9rem}
  .bi-intro :global(.bi-logo){width:min(220px,58vw);height:auto;margin-bottom:.4rem}
  .bi-label{display:inline-block;font-family:var(--utility);font-weight:600;font-size:.64rem;letter-spacing:.28em;text-transform:uppercase;color:var(--leaf);background:var(--sage);border-radius:999px;padding:.6em 1.3em .55em;margin:0}
  .bi-h{font-family:var(--display);font-weight:300;font-size:clamp(2.3rem,6vw,3.6rem);line-height:1.05;color:var(--ivory);margin:.2rem 0 0;font-variation-settings:'opsz' 144,'SOFT' 60}
  .bi-body{max-width:34em;font-family:var(--display);font-style:italic;font-size:clamp(1.04rem,1.6vw,1.2rem);line-height:1.6;color:color-mix(in srgb,var(--ivory) 90%,transparent)}
  .bi-q{margin-top:.4rem;padding-top:1rem;border-top:1px solid var(--hairdk);max-width:34em;display:grid;gap:.3rem}
  .bi-q h2{font-family:var(--display);font-weight:300;font-size:1.3rem;color:var(--gold-lt)}
  .bi-q p{font-size:.95rem;color:color-mix(in srgb,var(--ivory) 82%,transparent)}
  .bi-card{min-width:0;background:var(--paper);color:var(--ink-soft);border-radius:var(--r-lg);padding:clamp(20px,4vw,40px);box-shadow:0 70px 120px -60px rgba(0,0,0,.75)}
  .bi-card-k{font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--brass);margin:0 0 1rem}
  .bi-note{text-align:center;font-size:.8rem;color:color-mix(in srgb,var(--ivory) 72%,transparent);margin:0}
  @media(max-width:400px){.bi-card{padding:18px 16px 20px}}
</style>
