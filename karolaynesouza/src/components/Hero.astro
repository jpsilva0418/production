---
/** HERO — her work first, then her; her words; two ways to book.
 *   · Opening, "the blink" (once per visit, never under reduced motion): a gold line eye draws in —
 *     lids, iris, then the lashes flick out one by one — her KS monogram settles as the iris, the
 *     wordmark beneath, then the view rushes through the eye onto the hero. ~2.8 s; any scroll, tap or key skips it; a failsafe removes it if the script stalls.
 *   · Media: a montage of her work that ends on her portrait and holds there —
 *       lash line (close-up) → brow (close-up) → the full eye → KS beat → Karolayne.
 *     Built from the only work photo supplied; every new photo or reel of hers is one more frame in
 *     MONTAGE. MEDIA.heroFilm (a clip with NO burned-in text) replaces the montage when set.
 *     Reduced motion: the portrait alone, still.
 *   · No pinning: the hero scrolls away normally, so nothing ever slides over the booking buttons.
 *  Desktop: words left, media in a tall arched gold-ruled frame right. Phone: media fills the top,
 *  the words sit on a dark gradient below it. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from './Logo.astro';
import { SITE, HERO, MEDIA, ext } from '../lib/content';
import { eyeArt, frameFringe } from '../lib/lashart';
const eye = eyeArt();
const fr = frameFringe();
const plates = import.meta.glob<{ default: ImageMetadata }>('../assets/plates/*.jpg', { eager: true });
const plate = (id: string) => plates[`../assets/plates/${id}.jpg`].default;
const portrait = plate(MEDIA.plates.portrait);
const lashes = plate(MEDIA.plates.lashes);
const film = MEDIA.heroFilm;
/** Montage frames before the portrait. `move` names a camera move in the CSS below. */
const MONTAGE = [
  { src: lashes, move: 'lashline', tag: 'Lashes' },
  { src: lashes, move: 'brow', tag: 'Brows' },
  { src: lashes, move: 'eye', tag: 'Lashes & brows' },
];
---
<script is:inline>
  (function(){try{var d=document.documentElement;
    if(!window.matchMedia||matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('ks-still');return;}
    if(sessionStorage.getItem('ks-intro-v1')){d.classList.add('ks-go');return;}
    sessionStorage.setItem('ks-intro-v1','1');d.classList.add('ks-intro');
    setTimeout(function(){d.classList.add('ks-done');},4200);
  }catch(e){document.documentElement.classList.add('ks-go');}})();
</script>
<div class="ksi" id="ksIntro" aria-hidden="true">
  <div class="ksi-c">
    <div class="ksi-eye">
      <svg viewBox={eye.viewBox} focusable="false">
        <path class="ksi-lid" d={eye.upper} pathLength="1" />
        <path class="ksi-lid ksi-lid--lo" d={eye.lower} pathLength="1" />
        <g class="ksi-lash">{eye.lashes.map((d, i) => <path d={d} pathLength="1" style={`--k:${i}`} />)}</g>
        <circle class="ksi-iris" cx="200" cy="112" r="54" pathLength="1" />
      </svg>
      <Logo class="ksi-ks" />
    </div>
    <p class="ksi-n">Karolayne Souza</p>
    <p class="ksi-t">Lashes &amp; Brows</p>
  </div>
</div>

<section class="hx" id="hero" data-chapter="hero" data-tone="film" aria-labelledby="hxTitle">
  <div class="hx-media" aria-hidden={film ? undefined : 'true'}>
    <svg class="hx-lash" viewBox={fr.viewBox} aria-hidden="true" focusable="false"><path class="hx-lid" d={fr.lid} pathLength="1" />{fr.lashes.map((d, i) => <path d={d} pathLength="1" style={`--k:${i}`} />)}</svg>
    <div class="hx-fr">
      {!film && MONTAGE.map((f, i) => (
        <div class:list={['hx-sl', `hx-sl--${f.move}`]} style={`--i:${i}`}>
          <Image src={f.src} alt="" widths={[640, 941]} sizes="(max-width:899px) 100vw, 46vw" loading="eager" quality={90} />
          <span class="hx-tag">{f.tag}</span>
        </div>
      ))}
      {!film && <div class="hx-sl hx-sl--brand" style={`--i:${MONTAGE.length}`}><Logo full class="hx-brand-ks" /></div>}
      <div class="hx-sl hx-sl--her" style={`--i:${MONTAGE.length + 1}`}>
        <Image src={portrait} alt="" widths={[640, 900, 1086]} sizes="(max-width:899px) 100vw, 46vw" loading="eager" fetchpriority="high" quality={90} />
      </div>
      {film && (
        <video class="hx-film" data-film autoplay muted loop playsinline preload="none" poster={film.poster} disablepictureinpicture tabindex="-1" aria-label={film.alt}>
          <source data-src={film.webm} type="video/webm" />
          <source data-src={film.mp4} type="video/mp4" />
        </video>
      )}
      {!film && <div class="hx-prog" aria-hidden="true">{[...MONTAGE, 0, 0].map((_, i) => <i style={`--i:${i}`}></i>)}</div>}
      <i class="grain" aria-hidden="true"></i>
    </div>
  </div>
  <div class="hx-c">
    <p class="hx-eye">{HERO.eyebrow.map((e, i) => <><span>{e}</span>{i < HERO.eyebrow.length - 1 && <i aria-hidden="true">✦</i>}</>)}</p>
    <h1 class="hx-h" id="hxTitle">
      <span class="hx-l">{HERO.lines[0]}</span>
      <span class="hx-l ital">{HERO.italic}</span>
    </h1>
    <p class="hx-pt" lang="pt-BR">“{SITE.motto}.”</p>
    <p class="hx-sub">{HERO.sub}</p>
    <div class="hx-ctas">
      <a class="btn btn--ivory" href={HERO.ctaHref} {...ext(HERO.ctaHref)}>{HERO.cta}</a>
      <a class="btn btn--ghost" href={HERO.onlineHref} {...ext(HERO.onlineHref)}>{HERO.online}</a>
    </div>
    <p class="hx-offer"><span class="hx-dot" aria-hidden="true"></span>{SITE.offer}<span class="hx-offer-n">· from her Instagram</span></p>
  </div>
</section>

<style>
  /* ============ opening ============ */
  .ksi{display:none}
  :global(html.ks-intro) .ksi{display:grid;position:fixed;inset:0;z-index:200;place-items:center;background:var(--leaf-deep);color:var(--ivory);
    animation:ksiLift .6s ease 2.25s forwards}
  :global(html.ks-intro:not(.ks-done)) body{overflow:hidden}
  :global(html.ks-done) .ksi{display:none}
  .ksi-c{display:flex;flex-direction:column;align-items:center;text-align:center;animation:ksiThrough .8s cubic-bezier(.7,0,.3,1) 1.95s forwards}
  .ksi-eye{position:relative;width:min(78vw,380px)}
  .ksi-eye svg{display:block;width:100%;height:auto;overflow:visible;fill:none}
  .ksi-eye path,.ksi-eye circle{stroke:var(--gold-lt);stroke-linecap:round;stroke-dasharray:1 1;stroke-dashoffset:1}
  .ksi-lid{stroke-width:1.5;animation:ksiDraw 1s cubic-bezier(.45,.05,.25,1) .1s forwards}
  .ksi-lid--lo{stroke-opacity:.55;animation-delay:.25s}
  .ksi-iris{stroke-width:1;stroke-opacity:.6;transform-origin:200px 112px;animation:ksiDraw .9s cubic-bezier(.45,.05,.25,1) .45s forwards}
  .ksi-lash path{stroke-width:1;animation:ksiDraw .45s ease forwards;animation-delay:calc(.75s + var(--k) * 16ms)}
  .ksi-eye :global(.ksi-ks){position:absolute;left:50%;top:48.7%;width:20%;transform:translate(-50%,-50%);color:var(--ivory);opacity:0;animation:ksiIris .8s var(--ease) .8s forwards}
  .ksi-eye :global(.ksi-ks .ks-m){width:100%}
  .ksi-n{margin:1.4rem 0 .7rem;font-family:var(--display);letter-spacing:.2em;text-indent:.2em;text-transform:uppercase;font-size:clamp(1rem,2.4vw,1.3rem);opacity:0;animation:ksiUp .8s var(--ease) 1.05s forwards}
  .ksi-t{margin:0;font-family:var(--utility);font-weight:500;letter-spacing:.44em;text-indent:.44em;text-transform:uppercase;font-size:.62rem;color:var(--gold-lt);opacity:0;animation:ksiUp .8s var(--ease) 1.2s forwards}
  @keyframes ksiDraw{to{stroke-dashoffset:0}}
  @keyframes ksiIris{from{opacity:0;transform:translate(-50%,-50%) scale(.6)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
  @keyframes ksiUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  /* through the eye: the drawing rushes toward the viewer while the black lifts */
  @keyframes ksiThrough{to{transform:scale(7);opacity:0}}
  @keyframes ksiLift{to{opacity:0;visibility:hidden}}

  /* ============ hero ============ */
  .hx{--peek:56px;position:relative;z-index:0;min-height:100vh;min-height:100svh;overflow:hidden;color:var(--ivory);
    background:radial-gradient(90% 80% at 75% 40%,var(--leaf-2) 0%,var(--leaf) 55%,var(--leaf-deep) 100%);
    display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);align-items:center;
    padding:clamp(6.5rem,13vh,8.5rem) var(--gut,5vw) calc(var(--peek) + clamp(3rem,7vh,4.5rem));gap:clamp(2rem,5vw,5rem)}
  .hx-c{position:relative;z-index:2;max-width:600px}
  .hx-eye{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1rem;margin:0 0 clamp(1.4rem,3vh,2.2rem);font-family:var(--utility);font-weight:600;font-size:.64rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold-lt)}
  .hx-eye i{font-style:normal;font-size:.55rem;opacity:.8}
  .hx-h{font-size:clamp(2.8rem,5vw,5.2rem);line-height:1;letter-spacing:-.015em;color:var(--ivory);margin:0 0 clamp(1rem,2vh,1.4rem);font-variation-settings:'opsz' 96}
  .hx-l{display:block;white-space:nowrap}
  .hx-h .ital{color:var(--gold-lt)}
  .hx-pt{font-family:var(--display);font-style:italic;font-size:clamp(1rem,1.4vw,1.2rem);color:color-mix(in srgb,var(--ivory) 70%,transparent);margin:0 0 clamp(1.2rem,2.4vh,1.6rem);font-variation-settings:'opsz' 28}
  .hx-sub{max-width:31em;font-size:clamp(1rem,1.2vw,1.1rem);line-height:1.7;color:color-mix(in srgb,var(--ivory) 84%,transparent);margin:0 0 clamp(1.8rem,3.6vh,2.6rem)}
  .hx-ctas{display:flex;flex-wrap:wrap;gap:12px}
  .hx-ctas .btn{min-width:200px}
  .hx-offer{display:inline-flex;align-items:center;flex-wrap:wrap;gap:.55rem;margin:clamp(1.4rem,3vh,2rem) 0 0;padding:.6rem 1rem .55rem;border:1px solid var(--hairdk-strong);border-radius:999px;
    font-family:var(--utility);font-weight:600;font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ivory)}
  .hx-offer-n{color:color-mix(in srgb,var(--gold-lt) 85%,transparent);letter-spacing:.12em;font-weight:500}
  .hx-dot{width:7px;height:7px;border-radius:50%;background:var(--gold-lt);box-shadow:0 0 0 4px color-mix(in srgb,var(--gold-lt) 22%,transparent)}

  /* the media frame */
  .hx-media{position:relative;z-index:1;order:2;justify-self:end;width:min(100%,520px)}
  .hx-fr{position:relative;aspect-ratio:4/5;border-radius:50% 50% var(--r) var(--r) / 15% 15% var(--r) var(--r);overflow:hidden;background:var(--leaf-deep);
    box-shadow:0 60px 120px -50px rgba(0,0,0,.8),0 0 0 1px var(--hairdk-strong)}
  /* the lash fringe along the lid-shaped top edge, drawn in once the opening is done */
  .hx-lash{position:absolute;left:0;top:0;width:100%;height:auto;margin-top:calc(-60 / 520 * 100%);overflow:visible;z-index:3;fill:none;pointer-events:none}
  .hx-lash .hx-lid{stroke-width:1.4;opacity:1}
  .hx-lash path{stroke:var(--gold-lt);stroke-width:1;stroke-linecap:round;stroke-dasharray:1 1;stroke-dashoffset:1;opacity:.9}
  :global(html.ks-go) .hx-lash path{animation:ksiDraw .5s ease forwards;animation-delay:calc(.3s + var(--k) * 22ms)}
  :global(html.ks-intro) .hx-lash path{animation:ksiDraw .5s ease forwards;animation-delay:calc(2.5s + var(--k) * 22ms)}
  :global(html.ks-still) .hx-lash path{stroke-dashoffset:0}
  .hx-film{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:6}
  .hx-fr .grain{opacity:.04;z-index:7}

  /* ---- montage: each frame 2.2 s; the portrait arrives last and stays ---- */
  .hx-sl{--step:2.2s;position:absolute;inset:0;overflow:hidden;opacity:0}
  .hx-sl :global(img){position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hx-sl--her{opacity:1}
  .hx-sl--her :global(img){object-position:50% 28%}
  .hx-tag{position:absolute;left:50%;bottom:clamp(18px,4%,28px);transform:translateX(-50%);z-index:3;font-family:var(--utility);font-weight:600;font-size:.56rem;letter-spacing:.3em;text-indent:.3em;text-transform:uppercase;color:#fff;
    padding:.6em 1.1em .55em;border-radius:999px;background:rgba(0,0,0,.35);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);white-space:nowrap}
  .hx-sl--brand{display:grid;place-items:center;background:radial-gradient(70% 60% at 50% 45%,var(--leaf-2),var(--leaf-deep))}
  .hx-sl--brand :global(.hx-brand-ks){--ks:clamp(90px,28%,140px);--ks-n:clamp(.85rem,1.6vw,1.05rem);--ks-t:.55rem;color:var(--ivory)}
  .hx-prog{position:absolute;left:18px;right:18px;top:18px;z-index:5;display:flex;gap:5px}
  .hx-prog i{flex:1;height:2px;border-radius:2px;background:rgba(255,255,255,.28);overflow:hidden;position:relative}
  .hx-prog i::after{content:"";position:absolute;inset:0;background:#fff;transform:scaleX(0);transform-origin:left}
  @media(min-width:900px){.hx-prog{left:50%;right:auto;width:46%;transform:translateX(-50%);top:auto;bottom:16px}.hx-tag{bottom:34px}}

  /* the montage runs once the opening has finished (or straight away on later visits) */
  :global(html.ks-go) .hx-sl:not(.hx-sl--her){animation:hxFrame var(--step) ease both;animation-delay:calc(var(--i) * var(--step))}
  :global(html.ks-go) .hx-sl--her{animation:hxHer 1.2s ease both;animation-delay:calc(var(--i) * var(--step) - .3s)}
  :global(html.ks-intro) .hx-sl:not(.hx-sl--her){animation:hxFrame var(--step) ease both;animation-delay:calc(2.4s + var(--i) * var(--step))}
  :global(html.ks-intro) .hx-sl--her{animation:hxHer 1.2s ease both;animation-delay:calc(2.4s + var(--i) * var(--step) - .3s)}
  :global(html.ks-go) .hx-prog i::after{animation:hxBar var(--step,2.2s) linear both;animation-delay:calc(var(--i) * 2.2s)}
  :global(html.ks-intro) .hx-prog i::after{animation:hxBar 2.2s linear both;animation-delay:calc(2.4s + var(--i) * 2.2s)}
  :global(html.ks-go) .hx-prog,:global(html.ks-intro) .hx-prog{animation:hxProgOut .6s ease forwards}
  :global(html.ks-go) .hx-prog{animation-delay:11.6s}
  :global(html.ks-intro) .hx-prog{animation-delay:14s}
  .hx-sl--lashline :global(img){object-position:42% 55%;animation:camLash var(--step) linear both;animation-delay:inherit}
  .hx-sl--brow :global(img){object-position:75% 45%;animation:camBrow var(--step) linear both;animation-delay:inherit}
  .hx-sl--eye :global(img){object-position:50% 50%;animation:camEye var(--step) linear both;animation-delay:inherit}
  :global(html:not(.ks-go):not(.ks-intro)) .hx-sl :global(img){animation:none}
  @keyframes hxFrame{0%{opacity:0}14%{opacity:1}86%{opacity:1}100%{opacity:0}}
  @keyframes hxHer{from{opacity:0;transform:scale(1.06)}to{opacity:1;transform:none}}
  @keyframes hxBar{to{transform:scaleX(1)}}
  @keyframes hxProgOut{to{opacity:0}}
  @keyframes camLash{from{transform:scale(1.32) translate(2%,-3%)}to{transform:scale(1.18) translate(-1%,-1%)}}
  @keyframes camBrow{from{transform:scale(1.3) translate(-5%,7%)}to{transform:scale(1.18) translate(-3%,4%)}}
  @keyframes camEye{from{transform:scale(1.12)}to{transform:scale(1)}}
  /* no JS / reduced motion: her portrait, still */
  :global(html.ks-still) .hx-sl:not(.hx-sl--her),:global(html.ks-still) .hx-prog{display:none}
  :global(html:not(.ks-go):not(.ks-intro)) .hx-prog{display:none}

  @media (prefers-reduced-motion:no-preference){
    :global(html.ks-go) .hx-c>*{animation:fadeUp .9s var(--ease) both}
    :global(html.ks-intro) .hx-c>*{animation:fadeUp .9s var(--ease) 2.2s both}
    .hx-c>:nth-child(2){animation-delay:.08s}.hx-c>:nth-child(3){animation-delay:.16s}.hx-c>:nth-child(4){animation-delay:.22s}
    .hx-c>:nth-child(5){animation-delay:.28s}.hx-c>:nth-child(6){animation-delay:.34s}
    :global(html.ks-intro) .hx-c>:nth-child(2){animation-delay:2.28s}:global(html.ks-intro) .hx-c>:nth-child(3){animation-delay:2.36s}
    :global(html.ks-intro) .hx-c>:nth-child(4){animation-delay:2.42s}:global(html.ks-intro) .hx-c>:nth-child(5){animation-delay:2.48s}:global(html.ks-intro) .hx-c>:nth-child(6){animation-delay:2.54s}
  }

  /* tablet & phone: media fills the top, the words sit on a dark gradient below — sized so both
     booking buttons and the offer are on the first screen of a 390×844 phone */
  @media(max-width:899px){
    .hx{--peek:38px;grid-template-columns:1fr;align-items:end;min-height:0;padding:0 20px calc(var(--peek) + 2.6rem);background:var(--leaf-deep)}
    .hx-media{position:absolute;inset:0 0 auto 0;height:min(62svh,560px);width:100%;justify-self:stretch;order:0}
    .hx-lash{display:none}
    .hx-fr{position:absolute;inset:0;aspect-ratio:auto;border-radius:0;box-shadow:none}
    .hx-fr::after{content:"";position:absolute;inset:0;z-index:4;background:linear-gradient(180deg,rgba(0,0,0,.4) 0%,rgba(0,0,0,0) 20%,rgba(0,0,0,0) 55%,var(--leaf-deep) 100%)}
    .hx-sl--her :global(img){object-position:50% 16%}
    .hx-prog{top:84px}
    .hx-tag{bottom:auto;top:100px}
    .hx-c{padding-top:calc(min(62svh,560px) - 9rem)}
    .hx-eye{font-size:.58rem;margin-bottom:1rem}
    .hx-h{font-size:clamp(2.1rem,9.6vw,3.2rem)}
    .hx-pt{margin-bottom:.9rem}
    .hx-sub{font-size:.95rem;line-height:1.6;margin-bottom:1.3rem}
    .hx-ctas{flex-direction:column;align-items:stretch;max-width:380px}
    .hx-ctas .btn{min-width:0}
    .hx-offer{margin-top:1.1rem}
  }
</style>
<script>
  // The opening: hand over to the montage when the curtain has lifted; any scroll, tap or key
  // skips it immediately. Never blocks: the head script's failsafe hides it at 4.2 s.
  const d = document.documentElement;
  if (d.classList.contains('ks-intro')) {
    const intro = document.getElementById('ksIntro');
    const end = () => d.classList.add('ks-done');
    intro?.addEventListener('animationend', (e) => { if ((e as AnimationEvent).animationName.includes('ksiLift')) end(); });
    const skip = () => end();
    addEventListener('wheel', skip, { once: true, passive: true });
    addEventListener('touchstart', skip, { once: true, passive: true });
    addEventListener('keydown', skip, { once: true });
  }
</script>
