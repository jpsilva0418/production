---
/** One work tile — a photograph or a reel (Film) — for the home grid and /work. Photos and reels
 *  share one grid so they mix the way her Instagram does. `span` drives the desktop layout. */
import Plate from './Plate.astro';
import Film from './Film.astro';
import type { WorkItem } from '../lib/content';
interface Props { item: WorkItem; sizes?: string; widths?: number[] }
const { item, sizes = '(max-width:899px) 90vw, 40vw', widths = [480, 800, 1078] } = Astro.props;
const span = item.span ? `tile--${item.span}` : '';
---
{item.kind === 'film'
  ? <figure class:list={['tile tile--film rv-im', span]}><Film film={item.film} label={item.tag} /></figure>
  : <figure class:list={['tile rv-im', span]}><div class="ph tile-ph"><Plate id={item.plate} alt={item.alt} sizes={sizes} widths={widths} /><i class="grain" aria-hidden="true"></i></div><figcaption class="tile-tag">{item.tag}</figcaption></figure>}
<style is:global>
  .tile{position:relative;min-width:0;margin:0}
  .tile-ph{aspect-ratio:4/5;border-radius:var(--r);height:100%}
  .tile-ph img{transition:transform 1.1s var(--ease)}
  .tile:hover .tile-ph img{transform:scale(1.04)}
  .tile-tag{position:absolute;left:14px;bottom:12px;z-index:5;font-family:var(--utility);font-weight:600;font-size:.56rem;letter-spacing:.24em;text-transform:uppercase;color:#fff;
    padding:.5em .9em .45em;border-radius:999px;background:rgba(0,0,0,.38);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
  .tile--film .film{height:100%}
</style>
