---
/** Her work as one mixed grid: photos and reels together, then an Instagram card that names her
 *  highlight albums (Lashes, Brows, Combo, My space) and links out. With few items the card fills
 *  the row, so the grid never shows a gap; as her posts are added it simply grows. */
import WorkTile from './WorkTile.astro';
import { SITE, ext, type WorkItem } from '../lib/content';
interface Props { items: WorkItem[]; limit?: number }
const { items, limit } = Astro.props;
const shown = limit ? items.slice(0, limit) : items;
const albums = ['Lashes', 'Brows', 'Combo', 'My space'];
---
<div class:list={['wg', `wg--n${Math.min(shown.length, 4)}`]} data-stag=".08">
  {shown.map((item) => <WorkTile item={item} />)}
  <a class="wg-ig fade" href={SITE.instagram.url} {...ext(SITE.instagram.url)}>
    <span class="caps-xs">More on Instagram</span>
    <span class="wg-ig-t">{SITE.instagram.handle}</span>
    <span class="wg-ig-h">Fresh sets, straight from her chair.</span>
    <ul class="wg-alb" aria-label="Her highlight albums">{albums.map((a) => <li>{a}</li>)}</ul>
    <span class="wg-ig-go">Open her profile <span aria-hidden="true">→</span></span>
  </a>
</div>
<style>
  .wg{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1rem,2vw,1.6rem);grid-auto-flow:dense}
  .wg :global(.tile--big){grid-column:span 2;grid-row:span 2}
  .wg :global(.tile--tall){grid-row:span 2}
  .wg :global(.tile--wide){grid-column:span 2}
  .wg :global(.tile--big .tile-ph){aspect-ratio:auto;min-height:100%}
  .wg :global(.tile--tall .film),.wg :global(.tile--tall .tile-ph){aspect-ratio:auto;height:100%;min-height:100%}
  .wg-ig{display:flex;flex-direction:column;gap:1rem;padding:clamp(1.6rem,2.6vw,2.4rem);background:var(--leaf);color:var(--ivory);border-radius:var(--r);
    min-height:280px;transition:transform .5s var(--ease),box-shadow .5s var(--ease);position:relative;overflow:hidden}
  .wg-ig::before{content:"";position:absolute;inset:10px;border:1px solid var(--hairdk);border-radius:calc(var(--r) - 4px);pointer-events:none}
  .wg-ig:hover,.wg-ig:focus-visible{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
  .wg-ig .caps-xs{color:var(--gold-lt)}
  .wg-ig-t{font-family:var(--display);font-size:clamp(1.3rem,2vw,1.8rem);line-height:1.15;overflow-wrap:anywhere;font-variation-settings:'opsz' 48}
  .wg-ig-h{display:none;font-family:var(--display);font-style:italic;font-size:clamp(2rem,3.4vw,3.2rem);line-height:1.08;color:var(--gold-lt);max-width:9em;margin-top:auto;font-variation-settings:'opsz' 96}
  .wg--n1 .wg-ig-h{display:block}
  .wg--n1 .wg-alb{margin-top:1.4rem}
  .wg-alb{list-style:none;margin:auto 0 0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}
  .wg-alb li{font-family:var(--utility);font-weight:600;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;padding:.55em 1em .5em;border:1px solid var(--hairdk-strong);border-radius:999px;color:var(--gold-lt)}
  .wg-ig-go{font-family:var(--display);font-style:italic;font-size:1.05rem;color:var(--ivory)}
  /* one photo: the photo and the card side by side */
  .wg--n1{grid-template-columns:minmax(0,1.35fr) minmax(0,1fr)}
  .wg--n1 :global(.tile--big){grid-column:auto;grid-row:auto}
  .wg--n1 :global(.tile--big .tile-ph){aspect-ratio:4/5}
  @media(max-width:899px){
    .wg--n1 .wg-ig-h{display:none}
    .wg--n1 .wg-alb{margin-top:auto}
    .wg{grid-template-columns:1fr 1fr}
    .wg--n1{grid-template-columns:1fr}
    .wg :global(.tile--big){grid-column:1/-1;grid-row:auto}
    .wg :global(.tile--big .tile-ph){aspect-ratio:4/5}
    .wg-ig{grid-column:1/-1;min-height:0}
  }
</style>
