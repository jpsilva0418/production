---
/** A photo slot: renders her photo from src/assets/plates through astro:assets (responsive
 *  widths, lazy by default, quality 90 so nothing looks soft on a retina phone). New photos: drop
 *  the file into src/assets/plates and reference it by name. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  style?: string;
}
const { id, alt, class: cls, widths = [480, 800, 1078], sizes = '(max-width: 899px) 90vw, 50vw', loading = 'lazy', fetchpriority, style } = Astro.props;
const plates = import.meta.glob<{ default: ImageMetadata }>('../assets/plates/*.jpg', { eager: true });
const entry = plates[`../assets/plates/${id}.jpg`];
if (!entry) throw new Error(`Plate "${id}" not found in src/assets/plates`);
---
<Image src={entry.default} alt={alt} class={cls} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} style={style} quality={90} />
