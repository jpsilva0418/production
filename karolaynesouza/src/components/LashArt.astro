---
/** An animated line drawing of one lash set (see lib/lashart.ts). Strokes draw in when the
 *  wrapper gets `.in` from the shared reveal runtime; under reduced motion they are simply drawn. */
import { lashSet, type LashStyle } from '../lib/lashart';
interface Props { style: LashStyle; label: string; class?: string }
const { style, label, class: cls } = Astro.props;
const a = lashSet(style);
---
<figure class:list={['la fade', cls]} role="img" aria-label={label}>
  <svg viewBox={a.viewBox} aria-hidden="true" focusable="false">
    <g class="la-lashes" style={`--w:${a.weight}`}>
      {a.lashes.map((d, i) => <path d={d} pathLength="1" style={`--k:${i}`} />)}
    </g>
    <path class="la-lid" d={a.lid} pathLength="1" />
  </svg>
</figure>
<style is:global>
  .la{margin:0;color:var(--gold-lt)}
  .la svg{display:block;width:100%;height:auto;overflow:visible}
  .la path{fill:none;stroke:currentColor;stroke-linecap:round;stroke-dasharray:1 1;stroke-dashoffset:1}
  .la-lid{stroke-width:1.6;transition:stroke-dashoffset 1s var(--ease)}
  .la-lower{stroke-width:.8;opacity:.35;transition:stroke-dashoffset 1.1s var(--ease) .1s}
  .la-lashes path{stroke-width:var(--w);opacity:.95;transition:stroke-dashoffset .5s ease calc(.5s + min(var(--k) * 8ms, 1.2s))}
  .la.in path{stroke-dashoffset:0}
  @media (prefers-reduced-motion:reduce){.la path{stroke-dashoffset:0;transition:none}}
</style>
